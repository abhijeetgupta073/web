const defaultHeadersOrder = [];
function GetRegisterListData(id, UID, showCompleted, showCurrent, showBuilt1, showAll, ddlSitesLoc, ddlLocaSite, checkHideCompleted, WorkGroup, SubGroup, Supervisor, BuildingID, IsMasterJob) {

    $('#LoadingPanel1').show();
    var hdnTimeOffSet = $('#hdnTimeOffSetForAllPage').val();  
    $.ajax({
        type: "POST",
        url: "/RegisterList/GetRegisterListData",
        // data: JSON.stringify({ id: id, UID: UID, showCompleted: showCompleted, showCurrent: showCurrent, showBuilt1: showBuilt1, showAll: showAll, ddlSitesLoc: ddlSitesLoc, ddlLocaSite: ddlLocaSite, checkHideCompleted: checkHideCompleted, hdnTimeOffSet: hdnTimeOffSet }),

        data: JSON.stringify({ id: id, UID: UID, showCompleted: showCompleted, showCurrent: showCurrent, showBuilt1: showBuilt1, showAll: showAll, ddlSitesLoc: ddlSitesLoc, ddlLocaSite: ddlLocaSite, checkHideCompleted: checkHideCompleted, hdnTimeOffSet: hdnTimeOffSet, WorkGroup: WorkGroup, SubGroup: SubGroup, Supervisor, BuildingID, IsMasterJob }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            var str = "";
            var GetData = response;
            $('#tblRegisterList').DataTable().clear();
            $('#tblRegisterList').DataTable().destroy();
            updateTableIfOrderChanged("tblRegisterList", defaultHeadersOrder);
            applySearchRow();
            if (GetData.length > 0) {
                var str = "";
               
                for (var i = 0; i < GetData.length; i++) {
                    const data = GetData[i];
                    var scafRefStyle = (data.ImageFlag == 1) ? " style='background-color:#a3d9a5;'" : "";
                    var scafRefTd = "<td class='setWidth4'" + scafRefStyle + ">" + (data.ShowRegisterID || "") + "</td>";
                    const rowData = {
                        hidden0: "<td class='setWidth0' style='display:none'></td>",
                        Copy: "<td class='setWidth1' style='text-align:center;cursor:pointer;' title='Click here to Copy Historical Job.'>" +
                            "<i class='fa fa-copy CopyIcon setWidth1 Checkjob' value='" + (data.REGISTERId || "") + "' ChkRegisterId_='" + (data.REGISTERId || "") + "' ChkScaffRef_='" + (data.ShowRegisterID || "") + "' ChkOldLocId_='" + (data.LocationId || "") + "' ChkOldSiteId_='" + (data.SiteLocID || "") + "' ChkOldFloorid_='" + (data.FloorLevelId || "") + "'></i></td>",
                        GoOffline: "<td class='setWidth1' style='text-align:center;cursor:pointer;' title='Click here to Go Offline Inspection.'>" +
                            "<input type='checkbox' class='ChkTransID setWidth1' value='" + (data.REGISTERId || "") + "' ChkRegisterId_='" + (data.REGISTERId || "") + "'/></td>",
                        Edit: "<td class='setWidth2' title='Click here to edit Job.' style='cursor:pointer;'>" +
                            "<a id='tbnEdit' class='btnJobEdit' tbnEditRegisterId_='" + (data.REGISTERId || "") + "'><i class='fa fa-pencil'></i>&nbsp;</a></td>",
                        //JobStatus1: "<td class='setWidth3'>" +
                        //    ((data.Status || "").toUpperCase() == "RED" || (data.Status || "").toUpperCase() == "GREEN" || (data.Status || "").toUpperCase() == "YELLOW"
                        //        ? "<img src='/images/" + data.Status + ".jpg' class='img-responsive' style='height: 22px;width: 22px;float: left;'/>"
                        //        : (data.Status || "")) +
                        //    "</td>",
                        JobStatus1: "<td class='setWidth3'>" +
                            ((data.Status || "").toUpperCase() == "RED" ||
                                (data.Status || "").toUpperCase() == "GREEN" ||
                                (data.Status || "").toUpperCase() == "YELLOW"
                                ? "<span style='display:none'>" + data.Status + "</span>" +
                                "<img src='/images/" + data.Status + ".jpg' style='height:22px;width:22px;'/>"
                                : (data.Status || "")) +
                            "</td>",
                        JobStatus2: "<td class='setWidth3' style='display:none;'>" + (data.Status || "") + "</td>",
                        ScafRef: scafRefTd,
                        ClientScafRef: "<td class='setWidth5'>" + (data.ClientScaffref || "") + "</td>",
                        WONo: "<td class='setWidth6'>" + (data.WONumber || "") + "</td>",
                        Location: "<td class='setWidth7'>" + (data.Location || "") + "</td>",
                        BuildingModuleNo: "<td class='setWidth8'>" + (data.BuildingNo || "") + "</td>",
                        FloorLevel: "<td class='setWidth9'>" + (data.FloorLevel || "") + "</td>",
                        Bearing: "<td class='setWidth10'>" + (data.Bearing || "") + "</td>",
                        ReasonForAccess1: "<td class='setWidth11' title='" + (data.Description || "") + "'>" + ((data.Description || "").substring(0, 50)) + "</td>",
                        ReasonForAccess2: "<td class='setWidth11' style='display:none;'>" + (data.Description || "") + "</td>",
                        AssetFuncLoc: "<td class='setWidth12'>" + (data.AssetNo || "") + "</td>",
                        DateBuilt: "<td class='setWidth13'>" + DateFormat(data.DateTagged) + "</td>",
                        DaysSinceLastInsp: "<td class='setWidth14'>" + (data.DaysSinceLastInsp || "") + "</td>",
                        Tonnage: "<td class='setWidth15'>" + (data.Tonnage || "") + "</td>",
                        DesignType: "<td class='setWidth16'>" + (data.DesignType || "") + "</td>",
                        MaterialType: "<td class='setWidth17'>" + (data.MaterialType || "") + "</td>",
                        DutyRating: "<td class='setWidth18'>" + (data.DutyRating || "") + "</td>",
                        DateOfDismantle: "<td class='setWidth19'>" + DateFormat(data.DateOFDismantle) + "</td>",
                        InspectedBy: "<td class='setWidth20'>" + (data.InspectedBy || "") + "</td>",
                        StandingDaysToDate: "<td class='setWidth21'>" + (data.HireDaysToDate || "") + "</td>",
                        TotalStandingDays: "<td class='setWidth22'>" + (data.TotalHireDays || "") + "</td>",
                        SAPNumber: "<td class='setWidth23'>" + (data.SAPNumber || "") + "</td>",
                        ProjectType: "<td class='setWidth24'>" + (data.ScafType || "") + "</td>",
                        OwnerRef: "<td class='setWidth25'>" + (data.ClientRef || "") + "</td>",
                        OwnerName: "<td class='setWidth26'>" + (data.OwnerName || "") + "</td>",
                        Site: "<td class='setWidth27'>" + (data.SiteLocation || "") + "</td>",
                        LongTermStructure: "<td class='setWidth42'>" + (data.LongTermStructure ? "Yes" : "") + "</td>",
                        SubOwner: "<td class='setWidth28'>" + (data.ScaffoldOwner || "") + "</td>",
                        SubOwnerRep: "<td class='setWidth29'>" + (data.discipline || "") + "</td>",
                        WorkGroup: "<td class='setWidth29'>" + (data.WorkGroup || "") + "</td>",
                        SubGroup: "<td class='setWidth29'>" + (data.SubGroup || "") + "</td>",
                        ManHrsErect: "<td class='setWidth30'>" + (data.ManHrsErect || "") + "</td>",
                        ManHrsDismantle: "<td class='setWidth31'>" + (data.ManHrsDismantle || "") + "</td>",
                        ShiftAllocation: "<td class='setWidth32'>" + (data.ShiftAllocation || "") + "</td>",
                        CreatedBy: "<td class='setWidth33'>" + (data.CreatedBy || "") + "</td>",
                        CreatedOn: "<td class='setWidth34'>" + DateFormat(data.CreatedOn) + "</td>",
                        UpdatedBy: "<td class='setWidth35'>" + (data.UpdatedBy || "") + "</td>",
                        UpdatedOn: "<td class='setWidth36'>" + DateFormat(data.UpdatedOn) + "</td>",
                        Length: "<td class='setWidth37'>" + (data.Length || "") + "</td>",
                        Width: "<td class='setWidth38'>" + (data.Width || "") + "</td>",
                        HeightTWP: "<td class='setWidth39'>" + (data.Height || "") + "</td>",
                        SiteStatus: "<td class='setWidth40'>" + (data.SiteLocationStatus || "") + "</td>",
                        LockedIn: "<td class='setWidth43'>" + (data.LockedIn ? "Yes" : "No") + "</td>",
                        RequiresIsolation: "<td class='setWidth26'>" + (data.ChkRequiresIsolation ? "Yes" : "No") + "</td>",
                        Supervisor: "<td class='setWidth26'>" + (data.Supervisor || "") + "</td>",

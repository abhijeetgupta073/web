function btnaddnew_Click() {
    var ClientID = getParameterByName('id');
    var UID = getParameterByName('UID');
    var UserRole = getParameterByName('UserRole');
    var RID = "0";
    var EncryptData = [RID];
    var encryData = Encrypt(EncryptData);
    RID = encryData[0];

    window.location.href = '/Register/Register?UID=' + UID + '&UserRole=' + UserRole + '&id=' + ClientID + '&RID=' + RID;
}
function ShowDeletePopup(RegisterId) {
    $('#hdnRegisterID').val(RegisterId);
    $('#divdelete').show();
}
function btndeleteyes_Click() {
    // $('#LoadingPanel1').show();
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    var RegisterID = $('#hdnRegisterID').val();

    var checkHideCompleted = $('#checkHideCompleted').prop('checked');

    var LocationID = $('#ddlLocaSite').val();
    if (LocationID == "" || LocationID == undefined) {
        LocationID = "";
    }

    var Siteid = $('#ddlSites').val();
    if (Siteid == "" || Siteid == undefined) {
        Siteid = "";
    }
    var ddlWorkGroup = $('#ddlWorkGroup').val();
    if (ddlWorkGroup == undefined) {
        ddlWorkGroup = "";
    }
    var ddlSubGroup = $('#ddlSubGroup').val();
    if (ddlSubGroup == undefined) {
        ddlSubGroup = "";
    }

    var Supervisor = $('#ddlSupervisor').val();
    if (Supervisor == "" || Supervisor == undefined) {
        Supervisor = "";
    }
    var ddlBuilding = $('#ddlBuilding').val();
    if (ddlBuilding == "" || ddlBuilding == undefined) {
        ddlBuilding = "";
    }
    $.ajax({
        type: "POST",
        url: "/RegisterList/btndeleteyes_Click",

        data: JSON.stringify({ id: id, RegisterID: RegisterID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {

            var GetData = response;
            CustomAlert(response);

            // GetRegisterListData(id, UID, false, false, false, false, Siteid, LocationID, checkHideCompleted);
            GetRegisterListData(id, UID, false, false, false, false, Siteid, LocationID, checkHideCompleted, ddlWorkGroup, ddlSubGroup, Supervisor, ddlBuilding);
            //$('#LoadingPanel1').hide();
        }
    })
    $('#divdelete').hide();
    // $('#LoadingPanel1').hide();
}
function btndeleteno_Click() {
    $('#divdelete').hide();
}

function btnQRCodeClick_Click() {
    var id = getParameterByName('id');
    var hdnfrom = $('#hdnfrom').val();
    var tempimg = $('#tempimg').val();
    var UID = getParameterByName('UID');
    var UserRole = getParameterByName('UserRole');
    $.ajax({
        type: "POST",
        url: "/RegisterList/btnQRCodeClick_Click",

        data: JSON.stringify({ id: id, hdnfrom: hdnfrom, tempimg: tempimg, UID: UID, UserRole: UserRole }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {

            var GetData = response;
            if (response.Result == "Success") {
                window.location.href = response.Message;
                // window.location.href = '/OfflineRegister.html?UID=' + UID + '&UserRole=' + UserRole + '&id=' + ClientID + '&offlinestatus=' + hdnOfflineStatus;
                $('#LoadingPanel1').hide();
            } else {
                CustomAlert(response);
                $('#LoadingPanel1').hide();
            }

        }
    })
}

function btnOfflineLink_Click() {
    // $('#GetOfflineModal').show();
    $('#LoadingPanel1').show();
    setTimeout(function () {

        var RegisterID = "";
        var selectedCount = 0;
        table.$('.ChkTransID').each(function () {
            if (this.checked) {
                selectedCount++;
                ChkUpdateAllflag = true;
                RegisterID = this.value;
            }
        });


        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        //var hdnOfflineStatus = $('#hdnOfflineStatus').val();
        var Siteid = $('#ddlSites').val();
        if (Siteid) {

            if (selectedCount > 1) {
                alert("please select only 1 job.");
                $('#LoadingPanel1').hide();
                return;  // Exit the function if more than one checkbox is selected
            }
            $.ajax({
                type: 'Post',
                url: '/RegisterList/CheckuserUserisOfflineMode',
                data: JSON.stringify({ id: id, UID: UID, Siteid: Siteid, RegisterID: RegisterID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    if (response.VerifyedUser == 1) {
                        $.ajax({
                            type: 'Post',
                            url: '/RegisterList/btnOfflineLink_Click',
                            data: JSON.stringify({ id: id, UID: UID, UserRole: UserRole, hdnOfflineStatus: hdnOfflineStatus, RegisterID: RegisterID }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            async: true,
                            success: function (response) {
                                var GetData = response;
                                if (response.Result == "Success") {
                                    if (response.Message == "Adddocs") {
                                        $('#LoadingPanel1').hide();
                                        $('#GetOfflineModal').css('display', 'block');
                                    } else {
                                        CustomAlert(response);
                                        $('#LoadingPanel1').hide();
                                    }
                                } else {
                                    CustomAlert(response);
                                    $('#LoadingPanel1').hide();
                                }
                            },
                            error: function (x, y, z) {
                                $('#LoadingPanel1').hide();
                                $('#GetOfflineModal').css('display', 'none');
                                alert(z);
                            }
                        });
                    }
                    else {
                        var res = {
                            Result: "Failed", Message: " " + response.UserName + " Allready in offline mode with this job "
                        }
                        CustomAlert(res);
                        $('#GetOfflineModal').modal('hide');
                        $('#LoadingPanel1').hide();
                    }
                },
                error: function (x, y, z) {
                    $('#LoadingPanel1').hide();
                    $('#GetOfflineModal').css('display', 'none');
                    alert(z);
                }
            });

        }
        else {
            var Response = { Result: "Failed", Message: "Please select Site." };
            CustomAlert(Response);
            $('#LoadingPanel1').hide();

        }

    }, 1000);


}
function btnofflineconfirm_Click() {
    $('#LoadingPanel1').show();
    var Siteid = $('#ddlSites').val();
    if (Siteid) {

        setTimeout(function () {

            var RegisterID = "";
            ArrayOfflineRegister = [];
            table.$('.ChkTransID').each(function () {
                if (this.checked) {
                    ChkUpdateAllflag = true;
                    RegisterID = this.value;
                    var ArryVal = { RegisterID: RegisterID };
                    ArrayOfflineRegister.push(ArryVal);
                }
            });
            var id = getParameterByName('id');
            var UID = getParameterByName('UID');
            var UserRole = getParameterByName('UserRole');
            var hdnOfflineStatus = $('#hdnOfflineStatus').val();
            $.ajax({
                type: 'Post',
                url: '/RegisterList/btnofflineconfirm_Click',
                data: JSON.stringify({ id: id, UID: UID, UserRole: UserRole, GetOfflinestatus: hdnOfflineStatus, Siteid: Siteid, model: ArrayOfflineRegister }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                    var GetData = response;
                    if (response.Result == "Success") {
                        // $('#LoadingPanel1').hide();
                        //$('#GetOfflineModal').hide();
                        $('#GetOfflineModal').css('display', 'none');
                        //CustomAlert(response);
                        console.log(response.Link)
                        window.location.href = response.Link;
                    } else {
                        $('#LoadingPanel1').hide();
                        // $('#GetOfflineModal').hide();
                        $('#GetOfflineModal').css('display', 'none');
                        CustomAlert(response);
                    }

                    var id = getParameterByName('id');
                    var UID = getParameterByName('UID');
                    var checkHideCompleted = $('#checkHideCompleted').prop('checked');

                    var LocationID = $('#ddlLocaSite').val();
                    if (LocationID == undefined) {
                        LocationID = "";
                    }

                    var Siteid = $('#ddlSites').val();
                    if (Siteid == undefined) {
                        Siteid = "";
                    }
                    var ddlWorkGroup = $('#ddlWorkGroup').val();
                    if (ddlWorkGroup == undefined) {
                        ddlWorkGroup = "";
                    }
                    var ddlSubGroup = $('#ddlSubGroup').val();
                    if (ddlSubGroup == undefined) {
                        ddlSubGroup = "";
                    }
                    var ddlBuilding = $('#ddlBuilding').val();
                    if (ddlBuilding == undefined) {
                        ddlBuilding = "";
                    }
                    var Supervisor = $('#ddlSupervisor').val();
                    if (Supervisor == "" || Supervisor == undefined) {
                        Supervisor = "";
                    }
                    GetRegisterListData(id, UID, false, false, false, false, Siteid, LocationID, checkHideCompleted, ddlWorkGroup, ddlSubGroup, Supervisor,ddlBuilding);

                    setTimeout(function () {

                        $('#LoadingPanel1').hide();
                        CustomAlert(response);
                    }, 1000);
                },
                error: function (x, y, z) {
                    $('#LoadingPanel1').hide();
                    $('#GetOfflineModal').css('display', 'none');
                    alert(z);
                }
            });
        }, 1000);
    }
    else {
        var Response = { Result: "Failed", Message: "Please select Site." };
        CustomAlert(Response);
        $('#LoadingPanel1').hide();

    }
}

function checkIsOfflineCurrent() {

    var id = getParameterByName('id'); // Extract the ID from query parameters

    $.ajax({
        type: 'POST',
        url: '/RegisterList/checkIsOfflineCurrent',
        data: JSON.stringify({ id: id }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            if (response.Result === "Success") {
                var offlineRegisterID = response.RegisterID;
                if (offlineRegisterID.length > 0) {
                    for (var i = 0; i < offlineRegisterID.length; i++) {
                        $(".ChkTransID").each(function () {
                            var checkbox = $(this);
                            if (checkbox.attr("ChkRegisterId_") === offlineRegisterID[i]) { // Match RegisterID
                                if (response.IsOffline) {
                                    checkbox.prop('disabled', true); // Disable the checkbox
                                    checkbox.prop('checked', false); // Uncheck the checkbox
                                    checkbox.attr('title', 'This job is currently in offline mode.');
                                } else {
                                    checkbox.prop('disabled', false); // Enable the checkbox
                                }
                            }
                        });
                    }
                }
                else {
                    checkbox.prop('disabled', false);
                }
            } else {
                console.error("Error: " + response.Message);
            }
        },
        error: function (xhr, status, error) {
            console.error("AJAX error: " + error);
        }
    });
}
function btnofflinecancel_Click() {
    $('#GetOfflineModal').hide();


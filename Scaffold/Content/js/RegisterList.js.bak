function dropdownWorkGroup(selectedWorkGroup) {
    var id = getParameterByName('id');
    var Siteid = $("#ddlSites").val();
    var LocationID = $("#ddlLocaSite").val();
    var BuildingID = $("#ddlBuilding").val();
    var UID = getParameterByName('UID');
    if (Siteid == undefined) {
        Siteid = "";
    }
    if (LocationID == undefined) {
        LocationID = "";
    }

    $('#LoadingPanel1').css('display', 'block');
    $.ajax({
        type: "POST",
        url: "/RegisterList/dropdownWorkGoups",

        data: JSON.stringify({ id: id, UID: UID, Siteid: Siteid, LocationID: LocationID, BuildingID: BuildingID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {

            //var GetData = response;
            //$("#ddlWorkGroup").empty().append('<option value=""></option>');
            //if (GetData.length > 0) {
            //    for (var i = 0; i < GetData.length; i++) {
            //        $("#ddlWorkGroup").append("<option value='" + GetData[i].WorkGroup + "'>" + GetData[i].WorkGroup + "</option>");
            //    }
            //}
            var GetData = response;
            $("#ddlWorkGroup").empty().append('<option value=""></option>');
            for (var i = 0; i < GetData.length; i++) {
                $("#ddlWorkGroup").append("<option value='" + GetData[i].WorkGroupID + "'>" + GetData[i].WorkGroup + " (" + GetData[i].DropdownSitelocation + ")" + "</option>"
                );
            }
            if (selectedWorkGroup && selectedWorkGroup !== "") {
                $("#ddlWorkGroup").val(selectedWorkGroup);
            } else if ($('#hdnWorkGroup').val() !== "") {
                $("#ddlWorkGroup").val($('#hdnWorkGroup').val());
            }

            //  $('#LoadingPanel1').css('display', 'none');
        }

    })
}



function dropdownBuilding(selectedBuilding) {
    var id = getParameterByName('id');
    var Siteid = $("#ddlSites").val();
    var LocationID = $("#ddlLocaSite").val();
    var UID = getParameterByName('UID');
    if (Siteid == undefined) {
        Siteid = "";
    }
    if (LocationID == undefined) {
        LocationID = "";
    }

    $('#LoadingPanel1').css('display', 'block');
    $.ajax({
        type: "POST",
        url: "/RegisterList/dropdownBuilding",

        data: JSON.stringify({ id: id, UID: UID, Siteid: Siteid, LocationID: LocationID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {
            var GetData = response;
            $("#ddlBuilding").empty().append('<option value=""></option>');
            for (var i = 0; i < GetData.length; i++) {
                //$("#ddlBuilding").append("<option value='" + GetData[i].buildingid + "'>" + GetData[i].DropdownBuilding + "</option>"
                //);
                $("#ddlBuilding").append(
                    "<option value='" + GetData[i].buildingid + "'>" + GetData[i].DropdownBuilding + " (" + GetData[i].DropdownSitelocation + ")" + "</option>"
                );
            }
            if (selectedBuilding && selectedBuilding !== "") {
                $("#ddlBuilding").val(selectedBuilding);
            } else if ($('#hdnBuilding').val() !== "") {
                $("#ddlBuilding").val($('#hdnBuilding').val());
            }

            //  $('#LoadingPanel1').css('display', 'none');
        }

    })
}


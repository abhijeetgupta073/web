$(document).ready(function () {
    //db.transaction(function (t) {
    //    t.executeSql(CreateCurrentRid);
    //});

    var screensize = $(window).width();
    if (screensize < 1150 && screensize > 650) {
        ($BODY.hasClass('nav-md'))
        $('#CreateNewDropDown').css("margin-top", "2px");
        $BODY.removeClass('nav-md').addClass('nav-sm');
        $LEFT_COL.removeClass('scroll-view');
        $('#imgLogo').parent().css('display', 'none');
        $('#imgLogo1').css('display', 'block').css("height", "38px");
        $('#leftbarsection').css('margin-top', '0px');
        // $('#ContentPlaceHolder1_ddlSitesLoc').css('margin-left', '-14px').css('width', '100%');
        // $('#ContentPlaceHolder1_ddlLocaSite').css('margin-left', '9px').css('width', '100%');
    }
    else {
        if (screensize < (650)) {
            $BODY.removeClass('nav-sm')
            $('#imgLogo').parent().css('display', 'none');
            $('#imgLogo1').css('display', 'block').css("height", "52px");

        }

        else {
            $('#CreateNewDropDown').css("margin-top", "6px");
            $BODY.removeClass('nav-sm').addClass('nav-md');
            //$('#BlackSection').css('display', 'none');
            $('#imgLogo').parent().css('display', 'block');
            $('#imgLogo1').css('display', 'none');
            $('#leftbarsection').css('margin-top', '40px');
        }
    }

});

function SiteDropDown() {
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    $('#LoadingPanel1').css('display', 'block');
    $.ajax({
        type: "POST",
        url: "/RegisterList/SiteDropDown",

        data: JSON.stringify({ id: id, UID: UID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {

            var SiteData = response;

            $("#ddlSites").empty();

            $("#ddlSites").empty().append('<option value=""></option>');
            for (var i = 0; i < SiteData.length; i++) {
                $("#ddlSites").append(
                    "<option value='" + SiteData[i].SiteLocID + "'>" + SiteData[i].SiteLocation + "</option>"
                );
            }
            if ($('#hdnSiteID').val() != "") {
                $("#ddlSites").val($('#hdnSiteID').val());
            }

            //  $('#LoadingPanel1').css('display', 'none');
        }

    })
}


function LocationDropDown(selectedLocationId) {
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    var Siteid = $('#ddlSites').val();

    if (Siteid == undefined) {
        Siteid = "";
    }

    $('#LoadingPanel1').css('display', 'block');

    $.ajax({
        type: "POST",
        url: "/RegisterList/LocationDroupdown",
        data: JSON.stringify({ id: id, UID: UID, Siteid: Siteid }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {
            var GetData = response;

            $("#ddlLocaSite").empty().append('<option value=""></option>');

            for (var i = 0; i < GetData.length; i++) {
                $("#ddlLocaSite").append(
                    "<option value='" + GetData[i].areaid + "'>" + GetData[i].area + "</option>"
                );
            }
            if (selectedLocationId && selectedLocationId !== "") {
                $("#ddlLocaSite").val(selectedLocationId);
            } else if ($('#hdnLocationID').val() !== "") {
                $("#ddlLocaSite").val($('#hdnLocationID').val());
            }

            $('#LoadingPanel1').css('display', 'none');
        },
        error: function () {
            $('#LoadingPanel1').css('display', 'none');
        }
    });
}


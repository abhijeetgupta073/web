$(document).ready(function () {

    var scanner;

    $(".ButtonQRCode").on("click", function () {
        // alert();

        var contentScan;
        $("#btnOpenModel").css("display", "block");

        let scanner = new Instascan.Scanner(
            {
                video: document.getElementById('preview')


            }
        );
        scanner.addListener('scan', function (content) {
            //alert('Do you want to open this page?: ' + content);
            contentScan = content;
            //window.open(content, "_blank");

        });
        Instascan.Camera.getCameras().then(cameras => {

            if (cameras.length > 0) {
                // scanner.start(cameras[1]);     // For Back Camera
                scanner.start(cameras[0]);  // For Front Camere

            } else {
                console.error("Please enable Camera!");
            }
        });

        $("#cancelsnap").off("click").on("click", function () {
            $("#btnOpenModel").css("display", "none");
            if (scanner) {
                scanner.stop();
            }
        });

        // Trigger photo take
        document.getElementById('snap').addEventListener('click', function () {
            $("#btnOpenModel").css("display", "none");
            //$(".hdnCamerabefore").css("display", "block");
            //$("#imga").css("display", "none");
            $("#tempimg").val(contentScan);
            //cameraStream.stop();
            $("#hdnfrom").val("1");
            //var btn = document.getElementById('<%=btnQRCodeClick.ClientID%>');
            if (scanner) {
                scanner.stop();
            }
            var btn = document.getElementById('btnQRCodeClick');
            btn.click();
        });
        document.getElementById('Inspection').addEventListener('click', function () {
            $("#btnOpenModel").css("display", "none");
            //$(".hdnCamerabefore").css("display", "block");
            //$("#imga").css("display", "none");
            $("#tempimg").val(contentScan);
            //cameraStream.stop();
            $("#hdnfrom").val("2");
            if (scanner) {
                scanner.stop();
            }
            // var btn = document.getElementById('<%=btnQRCodeClick.ClientID%>');
            var btn = document.getElementById('btnQRCodeClick');
            btn.click();
        });
    });
});


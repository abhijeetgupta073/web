                orderCellsTop: true,
                dom: 'Bfrtip',
                 buttons: [
                     {
                         extend: 'csvHtml5',
                         title: 'Register List',
                         exportOptions: {
                             columns: function (idx, data, node) {
                                 let colName = defaultHeadersOrder[idx]?.columnName || "";
                                 const neverExport = ["hidden0", "Copy", "GoOffline", "Edit", "Delete", "JobStatus1", "ReasonForAccess1"];
                                 const conditionalExport = ["JobStatus2", "ReasonForAccess2"];

                                 if (neverExport.includes(colName)) return false;

                                 if (conditionalExport.includes(colName)) {
                                     let relatedCol = colName === "JobStatus2" ? "JobStatus1" : "ReasonForAccess1";
                                     let relatedVisible = $("#tblRegisterList thead th").filter(function () {
                                         return $(this).attr("columnName") === relatedCol;
                                     }).is(":visible");
                                     return relatedVisible;
                                 }

                                 return $(node).is(':visible');
                             },
                             format: {
                                 header: function (data, columnIdx) {
                                     let colName = defaultHeadersOrder[columnIdx]?.columnName || "";

                                     if (colName === "JobStatus2") {
                                         return 'Job Status'; 
                                     }
                                     if (colName === "ReasonForAccess2") {
                                         return 'Reason for Access. (Provide Detailed Description)';
                                     }
                                     return data;
                                 },
                                 body: function (data, row, column, node) {

                                     let colName = defaultHeadersOrder[column]?.columnName || "";

                                     let cell = $(node);
                                     let textValue = cell.text().trim();

                                     if (colName === "JobStatus1") {
                                         let img = cell.find("img").attr("src");
                                         if (img) {
                                             return img.replace("/images/", "").replace(".jpg", "");
                                         }
                                         return textValue;
                                     }

                                     if (colName === "JobStatus2") {
                                         return textValue;
                                     }

                                     if (colName === "ReasonForAccess1") {
                                         return textValue;
                                     }

                                     if (colName === "ReasonForAccess2") {
                                         return textValue;
                                     }

                                     return textValue;
                                 }
                             }

                         }
                     }
                 ],

            });
            var UserRole = getParameterByName("UserRole");
            var DecriptValues = Decrypt([UserRole]);
            UserRole = DecriptValues[0];
            if (UserRole != 10) { //  commented code on 04-05-2024  because we already hide these column from hide show no need this hardcoded 
                //table.column(30).visible(false);
                ////table.column(35).visible(false);
                ////table.column(36).visible(false);
                ////table.column(37).visible(false);
                //table.column(38).visible(false);
                ////table.column(42).visible(false);
                ////table.column(43).visible(false);
                //table.column(39).visible(false);
                //table.column(40).visible(false);
                //table.column(41).visible(false);
                //table.column(45).visible(false);
                //table.column(46).visible(false);

            }
            GridButtonHideShow(table, "tblRegisterList");

            //if ($('#hdnOfflineEnabled').val() != 'True') {
            //if (($('#hdnOfflineEnabled').val() != 'True') && ($('#hdnOfflineInspEnable').val() != 'True')) {
            //    //table.column(1).visible(false); //Commented on 05-01-2024 we have added new column of Copy Historical Check box.
            //    table.column(defaultHeadersOrder.findIndex(x => x.columnName === "GoOffline")).visible(false);
            //}

            // Hide GoOffline column ONLY (safe – does not affect Delete column)
            if ($('#hdnOfflineEnabled').val() !== 'True' && $('#hdnOfflineInspEnable').val() !== 'True') {

                table.columns().every(function () {
                    var colName = $(this.header()).attr("columnName");
                    if (colName === "GoOffline") {
                        this.visible(false);
                    }
                });
            }



        }
    })
}

function ApplyRegisterListColumnOrder(id, UID, SiteLocId, LocationId, showCompleted, WorkGroup, SubGroup, DropDownSupervisor, ddlBuilding) {

    if ($.fn.DataTable.isDataTable("#tblRegisterList")) {
        $('#tblRegisterList').DataTable().destroy();
    }

    $.ajax({
        url: "/RegisterList/GetRegisterListSortingData",
        type: "GET",
        data: { id: id },
        success: function (res) {

            if (res.status !== 1 || !res.columns) return;
            defaultHeadersOrder.length = 0;
            res.columns.forEach(c => {
                defaultHeadersOrder.push({
                    columnName: c.ColumnName,
                    colOrder: c.ItemOrder
                });
            });
            buildTableHeaders(res.columns);     
            generateDynamicHeaders(res.columns);
            reorderHeadersByItemOrder("tblRegisterList", res.columns); 
            GetRegisterListData(id, UID, "", "", "", "", SiteLocId, LocationId, showCompleted, WorkGroup, SubGroup, DropDownSupervisor, ddlBuilding);  
        }
    });
}
function applySearchRow() {
    $('#tblRegisterList thead tr.searchRow').remove();
    var $searchRow = $('#tblRegisterList thead tr:eq(0)').clone().addClass('searchRow');
    $('#tblRegisterList thead').append($searchRow);

    $searchRow.find('th').each(function (index) {
        var $th = $(this);
        var columnName = $th.attr('columnName');

        if (!columnName ||
            $th.hasClass('no-search') ||
            $th.css('display') === 'none' ||
            /delete|edit|checkbox|GoOffline|copy|icon/i.test(columnName)) {
            $th.html('');
            return;
        }

        var title = $th.text().trim();
        $th.html('<input type="text" class="thSearch" placeholder="' + title + '" size="' + Math.max(title.length, 5) + '" />');


        $th.find('input').on('keyup change', function () {
            var searchValue = this.value; 

            if (table.column(index).search() !== searchValue) {
                table
                    .column(index)
                    .search(searchValue) 
                    .draw();
            }
        });
    });
}



function buildTableHeaders(columns) {

    let headerHtml = "<tr>";

    columns
        .sort((a, b) => a.ItemOrder - b.ItemOrder)
        .forEach(col => {
            headerHtml += `<th columnName="${col.ColumnName}"  id="${col.ColumnId}" colorder="${col.ItemOrder}">${col.DisplayColumnName}</th>`;
        });

    headerHtml += "</tr>";

    $("#tblRegisterList thead").html(headerHtml);
}
function generateDynamicHeaders(columns) {

    columns.forEach(function (col) {

        let th = $(`th[columnName='${col.ColumnName}']`);

        if (th.length > 0) {
            th.text(col.DisplayColumnName);
            if (col.IsVisible == 0) th.hide();
            else th.show();
            th.attr("colorder", col.ItemOrder);
        }
    });
}

function reorderHeadersByItemOrder(tableId, columns) {

    let $table = $("#" + tableId);
    let $headerRow = $table.find("thead tr");
    if ($headerRow.length === 0) return;

    let thArray = $headerRow.children("th").get();
    if (thArray.length === 0) return;
    let orderMap = {};
    columns.forEach(col => orderMap[col.ColumnName] = col.ItemOrder);
    thArray.sort(function (a, b) {
        let colA = $(a).attr("columnName");
        let colB = $(b).attr("columnName");

        let orderA = orderMap[colA] ?? 999;
        let orderB = orderMap[colB] ?? 999;

        return orderA - orderB;
    });
    $headerRow.empty().append(thArray);
}

function reorderTableHeaders(tableId, config) {
    let $table = $("#" + tableId);
    let allRows = $table.find("thead tr, tfoot tr");
    config = config.sort((a, b) => a.colOrder - b.colOrder);

    allRows.each(function () {
        let $row = $(this);
        let ths = $row.find("th[columnName]");
        if (ths.length === 0) return;
        let thMap = {};
        ths.each(function () {
            let colName = $(this).attr("columnName");
            thMap[colName] = $(this);
        });
        $row.empty();
        config.forEach(col => {
            if (thMap[col.columnName]) {
                $row.append(thMap[col.columnName]);
            }
        });
    });
}

function updateTableIfOrderChanged(tableId, newConfig) {
    let hasChanged = false;

    let currentOrder = $("#" + tableId).find("thead th").map(function () {
        return $(this).attr("columnName");
    }).get();

    let newOrder = newConfig.slice().sort((a, b) => a.colOrder - b.colOrder).map(c => c.columnName);
    if (currentOrder.length !== newOrder.length) {
        hasChanged = true;
    } else {
        for (let i = 0; i < currentOrder.length; i++) {
            if (currentOrder[i] !== newOrder[i]) {
                hasChanged = true;
                break;
            }
        }
    }

    if (hasChanged) {
        reorderTableHeaders(tableId, newConfig);
        console.log("Table headers updated!");
    } else {
        console.log("No change in column order.");
    }
}




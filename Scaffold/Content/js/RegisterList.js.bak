function BindallDropdown() {
    var id = getParameterByName('id');
    $.ajax({
        url: '/RegisterList/BindallDropdown',
        async: false,
        data: { id: id },
        success: function (response) {

            data = response;

            var ddlInspectedBy = "<option value='' disabled selected='selected'>Select---</option>";
            $.each(response.ddlInspectedBy, function (idx, obj) {
                if (obj != null) {
                    ddlInspectedBy += '<option value="' + obj.UserId + '">' + obj.name + '</option>';
                }
            });

            var ddlChecklist = "<option value='' disabled selected='selected'>Select---</option>";
            $.each(response.ddlChecklistInsp, function (idx, obj) {
                if (obj != null) {
                    ddlChecklist += '<option value="' + obj.checklistID + '">' + obj.checklistdescription + '</option>';
                }
            });

            $('#ddlddlInspectedByadd').empty().append(ddlInspectedBy);
            $('#ddlChecklistInsp').empty().append(ddlChecklist);
        }
    });
}

function btnOfflinedocs_Click() {
    $('#LoadingPanel1').show();
    setTimeout(function () {

        BindallDropdown();
        if ($('#hdnLoginUserID').val() != "") {
            $('#ddlddlInspectedByadd').val($('#hdnLoginUserID').val())
        }

        $('#rdpInspectiondate').val(getDateTime());
        var RegisterID = "";
        table.$('.ChkTransID').each(function () {
            if (this.checked) {
                ChkUpdateAllflag = true;
                RegisterID = this.value;
            }
        });


        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        $.ajax({
            type: 'Post',
            url: '/RegisterList/btnOfflinedocs_Click',
            data: JSON.stringify({ id: id, UserRole: UserRole, UID: UID, RegisterID: RegisterID, hdnOfflineStatus: hdnOfflineStatus }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                var GetData = response;
                if (response.Result == "Success") {
                    if (response.Message == "Adddocs") {
                        $('#LoadingPanel1').hide();
                        $('#Adddocs').css('display', 'block');
                    } else {
                        CustomAlert(response);
                        $('#LoadingPanel1').hide();
                    }
                } else {
                    CustomAlert(response);
                    $('#LoadingPanel1').hide();
                }
            },
            error: function (x, y, z) {
                $('#LoadingPanel1').hide();
                $('#Adddocs').css('display', 'none');
                alert(z);
            }
        });

    }, 1000);

}

function btnsave_Click() {
    $('#LoadingPanel1').show();
    setTimeout(function () {

        $('#rdpInspectiondate').val(getDateTime());
        var RegisterID = "";
        ArrayOfflineInspection = [];
        table.$('.ChkTransID').each(function () {
            if (this.checked) {
                ChkUpdateAllflag = true;
                RegisterID = this.value;
                var ArryVal = { RegisterID: RegisterID };
                ArrayOfflineInspection.push(ArryVal);
            }
        });

        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var ddlddlInspectedByadd = $('#ddlddlInspectedByadd').val();
        var hdnOfflineStatus = $('#hdnOfflineStatus').val();
        var rdpInspectiondate = $('#rdpInspectiondate').val();
        var hdnTimeOffSet = $('#hdnTimeOffSet').val();
        var ddlChecklistInsp = $('#ddlChecklistInsp').val();
        var ddlInspStatuspop = "Scheduled";
        if (ddlChecklistInsp != null) {
            $('#ddlChecklistInsp').removeClass('requiredColumn');
            if (ddlddlInspectedByadd != null) {
                $('#ddlddlInspectedByadd').removeClass('requiredColumn');
                if (rdpInspectiondate != "") {
                    $('#rdpInspectiondate').removeClass('requiredColumn');
                    $.ajax({
                        type: 'Post',
                        url: '/RegisterList/btnsave_Click',
                        data: JSON.stringify({ id: id, UID: UID, UserRole: UserRole, ddlddlInspectedByadd: ddlddlInspectedByadd, hdnOfflineStatus: hdnOfflineStatus, rdpInspectiondate: rdpInspectiondate, hdnTimeOffSet: hdnTimeOffSet, ddlChecklistInsp: ddlChecklistInsp, ddlInspStatuspop: ddlInspStatuspop, model: ArrayOfflineInspection }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        async: true,
                        success: function (response) {

                            var GetData = response;
                            if (response.Result == "Success") {
                                $('#LoadingPanel1').hide();
                                $('#Adddocs').css('display', 'none');
                                CustomAlert(response);
                            } else {
                                $('#LoadingPanel1').hide();
                                $('#Adddocs').css('display', 'none');
                                CustomAlert(response);
                            }

                            var id = getParameterByName('id');
                            var UID = getParameterByName('UID');
                            var checkHideCompleted = $('#checkHideCompleted').prop('checked');

                            var LocationID = $('#ddlLocaSite').val();
                            if (LocationID == undefined) {
                                LocationID = "";
                            }

                            var Siteid = $('#ddlSites').val();
                            if (Siteid == undefined) {
                                Siteid = "";
                            }
                            var ddlWorkGroup = $('#ddlWorkGroup').val();
                            if (ddlWorkGroup == undefined) {
                                ddlWorkGroup = "";
                            }
                            var ddlSubGroup = $('#ddlSubGroup').val();
                            if (ddlSubGroup == undefined) {
                                ddlSubGroup = "";
                            }
                            var Supervisor = $('#ddlSupervisor').val();
                            if (Supervisor == "" || Supervisor == undefined) {
                                Supervisor = "";
                            }
                            var ddlBuilding = $('#ddlBuilding').val();
                            if (ddlBuilding == undefined) {
                                ddlBuilding = "";
                            }
                            GetRegisterListData(id, UID, false, false, false, false, Siteid, LocationID, checkHideCompleted, ddlWorkGroup, ddlSubGroup, Supervisor, ddlBuilding);
                        },
                        error: function (x, y, z) {
                            $('#LoadingPanel1').hide();
                            $('#Adddocs').css('display', 'none');
                            alert(z);
                        }
                    });

                }
                else {
                    var Response = { Result: "Failed", Message: "Please select Scheduled Inspection Date" };
                    CustomAlert(Response);
                    $('#rdpInspectiondate').addClass('requiredColumn');
                    $('#LoadingPanel1').hide();
                }
            }
            else {
                var Response = { Result: "Failed", Message: "Please select Inspected By." };
                CustomAlert(Response);
                $('#ddlddlInspectedByadd').addClass('requiredColumn');
                $('#LoadingPanel1').hide();
            }
        } else {
            var Response = { Result: "Failed", Message: "Please select Scaffold Inspection List." };
            CustomAlert(Response);
            $('#ddlChecklistInsp').addClass('requiredColumn');
            $('#LoadingPanel1').hide();
        }
    }, 1000);
}


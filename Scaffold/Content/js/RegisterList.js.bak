function btnSaveSearchHistory() {
    $('#LoadingPanel1').show();

    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    var UserRole = getParameterByName('UserRole');
    var checkHideCompleted = $('#checkHideCompleted').prop('checked');
    var LocationID = $('#ddlLocaSite').val();
    var Siteid = $('#ddlSites').val();
    var ddldisciplines = $('#ddldisciplines').val();
    var ddlWorkGroup = $('#ddlWorkGroup').val();
    var ddlSubGroup = $('#ddlSubGroup').val();
    var ddlcampaignCode = $('#ddlCampaignCode').val();
    var ddlBuilding = $('#ddlBuilding').val();
    var DropDownWONumber = $('#ddlWONumber').val();
    var ddlSubDisciplines = $('#ddlWONumber').val();
    var ddlSupervisor = $('#ddlSupervisor').val();
    $.ajax({
        type: 'Post',
        url: '/RegisterList/btnSaveSearchHistory',
        data: JSON.stringify({ id: id, UID: UID, UserRole: UserRole, checkHideCompleted: checkHideCompleted, LocationID: LocationID, Siteid: Siteid, ddldisciplines: ddldisciplines, ddlWorkGroup: ddlWorkGroup, ddlSubGroup: ddlSubGroup, ddlcampaignCode: ddlcampaignCode, ddlBuilding: ddlBuilding, DropDownWONumber: DropDownWONumber, ddlSubDisciplines: ddlSubDisciplines, ddlSupervisor: ddlSupervisor }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            var Response = { Result: response.Result, Message: response.Message };
            CustomAlert(Response);
            $('#LoadingPanel1').hide();
        }
    })

}
function GetSearchHistory() {
    var UID = getParameterByName('UID');
    var id = getParameterByName('id');
    $.ajax({
        type: "POST",
        url: "/RegisterList/GetSearchHistory",
        data: JSON.stringify({ UID: UID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {
            CustomAlert(response);
            var str = "";
            var GetData = response;

            if (GetData.length > 0) {
                for (var i = 0; i < GetData.length; i++) {

                    var ClientScaffref = GetData[i].ClientScaffref == null ? "" : GetData[i].ClientScaffref;
                    var WorkGroup = GetData[i].WorkGroup == null ? "" : GetData[i].WorkGroup;
                    var SubGroup = GetData[i].SubGroup == null ? "" : GetData[i].SubGroup;
                    var discipline = GetData[i].discipline == null ? "" : GetData[i].discipline;
                    var SiteLocId = GetData[i].SiteLocId == null ? "" : GetData[i].SiteLocId;
                    var LocationId = GetData[i].LocationId == null ? "" : GetData[i].LocationId;
                    var showCompleted = GetData[i].showCompleted == null ? "" : GetData[i].showCompleted;
                    var DropDownWONumber = GetData[i].WONumber == null ? "" : GetData[i].WONumber;
                    var DropDownSubDiscipline = GetData[i].SubDiscipline == null ? "" : GetData[i].SubDiscipline;
                    var DropDownSupervisor = GetData[i].Supervisor == null ? "" : GetData[i].Supervisor;
                    var BuildingID = (GetData[i].BuildingID == null || GetData[i].BuildingID == 0) ? "" : GetData[i].BuildingID;
                    if (SiteLocId != "" || SiteLocId != null) {
                        $('#ddlSites').val(SiteLocId);
                    }
                    if (LocationId != "" || LocationId != null) {
                        $('#ddlLocaSite').val(LocationId);
                    }
                    if (BuildingID != "" || BuildingID != null) {
                        $('#ddlBuilding').val(BuildingID);
                    }
                    if (discipline != "" || discipline != null) {
                        $('#ddldisciplines').val(discipline);
                    }
                    if (WorkGroup !== "" && WorkGroup !== null) {
                        $('#ddlWorkGroup').val(WorkGroup);
                    } else {
                        $('#ddlSubGroup').val('');
                        $('#ddlSubGroup').empty();
                        $('#ddlSubGroup').append('<option value=""></option>');
                    }

                    if (WorkGroup !== "" && WorkGroup !== null && SubGroup !== "" && SubGroup !== null) {
                        $('#ddlSubGroup').val(SubGroup);
                    }

                    if (ClientScaffref !== "" && ClientScaffref !== null) {
                        $('#ddlCampaignCode').val(ClientScaffref);
                    }

                    if (DropDownWONumber !== "" && DropDownWONumber !== null) {
                        $('#ddlWONumber').val(DropDownWONumber);
                    }

                    if (DropDownSubDiscipline !== "" && DropDownSubDiscipline !== null) {
                        $('#ddlSubDiscipline').val(DropDownSubDiscipline);
                    }

                    $('#checkHideCompleted').prop('checked', showCompleted === true);

                    if (DropDownSupervisor !== "" && DropDownSupervisor !== null) {
                        $('#ddlSupervisor').val(DropDownSupervisor);
                    }
                    LocationDropDown(LocationId);
                    if (LocationId !== "" && LocationId !== null) {
                        dropdownBuilding(BuildingID);
                    } else {
                        $('#ddlBuilding').val('');
                        $('#ddlBuilding').empty();
                        $('#ddlBuilding').append('<option value=""></option>');
                    }
                    dropdownWorkGroup(WorkGroup);
                    if (WorkGroup !== "" && WorkGroup !== null) {
                        dropdownSubGroup(SubGroup);
                    } else {
                        $('#ddlSubGroup').val('');
                        $('#ddlSubGroup').empty();
                        $('#ddlSubGroup').append('<option value=""></option>');
                    }
                    dropdownSupervisor(DropDownSupervisor);               
                    ApplyRegisterListColumnOrder(id, UID, SiteLocId, LocationId, showCompleted, WorkGroup, SubGroup, DropDownSupervisor, BuildingID);
                }
            }
            else {
                LocationDropDown();
                dropdownBuilding();
                dropdownWorkGroup();
               /* GetRegisterListData(id, UID, false, false, false, false, "", "", true, "", "", "", "", "", "", "", "", "");*/
                ApplyRegisterListColumnOrder(id, UID, "", "", "", "", "", "","");
            }
        }
    })
}

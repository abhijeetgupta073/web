    $('#ddlSites').val('');
    $("#ddlLocaSite").val($('#hdnLocationID').val(''));
    $("#ddlBuilding").val($('#hdnBuilding').val(''));
    $("#ddlWorkGroup").val($('#hdnWorkGroup').val(''));
    $("#ddlSubGroup").val($('#hdnSubGroup').val(''));
    $("#ddlSupervisor").val($('#hdnSAPNumber').val(''));


    //GetRegisterListData(
    //    id, UID, false, false, false, false, "", "", checkHideCompleted, "", "", "", "", "", true
    //);
    GetRegisterListData(
        id, UID, false, false, false, false, "", "", checkHideCompleted, "", "", "", "", true

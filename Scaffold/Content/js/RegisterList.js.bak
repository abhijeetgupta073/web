function filterhide() {
    $(".rgFilterRow").css("display", "none");
}
function btncssapply() {
    $('.double-scroll').doubleScroll();
    $('#ctl00_ContentPlaceHolder1_GridRegiterList_ctl00_ctl02_ctl00_ExportToCsvButton').removeClass('rgExpCSV').addClass('btn w3-btn w3-teal').attr('value', 'Export to CSV').css('width', '110px');
    $('#ctl00_ContentPlaceHolder1_GridRegiterList_ctl00_ctl02_ctl00_RebindGridButton').addClass('btn w3-btn w3-grey').css('color', 'white !important');
    $('#ctl00_ContentPlaceHolder1_GridRegiterList_ctl00_ctl02_ctl00_RefreshButton').css('display', 'none');
}



function UpdateFilterTable() {
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    var UserRole = getParameterByName('UserRole');
    var PageName = "RegisterList";

    var LocationID = $('#ddlLocaSite').val();
    if (LocationID == undefined) {
        LocationID = "";
    }

    var Siteid = $('#ddlSites').val();
    if (Siteid == undefined) {
        Siteid = "";
    }

    var ddlWorkGroup = $('#ddlWorkGroup').val();
    if (ddlWorkGroup == undefined) {
        ddlWorkGroup = "";
    }
    var ddlSubGroup = $('#ddlSubGroup').val();
    if (ddlSubGroup == undefined) {
        ddlSubGroup = "";
    }

    $.ajax({
        type: "POST",
        url: "/RegisterList/UpdateFilterTable",

        data: JSON.stringify({ id: id, UID: UID, UserRole: UserRole, PageName: PageName, SiteID: Siteid, LocationID: LocationID, WorkGroup: ddlWorkGroup, SubGroup: ddlSubGroup }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {

            var SiteData = response;

        }

    })
}


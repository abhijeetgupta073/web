    $('#ddlLocaSite, #ddlSubGroup, #ddlWorkGroup, #ddlSupervisor, #ddlBuilding').val('');

        btnSaveSearchHistory();

    setTimeout(function () {
        GetSearchHistory();
        UpdateFilterTable();

        //Sitedropdownbind Start

        function ddlSitebind(id) {
            $.ajax({
                type: "POST",
                //url: "../WebApi/Dashboard.asmx/ddlsitedropdownbindquery",
                url: "/WeeklySummaryReport/ddlsitedropdownbindquery",
                data: JSON.stringify({ id: id}),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var ddlSitedropdownbind = response;
                    var Siteid = "";
                    var SiteLocatext = "";
                    $("#ddlSite").html("");
                    for (var i = 0; i < ddlSitedropdownbind.length; i++) {
                        Siteid = ddlSitedropdownbind[0].SiteLocID;
                        SiteLocatext = ddlSitedropdownbind[0].SiteLocation;
                        $("#ddlSite").append('<option value="' + ddlSitedropdownbind[i].SiteLocID + '">' + ddlSitedropdownbind[i].SiteLocation + '</option>');
                    }
                    var ClientID = $("#hdnClientID").val();
                    SiteData(Siteid, ClientID);
                    LocationBySite(Siteid, ClientID);
                    $("#hdnSiteID").val(Siteid);
                    $("#lblLockedSite").text(SiteLocatext);
                    //var getnewdate = $("#ctl00_ContentPlaceHolder1_picweekdate_dateInput").val();
                    var getnewdate = $("#picweekdate").val();
                    chart3(ClientID, Siteid, "All", getnewdate);
                }
            });

        }


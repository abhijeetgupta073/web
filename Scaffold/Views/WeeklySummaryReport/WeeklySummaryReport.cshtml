        function SiteData(Siteid, ClientID) {
            //$('.forRemoveData3').remove();

            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/SiteDetails",
                url: "/WeeklySummaryReport/SiteDetails",
                data: JSON.stringify({ Siteid: Siteid, ClientID: ClientID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    //var SitedataDetails = response.d;
                    var SitedataDetails = response;
                    $("#ErrectedScaffolds").val(SitedataDetails[0]["ErectedDate1"]);
                    $("#TextBox1").val(SitedataDetails[0]["ScaffoldsStanding1"]);
                    $("#TextBox2").val(SitedataDetails[0]["TonnageErected1"]);
                    $("#TextBox3").val(SitedataDetails[0]["TonnageStanding1"]);
                    $("#TextBox4").val(SitedataDetails[0]["AverageTonnage1"]);
                    $("#TextBox5").val(SitedataDetails[0]["HireDays1"]);
                    Allsites("all", ClientID);
                }

            });
        }


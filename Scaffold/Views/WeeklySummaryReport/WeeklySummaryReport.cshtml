        function chart3(ClientID, Siteid, jobval, getnewdate) {
            $('.forRemoveData3').remove();
            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/WeeklyProgress",
                url: "/WeeklySummaryReport/WeeklyProgress",
                data: JSON.stringify({ id: ClientID, site: Siteid, jobid: jobval, getnewdate: getnewdate }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // WRegister = response.d;
                    WRegister = response;
                    var Week = [];
                    var WRegisterDataErect = [];
                    var WRegisterDataDismantle = [];
                    var week1Register = 0;
                    var weeks = [];
                    var start = "";
                    var end = "";
                    var erect = 0;
                    var week10Register = 0;
                    var lastWeekNo = WRegister[WRegister.length - 1].WeekNo;
                    var firstWeekNo = lastWeekNo - 9;
                    if (WRegister.length > 0) {
                        for (var i = 0; i < WRegister.length; i++) {
                            var TobePush = true;
                            if (TobePush) {

                                WRegisterDataErect.push({ name: WRegister[i].WeekNo, y: WRegister[i].TotErectedRegister, sliced: true });
                                WRegisterDataDismantle.push({ name: WRegister[i].WeekNo, y: WRegister[i].TotDismantleRegister, sliced: true });
                                //week1Register = WRegister[0].TotErectedRegister;
                                //week10Register = WRegister[9].TotErectedRegister;
                                Week.push('Week ' + WRegister[i].WeekNo);
                                weeks.push([WRegister[i].WeekNo - firstWeekNo, WRegister[i].TotErectedRegister]);
                                //alert(weeks);
                                if (WRegister[i].WeekNo == lastWeekNo) {
                                    start = WRegister[i].WeekStartDate;
                                    end = WRegister[i].WeekEndDate;
                                }
                            }


                        }

                    }
                    Highcharts.chart('Chart3container', {
                        chart: {
                            backgroundColor: "#f2f2f2"
                        },
                        title: {
                            text: 'Scaffold Builds Vs Dismantles',
                            x: -20,
                        },
                        subtitle: {
                            text: '(Week '+lastWeekNo+' => ' + start + ' to ' + end + ')',
                            x: -20,
                        },
                        yAxis: {
                            allowDecimals: false,
                            title: {
                                text: ''
                            }
                        },

                        xAxis: {
                            categories: Week,
                            //tickInterval: 1, // Ensure ticks align with categories
                            //startOnTick: true, // Force alignment with the first category
                            //endOnTick: true, // Force alignment with the last category
                            //min: 0, // Start at the first category
                            //max: Week.length - 1 // End at the last category,
                        },
                        labels: {
                            items: [{
                                html: '',
                                style: {
                                    left: '50px',
                                    top: '18px',
                                    color: (Highcharts.theme && Highcharts.theme.textColor) || 'black'
                                }
                            }]
                        },
                        navigation: {
                            buttonOptions: {
                                verticalAlign: 'top',
                                y: -12,
                            }
                        },
                        exporting: {
                            buttons: {
                                contextButton: {
                                    enabled: true,
                                    x: 9,
                                },
                                exportButton: {
                                    //x: -28,
                                    onclick: function () {
                                        $('#btnOpenModel3').click();
                                    },
                                    //symbol: 'circle'
                                    text: 'Show All'
                                }
                            }


                        },
                        series: [{
                            type: 'column',
                            regression: true,
                            regressionSettings: {
                                name: 'Linear (Built)',
                                dashStyle: 'ShortDot',
                                color: '#76C3FD',
                            },
                            name: 'Built',
                            id: 'primary',
                           data: weeks
                        }, {
                            type: 'line',
                            color: '#D5333E',
                            marker: {
                                enabled: false,
                                radius: 3
                            },
                            name: ' Dismantled',
                            data: WRegisterDataDismantle
                        }, {
                            name: '2 per. Mov. Avg.(Built)',
                            linkedTo: 'primary',
                            dashStyle: 'ShortDot',
                            color: '#5A79F5',
                            showInLegend: true,
                            type: 'trendline',
                            algorithm: 'SMA',
                            periods: 2
                            //    }
                            //{
                            //    type: 'line',
                            //    dashStyle: 'ShortDot',
                            //    color: '#76C3FD',
                            //    width: 1,
                            //    marker: {
                            //        enabled: false,
                            //        radius: 3
                            //    },
                            //    //yAxis: 2,
                            //    name: 'Linear (Built)',
                            //    data: [[0, week1Register + 0.1], [9, week10Register + 0.1]
                            //    ]
                            //    //marker: {
                            //    //    lineWidth: 2,
                            //    //    lineColor: Highcharts.getOptions().colors[3],
                            //    //    fillColor: 'white'
                            //    //}
                        }]

                    });


                    function redrawchart() {
                        var chart = $('#Chart3container').highcharts();

                        var w = $('#Chart3container').closest(".wrapper").width();
                        var size = $(window).width();
                        if (size < 1150 && size > 650) {
                            chart.setSize(
                           w, w * (1.0 / 4), false
                        );
                        } else {
                            if (size < (650)) {
                                chart.setSize(
                                 w, w * (3.0 / 4), false
                              );
                            } else {
                                chart.setSize(
                         w, w * (1.0 / 4), false
                         );
                            }


                        }
                    }



                    $(window).resize(redrawchart);
                    redrawchart();
                    var row3 = '';
                    // $.each(response.d, function (index, obj) {
                    //$.each(response, function (index, obj) {
                    $.each(WRegister, function (index, obj) {
                        //var num;
                        //num = (obj.PctAllSite1 * 100);
                        //alert(obj.WeekNo);
                        //row3 += "<tr class='forRemoveData3'><td style='text-align: center;'>" + obj.WeekNo + "</td><td style='text-align: center;'>" + obj.TotErectedRegister + "</td><td style='text-align: center;'>" + obj.TotDismantleRegister + "</td></tr>";

                    
                            row3 += "<tr class='forRemoveData3'><td style='text-align: center;'>" + obj.WeekNo + "</td><td style='text-align: center;'>" + obj.TotErectedRegister + "</td><td style='text-align: center;'>" + obj.TotDismantleRegister + "</td></tr>";

                        
                    });
                    $("#tbDetails3 tbody").append(row3);
                }

            });
        }



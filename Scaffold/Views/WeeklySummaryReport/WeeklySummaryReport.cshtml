        function ScaffoldLockedIn(Siteid, ClientID) {
            $('.forRemoveDataAction').remove();
            $.ajax({
                type: "POST",
                //url: "../WebApi/Dashboard.asmx/LockedInClick",
                url: "/WeeklySummaryReport/LockedInClick",
                data: JSON.stringify({ Siteid: Siteid, ClientID: ClientID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    //var CycloneAction = response.d;
                    var CycloneAction = response;
                    var CycloneData = [];
                    if (CycloneAction.length > 0) {
                        for (var i = 0; i < CycloneAction.length; i++) {
                            var TobePush = true;
                            if (TobePush) {

                                CycloneData.push({ name: CycloneAction[i].ScaffRefAction, y: CycloneAction[i].DescriptionAction, z: CycloneAction[i].Location, s: CycloneAction[i].BuildingNo, r: CycloneAction[i].assetId, x: CycloneAction[i].FloorLevel, a: CycloneAction[i].DesignType, b: CycloneAction[i].MaterialType, sliced: true });
                            }
                        }
                    }
                    $('#btnOpenModelAllDetails').click();
                    //$("#lblAction").text(CycloneActionName);
                    //$("#ContentPlaceHolder1_labelaction").val(CycloneActionName);
                    var row1 = '';
                    // $.each(response.d, function (index, obj) {
                    $.each(response, function (index, obj) {
                        row1 += "<tr class='forRemoveDataAction'><td style='text-align: center;font-size: 12px;'>" + obj.ScaffRefAction + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DescriptionAction + "</td><td style='text-align: center;font-size: 12px;'>" + obj.Location + "</td><td style='text-align: center;font-size: 12px;'>" + obj.BuildingNo + "</td><td style='text-align: center;font-size: 12px;'>" + obj.assetId + "</td><td style='text-align: center;font-size: 12px;'>" + obj.FloorLevel + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DesignType + "</td><td style='text-align: center;font-size: 12px;'>" + obj.MaterialType + "</td></tr>";
                    });
                    $("#tbDetailsLockedIn tbody").append(row1);
                }
            });

        }


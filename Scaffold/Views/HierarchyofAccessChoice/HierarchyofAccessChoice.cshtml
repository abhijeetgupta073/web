<style>
    input[type=checkbox] {
        cursor: pointer;
    }

        input[type=checkbox]:checked:before {
            content: "\2713";
            background: #fffed5;
            text-shadow: 1px 1px 1px rgba(0, 0, 0, .2);
            font-size: 25px;
            text-align: center;
            line-height: 10px;
            display: inline-block;
            width: 20px;
            height: 20px;
            color: #00904f;
            border: 1px solid #cdcdcd;
            border-radius: 4px;
            margin: -3px -3px;
            text-indent: 1px;
        }

        input[type=checkbox]:before {
            content: "\202A";
            background: #ffffff;
            text-shadow: 1px 1px 1px rgba(0, 0, 0, .2);
            font-size: 25px;
            text-align: center;
            line-height: 10px;
            display: inline-block;
            width: 20px;
            height: 20px;
            color: #00904f;
            border: 1px solid #cdcdcd;
            border-radius: 4px;
            margin: -3px -3px;
            text-indent: 1px;
        }

    .arrowimage {
        position: absolute;
        top: calc(-45%);
        left: calc(86%);
    }

    .spancolorandsize {
        font-size: 12px !important;
    }


    .form-control {
        height: 28px !important;
    }

    .x_content {
        padding: 0 0px 6px;
    }

    .input-group {
        margin-bottom: 0px;
    }

    #FormSection label {
        color: gray !important;
        font-size: 11px;
        font-weight: 500;
    }

    .nav-sm span.fa, .nav-sm .menu_section h3 {
        display: block !important;
    }

    .w3-card-4, .w3-hover-shadow:hover {
        box-shadow: 0 0px 0px 0 rgba(0,0,0,0.2),0 0px 0px 0 rgba(0,0,0,0.19) !important;
    }

    .panel_toolbox > li > a:hover {
        background: none;
    }

    label {
        font-size: 12px;
    }


    @@media(min-width:100px) and (max-width:550px) {
        label.Size {
            font-size: 10px !important;
        }

        .sizetextbox {
            font-size: 10px !important;
        }
    }

    @@media(min-width:550px) and (max-width:850px) {
        label.Size {
            font-size: 14px !important;
        }

        .sizetextbox {
            font-size: 14px !important;
        }
    }

    @@media(min-width:850px) and (max-width:3000px) {
        label.Size {
            font-size: 16px !important;
        }

        .sizetextbox {
            font-size: 18px !important;
        }
    }
</style>


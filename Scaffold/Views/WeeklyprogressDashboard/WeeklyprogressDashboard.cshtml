                    function redrawchart() {
                        var chart = $('#Chart1container').highcharts();
                        var chart2 = $('#Chart2container').highcharts();
                        var chart3 = $('#Chart3container').highcharts();

                        var w = $('#Chart1container').closest(".wrapper").width()
                        var w2 = $('#Chart2container').closest(".wrapper").width()
                        var w3 = $('#Chart3container').closest(".wrapper").width()
                        var size = $(window).width();
                        if (size < 1150 && size > 650) {
                            chart.setSize(
                                w, w * (1.0 / 4), false
                            );
                            chart2.setSize(
                                w2, w2 * (1.0 / 4), false
                            );
                            chart3.setSize(
                                w3, w3 * (1.0 / 4), false
                            );
                        } else {
                            if (size < (650)) {
                                chart.setSize(
                                    w, w * (3.0 / 4), false
                                );
                                chart2.setSize(
                                    w2, w2 * (3.0 / 4), false
                                );
                                chart3.setSize(
                                    w3, w3 * (3.0 / 4), false
                                );
                            } else {
                                chart.setSize(
                                    w, w * (1.0 / 4), false
                                );
                                chart2.setSize(
                                    w2, w2 * (1.0 / 4), false
                                );

                                chart3.setSize(
                                    w3, w3 * (1.0 / 4), false
                                );
                            }
                        }
                    }


                $('#loadingpanel1').css('display', 'none');
            }, 500)
            ddlJobbind(ClientID, "All");




            ddlWorkgroupbind(ClientID, "All", "All");

            Highcharts.getSVG = function (charts) {
                var svgArr = [],
                  top = 0,
                  width = 0;
                Highcharts.each(charts, function (chart, i) {
                    var svg = chart.getSVG();
                    svg = svg.replace('<svg', '<g transform="translate(0,' + top + ')" ');
                    svg = svg.replace('</svg>', '</g>');
                    top += chart.chartHeight;
                    if (i<=1) {
                        width = Math.max(width, chart.chartWidth);
                        //width = width / 2;
                    }
                    if (i==2) {
                        width = Math.max(width, chart.chartWidth/2);
                        //width = width / 2;
                    }
                    svgArr.push(svg);
                });
                return '<svg height="' + top + '" width="' + width + '" version="1.1" xmlns="http://www.w3.org/2000/svg">' + svgArr.join('') + '</svg>';
            };

            Highcharts.exportCharts = function (charts, options) {
                // Merge the options
                options = Highcharts.merge(Highcharts.getOptions().exporting, options);
                // Post to export server
                Highcharts.post(options.url, {
                    filename: options.filename || 'chart',
                    type: options.type,
                    width: options.width,
                    svg: Highcharts.getSVG(charts),
                });
            };

            $("#exportButton").click(function () {
                var chart1 = $('#Chart1container').highcharts();
                var chart2 = $('#Chart2container').highcharts();
                var chart3 = $('#Chart3container').highcharts();
                Highcharts.exportCharts([chart1, chart2, chart3], {
                    type: 'application/pdf',
                    filename: 'WeeklyProgressReport-pdf'
                });
            });
            generateActualPlanningWeek();
        });

        function generateActualPlanningWeek() {
            var id = getParameterByName('id');
            var UID = getParameterByName('UID');
            $.ajax({
                type: "POST",
                url: "/WeeklySummaryReport/generateActualWeekPlan",
                data: JSON.stringify({ id: id, UID: UID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var generate = response;
                }
            });
        }


@*Delete Popup Start Here*@

<div id="divdelete" class="w3-modal" runat="server" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 128px; width: 365px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey ">
            <h4 class="w3-text-white" id="H1" runat="server"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp;Delete Record</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">
                <label runat="server" id="c1">Are you sure you want to Delete the Record?</label>
            </p>
        </div>
        <div class=" row" style="padding-bottom: 20px;">
            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4"></div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px;">
                <a class="w3-btn w3-green w3-hover-dark-grey" onclick="deleterowyes()"
                   id="btndeleteyes"><i class="glyphicon glyphicon-ok-circle "></i>&nbsp;Yes</a>
            </div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2">
                <a class="w3-btn nln-bg w3-hover-dark-grey" onclick="deleterowno()" id="btndeleteno"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp;No</a>
            </div>
        </div>
    </div>
</div>

@*Delete Popup End Here *@

<div id="divSave" class="w3-modal" runat="server" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 148px; width: 365px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey ">
            <h4 class="w3-text-white" id="save"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp;Alert!</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">
                <label id="Label2">Please clear the SEARCH  and then click on Add New Inventory?</label>
            </p>
        </div>
        <div class="row" style="padding-bottom: 20px;">
            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4"></div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px;">
                <a class="w3-btn w3-green w3-hover-dark-grey" onclick="btnsaveyes()"
                   id="btnsaveYes"><i class="glyphicon glyphicon-ok-circle "></i>&nbsp;OK</a>
            </div>
        </div>
    </div>
</div>

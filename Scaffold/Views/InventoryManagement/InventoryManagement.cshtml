<script>
    $(document).ready(function () {
        $("#hdnid").val(@ViewBag.id);
        $("#hdnUID").val(@ViewBag.UID);
        var id = $("#hdnid").val();
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');

        if ($("#hdnerror").val() == true) {
            errorgrid(id, UID)
        }
        else {
            GetInventoryData(id, "All");
        }
    });
</script>

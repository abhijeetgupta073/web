<div class="row ">
    <form>
        <div class="col-lg-1 col-md-1 col-sm-2 col-xs-3">
            <button type="button" class="btn" id="btndelete" style="background:#0492d9; color:white;" onclick="btndelete_Click()"><i class="fa fa-trash"></i>&nbsp;Delete</button>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-4 col-xs-6">
            <button type="button" class="btn btn-primary" id="btnLoad" style="background:#0492d9; color:white; display: block" onclick="DowloadTemplete()"><i class="fa fa-download">&nbsp;</i>Download Template</button>
        </div>
        <div class="col-lg-2 col-md-3 col-sm-4 col-xs-6">
            @*<asp:Label ID="Label1" runat="server" Style="text-align: right" Text="Select file for Load" Width="100%" CssClass="blue"></asp:Label>*@
            <span id="Label1" Style="float: right;font-size: 15px;" class="blue">Select file for Load</span>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-4 col-xs-6">
            @*<asp:FileUpload onchange="OnClientChange(this,event)" EnableViewState="true" ID="FileUploadSelectfile" runat="server" Width="100%" CssClass="blue" />*@
            <input type="file" id="FileUploadSelectfile" class="blue" accept=".xlsx" name="InventoryFile" />
        </div>
        <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
            @*<asp:LinkButton ID="btnLoad" runat="server" OnClientClick="ButtonClient();" Style="display: block" Width="100%" OnClick="btnLoad_Click" CssClass="btn btn-primary "><i class="fa fa-spinner"></i> Load & Save</asp:LinkButton>
        <asp:LinkButton ID="btnLoadforsm" runat="server" OnClientClick="ButtonClient();" Style="display: none" Width="100%" OnClick="btnLoad_Click" CssClass="btn btn-primary "><i class="fa fa-spinner"></i> Load</asp:LinkButton>*@
            <button type="button" class="btn btn-primary" id="btnLoad" style="background: #0492d9; width: -webkit-fill-available; color: white; display: block" onclick="btnLoad_Click(false)"><i class="fa fa-spinner"></i>Load & Save</button>
            <button type="button" class="btn btn-primary" id="btnLoadforsm" style="background: #0492d9; width: -webkit-fill-available; color: white; display: none" onclick="btnLoad_Click(false)"><i class="fa fa-spinner"></i>Load</button>
 
        </div>
        <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
            <button type="button" class="btn btn-primary" id="btnLoadSortOrder" style="background: #9f9d9e; width: -webkit-fill-available; color: white; display: block " onclick="btnLoad_Click(true)"><i class="fa fa-spinner"></i>Load Sort Order</button>

        </div>
    </form>
    <form>
        <div class="col-lg-2 col-md-2 col-sm-4 col-xs-6">
            <button id="btnaddinventorysss" type="button" class="w3-btn w3-teal fa fa-plus" style="margin-top:19px"> Add New Inventory Item</button>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-4 col-xs-6">
            <button id="ExportToCsvButton" type="button" class="w3-btn w3-teal Export" style="margin-left:23px;height:26px;padding-top:3px; margin-top:19px"><i class="fa fa-file-excel-o"></i> Export to CSV</button>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-6 col-xs-6">
            <label id="lblmaterial">Filter By Material Type  </label>
            <select id="ddlMaterialType" class="form-control" ; onchange="ddlMaterialTypeOptionsChanged()">
            </select>
        </div>
        <div class="col-lg-2 col-md-2 col-sm-3 col-xs-5">
            <label># of Items</label>
            <input type="text" id="txtitems" class="form-control" disabled="disabled" />
        </div>
        <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4">
            <label>Total Tonnage</label>
            <input type="text" id="txttotaltonnage" class="form-control" disabled="disabled" />
        </div>
    </form>
</div>


@{
    ViewBag.Title = "AllDamageReport";
}

<style>

     .dt-button.buttons-csv.buttons-html5 {
        display: none;
    }

    .dataTables_filter {
    margin-bottom: 3px;
    }

</style>

<div class="row">
    <div class="col-md-5 col-sm-3 col-lg-6 col-xs-1"></div>
    <div class="col-md-2 col-sm-3 col-lg-2 col-xs-3">
        @*<asp:Button ID="ExportToCsvButton" runat="server" CommandName="ExportToCsv" Width="100%" CssClass="btn w3-btn w3-teal " Text="Export to CSV" OnClick="ExportToCsvButton_Click" />*@
        <button type="button" id="ExportToCsvButton" class="btn w3-btn w3-teal" onclick="ExportToCsvButton_Click();" style="Width:100%">Export to CSV</button>
    </div>
    <div class="col-lg-2 col-md-2 col-sm-3  col-xs-4">
        @*<asp:LinkButton ID="btnprint" runat="server" OnClick="btnprint_Click" Width="100%" CssClass="w3-btn w3-blue"><i class="fa fa-print"></i>&nbsp;Print</asp:LinkButton>*@
        <button type="button" id="btnprint" class="w3-btn w3-blue" onclick="btnprint_Click();" style="Width:100%"><i class="fa fa-print"></i>&nbsp;Print</button>
    </div>
    <div class="col-lg-2 col-md-3 col-sm-3 col-xs-2">
        @*<asp:LinkButton runat="server" ID="btnBack" Width="100%" style="padding-left: 7px;" CssClass="w3-btn w3-small  nln-bg w3-text-white" OnClick="btnBack_Click"> <span class="icon"><i class="fa fa-backward"> </i></span><span class="text">&nbsp;Back to Damage </span></asp:LinkButton>*@
        <button type="button" id="btnBack" class="w3-btn w3-small  nln-bg w3-text-white" onclick="btnBack_Click();" style="Width:100%"><span class="icon"><i class="fa fa-backward"> </i></span><span class="text">&nbsp;Back to Damage </span></button>
    </div>
</div>


<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id="AllDamageReportDiv" style="color: black; width: 100%;margin-top:5px;">
            <table id="tblAllDamageReport" class="table table-striped">
                <thead style="background-color: #efefef; color: #716262;">
                    <tr>
                        <th style="display:none"></th>
                        <th>Material Type</th>
                        <th>Item Code</th>
                        <th>Item Description</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Damaged Quantity</th>
                        <th>Reason for Damage</th>
                        <th>Report Entered By</th>
                        <th>Report Entered On</th>
                        <th>Item Weight (kg)</th>
                        <th>Total Weight (kg)</th>
                    </tr>

                </thead>
                <tbody id="tbodyTblAllDamageReport"></tbody>
            </table>

        </div>
    </div>
</div>


<script>

    $(function () {
        GetAllDamageReportDt();
    });

    function btnprint_Click()
    {
        var ClientID = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var radioBtnCheck = '@ViewBag.Check';
        
        window.open('/AllDamageReportPdf/AllDamageReportPdf?UID=' + UID + '&UserRole=' + UserRole + '&id=' + ClientID + '&Check=' + radioBtnCheck);
    }


    function GetAllDamageReportDt() {

        $.ajax({
            type: 'POST',
            url: '/AllDamageReport/GetDamageReport',
            data: JSON.stringify({ClientID : '@ViewBag.id', Check:'@ViewBag.Check'}),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                var data = response;

                $('#tblAllDamageReport').DataTable().clear();
                $('#tblAllDamageReport').DataTable().destroy();

                if (data.length != 0) {
                    var str = '';
                    $.each(data, function (index, obj) {

                        var MaterialType = obj.MaterialType == null ? "" : obj.MaterialType;
                        var ItemCode = obj.ItemCode == null ? "" : obj.ItemCode;
                        var ItemDesc = obj.ItemDesc == null ? "" : obj.ItemDesc;
                        var ItemWeight = obj.ItemWeight == null ? "" : obj.ItemWeight;
                        var FromName = obj.FromName == null ? "" : obj.FromName;
                        var ToName = obj.ToName == null ? "" : obj.ToName;
                        var Reason = obj.Reason == null ? "" : obj.Reason;
                        var Name = obj.Name == null ? "" : obj.Name;
                        var DamageEnterBy = obj.DamageEnterBy == null ? "" : obj.DamageEnterBy;
                        var DamageEnterOn = obj.DamageEnterOn == null ? "" : obj.DamageEnterOn;
                        var InventoryId = obj.InventoryId == null ? "" : obj.InventoryId;
                        var QuantityDamaged = obj.QuantityDamaged == null ? "" : obj.QuantityDamaged;
                        var TotalWeight = obj.TotalWeight == null ? "" : obj.TotalWeight;


                        str += "<tr>";
                        str += "<td style='display:none'></td>";
                        str += "<td>" + MaterialType + "</td>";
                        str += "<td>" + ItemCode + "</td>";
                        str += "<td>" + ItemDesc + "</td>";
                        str += "<td>" + FromName + "</td>";
                        str += "<td>" + ToName + "</td>";
                        str += "<td>" + QuantityDamaged + "</td>";
                        str += "<td>" + Reason + "</td>";
                        str += "<td>" + DamageEnterBy + "</td>";
                        str += "<td>" + DamageEnterOn + "</td>";
                        str += "<td>" + ItemWeight + "</td>";
                        str += "<td>" + TotalWeight.toFixed(2); + "</td>";
                        str += "</tr>";
                    });
                    $('#tbodyTblAllDamageReport').html(str);
                    table = $('#tblAllDamageReport').dataTable({
                        "bSort": false,
                        "processing": true,
                        scrollY: '62vh',
                        searching: true,
                        paging: false,
                        info: false,
                        autoWidth: false,

                        dom: 'Bfrtip',
                        buttons: [

                            {
                                extend: 'csvHtml5',
                                title: 'All Damaged Report',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            }
                        ],
                    });
                }
            }
        });

    }

    function ExportToCsvButton_Click() {
        $('.dt-button.buttons-csv.buttons-html5').trigger('click');
    }

    function btnBack_Click()
    {
         var Href = window.location.href.split('?');
     var ClientID = getParameterByName('id');
      var UID = getParameterByName('UID');
      var UserRole = getParameterByName('UserRole');

         window.location.href = '/DamagedInventory/DamagedInventory?' + Href[1];
       //  window.location.href = '/DamagedInventory/DamagedInventory?UID=' + UID + '&UserRole=' + UserRole + '&id=' + ClientID;
    }

</script>
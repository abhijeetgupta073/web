            //    RowBack.Style.Add("display", "none");
            //}

            bindtermsandcondition();
            bindPolicyandcondition();
        });

        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, "\\$&");
            var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, " "));
        }

        function bindtermsandcondition() {
            var UID = getParameterByName('UID');
            $.ajax({
                type: 'POST',
                data: JSON.stringify({ UID: UID}),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                global: false,
                url: '/TermsNCondition/bindtermsandcondition',
                success: function (response) {
                    var res = response;
                    var str="";
                    $.each(response, function (index, obj) {
                        if (obj != null) {
                            var MainPoint = obj.MainPoint == null ? "" : obj.MainPoint;
                            var SubPoint = obj.SubPoint == null ? "" : obj.SubPoint;
                            var Text = obj.Text == null ? "" : obj.Text;
                            //$('#lblMainPoint').text(MainPoint);
                            //$('#lblSubPoint').text(SubPoint);

                            str+='<div class="col-lg-2 col-sm-2 col-md-2" id="TermMainPoint">'
                            str += '<label id="lblMainPoint" Style="font-weight: bold; font-size: 16px">' + MainPoint + '</label>'
                            str+='</div>'
                            str+='<div class="col-lg-9 col-sm-9 col-md-9" id="TermSubPoint">'
                            str += '<span id="lblSubPoint" Style="font-size: 16px">' + SubPoint + '</label>'
                            str += '</div>'
                            str += '<div class="col-lg-12 col-sm-12 col-md-12" style="padding-top: 10px;"></div>'
                            }
                    });
                    $('#DivTermCondition').empty().append(str);
                   }
                });
        }

        function bindPolicyandcondition() {
            var UID = getParameterByName('UID');
            $.ajax({
                type: 'POST',
                data: JSON.stringify({ UID: UID}),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                global: false,
                url: '/TermsNCondition/bindPolicyandcondition',
                success: function (response) {
                    var res = response;
                    var str="";
                    $.each(response, function (index, obj) {
                        if (obj != null) {
                            var MainPoint = obj.MainPoint == null ? "" : obj.MainPoint;
                            var SubPoint = obj.SubPoint == null ? "" : obj.SubPoint;
                            var Text = obj.Text == null ? "" : obj.Text;
                           
                            str+='<div class="col-lg-12 col-sm-12 col-md-12" id="Mainpointmargin">'
                            str += '<label id="lblMainPoint" Style="font-weight: bold; font-size: 16px;">'+MainPoint+'</label>'
                            str+='</div>'
                            str+='<div class="row">'
                            str+='<div class="col-lg-12 col-sm-12 col-md-12" id="TextMargin">'
                            str += '<label id="lbltext" Style="font-weight: bold; font-size: 16px; color: #89c1e8;">' + Text + '</label>'
                            str+='</div>'
                            str+='<div class="col-lg-11 col-sm-11 col-md-11" id="Subpointmargin">'
                            str += '<span id="lblSubPoint" Style="font-size: 16px">' + SubPoint + '</label>'
                            str += '</div>'
                            str += '</div>'
                            str += '<div class="col-lg-12 col-sm-12 col-md-12" style="padding-top: 10px;"></div>'
                        }
                    });
                    $('#DivPolicyService').empty().append(str);
                }
            });
        }

        function Accept_Click() {
            var ChkAgree = $("#ChkAgree").prop('checked');
            if (ChkAgree == true) {
                //var Response = { Result: "Failed", Message: "Please Select Client." };
                //CustomAlert(Response);
               
            
                var UID = getParameterByName('UID');
                var UserRole = getParameterByName('UserRole');
                var id = getParameterByName('id');
               
                window.location.href = '/TermsNCondition/Accept_Click?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&ChkAgree=' + ChkAgree;

            } else {
               // alert('Please checked Accept');
                $('#divAccept').css('display', 'block');
            }
        }

<script src="~/Content/js/jquery.datetimepicker.js"></script>
<script>
    $(document).ready(function () {
        $('#LiInspection').removeClass('active').addClass('active');
        $('#hdnTimeOffSet').val(new Date().getTimezoneOffset());  // Get Time OffSet
        @*if ('@ViewBag.OffSystemInspection' == 'True') {
       $('#btnDeplank').css('display', 'none');
       $ ('#btnadddocs').css('display', 'none');
       }*@
        if ('@ViewBag.CycloneManagement' == 'False') {
            $('#btnDeplank').css('display', 'none');
        }

        ShowJobInfoDetails();
        BindallDropdown();
        GetInspectionListData();

        var today = new Date();

        //$('#rdpInspectiondate').val(getDateTime());
        //$('#dateInspection').val(getDateTime());
        $('#rdpInspectiondate').datetimepicker({
            // datepicker: false,
            format: 'd-M-Y H:i A',
            //format: 'D M-d-Y g:i a',
            //formatTime: 'g:i a',
            // dateFormat: "mm/dd/yy",
            // timeFormat: "hh:mm:ss",
            maxDate: today,
            //maxTime: '18:00'
            // maxTime: Hours    // UTC + 12 Hours
        });
        $('#dateInspection').datetimepicker({
            // datepicker: false,
            format: 'd-M-Y H:i A',
            maxDate: today,
            //maxTime: '18:00'
            // maxTime: Hours    // UTC + 12 Hours
        });
        $('.calendar-icon').click(function () {
            $('#rdpInspectiondate').focus();
        });
        $('.calendar-icon').click(function () {
            $('#dateInspection').focus();
        });
    });
</script>

<script>

        $(document).ready(function () {

            //    $("#ulalwaysactive").css("display", "none");
            var screensize = $(window).width();
            if (screensize < 1150 && screensize > 650) {
                ($BODY.hasClass('nav-md'))
                $('#CreateNewDropDown').css("margin-top", "2px");
                $BODY.removeClass('nav-md').addClass('nav-sm');
                $LEFT_COL.removeClass('scroll-view');
                //$('#BlackSection').css('display', 'block');
                $('#imgLogo').parent().css('display', 'none');
                $('#imgLogo1').css('display', 'block').css("height", "38px");
                $('#leftbarsection').css('margin-top', '0px');


            }


            else {
                if (screensize < (650)) {
                    $BODY.removeClass('nav-sm')
                    $('#imgLogo').parent().css('display', 'none');
                    $('#imgLogo1').css('display', 'block').css("height", "52px");
                    $('.xsfieldset').css('margin-left', '-22px').css("width", "100%");
                    $('.xsgridwidth').css("width", "110%");
                }
                else {
                    $('#CreateNewDropDown').css("margin-top", "6px");
                    $BODY.removeClass('nav-sm').addClass('nav-md');
                    //$('#BlackSection').css('display', 'none');
                    $('#imgLogo').parent().css('display', 'block');
                    $('#imgLogo1').css('display', 'none');
                    $('#leftbarsection').css('margin-top', '40px');
                }

            }
        });

        function hide() {
        $('#Adddocs').css('display', 'none');

        }
        function hide2() {
            $('#divDeplank').css('display', 'none');
    }
 

    function btnDeplank_Click() {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        if ($('#lblNewstatus').val() == "Completed") {
            $('#divDeplank').css('display', 'none');
            var Response = { Result: "Failed", Message: "Since Job has been Completed so no further action allowed." };
            CustomAlert(Response);
        }
        else {
            BindallDropdown();
            if ($('#hdnLoginUserId').val() != "") {
                $('#ddlInspecdeplank').val($('#hdnLoginUserId').val());
            }
            $('#divDeplank').css('display', 'block');
            //divDeplank.Style.Add("display", "block");
            // dateInspection.SelectedDate =DateTime.Now;
            //dateInspection.SelectedDate = Convert.ToDateTime(hdnCurrentDate.Value);
            $('#txtcomm').val('');
            $('#dateInspection').val(getDateTime());
        }
        ShowJobInfoDetails();

    }
</script>
<style>

    .input-container {
        position: relative;
        display: flex;
        align-items: center;
    }

        .input-container input {
            width: 100%;
            padding-right: 30px; /* Adjust to provide space for the icon */
            box-sizing: border-box;
        }

        .input-container .calendar-icon {
            position: absolute;
            right: 10px; /* Adjust to position the icon correctly */
            cursor: pointer;
        }

            .input-container .calendar-icon i {
                font-size: 16px;
            }

     .requiredColumn{
    border-color:red;
    }
    .setWidth1 {
        min-width: 5px !important;
    }

    .setWidth3 {
        min-width: 70px !important;
    }

    .setWidth2, .setWidth4, .setWidth5, .setWidth10 {
        min-width: 130px !important;
    }

    .setWidth6 {
        min-width: 180px !important;
    }

    .setWidth7, .setWidth8, .setWidth9 {
        min-width: 70px !important;
    }
</style>


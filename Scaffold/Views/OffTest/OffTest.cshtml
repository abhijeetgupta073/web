        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id="DivtblOffSystemInspectionListMessage" width: 100%; margin-top:5px; display:none;">
            <table id="tblOffSystemInspectionListMessage" class="table table-striped" style="width:100%">
                <thead style="background-color: #efefef; color: #716262; width: 100%;">
                    <tr>
                        <th> </th>
                    </tr>
                </thead>
                <tbody id="tbodyOffSystemInspectionListMessage" style="width:100%"></tbody>
            </table>
        </div>
    </div>
</div>


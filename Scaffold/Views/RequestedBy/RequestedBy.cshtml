<script>
    $(function () {

        ddlSiteDropdown();
        GetRequestBy();

        var registerid = getParameterByName('RID');

        if (registerid != null && registerid != "" && registerid != "0") {
            $('#btnBack').show();
        } else {
            $('#btnBack').hide();
        }
    });

    function ddlSitesLocation() {
        GetRequestBy();
    }



@{
    ViewBag.Title = "RequestInventory";
}
<script src="~/Content/js/RequestInventory.js?V1=29"></script>
<script>
    $(document).ready(function () {
        var RID = getParameterByName('RID');
        var ArrayData = [RID];
        var DecryptData = Decrypt(ArrayData);
        var fromtocheck = getParameterByName('fromtocheck');
        var ThirdParty = getParameterByName('ThirdParty');

        RID = DecryptData[0];
        if (RID != "" && RID != null) {
            $('#rdositetojob').prop('checked', true);
            //$('#btnnewrequest').css('display', 'none');
            //$('#btnedit').css('display', 'none');
            //$('#Delivery').css('display', 'none');
            $('#showback').css('display', 'block');
            $('#DtoS').css('display', 'none');
            $('#showreqdel').css('display', 'none');
            //$('#RequiredDt').css('display', 'none');

            $('#StoJ').css('display', 'block');
            $('#txtsite').val('@ViewBag.SiteName');
            $('#txtjob').val('@ViewBag.ScaffRref');

            $('#ShowThirdPartytoDepot').css('display', 'none');
            $('#Showdepottosite').css('display', 'none');

        } else {
            if (Decrypt(fromtocheck) == "3" || Decrypt(ThirdParty) == "true") {
                $('#rdoThirdPartytoDepot').prop('checked', true);
                $('#lblfrom').css('display', 'none');
                $('#ddlSite').css('display', 'none');
            }
            else {
                $('#rdodepottosite').prop('checked', true);
                //$('#rdoThirdPartytoDepot').prop('checked', true);
                //$('#lblfrom').css('display', 'none');
                //$('#ddlSite').css('display', 'none');
            }
           //commented on 15-02-2023 $('#RequiredDt').css('display', 'block');

        }

       SiteDropDownBind();
        GetRequestInventoryData();

    });

    function rdoThirdPartytoDepot_CheckedChanged() {
        $('#lblfrom').css('display', 'none');
        $('#ddlSite').css('display', 'none');
        //$('#displaygrid').css('display', 'block');
        GetRequestInventoryData();
        
    }

    function rdodepottosite_CheckedChanged() {
        $('#lblfrom').css('display', 'block');
        $('#ddlSite').css('display', 'block');
        //$('#displaygrid').css('display', 'block');
        GetRequestInventoryData();
      
    }


</script>

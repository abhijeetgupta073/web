function showData(EntryDate){
    
    $('#LoadingPanel1').show();

    var RecocileEntryDate = EntryDate;
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    var getRowCount="";
    $.ajax({
            url: '/ManHrsReconcile/showData',
            type: 'POST',
            data: JSON.stringify({ id: id, UID: UID, EntryDate: RecocileEntryDate }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                getRowCount= response.getRowCount;
                if(getRowCount !=""){
                  $('#btnExport').css('display', 'block');
                }
                else{
                  $('#btnExport').css('display', 'none');
                }
                $('#lbltabledata').val(response.lbltabledata);
                $('#PlaceHolder1').empty().append(response.html);  
             

                    }
                });
            
          $('#LoadingPanel1').hide();
            var RowCount = 0;
            var SiteTotal;

            //RowCount = $('#<%= getRowCount.ClientID%>').val();

            RowCount = getRowCount;
                          
            if (RowCount > 0) {
                for (var i = 0; i < RowCount; i++) {
                    SiteTotal = 0;
                    //$("#manhrRow" + i).find(".siteTotal" + i).each(function () {
                    //    //alert($(this).text());
                    //    SiteTotal = (parseFloat(SiteTotal) + parseFloat($(this).text())).toFixed(2);
                    //});

                    SiteTotal = $(".ActualHrsTotal" + i).text();

                    if (SiteTotal != null && SiteTotal != 0) {
                        $(".ActualHrsTotal" + i).text(SiteTotal);

                        if (parseInt($(".ExpectedHrsTotal" + i).text()) != null && parseInt($(".ExpectedHrsTotal" + i).text()) != 0) {

                            //Commented on 24-05-2023 Total Hours Was showing twice data 
                            //if (SiteTotal < parseInt($(".ExpectedHrsTotal" + i).text()) || SiteTotal > parseInt($(".ExpectedHrsTotal" + i).text())) {
                            //    $(".ExpectedHrsTotal" + i).parent().addClass("InvalidCol");
                            //}
                            //else {
                            //    $(".ExpectedHrsTotal" + i).parent().removeClass("InvalidCol");
                            //}

                            if (SiteTotal < parseInt($(".ExpectedHrsTotal" + i).text())) {
                                $(".ExpectedHrsTotal" + i).parent().addClass("InvalidCol");
                            }
                            else {
                                $(".ExpectedHrsTotal" + i).parent().addClass("totalcolor");
                            }
                        }
                    } else {
                        $(".ActualHrsTotal" + i).text("0.00");
                        if (parseInt($(".ExpectedHrsTotal" + i).text()) != null && parseInt($(".ExpectedHrsTotal" + i).text()) != 0) {

                            //Commented on 24-05-2023
                            //if (SiteTotal < parseInt($(".ExpectedHrsTotal" + i).text()) || SiteTotal > parseInt($(".ExpectedHrsTotal" + i).text())) {
                            //    $(".ExpectedHrsTotal" + i).parent().addClass("InvalidCol");
                            //}
                            //else {
                            //    $(".ExpectedHrsTotal" + i).parent().removeClass("InvalidCol");
                            //}

                            if (SiteTotal < parseInt($(".ExpectedHrsTotal" + i).text())) {
                                $(".ExpectedHrsTotal" + i).parent().addClass("InvalidCol");
                            }
                            else {
                                $(".ExpectedHrsTotal" + i).parent().addClass("totalcolor");
                            }
                        }
                    }
                }
            }

    }

    </script>

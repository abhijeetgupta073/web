    function btnConfirmDeleteYes_Click() {
        var UserID = $('#hdnUserID').val();
        $.ajax({
            url: '/ClientUsers/btnConfirmDeleteYes_Click',
            type: 'POSt',
            data: JSON.stringify({ UserID: UserID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response.Result == "Success") {
                    $("#PopupDelete").css("display", "none");
                    //GetClientUser();
                    location.reload();
                    CustomAlert(response);

                } else {
                    $("#PopupDelete").css("display", "none");
                    CustomAlert(response);
                }
            }
        });
    }
    function btnConfirmDeleteNo_Click() {
        $("#PopupDelete").css("display", "none");
    }

    function EncrptyClientUserID(clientUserId) {
        let tempClientUserId;
        $.ajax({
            url: '/ClientUsers/EncrptyClientUserID',
            type: 'POST',
            async: false,
            data: { clientUserId },
            success: function (response) {
                if (response != null) {
                    tempClientUserId = response;
                }
            }
        });
        return tempClientUserId;
    }


    function btnExportToCSV() {
        $('.dt-button.buttons-csv.buttons-html5').trigger('click');
    }


    function btnAddUser_Click() {
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var Clientid = getParameterByName('id');
        var UserID = '0';
        var encryData = Encrypt([UserID]);
        UserID = encryData[0];
        window.location.href = '/UserInfo/UserInfo?UID=' + UID + '&UserRole=' + UserRole + '&id=' + Clientid + '&UserID=' + UserID;
    }


                                }
                            }
                        ],

                    });
                    $(document).on('click', '.fa-trash', function () {
                        var Userid = this.id.split('deleteUserID_')[1];
                        $("#hdnUserID").val(Userid);
                        $("#PopupDelete").css("display", "block");
                    });

                    //$(".fa-trash").click(function () {
                    //    var Userid = this.id.split('deleteUserID_')[1];
                    //    $("#hdnUserID").val(Userid);
                    //    $("#PopupDelete").css("display", "block");
                    //});
                    $('#tblClientUser tbody').on('click', '.clsClientUserId', function () {

                        var rowNumber = $(this).attr('nowNumber');
                        var ClientUserid = $('#UserId_' + rowNumber).text();

                        var UID = getParameterByName('UID');
                        var UserRole = getParameterByName('UserRole');
                        var id = getParameterByName('id');
                        var encryData = Encrypt([ClientUserid]);
                        ClientUserid = encryData[0];
                        location.href = '/UserInfo/UserInfo?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&UserID=' + ClientUserid;

                        //Response.Redirect("UserInfo.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&UserID=" + databaseCon.Encrypt(UserId), false);
                    });
                }

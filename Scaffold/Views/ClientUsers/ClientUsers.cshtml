    function GetClientUser(showpass) {
        var id = getParameterByName('id');
        $.ajax({
            url: '/ClientUsers/GetClientUserData',
            type: 'POSt',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var data = response;

                $('#tblClientUser').DataTable().clear();
                $('#tblClientUser').DataTable().destroy();
                $('#tblClientUserpass').DataTable().clear();
                $('#tblClientUserpass').DataTable().destroy();
                if (data.length != 0) {
                    var str = '';
                    var str2 = '';
                    $.each(data, function (index, obj) {

                        var UserId = obj.UserId == null ? "" : obj.UserId;
                        var firstname = obj.firstname == null ? "" : obj.firstname;
                        var lastname = obj.lastname == null ? "" : obj.lastname;
                        var Category = obj.Category == null ? "" : obj.Category;
                        var CellPhone = obj.CellPhone == null ? "" : obj.CellPhone;
                        var Zip = obj.Zip == null ? "" : obj.Zip;
                        var City = obj.City == null ? "" : obj.City;
                        var Role = obj.Role == null ? "" : obj.Role;
                        var EmailID = obj.EmailID == null ? "" : obj.EmailID;
                        var Status = obj.Status == null ? "" : obj.Status;
                        // On the date 05 / 13 / 2025, the 'Show Password' button and the password column from the DataTable were removed.
                        //var Password = obj.Password == null ? "" : obj.Password;
                        //var Password = Decrypt(obj.Password);
                        //Password = Password == null ? "" : Password;

                        if (showpass == "showpass") {
                            str += "<tr>";
                            str += "<td id='UserId_" + index + "' class='clsClientUserIDWidth' style='display: none;'> " + UserId + "</td>";
                            str += "<td id='EditClientUser_" + index + "' class='clsClientUserId' style='cursor:pointer;' nowNumber='" + index + "'><i class='expand fa fa-pencil'></i></td>";
                            str += "<td class='clsClientUserdeleteWidth' style='cursor:pointer;'><i id='deleteUserID_" + UserId + "' class='fa fa-trash'></i></td>";
                            str += "<td class='clsFirstNameWidth' > " + firstname + "</td>";
                            str += "<td class='clsLastNameWidth' > " + lastname + "</td>";
                            str += "<td class='clsCategoryWidth' > " + Category + "</td>";
                            str += "<td class='clsRoleWidth' > " + Role + "</td>";
                            str += "<td class='clsEmailWidth' > " + EmailID + "</td>";
                            // On the date 05 / 13 / 2025, the 'Show Password' button and the password column from the DataTable were removed.
                            //str += "<td class='clsPasswordWidth'> " + Password + "</td>";
                            str += "<td class='clsStatusWidth' > " + Status + "</td>";
                            str += "<td class='clsContactNoWidth' > " + CellPhone + "</td>";
                            str += "<td class='clsPostcodeWidth' > " + Zip + "</td>";
                            str += "<td class='clsCityWidth' > " + City + "</td>";
                            str += "</tr>";
                        }
                        else {
                            str2 += "<tr>";
                            str2 += "<td id='UserId_" + index + "' class='clsClientUserIDWidth' style='display: none;'> " + UserId + "</td>";
                            str2 += "<td id='EditClientUser_" + index + "' class='clsClientUserId' style='cursor:pointer;' nowNumber='" + index + "'><i class='expand fa fa-pencil'></i></td>";
                            str2 += "<td class='clsClientUserdeleteWidth' style='cursor:pointer;'><i id='deleteUserID_" + UserId + "' class='fa fa-trash'></i></td>";
                            str2 += "<td class='clsFirstNameWidth' > " + firstname + "</td>";
                            str2 += "<td class='clsLastNameWidth' > " + lastname + "</td>";
                            str2 += "<td class='clsCategoryWidth' > " + Category + "</td>";
                            str2 += "<td class='clsRoleWidth' > " + Role + "</td>";
                            str2 += "<td class='clsEmailWidth' > " + EmailID + "</td>";
                            str2 += "<td class='clsStatusWidth' > " + Status + "</td>";
                            str2 += "<td class='clsContactNoWidth' > " + CellPhone + "</td>";
                            str2 += "<td class='clsPostcodeWidth' > " + Zip + "</td>";
                            str2 += "<td class='clsCityWidth' > " + City + "</td>";
                            str2 += "</tr>";
                        }
                    });

                }
                if (showpass == "showpass") {
                    $("#LoadingPanel1").css("display", "none");
                    $('#tbodyTblClientUser2').html(str);
                    tblClientUserpass = $('#tblClientUserpass').dataTable({
                        "bSort": false,
                        "processing": true,
                        searching: true,
                        "bLengthChange": false,
                        "bInfo": false,
                        autoWidth: false,
                        scrollX: true,
                        scrollCollapse: true,
                        scrollY: "60vh",
                        //paging: false,
                        dom: 'Bfrtip',
                        buttons: [

                            {
                                extend: 'csvHtml5',
                                title: 'User List',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            }
                        ],

                    });
                    $(document).on('click', '.fa-trash', function () {
                        var Userid = this.id.split('deleteUserID_')[1];
                        $("#hdnUserID").val(Userid);
                        $("#PopupDelete").css("display", "block");
                    });

                    //$(".fa-trash").click(function () {
                    //    var Userid = this.id.split('deleteUserID_')[1];
                    //    $("#hdnUserID").val(Userid);
                    //    $("#PopupDelete").css("display", "block");
                    //});
                    $('#tblClientUserpass tbody').on('click', '.clsClientUserId', function () {

                        var rowNumber = $(this).attr('nowNumber');
                        var ClientUserid = $('#UserId_' + rowNumber).text();

                        var UID = getParameterByName('UID');
                        var UserRole = getParameterByName('UserRole');
                        var id = getParameterByName('id');
                        var encryData = Encrypt([ClientUserid]);
                        ClientUserid = encryData[0];
                        location.href = '/UserInfo/UserInfo?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&UserID=' + ClientUserid;

                        //Response.Redirect("UserInfo.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&UserID=" + databaseCon.Encrypt(UserId), false);
                    });
                }
                else {
                    $("#LoadingPanel1").css("display", "none");
                    $('#tbodyTblClientUser').html(str2);
                    tbleClientUser = $('#tblClientUser').dataTable({
                        "bSort": false,
                        "processing": true,

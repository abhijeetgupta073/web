        function OnDdlFilterChange() {

            var ddldatetime = $('#ddlFilterDateMonthly').val();

            if (ddldatetime == "This_Month") {
                var date = new Date();
                var firstDay = new Date(date.getFullYear(), date.getMonth(), 1);

                var lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0);
                //var datepicker = $find("<%=txtDatePickerFrom1.ClientID %>");
                //var datepicker2 = $find("<%=txtDatePickerTo1.ClientID %>");
                //datepicker.set_selectedDate(firstDay);
               // datepicker2.set_selectedDate(lastDay);

                $('#txtDatePickerFrom1').val(firstDay.DateMonthFormat());
                $('#txtDatePickerTo1').val(lastDay.DateMonthFormat());
            }
            if (ddldatetime == "Last_Month") {
                var now = new Date();
                var prevMonthLastDate = new Date(now.getFullYear(), now.getMonth(), 0);
                var prevMonthFirstDate = new Date(now.getFullYear() - (now.getMonth() > 0 ? 0 : 1), (now.getMonth() - 1 + 12) % 12, 1);

               // var datepicker = $find("<%=txtDatePickerFrom1.ClientID %>");
               // var datepicker2 = $find("<%=txtDatePickerTo1.ClientID %>");
               // datepicker.set_selectedDate(prevMonthFirstDate);
               // datepicker2.set_selectedDate(prevMonthLastDate);

                $('#txtDatePickerFrom1').val(prevMonthFirstDate.DateMonthFormat());
                $('#txtDatePickerTo1').val(prevMonthLastDate.DateMonthFormat());
            }

        }

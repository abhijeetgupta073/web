        function SiteDropDownBind(id) {

            $.ajax({
                type: "POST",
                url: "/ManHrsDashboard/SiteDropDownBind",
                data: JSON.stringify({ id: id}),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var getData = response;
                    $("#manhrsselectSite").html("");
                    $("#manhrsselectSite").append('<option value="All">All</option>');
                    for (var i = 0; i < getData.length; i++) {
                        $("#manhrsselectSite").append('<option value="' + getData[i].SiteLocID + '">' + getData[i].SiteLocation + '</option>');

                    }
                }
            });

        }
        function ddlJobbind(id) {

            $.ajax({
                type: "POST",
                url: "/ManHrsDashboard/ddlJobDashboard",
                data: JSON.stringify({ id: id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var ddlJobdropdownbind = response;
                    $("#manhrSelectjob").html("");
                    $("#manhrSelectjob").append('<option value="All">All</option>');
                    for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                        $("#manhrSelectjob").append('<option value="' + ddlJobdropdownbind[i].Scaffref + '">' + ddlJobdropdownbind[i].Description + '</option>');
                       
                    }
                }
            });

        }
        function ddlCategoryBind(id) {

            $.ajax({

            //            alert(hello);
            //        },


            //    });


            var ddldatetime = $('#ddlFilterDate').val();
            //alert(ddldatetime);
            if (ddldatetime == "This_Week") {
                var date = new Date();
                var startDay = 0;
                var week = $("#hdnweekday").val();
                var firstDay = new Date(date.getFullYear(), date.getMonth(), date.getDate() - date.getDay() + parseInt(week));
                var lastDay = new Date(date.getFullYear(), date.getMonth(), date.getDate() - date.getDay() + parseInt(week) + 6);
               // var datepicker = $find("<%=txtDatePickerFrom.ClientID %>");
               // var datepicker2 = $find("<%=txtDatePickerTo.ClientID %>");
                //datepicker.set_selectedDate(firstDay);
                //datepicker2.set_selectedDate(lastDay);
                $('#txtDatePickerFrom').val(firstDay.DateMonthFormat());
                $('#txtDatePickerTo').val(lastDay.DateMonthFormat());
            }
            if (ddldatetime == "Last_Week") {
                var now = new Date();
                var prevMonthFirstDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - now.getDay() - 6);
                var prevMonthLastDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - now.getDay());
                //var datepicker = $find("<%=txtDatePickerFrom.ClientID %>");
                //var datepicker2 = $find("<%=txtDatePickerTo.ClientID %>");
                //datepicker.set_selectedDate(prevMonthFirstDate);
                //datepicker2.set_selectedDate(prevMonthLastDate);
                $('#txtDatePickerFrom').val(prevMonthFirstDate.DateMonthFormat());
                $('#txtDatePickerTo').val(prevMonthLastDate.DateMonthFormat());
            }

        }



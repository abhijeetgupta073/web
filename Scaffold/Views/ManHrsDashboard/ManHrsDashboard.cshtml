        function OnDdlFilterChangeWeekly() {
            //$.ajax({
            //    type: "POST",
            //        url: "/ManHrsDashboard.aspx/getsummaryData",
            //        data: JSON.stringify({ ClientID: ClientID }),
            //        contentType: "application/json; charset=utf-8",

                        $("#manhrsSelectcat").append('<option value="' + ddlCategorydropdownbind[i].TypeofVariation + '">' + ddlCategorydropdownbind[i].TypeofVariation + '</option>');
                       
                    }
                }
            });

        }


        /// textbox fill up 4 Textbox
        function manhrsall(ClientID, fromdate, todate) {
            $.ajax({
                type: "POST",
                //url: "../WebApi/Dashboard.asmx/GetAllManHrs",
                url: "/ManHrsDashboard/GetAllManHrs",
                data: JSON.stringify({ ClientID: ClientID, fromdate: fromdate, todate: todate }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                   // ManHrsAll = response.d;
                    ManHrsAll = response;

                    var ManHrsData = [];
                    for (var i = 0; i < ManHrsAll.length; i++) {
                        var TobePush = true;
                        for (var k = 0; k < ManHrsData.length; k++) {
                            if (ManHrsData[k].name == ManHrsBySite[i].SiteLocation) {
                                TobePush = false;
                            }
                        }

                        if (TobePush) {
                            $('#txtErectionhrs').val(ManHrsAll[i].AllErectionHrs);
                            $('#txtAdditionalhrs').val(ManHrsAll[i].AllAdditionalHrs);
                            $('#txtModificationhrs').val(ManHrsAll[i].AllModificationHrs);
                            $('#txtDismantlehrs').val(ManHrsAll[i].AllDismantleHrs);
                            $('#txtTotalhrs').val(ManHrsAll[i].total);
                        }
                    }
                }
            })
        }

        /// Chart 1 Man Hrs By Sites 
        function manhrsbysite(id, ClientID, fromdate, todate) {
            $.ajax({
                type: "POST",
               // url: "../WebApi/Dashboard.asmx/GetBySitesManHrs",
                url: "/ManHrsDashboard/GetBySitesManHrs",
                data: JSON.stringify({ id: id, ClientID: ClientID, fromdate: fromdate, todate: todate }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                   // ManHrsBySite = response.d;
                    ManHrsBySite = response;

                    var ManErectionHrs = [];
                    var ManHrsDataLabels = [];
                    var scaffref = [];
                    var total = 0;
                    var ManAdditionalHrs = [];
                    var ManDismantleHrs = [];
                    var ManHrsData = [];
                    var ManModificationHrs = [];
                    var TotalHrs1 = 0;
                    for (var i = 0; i < ManHrsBySite.length; i++) {
                        var TobePush = true;
                        for (var k = 0; k < ManHrsData.length; k++) {
                            if (ManHrsData[k].name == ManHrsBySite[i].SiteLocation) {
                                TobePush = false;
                            }
                        }

                        if (TobePush) {
                            ManErectionHrs.push({ name: ManHrsBySite[i].SiteLocation, y: ManHrsBySite[i].ErectionHrs, sliced: true });
                            ManAdditionalHrs.push({ name: ManHrsBySite[i].SiteLocation, y: ManHrsBySite[i].AdditionalHrs, sliced: true });
                            ManDismantleHrs.push({ name: ManHrsBySite[i].SiteLocation, y: ManHrsBySite[i].DismantleHrs, sliced: true });
                            ManModificationHrs.push({ name: ManHrsBySite[i].SiteLocation, y: ManHrsBySite[i].ModificationHrs, sliced: true });

                            //total = (total + ManHrsBySite[i].ErectionHrs);
                            scaffref.push(ManHrsBySite[i].SiteLocation);
                            var TotalHrs1 = TotalHrs1 + ManHrsBySite[i].ErectionHrs + ManHrsBySite[i].AdditionalHrs + ManHrsBySite[i].DismantleHrs + ManHrsBySite[i].ModificationHrs;
                            var totalSum = TotalHrs1;
                            //var abc = [];
                            //abc.push(ManHrsBySite[i].ErectionHrs);
                            //alert(abc);
                            //var totalPrice5 = parseFloat(total / ManHrsBySite.length).toFixed();
                        }

                    }

                    $("#lblTotalHrs1").text(totalSum);
                    $("#totalhrsbysite").val();
                    Highcharts.chart('newcontainer1', {
                        chart: {
                            type: 'column',
                            backgroundColor: '#f2f2f2'
                        },
                        title: {
                            text: ''
                        },
                        exporting: {
                            buttons: {
                                contextButton: {
                                    enabled: false
                                },
                            }
                        },
                        xAxis: {
                            categories: scaffref,
                            title: {
                                text: null
                            }
                        },
                        yAxis: {
                            max: 1000,
                            title: {
                                text: 'Total Hours'
                            }
                        },

                        tooltip: {
                            //pointFormat: '<span style="color:{series.color}">{series.name}</span>: {point.percentage:.0f} hrs<br/>',
                            shared: true
                        },
                        plotOptions: {
                            column: {
                                stacking: 'hours'
                            }
                        },
                        legend: {
                            enabled: false
                        },
                        series: [{
                            name: 'Erection',
                            data: ManErectionHrs
                        }, {
                            name: 'Dismantle',
                            data: ManDismantleHrs
                        }, {
                            name: 'Modification',
                            data: ManModificationHrs
                        }, {
                            name: 'Additional',
                            data: ManAdditionalHrs
                        }
                        ]
                    });

                    function redrawchart1() {
                        var chart = $('#newcontainer1').highcharts();

                        var w = $('#newcontainer2').closest(".wrapper").width()
                        chart.setSize(
                            w, w * (2.3 / 4), false
                        );
                    }

                    $(window).resize(redrawchart1);
                    redrawchart1();
                },
            });
        }


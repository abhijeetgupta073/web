        /// Chart 4 Line Spent Vs Earned
        function manhrsbyline(ClientID, fromdate, todate) {
            $.ajax({
                type: "POST",
               // url: "../WebApi/Dashboard.asmx/GetByLineManHrs",
                url: "/ManHrsDashboard/GetByLineManHrs",
                data: JSON.stringify({ ClientID: ClientID, fromdate: fromdate, todate: todate }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    //ManHrsByLine = response.d;
                      ManHrsByLine = response;

                    var ManDelayHrs = [];
                    var ManDelayHrs1 = [];
                    var ManHrsData = [];
                    var abc = [];
                    for (var i = 0; i < ManHrsByLine.length; i++) {
                        var TobePush = true;
                        for (var k = 0; k < ManHrsData.length; k++) {
                            //if (ManHrsData[k].name == ManHrsByLine[i].EntryDate) {
                            //    TobePush = false;
                            //}
                        }

                        if (TobePush) {
                            abc.push(ManHrsByLine[i].EntryDate);
                            ManDelayHrs.push({ name: ManHrsByLine[i].EntryDate, y: ManHrsByLine[i].SpentHours, sliced: true });
                            ManDelayHrs1.push({ name: ManHrsByLine[i].EntryDate, y: ManHrsByLine[i].NoOfHrs, sliced: true });


                        }

                    }
                    Highcharts.chart('newcontainer4', {
                        chart: {
                            borderColor: '#D3D3D3',
                            borderWidth: 1,
                            type: 'line',
                            backgroundColor: '#f2f2f2',
                            //height: 190,

                        },
                        title: {
                            text: 'Spent Vs Earned'
                        },
                        exporting: {
                            buttons: {
                                contextButton: {
                                    enabled: false
                                },
                            }
                        },
                        xAxis: {
                            categories: abc
                        },

                        yAxis: {
                            title: {
                                text: 'Spent/Earned'
                            },
                            // categories: ['','0', '80', '160', '240', '320','400']
                        },
                        legend: {
                            layout: 'vertical',
                            align: 'right',
                            verticalAlign: 'middle'
                        },

                        plotOptions: {
                            series: {
                                label: {
                                    connectorAllowed: false
                                },
                                pointStart: 0

                            }
                        },
                        series: [{
                            name: 'Spent',
                            data: ManDelayHrs
                        }, {
                            name: 'Earned',
                            color: 'orange',
                            data: ManDelayHrs1
                        }],

                        responsive: {
                            rules: [{
                                condition: {
                                    maxWidth: 400
                                },
                                chartOptions: {
                                    legend: {
                                        layout: 'horizontal',
                                        align: 'center',
                                        verticalAlign: 'bottom'
                                    }
                                }
                            }]
                        }
                    });


                    function redrawchart4() {
                        var chart4 = $('#newcontainer4').highcharts();

                        var w4 = $('#newcontainer4').closest(".wrapper").width()
                        chart4.setSize(
                            //695, 300, false
                            w4, w4 * (1.1 / 3.2), false
                        );
                    }

                    $(window).resize(redrawchart4);
                    redrawchart4();

                },
            });
        }


      
 </script>

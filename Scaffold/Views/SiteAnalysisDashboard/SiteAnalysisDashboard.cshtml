@*<%--Model to Show Scaffold By DesignType--%>*@
<div class="container">
    <button style="display: none;" id="Model1" type="button" class="btn btn-info btn-lg" data-toggle="modal" data-target="#myModal1">Open Modal</button>
    <div class="modal fade" id="myModal1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Scaffold By DesignType </h4>
                </div>
                <div class="modal-body">
                    <table class="table table-bordered" id="tbDetails1" style="width: 100%; color: black">
                        <tbody>
                            <tr>
                                <td style="width: 50%; text-align: center;"><b>Design Type</b></td>
                                <td style="width: 30%; text-align: center;"><b>Difficulty Rating</b></td>
                                <td style="width: 20%; text-align: center;"><b>Job Counts</b></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@*<%--Model to Show Scaffold By DesignType--%>*@




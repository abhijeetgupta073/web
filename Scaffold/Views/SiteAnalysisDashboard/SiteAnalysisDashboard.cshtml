    /// Chart 3 Difficulty Rating
    function ByDRating(ID, Job, Site) {
        $('.forRemoveData3').remove();
        $.ajax({
            type: "POST",
            // url: "../WebApi/Dashboard.asmx/SiteAnalysisByDRating",
            url: "/SiteAnalysisDashboard/SiteAnalysisByDRating",
            data: JSON.stringify({ id: ID, site: Site, jobid: Job }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // SiteStructureDRating = response.d;
                SiteStructureDRating = response;
                var SDRating = [];
                var SiteAnalysisDRating = [];
                var TotalRCount = [];
                var noofrow = 20;
                var totaldrate = 0;
                var registercount = 0;
                var gaugeval = 0;
                if (SiteStructureDRating.length < 20) {
                    noofrow = SiteStructureDRating.length;
                }

                if (SiteStructureDRating.length > 0) {
                    for (var i = 0; i < noofrow; i++) {
                        var TobePush = true;


                        if (TobePush) {
                            SiteAnalysisDRating.push({ name: SiteStructureDRating[i].DRating, y: SiteStructureDRating[i].DRCount, sliced: true });

                            SDRating.push(SiteStructureDRating[i].DRating);
                            TotalRCount.push(SiteStructureDRating[i].DRCount);
                            registercount += SiteStructureDRating[i].DRCount;
                            totaldrate += SiteStructureDRating[i].DRating * SiteStructureDRating[i].DRCount;
                            //gauge.push(totaldrate += totaldrate);
                        }

                    }
                }
                if (registercount > 0) {
                    gaugeval = totaldrate / registercount;
                    gaugeval = parseFloat(gaugeval.toFixed(2));
                }

                var theExportOptions = Highcharts.getOptions().exporting.buttons.contextButton.menuItems;
                theExportOptions.splice(0, 1);
                theExportOptions.splice(5, 10);



                Highcharts.chart('container3', {
                    chart: {
                        borderWidth: 0,

                        backgroundColor: '#f2f2f2',
                        type: 'gauge',
                        plotBorderWidth: 0,
                        plotShadow: false
                    },
                    title: {
                        align: 'left',
                        text: 'Scaffolds by Design Type Difficulty Rating'
                    },
                    navigation: {
                        buttonOptions: {
                            verticalAlign: 'top',
                            y: -12,
                        }
                    },
                    exporting: {
                        buttons: {

                            contextButton: {
                                enabled: true,
                                x: 9,
                                //menuItems: Highcharts.getOptions().exporting.buttons.contextButton.menuItems.splice(2,5)
                            },

                            exportButton: {
                                //x: -28,
                                onclick: function () {
                                    $('#Model3').click();
                                },
                                //symbol: 'circle'
                                text: 'Show All'
                            }
                        }
                    },
                    pane: {
                        startAngle: -90,
                        endAngle: 90,
                        size: 260,
                        center: ['50%', '70%'],
                        background: [],

                    },

                    // the value axis
                    yAxis: {
                        min: 0,
                        max: 5,
                        //width:600,
                        lineWidth: 0,
                        minorTickInterval: 0,
                        //minorTickWidth: 1,
                        minorTickLength: 5,
                        minorTickPosition: 'inside',

                        tickInterval: 0.5,
                        tickWidth: 2,

                        tickLength: 0,
                        //tickColor: '#4C941D',

                        tickPosition: 'outside',
                        //tickpositions: [-10, 0, 20, 40, 60, 80, 100, 110],

                        labels: {
                            //step: 2,
                            //rotation: 'auto'
                            formatter: function () {
                                //position3d: 'offset',
                                if (this.value == 2) return '';
                                if (this.value == 3) return '';
                                if (this.value == 0) return '0';
                                if (this.value == 5) return '5';
                                if (this.value == 1) return 'Low Difficulty';
                                if (this.value == 4) return 'High Difficulty';
                                if (this.value % 3 == 0) return this.value;
                                return '';
                            },
                            distance: 35
                            // y: 10,
                            //align:'right',

                        },

                        title: {
                            text: ''
                        },

                        plotBands: [{
                            from: 0,
                            to: 0.5,
                            color: '#4C941D',
                            thickness: '40%'
                        }, {
                            from: 0.5,
                            to: 1,
                            color: '#6CC72E',
                            thickness: '40%'
                        },
                        {
                            from: 1,
                            to: 1.5,
                            color: '#6EE91B', // green
                            thickness: '40%'
                        },
                        {
                            from: 1.5,
                            to: 2,
                            color: '#BDFD3C', // yellow
                            thickness: '40%'
                        }, {
                            from: 2,
                            to: 2.5,
                            color: '#E5FF77', // green
                            thickness: '40%'
                        },
                        {
                            from: 2.5,
                            to: 3,
                            color: '#F8FF0D',// red
                            thickness: '40%'
                        }, {
                            from: 3,
                            to: 3.5,
                            color: '#FFA70D', // green
                            thickness: '40%'
                        },
                        {
                            from: 3.5,
                            to: 4,
                            color: '#F97A25', // yellow
                            thickness: '40%'
                        }, {
                            from: 4,
                            to: 4.5,
                            color: '#F25222', // green
                            thickness: '40%'
                        }, {
                            from: 4.5,
                            to: 5,
                            color: '#F93E1B',
                            thickness: '40%'
                        }]
                    },

                    series: [{
                        name: 'Rating ',
                        data: [gaugeval],
                        options: {
                            dial: {
                                radius: Math.random() * 2000
                            },
                        },
                    }]

                });
                function redrawchart1() {
                    var chart = $('#container3').highcharts();

                    var w = $('#container3').closest(".wrapper").width()
                    chart.setSize(
                        w, w * (2 / 4), false
                    );
                }
                $(window).resize(redrawchart1);
                redrawchart1();

            },
        });
    }


<script>
    $(document).ajaxStart(function () {
        $('#LoadingPanel1').css('display', 'block');
    }).ajaxComplete(function () {
        $('#LoadingPanel1').css('display', 'none');
    });
    $(document).ready(function () {

        var id = getParameterByName('id');
        var DecriptData = Decrypt([id]);
        $("#hdnclientid").val(DecriptData[0]);

        var ClientID = $("#hdnclientid").val();

        BindallDropdown();
        ByDesigntype(ClientID, "All", "All");
        ByHeight(ClientID, "All", "All");
        ByDRating(ClientID, "All", "All");
        ByDRatingbar(ClientID, "All", "All");
        ddlJobbind(ClientID, "All", "All");
        //var a = $('rect.highcharts-label-box.highcharts-data-label-box').parent().attr();
        Changesite();
    });

    function Changesite() {
        var site = $("#ddlSite").val();
        var ClientID = $("#hdnclientid").val();
        ByDesigntype(ClientID, "All", site);
        ByHeight(ClientID, "All", site);
        ByDRating(ClientID, "All", site);
        ByDRatingbar(ClientID, "All", site);
        ddlJobbind(ClientID, site);
    }

    function selectarea() {
        var ClientID = $("#hdnclientid").val();
        var ddlselectarea = $("#ddlarea").val();
        var site = $("#ddlSite").val();
        ByDesigntype(ClientID, ddlselectarea, site);
        ByHeight(ClientID, ddlselectarea, site);
        ByDRating(ClientID, ddlselectarea, site);
        ByDRatingbar(ClientID, ddlselectarea, site);
    }

    function BindallDropdown() {
        var id = $("#hdnclientid").val();
        var UID = getParameterByName('UID');
        $.ajax({
            type: "POST",
            url: "/SiteAnalysisDashboard/BindallDropdown",
            data: JSON.stringify({ id: id, UID: UID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                var SiteData = response;
                var SiteLocId = "";
                $("#ddlSite").html("");

                // $("#ddlSite").append('<option value="All">All</option>');
                // $.each(response, function (idx, obj) {

                // if (obj != null) {
                for (var i = 0; i < SiteData.length; i++) {
                    SiteLocId = SiteData[i].SiteLocID;
                    if (SiteLocId == 0) {
                        SiteLocId = "All";
                    }
                    // $("#ddlSite").append('<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>');

                    $("#ddlSite").append("<option value='" + SiteLocId + "'>" + SiteData[i].SiteLocation + "</option>");
                }
                // }
                // });

            }
        });
    }

    function ddlJobbind(id, SiteId) {
        //var ddlsite = ("#ddlSite").val();

        $.ajax({
            type: "POST",
            //url: "../WebApi/Dashboard.asmx/ddlJobDashboard",
            url: "/SiteAnalysisDashboard/ddlJobDashboard",
            data: JSON.stringify({ id: id, SiteId: SiteId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // var ddlJobdropdownbind = response.d;
                var ddlJobdropdownbind = response;
                //alert(ddllocationSitedropdownbind.length);

                $("#ddlarea").html("");
                $("#ddlarea").append('<option value="All">All</option>');
                for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                    siteLocid = ddlJobdropdownbind[0].areaid;
                    $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].areaid + '">' + ddlJobdropdownbind[i].area + '</option>');

                }
            }
        });

    }

    /// Chart 1
    function ByDesigntype(ID, Job, Site) {
        $('.forRemoveData1').remove();
        $.ajax({
            type: "POST",
            // url: "../WebApi/Dashboard.asmx/SiteAnalysisByDType",
            url: "/SiteAnalysisDashboard/SiteAnalysisByDType",
            data: JSON.stringify({ id: ID, site: Site, jobid: Job }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // SiteStructure = response.d;
                SiteStructure = response;
                var Design = [];
                var SiteAnalysis = [];
                var TotalCount = [];
                var noofrow = 20;
                if (SiteStructure.length < 20) {
                    noofrow = SiteStructure.length;
                }
                if (SiteStructure.length > 0) {
                    for (var i = 0; i < noofrow; i++) {
                        var TobePush = true;


                        if (TobePush) {
                            SiteAnalysis.push({ name: SiteStructure[i].designtype, y: SiteStructure[i].rquantity, sliced: true });

                            Design.push(SiteStructure[i].designtype);
                            TotalCount.push(SiteStructure[i].rquantity);
                        }

                    }
                }

                var theExportOptions = Highcharts.getOptions().exporting.buttons.contextButton.menuItems;
                theExportOptions.splice(0, 1);
                theExportOptions.splice(5, 10);


                Highcharts.chart('container1', {
                    chart: {
                        type: 'bar',
                        backgroundColor: '#f2f2f2'
                    },
                    title: {
                        align: 'left',
                        text: 'Standing Scaffold by Design Type'
                    },
                    subtitle: {
                        text: ''
                    },
                    xAxis: {
                        categories: Design,
                        title: {
                            text: null
                        }
                    },
                    yAxis: {
                        min: 0,
                        title: {
                            text: '',
                            align: 'high'
                        },
                        labels: {
                            overflow: 'justify'
                        }
                    },
                    tooltip: {
                        shared: true,
                        formatter: function () {
                            return this.x + ', ' + this.y;
                        }
                    },
                    plotOptions: {
                        bar: {
                            dataLabels: {
                                enabled: true,
                                color: 'black'
                            }
                        }
                    },
                    navigation: {
                        buttonOptions: {
                            verticalAlign: 'top',
                            y: -12,
                        }
                    },
                    exporting: {
                        buttons: {

                            contextButton: {
                                enabled: true,
                                x: 9,
                                //menuItems: Highcharts.getOptions().exporting.buttons.contextButton.menuItems.splice(2,5)
                            },

                            exportButton: {
                                //x: -28,
                                onclick: function () {
                                    $('#Model1').click();
                                },
                                //symbol: 'circle'
                                text: 'Show All'
                            }
                        }


                    },
                    credits: {
                        enabled: false
                    },
                    series: [{
                        showInLegend: false,
                        data: SiteAnalysis
                    }]
                });
                function redrawchart1() {
                    var chart = $('#container1').highcharts();

                    var w = $('#container1').closest(".wrapper").width()
                    chart.setSize(
                        w, w * (4 / 4), false
                    );
                }
                $(window).resize(redrawchart1);
                redrawchart1();
                var row = '';
                // $.each(response.d, function (index, obj) {
                $.each(response, function (index, obj) {
                    var num;
                    // var num = ((obj.TonnageStanding / (totalTonnage)) * 100);
                    num = (obj.PctAllSite1 * 100);

                    var Chart1difficultyrating = obj.Chart1difficultyrating == null ? 0 : obj.Chart1difficultyrating;

                    row += "<tr class='forRemoveData1'><td style='text-align: center;'>" + obj.designtype + "</td><td style='text-align: center;'>" + Chart1difficultyrating + "</td><td style='text-align: center;'>" + obj.rquantity + "</td></tr>";
                });
                $("#tbDetails1 tbody").append(row);
            },
        });
    }


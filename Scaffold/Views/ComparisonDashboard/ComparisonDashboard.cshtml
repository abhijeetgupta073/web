                SiteLocatext = ddlSitedropdownbind[0].SiteLocation;
                $("#hdnSiteID").val(Siteid);

                funGraphLoad();

            }
        });

    }

    function SetStartEndDate() {
        var StartDate = "";
        var CompareFullDate = "";
        var now = new Date();
        var prevMonthLastDate = new Date(now.getFullYear(), now.getMonth(), 0);
        EndDate = getFormattedDate(prevMonthLastDate);
        $('#WeekEnding').val(EndDate);

        if (EndDate != "") {
            var Comparenow = new Date(now.getFullYear(), now.getMonth(), 0); //Commneted on 03june-2021
            var CompareMonthLastDate = new Date(Comparenow.getFullYear(), Comparenow.getMonth(), 0);
            CompareFullDate = getFormattedDate(CompareMonthLastDate);
            $('#ComparisonWeek').val(CompareFullDate);
        }
    }

    function getFormattedDate(InputDate) {
        var Curryear = InputDate.getFullYear();
        var Currmonth = (InputDate.getMonth()).toString();

        var CurrDay = InputDate.getDate().toString();
        CurrDay = CurrDay.length > 1 ? CurrDay : '0' + CurrDay;
        var month = new Array();
        month[0] = "Jan";
        month[1] = "Feb";
        month[2] = "Mar";
        month[3] = "Apr";
        month[4] = "May";
        month[5] = "Jun";
        month[6] = "Jul";
        month[7] = "Aug";
        month[8] = "Sep";
        month[9] = "Oct";
        month[10] = "Nov";
        month[11] = "Dec";
        var CurrmonthName = month[Currmonth];

        return CurrDay + '-' + CurrmonthName + '-' + Curryear;
    }

    function numberWithCommas(value) {
        value = value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return value;

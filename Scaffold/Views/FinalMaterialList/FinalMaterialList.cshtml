<script>
    $(document).ready(function () {
        $('#liFinalList').removeClass('active').addClass('active');
        ShowJobInfoDetails();
        GetMaterialFinalizedData();
        $('#txtQuantity').val('@ViewBag.Quantity');
        $('#txtTotalweight').val('@ViewBag.TotalWeight' + '     ' + '(Tonnes)');
    });

    function GetMaterialFinalizedData() {

        $('#LoadingPanel1').show();
        var id = getParameterByName('id');
        var RID = getParameterByName('RID');
        $.ajax({
            type: "POST",
            url: "/FinalMaterialList/GetMaterialFinalizedData",
            data: JSON.stringify({ id: id, RID: RID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                var str = "";
                var Totalstr = "";
                var GetData = response;
                $('#tblFinalMaterialList').DataTable().clear();
                $('#tblFinalMaterialList').DataTable().destroy();

                if (GetData.length > 0) {
                    //$('#Deletefreeze').css('display', 'block');
                    //$('#Print').css('display', 'block');
                    //$('#ExportToCSV').css('display', 'block');
                    for (var i = 0; i < GetData.length; i++) {
                        var optimizedQuantity = GetData[i].optimizedQuantity == null ? "" : GetData[i].optimizedQuantity;
                        var MaterialType = GetData[i].MaterialType == null ? "" : GetData[i].MaterialType;
                        var ItemCode = GetData[i].ItemCode == null ? "" : GetData[i].ItemCode;
                        var ItemDesc1 = GetData[i].ItemDesc == null ? "" : GetData[i].ItemDesc;
                        var ItemDesc = (ItemDesc1.length > 40) ? ItemDesc1.substring(0, 40) + '.....' : ItemDesc1;
                        var ItemWeight = GetData[i].ItemWeight == null ? "" : GetData[i].ItemWeight;
                        var TotalWeight = GetData[i].TotalWeight == null ? "" : GetData[i].TotalWeight;

                        str += "<tr>"
                        str += "<td style='display:none;width:10%'></td>"
                        str += "<td style='width:10%'>" + MaterialType + "</td>"
                        str += "<td style='width:10%'>" + ItemCode + "</td>"
                        str += "<td style='width:10%' title='" + ItemDesc1 + "'>" + ItemDesc1 + "</td>"
                        //str += "<td class='setWidth3' style='display:none' title='" + ItemDesc1 + "'>" + ItemDesc1 + "</td>"
                        str += "<td style='width:10%'>" + optimizedQuantity + "</td>"
                        str += "<td style='width:10%'>" + ItemWeight + "</td>"
                        str += "<td style='width:10%'>" + TotalWeight + "</td>"
                        str += "</tr>";
                    }
                    //ADDED BY S.SOURABH ON 16 MARCH 2023
                    var TotalWeight = $('#txtQuantity').val();
                    var TotalTones = $('#txtTotalweight').val();
                    Totalstr += "<tr>"
                    Totalstr += "<td style='display:none;width:10%'></td>"
                    Totalstr += "<td style='width:10%'>" + '' + "</td>"
                    Totalstr += "<td style='width:10%'>" + '' + "</td>"
                    Totalstr += "<td style = 'Font-weight:bold; margin-left:60px !important; width:40%'>" + 'Total' + "</td>"
                    Totalstr += "<td style = 'Font-weight:bold;width:10%'>" + TotalWeight + "</td>"
                    Totalstr += "<td style = 'Font-weight:bold;width:10%'>" + '' + "</td>"
                    Totalstr += "<td style = 'Font-weight:bold;width:10%'>" + TotalTones + "</td>"
                    Totalstr += "</tr>";

                }
                else {
                    $('#Deletefreeze').css('display', 'none');
                    $('#Print').css('display', 'none');
                    $('#ExportToCSV').css('display', 'none');
                }
                $('#tbodyFinalMaterialList').append(str);
                $('#tblfooter').append(Totalstr);

                $('#LoadingPanel1').hide();
                var table = $('#tblFinalMaterialList').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    "bLengthChange": true,
                    "bInfo": false,
                    //autoWidth: true,
                    scrollX: true,
                   scrollY: true,
                    scrollCollapse: true,   
                    //scrollY: "60vh",
                    "bPaginate": true,
                    dom: 'Bfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Final Material List',
                            exportOptions: {
                                 columns: ':visible'
                               // columns: [1,2,4, 5, 6]
                            }
                        }
                    ],
                });
            }
        })
    }
    function ExportToCSV() {
        $('.dt-button.buttons-csv.buttons-html5').trigger('click');
    }
    function Print_Click() {
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var RID = getParameterByName('RID');


        window.open('/FinalMaterialListReport/showreport?RegisterID=' + RID + '&ClientID=' + id);
    }
    function Deletefreeze_Click() {
        //Added On (24-01-2024) We now want to check that if Register is finalised then you can not delete record.
        var JobStatus = $('#txtstatus').html();
        if (JobStatus == "Completed")
        {
            var Response = { Result: "Failed", Message: "You cannot delete the finalised material list as the job has been completed." }
            CustomAlert(Response);
        }
        else
        {
            $('#deletefreezepopup').css('display', 'block');
        }
        
    }
    function btndltoptimizeyes_Click() {
        $('#LoadingPanel1').show();
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var RID = getParameterByName('RID');
        $.ajax({
            type: "POST",
            url: "/FinalMaterialList/btndltoptimizeyes_Click",
            data: JSON.stringify({ id: id, RID: RID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                if (response.Result = "Success") {
                    CustomAlert(response);
                    window.location.href = '/ScaffoldMaterialListPhase2/ScaffoldMaterialListPhase2?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&RID=' + RID;
                    //  Response.Redirect("ScaffoldMaterialListPhase2.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&RID=" + Request.QueryString["RID"]);
                } else {
                    CustomAlert(response);
                    $('#LoadingPanel1').show();
                }
            }
        })
    }
    function btndltoptimizeno_Click() {
        $('#deletefreezepopup').css('display', 'none');
    }

</script>

 


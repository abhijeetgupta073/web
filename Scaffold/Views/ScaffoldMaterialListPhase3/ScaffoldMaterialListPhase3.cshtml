<div id="divConvertPipeLineJob" class="w3-modal" runat="server" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 161px; width: 387px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey ">
            <h4 class="w3-text-white" id="H1" runat="server"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp;Convert To a Live Job?</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">
                <label runat="server" id="c1">Are you sure  you want to convert this PipeLine Job to a Live Job?.</label>
            </p>
        </div>
        <div class="row">
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12">
                <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4">
                    <label style="font-size: small; margin-left: 45px; margin-top: 3px; ">Built Date </label>

                </div>
                <div class="col-xs-6 col-lg-6 col-md-6 col-sm-6">
                    <div class="input-container">
                        <input type="text" id="BuildDate" class="form-control" readonly />
                        <span class="calendar-icon ClassA">
                            <i class="fa fa-calendar" aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class=" row" style="padding-bottom: 20px;">
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px; margin-left: 106px; ">
                <a class="w3-btn w3-green w3-hover-dark-grey" onclick="ConvertPipeLineJobyes()"
                   id="btndeleteyes"><i class="glyphicon glyphicon-ok-circle "></i>&nbsp;Yes</a>
            </div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2">
                <a class="w3-btn nln-bg w3-hover-dark-grey" onclick="ConvertPipeLineJobNo()" id="btndeleteno"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp;No</a>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var ReqDate = $("#txtrequesteddate").val();
        var RequiredDate = $("#txtrequireddate").val();
        if (ReqDate == null || ReqDate == "") {
            $('#txtrequesteddate').val(new Date().DateMonthFormat());
        }
            $("#txtrequesteddate").datepicker({
                dateFormat: 'dd-M-yy',
                // maxDate: 0,
                closeText: 'Close',

            });


        $("#txtrequireddate").datepicker({
            dateFormat: 'dd-M-yy',
            // maxDate: 0,
            closeText: 'Close',
        });

    //$(document).ready(function () {
    //    var ReqDate = $("#txtrequesteddate").val();
    //    var RequiredDate = $("#txtrequireddate").val();

    //    if (!ReqDate) {
    //        $('#txtrequesteddate').val(new Date().DateMonthFormat());
    //        $("#txtrequesteddate").datepicker({
    //            dateFormat: 'dd-M-yy',
    //            // maxDate: 0,
    //            closeText: 'Close',
    //        });
    //    }

        //if (!RequiredDate) {
        //    $('#txtrequireddate').val(new Date().DateMonthFormat());
        //    $("#txtrequireddate").datepicker({
        //        dateFormat: 'dd-M-yy',
        //        // maxDate: 0,
        //        closeText: 'Close',
        //    });
        //}


        dropdownSupplier();
        @*setTimeout(function () {
            $('#ddlSupplier').val('@Model.Supplier');
        }, 500)*@
        var UserRole = getParameterByName('UserRole');
        var DecUserRole = parseInt(Decrypt(UserRole));
        if (DecUserRole == 75) {
            $('#AnchorYardInventory').css('display', 'none');
            $('#AnchorDepotInventory').css('display', 'none');
            $('#AnchorSiteInventory').css('display', 'none');
        }

        var from = getParameterByName('from');
        var To = getParameterByName('To');

        var DecriptData = [from, To];
        var DecrData = Decrypt(DecriptData);
        var from = DecrData[0];
        var To = DecrData[1];

        $('#hdnfrom').val(from);
        $('#hdnTo').val(To);


    });

    function dropdownSupplier() {
        var id = getParameterByName('id');
        $.ajax({
            type: "POST",
            url: "/SiteRequest/dropdownSupplier",
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                var GetData = response;
                if (GetData.length > 0) {
                    $("#ddlSupplier").append('<option value=""></option>');
                    for (var i = 0; i < GetData.length; i++) {
                        $("#ddlSupplier").append("<option value='" + GetData[i].Supplier + "'>" + GetData[i].Supplier + "</option>");

                    }

                }
                var Supplier = '@Model.Supplier';
                Supplier = Supplier.replace('&#39;', "'")
                if (Supplier != "") {
                   // $('#ddlSupplier').val('@Model.Supplier');
                    $("#ddlSupplier option:contains(" + Supplier + ")").attr('selected', 'selected');
                }
            }
        })
    }
</script>

    @@-webkit-keyframes zoom {
        from {
            -webkit-transform: scale(1)
        }

        to {
            -webkit-transform: scale(2)
        }
    }

    @@keyframes zoom {
        from {
            transform: scale(0.4)
        }

        to {
            transform: scale(1)
        }
    }

    @@-webkit-keyframes zoom-out {
        from {
            transform: scale(1)


@{
    ViewBag.Title = "SecurityCode";
    Layout = null;
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>SCAFPAC</title>
    @*<link rel="icon" href="~/images/TopLogofavicon.png?v=2"/>*@
    @*<link rel="icon" type="image/x-icon" href="/images/TopLogofavicon.png?v=@DateTime.Now.Ticks" />*@
    <link rel="icon" href="~/images/TopLogofavicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/content/css/w3.css" rel="stylesheet" />
    <link href="~/content/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/content/js/jquery.min.js"></script>
    <script src="~/content/js/bootstrap.min.js"></script>
    <link href="~/content/fonts/css/font-awesome.min.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            $('#hdnid').val('@ViewBag.id');
            $('#hdnUID').val('@ViewBag.UID');
            $('#hdnUserRole').val('@ViewBag.UserRole');
            $('#hdnSecurityCode').val('@ViewBag.SecurityCode');
            $('#hdnTimeOffSet').val(new Date().getTimezoneOffset());
        });
        function btnSubmit_Click() {
            var hdnTimeOffSet = $('#hdnTimeOffSet').val();
            var txtSecurytiCode = $('#txtSecurytiCode').val();
            var id = $('#hdnid').val();
            var UID = $('#hdnUID').val();
            var UserRole = $('#hdnUserRole').val();
            var SecurityCode = $('#hdnSecurityCode').val();
            // $('#LoadingPanel1').show();
            $.ajax({
                type: "POST",
                url: "/SecurityCode/btnSubmit_Click",
                data: { SecurityCode: SecurityCode, txtSecurytiCode: txtSecurytiCode, hdnTimeOffSet: hdnTimeOffSet },
                async: true,
                success: function (response) {
                    var GetData = response;
                    if (response.Result == "Success") {
                        if (response.Message == "RedirectToRegisterList") {
                            window.location.href = '/RegisterList/RegisterList?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id;
                        }
                        if (response.Message == "RedirectToInventoryManagement") {
                            window.location.href = '/InventoryManagement/InventoryManagement?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id;
                        }
                        if (response.Message == "RedirectToTermsNcondition") {
                            var Form="null";
                            window.location.href = '/TermsNcondition/TermsNcondition?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&From=' + Form;
                        }
                    } else {
                        $('#art1').removeClass('alert w3-green w3-card-4').addClass('alert w3-red w3-card-4');
                        $('#art1').css("display", "block");
                        $('#alertlabel').html('<strong>Alert ! </strong>' +response.Message);
                    }
                }
            });
        }

        function btnCancel_Click() {
            //Redirect To Login Page
            // window.location.href = '/Login/Login';
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                url: '/SecurityCode/LogOutClick',
                success: function (response) {
                    if (response.Result == "SessionOut") {
                        window.location.href = '/Login/Login';
                    }

                }
            });
        }

    </script>
    <style type="text/css">

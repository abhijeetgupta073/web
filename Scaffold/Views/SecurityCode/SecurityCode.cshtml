                                                <div style="width: 100%;">
                                                    @*<img src="/images/Logo.png" width="90%" style="margin-left: 5%; height: 150px" class="img-responsive" />*@
                                                    <img src="/images/Logo.png" width="90%" style="margin-left: 5%; height: 150px" class="img-responsive"/>
                                                </div>
                                            </div>
                                        </div>
                                    </header>
                                    <div class="container-fluid">
                                        <div style="display: none; width: 100%;" id="art1">

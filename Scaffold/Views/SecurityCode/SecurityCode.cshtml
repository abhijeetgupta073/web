                                                    <input type="text" ID="txtSecurytiCode" placeholder="Enter your Security Code" Class="form-control input-sm" />
                                                    @*<asp:TextBox ID="txtSecurytiCode" runat="server" placeholder="Enter your Security Code" CssClass="form-control input-sm"></asp:TextBox>*@
                                                </div>
                                                <div id="btngrp" class="form-group">

        function ByLongTermDesignClick(DesignType, ID, Site, SubOwner, ddlarea) {
            $('.forRemoveDataAction').remove();
            $.ajax({
                type: "POST",
                url: "/LongTermStructureDashboard/LongTermDesignClick",
                data: JSON.stringify({ DesignType: DesignType, ID: ID, Site: Site, SubOwner: SubOwner, ddlarea: ddlarea }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var DesignAction = response;
                    var DesignData = [];
                    if (DesignAction.length > 0) {
                        for (var i = 0; i < DesignAction.length; i++) {
                            var TobePush = true;
                            if (TobePush) {

                                DesignData.push({ name: DesignAction[i].ScaffRefAction, y: DesignAction[i].DescriptionAction, z: DesignAction[i].Location, s: DesignAction[i].BuildingNo, r: DesignAction[i].assetId, x: DesignAction[i].FloorLevel, a: DesignAction[i].DesignType, b: DesignAction[i].MaterialType, c: DesignAction[i].PreparationHrs, d: DesignAction[i].RiskRating, sliced: true });
                            }
                        }
                    }
                    $('#btnOpenModelAllDetails').click();
                    $("#lblAction").text(DesignType);
                    $("#labelaction").val(DesignType);
                    var row1 = '';
                    $.each(response, function (index, obj) {
                        row1 += "<tr class='forRemoveDataAction'><td style='text-align: center;font-size: 12px;'>" + obj.ScaffRefAction + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DescriptionAction + "</td><td style='text-align: center;font-size: 12px;'>" + obj.Location + "</td><td style='text-align: center;font-size: 12px;'>" + obj.BuildingNo + "</td><td style='text-align: center;font-size: 12px;'>" + obj.assetId + "</td><td style='text-align: center;font-size: 12px;'>" + obj.FloorLevel + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DesignType + "</td><td style='text-align: center;font-size: 12px;'>" + obj.MaterialType + "</td><td style='text-align: center;font-size: 12px;'>" + Highcharts.numberFormat(obj.PreparationHrs, 2) + "</td><td style='text-align: center;font-size: 12px;'>" + obj.RiskRating + "</td></tr>";
                    });
                    $("#tbDetails3 tbody").append(row1);
                }
            });

        }

        function ByDesigntype(ID, Site, SubOwner, ddlarea) {
            $('.forRemoveData2').remove();
            $.ajax({
                type: "POST",
                url: "/LongTermStructureDashboard/ScaffoldDesignType",
                data: JSON.stringify({ id: ID, site: Site, SubOwner: SubOwner, ddlarea: ddlarea }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // SiteStructure = response.d;
                    SiteStructure = response;
                    var Design = [];
                    var SiteAnalysis = [];
                    var TotalCount = [];
                    var noofrow = 20;
                    if (SiteStructure.length < 20) {
                        noofrow = SiteStructure.length;
                    }
                    if (SiteStructure.length > 0) {
                        //$('.forRemoveData2').remove();
                        for (var i = 0; i < noofrow; i++) {

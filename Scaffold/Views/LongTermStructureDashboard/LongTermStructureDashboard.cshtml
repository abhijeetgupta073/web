    $(document).ready(function () {
        $("[id$=myButtonControlID]").click(function (e) {
            var uri = 'data:application/vnd.ms-excel;base64,',
            template = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>{worksheet}</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>{table}</table></body></html>',
              base64 = function (s) {
                  return window.btoa(unescape(encodeURIComponent(s)))
              },
        format = function (s, c) {
            return s.replace(/{(\w+)}/g, function (m, p) {
                return c[p];
            })
        }

            var toExcel = "";
            toExcel += document.getElementById("tbDetails3").innerHTML;
            var ctx = {
                worksheet: name || '',
                table: toExcel
            };
            var link = document.createElement("a");
            link.download = "Long Term Scaffolds By Design Type set as " + $("#lblAction").text() + ".xls";
            link.href = uri + base64(format(template, ctx))
            link.click();
        });

    });


    function ddlSitebind(id, ClientID) {
        $.ajax({
            type: "POST",
            url: "/LongTermStructureDashboard/ddlsitedropdownbindquery",
            data: JSON.stringify({ id: id, ClientID: ClientID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var ddlSitedropdownbind = response;
                var Siteid = "";
                var SiteLocatext = "";
                $("#ddlSite").html("");
                for (var i = 0; i < ddlSitedropdownbind.length; i++) {
                    Siteid = ddlSitedropdownbind[0].SiteLocID;
                    SiteLocatext = ddlSitedropdownbind[0].SiteLocation;
                    $("#ddlSite").append('<option value="' + ddlSitedropdownbind[i].SiteLocID + '">' + ddlSitedropdownbind[i].SiteLocation + '</option>');


                }
                //ddlDisciplinesbind(Siteid, ClientID);
                //SiteData(Siteid, ClientID,"all");
                ddlJobbind(ClientID, Siteid);
                ddlDisciplinesbind(Siteid, ClientID,"all");
                SiteData(Siteid, ClientID, "all","all");
                $("#hdnSiteID").val(Siteid);
                $("#lblLockedSite").text(SiteLocatext);
            }
        });

    }

    function ddlJobbind(id, SiteId) {

        $.ajax({
            type: "POST",
            url: "/LongTermStructureDashboard/ddlJobDashboard",
            data: JSON.stringify({ id: id, SiteId: SiteId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var ddlJobdropdownbind = response;

                $("#ddlarea").html("");
                $("#ddlarea").append('<option value="all">All</option>');
                for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                    siteLocid = ddlJobdropdownbind[0].areaid;
                    $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].areaid + '">' + ddlJobdropdownbind[i].area + '</option>');

                }
            }
        });

    }

    function ddlDisciplinesbind(Siteid, ClientID,LocId) {
        $.ajax({

            type: "POST",
            url: "/LongTermStructureDashboard/ddlDisciplinesdropdownbindquery",
            data: JSON.stringify({ Siteid: Siteid, ClientID: ClientID,LocId:LocId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var ddlDisciplinesdropdownbind = response;
                var ScaffoldOwner = "";
                $("#ddlDisciplines").html("");
                $("#ddlDisciplines").append('<option value="all">All</option>');
                for (var i = 0; i < ddlDisciplinesdropdownbind.length; i++) {
                    ScaffoldOwner = ddlDisciplinesdropdownbind[0].ScaffoldOwner;
                    $("#ddlDisciplines").append('<option value="' + ddlDisciplinesdropdownbind[i].ScaffoldOwner + '">' + ddlDisciplinesdropdownbind[i].ScaffoldOwner + '</option>');

                }
            }
        });

    }

    function CycloneHours(Siteid, ClientID, SubOwner, ddlarea) {
         $.ajax({
             type: "POST",
             url: "/LongTermStructureDashboard/CycloneHours",
             data: JSON.stringify({ Siteid: Siteid, ClientID: ClientID, SubOwner: SubOwner,ddlarea : ddlarea}),
             contentType: "application/json; charset=utf-8",
             dataType: "json",
             success: function (response) {
                 var CycloneDetails = response.PreparationHrs;
                 if (CycloneDetails != null && CycloneDetails != "") {
                     $("#txtCyclone").val(CycloneDetails);
                 }
                 else {
                     $("#txtCyclone").val("0.00");
                 }
                 var LongTermTonnage = $('#txtLongTermTonnage').val();
                 var TotalTonnage = $('#txtTotalTonnage').val();

                 if ((LongTermTonnage != "0.00") && (TotalTonnage != "0.00")) {
                     $("#txtPercentageWeight").val(((LongTermTonnage / TotalTonnage) * 100).toFixed(2));
                 }
                 else {
                     $("#txtPercentageWeight").val("0.00 %");
                 }
                

             }
    
         });
    }


    function SiteData(Siteid, ClientID,SubOwner, ddlarea) {

            $.ajax({
                type: "POST",
                url: "/LongTermStructureDashboard/SiteDetails",
                data: JSON.stringify({ Siteid: Siteid, ClientID: ClientID, SubOwner: SubOwner, ddlarea: ddlarea }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var SitedataDetails = response;
                    if (SitedataDetails.length > 0) {
                        $("#ErrectedScaffolds").val(SitedataDetails[0]["GraphName"]);
                        $("#txtTotalQty").val(SitedataDetails[0]["StandingScaffold"]);
                        $("#txtTotalTonnage").val(SitedataDetails[0]["StandingTonnage"]);
                        $("#txtTotalPacTonnage").val(SitedataDetails[0]["ATPACTonnage"]);
                        $("#txtTotalTube").val(SitedataDetails[0]["TubeFitTonnage"]);
                        $("#txtTotalAvSatnding").val(SitedataDetails[0]["AvgHireDays2"]);
                        $("#txtTotalOthers").val(SitedataDetails[0]["OtherTonnage"]);
                        $("#ErrectedScaffolds").val(SitedataDetails[1]["GraphName"]);
                        $("#txtLongTermQty").val(SitedataDetails[1]["StandingScaffold"]);
                        $("#txtLongTermTonnage").val(SitedataDetails[1]["StandingTonnage"]);
                        $("#txtLongTermPacTonnage").val(SitedataDetails[1]["ATPACTonnage"]);
                        $("#txtLongTermTube").val(SitedataDetails[1]["TubeFitTonnage"]);
                        $("#txtLongTermAvSatnding").val(SitedataDetails[1]["AvgHireDays2"]);
                        $("#txtLongTermOthers").val(SitedataDetails[1]["OtherTonnage"]);

                        //AllGraphDashboard(Siteid, ClientID, "QuantityGraph", "all");
                        //AllGraphLongDashboard(Siteid, ClientID, "TonnageGraph", "all");
                        //ByDesigntype(ClientID, Siteid, "all");
                        //CycloneHours(Siteid, ClientID, "all");
                        AllGraphDashboard(Siteid, ClientID, "QuantityGraph", SubOwner, ddlarea);
                        AllGraphLongDashboard(Siteid, ClientID, "TonnageGraph", SubOwner, ddlarea);
                        ByDesigntype(ClientID, Siteid, SubOwner, ddlarea);
                        CycloneHours(Siteid, ClientID, SubOwner, ddlarea);

                    }

                }

            });
        }


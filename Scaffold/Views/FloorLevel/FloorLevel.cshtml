<script>
    $(function () {
        var from = getParameterByName('from');
        if (from != null) // check Come From Job From 
        {
            //btnbacktoFloorGallery.Visible = true;
            $('#btnbacktoFloorGallery').css('display', 'block');
        }


        ddlSiteDropdown();
        GetFloorLevel();

        //$('#ddlSitesLoc').change(function () {
           
        //});

        $('#ddlLocaSite').change(function () {
            var ddlLocationId = $(this).children("option:selected").val();
            ddlBuildingLoc(ddlLocationId);
            GetFloorLevel();
        });

        $('#ddlBuilding').change(function () {
            GetFloorLevel();
        });
    });

    function ddlSitesLocation() {
        SetCategory();
        ddlBuildingLoc();
        dropdownlocation();
        GetFloorLevel();
    }
    
    function ddlSiteDropdown()
    {
        var id = getParameterByName('id');
        $.ajax({
            url: '/FloorLevel/ddlSiteDropdown',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                data = response;
                var optionAppend = "<option value='0'>Select Site</option>";
                $.each(data, function (index, obj) {
                    optionAppend += "<option value=" + obj.SiteLocID + ">" + obj.SiteLocation + "</option>";
                });
                $('#ddlSitesLoc').empty().append(optionAppend);
            }
        });
    }

    function dropdownlocation() {
        var id = getParameterByName('id');
        let ddlSitesLoc = $('#ddlSitesLoc').val();
        $.ajax({
            url: '/FloorLevel/dropdownlocation',
            type: 'POST',
            data: JSON.stringify({ id: id, ddlSitesLoc: ddlSitesLoc }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                data = response;
                var optionAppend = "<option value='0'>Select Location</option>";
                $.each(data, function (index, obj) {
                    optionAppend += "<option value=" + obj.AreaID + ">" + obj.area + "</option>";
                });
                $('#ddlLocaSite').empty().append(optionAppend);
            }
        });
    }

    function ddlBuildingLoc(ddlLocationId) {
        var id = getParameterByName('id');
       // let ddlLocationId = $('#ddlLocaSite').val();
        $.ajax({
            url: '/FloorLevel/ddlBuildingLoc',
            type: 'POST',
            data: JSON.stringify({ id: id, ddlLocationId: ddlLocationId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                data = response;
                var optionAppend = "<option value='0'>Select Building</option>";
                $.each(data, function (index, obj) {
                    optionAppend += "<option value=" + obj.buildingid + ">" + obj.buildingno + "</option>";
                });
                $('#ddlBuilding').empty().append(optionAppend);
            }
        });
    }


    function SetCategory() {
        let ddlSitesLoc = $('#ddlSitesLoc').val();
        $.ajax({
            url: '/FloorLevel/ddlSites',
            type: 'POST',
            data: { ddlSitesLoc: ddlSitesLoc },
            async: false,
            success: function (response) {
                if (response != null) {
                    $('#txtboxCategory').val(response);
                }
            }
        });
    }

    let Status = '';
    function GetFloorLevel() {

        var str = "";

        str += '<table id="dataforgrid" class="table table-striped display" style="width:100%;table-layout:fixed;font-size:12px">';
        str += "<thead><tr>";
        str += "<th style='width:5%'>#</th>";
        str += "<th  style='text-align:center;display:none'>FloorLevelId</th>";
        str += "<th  style='text-align:center;display:none'>Category</th>";
        str += "<th  style='text-align:center;display:none'>Site Location</th>";
        str += "<th  style='text-align:center;width:20%'>Floor Level</th>";
        str += "<th  style='text-align:center;width:20%'>Sort Order</th>";
        str += "<th  style='text-align:center;width:20%'>Status</th></tr></thead><tbody>";

        var id = getParameterByName('id');
        let siteId = $('#ddlSitesLoc').val();
        siteId = siteId == null ? '' : siteId;
        let locationId = $('#ddlLocaSite').val();
        locationId = locationId == null ? '' : locationId;
        let buildingId = $('#ddlBuilding').val();
        buildingId = buildingId == null ? '' : buildingId;
        let categoryValue = $('#txtboxCategory').val();
        $.ajax({
            url: '/FloorLevel/GetFloorLevelData',
            type: 'POST',
            data: JSON.stringify({ id: id, SiteID: siteId, ddlLocaSite: locationId, ddlBuilding: buildingId, CategoryValue: categoryValue}),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                var getdata = response;
                str += "<tr id='row_9999' style='display:none'><td  style='width:10%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                str += "<td  style='text-align:center;display:none'>0</td>";
                str += "<td  style='text-align:center;display:none'></td>";
                str += "<td  style='text-align:center;display:none'></td>";
                str += "<td  style='text-align:center;width:20%'></td>";
                str += "<td  style='text-align:center;width:10%'></td>";
                str += "<td  style='text-align:center;width:10%'></td></tr>";

                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var FloorLevelId = getdata[i].FloorLevelId == null ? "" : getdata[i].FloorLevelId;
                        var FloorLevel = getdata[i].FloorLevel == null ? "" : getdata[i].FloorLevel;
                        var FloorLevelStatus = getdata[i].FloorLevelStatus == null ? "" : getdata[i].FloorLevelStatus;
                        var SortOrder = getdata[i].SortOrder == null ? "" : getdata[i].SortOrder;
                        var SiteLocation = getdata[i].SiteLocation == null ? "" : getdata[i].SiteLocation;
                        var Category = getdata[i].Category == null ? "" : getdata[i].Category;
                        //if (i == 0) {
                        //    str += "<tr id='row_9999' style='display:none'><td  style='width:10%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                        //    str += "<td  style='text-align:center;display:none'>0</td>";
                        //    str += "<td  style='text-align:center;width:20%'></td>";
                        //    str += "<td  style='text-align:center;width:10%'></td>";
                        //    str += "<td  style='text-align:center;width:10%'></td></tr>";
                        //}

                        str += "<td  style='width:10%;'><a id='rowpencil' class='expand fa fa-pencil'></a>&nbsp;&nbsp;<a id='rowdelete' class='fa fa-trash'></a></td>";
                        str += "<td  style='text-align:center;display:none'>" + FloorLevelId + "</td>";
                        str += "<td  style='text-align:center;display:none'>" + Category + "</td>";
                        str += "<td  style='text-align:center;display:none'>" + SiteLocation + "</td>";
                        str += "<td  style='text-align:center;width:20%'>" + FloorLevel + "</td>";
                        str += "<td  style='text-align:center; width:10%'>" + SortOrder + "</td>";
                        str += "<td  style='text-align:center;width:10%'>" + FloorLevelStatus + "</td></tr>";
                    }
                    //str += "</tbody></table>";
                    //$("#loaddata").html(str);

                    $("#LoadingPanel1").css("display", "none");

                    //$(".fa-trash").click(function () {
                    //    var designType = $(this).parent().parent().children()[1].innerText;
                    //    $("#hdnFloorLevelId").val(designType);
                    //    $("#Deletemodal").css("display", "block");
                    //});

                    //$(".fa-pencil").click(function () {
                    //    var visible = $(this).parent().parent().hasClass("Edit");
                    //    var tr = $(this).closest('tr');
                    //    var row = table.row(tr);
                    //    if (visible == true) {
                    //        $(this).parent().parent().next('tr').remove();
                    //        $(this).parent().parent().removeClass('Edit');
                    //    }
                    //    else {
                    //        row.child(Editing(row.data())).show();
                    //        $('#ddlStatus').val(Status);
                    //        row.child.show();
                    //        tr.addClass('Edit');
                    //    }
                    //});

                }
                str += "</tbody></table>";
                $("#loaddata").html(str);
                var table = $('#dataforgrid').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    info: false,
                    "pageLength": 50,
                    autoWidth: true,
                    scrollX: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    fixedHeader: true,
                    fixedColumns: {
                        leftColumns: 11,
                    },

                    dom: 'lBfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'FloorList',
                            exportOptions: {
                                columns: [2, 3, 4,5,6]
                            }
                        }
                    ],


                    initComplete: function () {
                        this.api();
                        $("#dataforgrid_length").children().html('<button id="btnaddFloorLevel"  type="button" class="w3-btn w3-teal fa fa-plus" style="margin-bottom:-43px;">&nbsp;Add New Floor Level</button><button id="btnExport" type="button" class="w3-btn w3-teal Export" style="margin-left:180px;height:26px;padding-top:3px;"><i class="fa fa-file-excel-o"></i>&nbsp;Export to CSV</button>');

                        $("#btnaddFloorLevel").click(function () {
                            if (ValidateInactiveSite()) return false;
                            $(".fa-trash").click(function () {
                                if (ValidateInactiveSite()) return false;
                                var designType = $(this).parent().parent().children()[1].innerText;
                                $("#hdnFloorLevelId").val(designType);
                                $("#Deletemodal").css("display", "block");
                            });
                            if ($('#ddlSitesLoc').val() != 0) {
                                if ($('#txtboxCategory').val() == "Floor Level") {
                                    if ($('#ddlLocaSite').val() != 0) {
                                        if ($('#ddlBuilding').val() != 0) {
                                            var trow1 = $(this).parent().parent().siblings();
                                            var trow = $(this).parent().parent().siblings()[2].childNodes[0];
                                            var row = table.row(trow);
                                            var c = 0;
                                            row.child(Editing(c)).show();
                                        } else {
                                            var Response = { Result: "Failed", Message: "Please Select Building ." };
                                            CustomAlert(Response);
                                        }
                                    } else {
                                        var Response = { Result: "Failed", Message: "Please Select Location ." };
                                        CustomAlert(Response);
                                    }
                                } else {
                                    var trow1 = $(this).parent().parent().siblings();
                                    var trow = $(this).parent().parent().siblings()[2].childNodes[0];
                                    var row = table.row(trow);
                                    var c = 0;
                                    row.child(Editing(c)).show();
                                }
                               
                            } else {
                                var Response = { Result: "Failed", Message: "Please Select Site ." };
                                CustomAlert(Response);
                            }

                         

                        });

                        $(".fa-trash").click(function () {
                            if (ValidateInactiveSite()) return false;
                            var designType = $(this).parent().parent().children()[1].innerText;
                            $("#hdnFloorLevelId").val(designType);
                            $("#Deletemodal").css("display", "block");
                        });

                        $(".fa-pencil").click(function () {
                            if (ValidateInactiveSite()) return false;
                            var visible = $(this).parent().parent().hasClass("Edit");
                            var tr = $(this).closest('tr');
                            var row = table.row(tr);
                            if (visible == true) {
                                $(this).parent().parent().next('tr').remove();
                                $(this).parent().parent().removeClass('Edit');
                            }
                            else {
                                row.child(Editing(row.data())).show();
                                $('#ddlStatus').val(Status);
                                row.child.show();
                                tr.addClass('Edit');
                            }
                        });

                        $(".Export").click(function () {
                            $('.dt-button.buttons-csv.buttons-html5').trigger('click');
                        });
                    },

                    "columnDefs": [
                        { "width": "100px", "targets": 'fullsize' }
                    ],

                });

            }
        });
    }

    function Editing(d) {

        var id = getParameterByName('id');
        $.ajax({

            success: function (response) {

            },
            complete: function () {
                $(".CancelChangeClass").click(function () {
                    $(this).parent().parent().parent().parent().prev('tr').removeClass('Edit');
                    $(this).parent().parent().parent().parent().remove();
                });

                $("#savechange").click(function () {

                    var floorLevelId = $(this).parent().parent().parent().parent().prev('tr').children()[1].innerText;
                    var firstrow = $(this).parent().parent().prev('div').children().find('input[type=text]');
                    var secondrow = $(this).parent().parent().prev('div').children().find('input[type=number]');
                    var sropdownval = $(this).parent().parent().prev('div').children().find('select');

                    var FloorLevel = firstrow[0].value;
                    var SortOrder = secondrow[0].value;
                    var Status = sropdownval[0].value;
                    let txtboxCategory = $('#txtboxCategory').val();
                    let ddlSitesLoc = $('#ddlSitesLoc').val();
                    let ddlLocaSite = $('#ddlLocaSite').val();
                    let ddlBuilding = $('#ddlBuilding').val();
                    ddlBuilding = ddlBuilding == null ? ' ' : ddlBuilding;
                    var id = getParameterByName('id');
                    var UID = getParameterByName('UID');

                    if (FloorLevel != "" && SortOrder != "") {
                        $("#LoadingPanel1").css("display", "block");

                        $.ajax({
                            type: "POST",
                            url: "/FloorLevel/SaveFloorLevelData",
                            data: JSON.stringify({ "FloorTypeId": floorLevelId, "txtFloorLevel": FloorLevel, "NumericTextSortOrder": SortOrder, "ddlStatuss": Status, "txtboxCategory": txtboxCategory, "id": id, "UID": UID, "ddlSitesLoc": ddlSitesLoc, "ddlLocaSite": ddlLocaSite, "ddlBuilding": ddlBuilding }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (response) {
                                var result = response;
                                if (result.Result == 'Success') {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                    GetFloorLevel();
                                }
                                else {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                }
                                // $('#hdnOldQty').val("");
                            }
                        })
                    } else {
                        var Response = {Result:"Failed",Message:"Please Enter Floor Level and Sort Order."};
                        CustomAlert(Response);
                        $("#LoadingPanel1").css("display", "none");
                        $("#btnsubmit").click();
                    }
                });
            }
        });
        if (d == 0) {
            return '<div class="col-lg-12">'
                + '<div class="col-lg-4">'
                + 'Floor Level <a style="color:red">*</a><input type="text" class="form-control" style="width:100%" required>'
                + '</div><div class="col-lg-4">'
                + 'Sort Order <a style="color:red">*</a><input type="number" class="form-control" style="width:100%" required>'
                + '</div><div class="col-lg-4">'
                + 'Status<select id="ddlStatus" style="width:100%" class="form-control" required><option value="Active">Active</option><option value="InActive">InActive</option></select>'
                + '</div></div>'
                + '<div class="col-lg-12">'
                + '<div class="col-lg-2">'
                + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                + '</div><div class="col-lg-2">'
                + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                + '</div><div class="col-lg-6"></div><div class="col-lg-2">'
                + '<input id="psudouserid" type="text" class="form-control" value="" style="width:1% ; margin-top:6px; float:right;opacity:0" />'
                + '</div></div>'

        }
        else {
            Status = d[6];
            return '<div class="col-lg-12">'
                + '<div class="col-lg-4">'
                + 'Floor Level <a style="color:red">*</a><input type="text" class="form-control" value="' + d[4] + '" style="width:100%" required>'
                + '</div><div class="col-lg-4">'
                + 'Sort Order <a style="color:red">*</a><input type="number" class="form-control" value="' + d[5] + '" style="width:100%" required>'
                + '</div><div class="col-lg-4">'
                + 'Status<select id="ddlStatus" style="width:100%" class="form-control" required><option value="Active">Active</option><option value="InActive">InActive</option></select>'
                + '</div></div>'
                + '<div class="col-lg-12">'
                + '<div class="col-lg-2">'
                + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                + '</div><div class="col-lg-2">'
                + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                + '</div><div class="col-lg-6"></div><div class="col-lg-2">'
                + '<input id="psudouserid" type="text" class="form-control" value="" style="width:1% ; margin-top:6px; float:right;opacity:0" />'
                + '</div></div>'

        }

    }


    function btnyes_Click() {

        var FloorLevelId = $('#hdnFloorLevelId').val();

        $.ajax({
            url: '/FloorLevel/DeleteDocument',
            type: 'post',
            data: { FloorLevelId: FloorLevelId },
            async: false,
            success: function (response) {
                $("#Deletemodal").css("display", "none");
                if (response.Result == 'Success') {
                    CustomAlert(response);
                    GetFloorLevel();
                } else {
                    CustomAlert(response);
                }
            }
        });
    }

    function btnbacktoFloorGallery_Click() { 
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var Clientid = getParameterByName('id');
        var from = getParameterByName('from');
        var RID = getParameterByName('RID');
        window.location.href = '/FloorLevelGallery/FloorLevelGallery?UID=' + UID + '&UserRole=' + UserRole + '&id=' + Clientid + '&from=' +from + '&RID=' + RID;

        //Response.Redirect("FloorLevelGallery.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&from=" + Request.QueryString["from"] + "&RID=" + Request.QueryString["RID"]);
    }
    function ValidateInactiveSite() {
        var siteName = $('#ddlSitesLoc option:selected').text();

        if (siteName && siteName.toLowerCase().includes("(inactive)")) {
            CustomAlert({
                Result: "Failed",
                Message: "This site is InActive. You cannot make any changes."
            });
            return true;
        }

        return false;
    }

</script>


<input type="hidden" id="hdnFloorLevelId" />

<div class="row">
    <div class="col-lg-2 col-md-3 col-sm-4">

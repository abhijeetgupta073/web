        @*<label id="siteddl">Site:</label>*@
        <button id="btnbacktoFloorGallery" style="Width:100%; float: right; display:none;" class="w3-btn w3-small  nln-bg w3-text-white" OnClick="btnbacktoFloorGallery_Click()"> <i class="fa fa-backward"> </i>&nbsp;&nbsp;Back to Floor Gallery</button>

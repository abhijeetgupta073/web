
@{
    ViewBag.Title = "TermsAndConditionType";
}

<style>
    .dt-button.buttons-csv.buttons-html5 {
        display: none;
    }

    #dataforgrid_length {
        margin-top: -16px;
    }
      /*Window Size 67 %*/
        @@media (min-width: 1900px) and (max-width: 2050px) {
           #btnExport{
           margin-bottom:-45px;
           }
        }
</style>

<script>
    $(function () {

        if (document.querySelector('#rdoTerms').checked = true) {
            GetTermsAndCondition();
        }

       
    });

    function forTermAndPolicy(chkRadion) {
        if (chkRadion == 'Terms') {
            GetTermsAndCondition();
        } else {
            GetTermsAndCondition();
        }
    }

    function GetTermsAndCondition() {
     

        $("#LoadingPanel1").css("display", "block");

       
        var id = getParameterByName('id');
        var radioValue = $("input[name='radio']:checked").val();
        $.ajax({
            url: '/TermsAndConditionType/GetTermsAndConditionData',
            type: 'POST',
            data: JSON.stringify({ radioValue: radioValue, id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getdata = response.getData;
                var chkRadiobtn = response.radioValue;
                var str = "";
                str += '<table id="dataforgrid" class="table table-striped display" style="width:0%;table-layout:fixed;font-size:12px">';
                str += "<thead><tr>";
                str += "<th style='width:5%'>#</th>";
                str += "<th style='text-align:center;display:none'>id</th>";
                str += "<th style='text-align:center;width:5%'>Order</th>";
                str += "<th style='text-align:left;width:20%'>Main Point</th>";
                if (chkRadiobtn != 'Terms') {
                    str += "<th style='text-align:center;width:10%' class='clsText'>Text</th>";
                }
                str += "<th style='text-align:left;width:60%; display:none;'>Sub Point</th>";
                str += "<th style='text-align:left;width:60%'>Sub Point</th></tr></thead><tbody>";


                    str += "<tr id='row_9999' style='display:none'><td style='width:2%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                    str += "<td  style='text-align:center;display:none'>0</td>";
                    str += "<td  style='text-align:center;width:5%'></td>";
                    str += "<td  style='text-align:left;width:20%'></td>";
                    if (chkRadiobtn != 'Terms') {
                        str += "<td  style='text-align:center;width:10%' class='clsText'></td>";
                    }
                    str += "<td  style='text-align:left;width:60%; display:none;'></td>";
                    str += "<td  style='text-align:left;width:60%'></td></tr>";
                

                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var id = getdata[i].id == null ? "" : getdata[i].id;
                        var MainPoint = getdata[i].MainPoint == null ? "" : getdata[i].MainPoint;
                        var SubPoint1 = getdata[i].SubPoint == null ? "" : getdata[i].SubPoint;
                        var SubPoint = (SubPoint1.length > 70) ? SubPoint1.substring(0, 70) + '.....' : SubPoint1;
                        var TermOrder = getdata[i].TermOrder == null ? "" : getdata[i].TermOrder;
                        var Text = getdata[i].Text == null ? "" : getdata[i].Text;

                        str += "<td  style='width:2%;display:inline-flex;'><a id='rowpencil' class='expand fa fa-pencil'></a>&nbsp;&nbsp;<a id='rowdelete' class='fa fa-trash'></a></td>";
                        str += "<td  style='text-align:center;display:none'>" + id + "</td>";
                        str += "<td  style='text-align:center;width:5%'>" + TermOrder + "</td>";
                        str += "<td  style='text-align:left;width:20%'>" + MainPoint + "</td>";
                        if (chkRadiobtn != 'Terms') {
                            str += "<td  style='text-align:center; width:10%' class='clsText'>" + Text + "</td>";
                        }
                        str += "<td  style='text-align:left;width:60%; display:none;'>" + SubPoint1 + "</td>";
                        str += "<td  style='text-align:left;width:60%' title='" + SubPoint1 + "'>" + SubPoint + "</td></tr>";
                    }
                   
                }

                str += "</tbody></table>";
                $("#loaddata").html(str);

                $("#LoadingPanel1").css("display", "none");

                $(".fa-trash").click(function () {
                    var TermsAndConditionId = $(this).parent().parent().children()[1].innerText;
                    $("#hdnTermsAndConditionId").val(TermsAndConditionId);
                    $("#Deletemodal").css("display", "block");
                });

                $(".fa-pencil").click(function () {
                    var visible = $(this).parent().parent().hasClass("Edit");
                    var tr = $(this).closest('tr');
                    var row = table.row(tr);
                    if (visible == true) {
                        $(this).parent().parent().next('tr').remove();
                        $(this).parent().parent().removeClass('Edit');
                    }
                    else {
                        row.child(Editing(row.data())).show();
                        row.child.show();
                        tr.addClass('Edit');
                    }
                });

                var table = $('#dataforgrid').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    info: false,
                    "pageLength": 50,
                    autoWidth: true,
                    scrollX: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    fixedHeader: true,
                    fixedColumns: {
                        leftColumns: 11,
                    },

                    dom: 'lBfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Terms of Service',
                            exportOptions: {
                                columns: [2, 3, 4]
                            }
                        }
                    ],


                    initComplete: function () {
                        $(this.api().table().container()).find('input').parent().wrap('<form>').parent().attr('autocomplete', 'off'); // Auto Fill In Text box when ID Or Password Save on Crome Browser
                     // $("#dataforgrid_length").children().html('<button id="btnaddTermAndCondition"  type="button" class="w3-btn w3-teal fa fa-plus" style="margin-bottom:-43px;">&nbsp;Add New Terms and Conditions</button><button id="btnExport" type="button" class="w3-btn w3-teal Export" style="margin-left:237px;height:26px;padding-top:3px">&nbsp;Export to CSV</button>');
                        $("#dataforgrid_length").children().html('<button id="btnaddTermAndCondition"  type="button" class="w3-btn w3-teal fa fa-plus" style="margin-bottom:-43px;">&nbsp;Add New Terms of Service</button><button id="btnExport" type="button" class="w3-btn w3-teal Export" style="margin-left:237px;height:26px;padding-top:3px">&nbsp;Export to CSV</button>');

                        $("#btnaddTermAndCondition").click(function () {

                            var trow1 = $(this).parent().parent().siblings();
                            var trow = $(this).parent().parent().siblings()[2].childNodes[0];
                            // var trow = $(this).parent().parent().siblings()[2].children[1].children[0].children[1].childNodes[0];
                            var row = table.row(trow);
                            var c = 0;
                            row.child(Editing(c)).show();

                        });

                        $(".Export").click(function () {
                            $('.dt-button.buttons-csv.buttons-html5').trigger('click');
                        });
                    },

                    "columnDefs": [
                        { "width": "100px", "targets": 'fullsize' }
                    ],

                    "drawCallback": function () {

                        $('.fa-angle-right').click(function (eve) {
                            eve.stopImmediatePropagation();
                            var tr = $(this).closest('tr');
                            var row = table.row(tr);
                            var visible = $(this).parent().parent().hasClass("shown");
                            var anglechange = $(this).hasClass("fa-angle-right");
                            if (anglechange == true) {
                                var x = tr.children()[0];
                                $(this).removeClass("fa-angle-right");
                                $(this).addClass("fa-angle-down");
                            }
                            else {
                                $(this).addClass("fa-angle-right");
                                $(this).removeClass("fa-angle-down");
                            }
                            if (visible == true) {
                                // This row is already open - close it
                                $(this).parent().parent().next('tr').remove();
                                $(this).parent().parent().removeClass('shown');
                            }
                            else {
                                // Open this row
                                row.child(format(row.data())).show();
                                row.child.show();
                                tr.addClass('shown');
                            }
                        });
                    }

                });

                // scrolling Top when Click On Next Button

                table.on('page.dt', function () {
                    $('.dataTables_scrollBody').animate({
                        scrollTop: 0
                    }, 300);
                });
           }
        });
    }

 
    function Editing(d) {
        var chkradioValue = $("input[name='radio']:checked").val();
        var id = getParameterByName('id');
        $.ajax({

            success: function (response) {

            },
            complete: function () {
                $(".CancelChangeClass").click(function () {
                    $(this).parent().parent().parent().parent().prev('tr').removeClass('Edit');
                    $(this).parent().parent().parent().parent().remove();
                });

                $("#savechange").click(function () {

                    var termsAndConditionId = $(this).parent().parent().parent().parent().prev('tr').children()[1].innerText;
                    var firstrow = $(this).parent().parent().prev('div').children().find('input[type=text]');
                    var firstrow2 = $(this).parent().parent().prev('div').prev('div').children().find('input[type=text]');
                    var firstrow3 = $(this).parent().parent().prev('div').prev('div').prev('div').children().find('textarea');
                  
                    var Order = firstrow2[0].value;
                    var mainPoint = firstrow2[1].value;
                    var subPoint = '';
                    var text = '';
                    if (chkradioValue != 'Terms') {
                        text = firstrow2[2].value;
                        subPoint = $('#subPointId').val();
                    } else {
                        subPoint = $('#subPointId').val();
                    }
                    var id = getParameterByName('id');
                    var UID = getParameterByName('UID');

                    if (mainPoint != "" && subPoint != "") {
                        $("#LoadingPanel1").css("display", "block");

                        $.ajax({
                            type: "POST",
                            url: "/TermsAndConditionType/SaveTermAndCondition",
                            data: JSON.stringify({ "termsAndConditionId": termsAndConditionId, "Order": Order, "mainPoint": mainPoint, "text": text, "subPoint": subPoint, "chkradioValue": chkradioValue, "id": id, "UID": UID }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (response) {
                                var result = response;
                                if (result.Result == 'Success') {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                    GetTermsAndCondition();
                                }
                                else {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                }
                                // $('#hdnOldQty').val("");
                            }
                        })
                    } else {
                        var Response = { Result: "Failed", Message: "Please Enter All Mandatory Field." };
                        CustomAlert(Response);
                        $("#LoadingPanel1").css("display", "none");
                        $("#btnsubmit").click();
                    }
                });
            }
        });
        if (chkradioValue == 'Terms') {
            if (d == 0) {
                return '<div class="col-lg-12">'
                    + '<div class="col-lg-5">'
                    + 'Order <input type="text" class="form-control" style="width:100%" required>'
                    + '</div><div class="col-lg-7">'
                    + 'Main Point <a style="color:red">*</a><input type="text" class="form-control" style="width:100%" required>'
                    + '</div></div>'
                    + '<div class="col-lg-12">'
                    + 'Sub Point <a style="color:red">*</a><br/><textarea id="subPointId" rows="10" cols="50" style="width:100%"></textarea>'
                    + '</div>'
                    + '<div class="col-lg-12">'
                    + '<div class="col-lg-2">'
                    + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                    + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                    + '</div><div class="col-lg-2">'
                    + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                    + '</div><div class="col-lg-6"></div><div class="col-lg-2">'
                    + '<input id="psudouserid" type="text" class="form-control" value="" style="width:1% ; margin-top:6px; float:right;opacity:0" />'
                    + '</div></div>'

            }
            else {

                return '<div class="col-lg-12">'
                    + '<div class="col-lg-5">'
                    + 'Order <input type="text" class="form-control" style="width:100%" value="' + d[2] + '" required>'
                    + '</div><div class="col-lg-7">'
                    + 'Main Point <a style="color:red">*</a><input type="text" class="form-control" style="width:100%" value="' + d[3] + '" required>'
                    + '</div></div>'
                    + '<div class="col-lg-12">'
                    + 'Sub Point <a style="color:red">*</a><br/><textarea id="subPointId" rows="10" cols="50" style="width:100%">'+d[4]+'</textarea>'
                    + '</div>'
                    + '<div class="col-lg-12">'
                    + '<div class="col-lg-2">'
                    + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                    + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                    + '</div><div class="col-lg-2">'
                    + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                    + '</div><div class="col-lg-6"></div><div class="col-lg-2">'
                    + '<input id="psudouserid" type="text" class="form-control" value="" style="width:1% ; margin-top:6px; float:right;opacity:0" />'
                    + '</div></div>'

            }
        } else {
            if (d == 0) {
                return '<div class="col-lg-12">'
                    + '<div class="col-lg-2">'
                    + 'Order <input type="text" class="form-control" style="width:100%" required>'
                    + '</div><div class="col-lg-5">'
                    + 'Main Point <a style="color:red">*</a><input type="text" class="form-control" style="width:100%" required>'
                    + '</div><div class="col-lg-5">'
                    + 'Text <a style="color:red">*</a><input type="text" class="form-control" style="width:100%" required>'
                    + '</div></div>'
                    + '<div class="col-lg-12" >'
                    + 'Sub Point <a style="color:red">*</a><br/><textarea id="subPointId" rows="10" cols="50" style="width:100%"></textarea>'
                    + '</div>'
                    + '<div class="col-lg-12">'
                    + '<div class="col-lg-2">'
                    + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                    + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                    + '</div><div class="col-lg-2">'
                    + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                    + '</div><div class="col-lg-6"></div><div class="col-lg-2">'
                    + '<input id="psudouserid" type="text" class="form-control" value="" style="width:1% ; margin-top:6px; float:right;opacity:0" />'
                    + '</div></div>'

            }
            else {

                return '<div class="col-lg-12">'
                    + '<div class="col-lg-2">'
                    + 'Order <input type="text" class="form-control" style="width:100%" value="' + d[2] + '" required>'
                    + '</div><div class="col-lg-5">'
                    + 'Main Point <a style="color:red">*</a><input type="text" class="form-control" style="width:100%" value="' + d[3] + '" required>'
                    + '</div><div class="col-lg-5">'
                    + 'Text <a></a><input type="text" class="form-control" style="width:100%" value="' + d[4] + '" required>'
                    + '</div></div>'
                    + '<div class="col-lg-12">'
                    + 'Sub Point <a style="color:red">*</a><br/><textarea id="subPointId" rows="10" cols="50" style="width:100%">' + d[5] +'</textarea>'
                    + '</div>'
                    + '<div class="col-lg-12">'
                    + '<div class="col-lg-2">'
                    + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                    + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                    + '</div><div class="col-lg-2">'
                    + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                    + '</div><div class="col-lg-6"></div><div class="col-lg-2">'
                    + '<input id="psudouserid" type="text" class="form-control" value="" style="width:1% ; margin-top:6px; float:right;opacity:0" />'
                    + '</div></div>'

            }
        }

    }


    function btnyes_Click() {

        var TermsAndConditionId = $('#hdnTermsAndConditionId').val();

        $.ajax({
            url: '/TermsAndConditionType/DeleteDocument',
            type: 'post',
            data: { TermsAndConditionId: TermsAndConditionId },
            async: false,
            success: function (response) {
                $("#Deletemodal").css("display", "none");
                if (response.Result == 'Success') {
                    CustomAlert(Response);
                    GetTermsAndCondition();
                } else {
                    CustomAlert(Response);
                }
            }
        });
    }


</script>


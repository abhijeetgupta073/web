    let txtStatus = '';
    function GetShiftAllocation(id) {

        var str = "";

        str += '<table id="gridShiftAllocation" class="table table-striped display" style="width:120%;table-layout:fixed;font-size:12px">';
        str += "<thead><tr>";
        /*str += "<th style='width:0%;padding: 0px;display:none'></th>";*/
        str += "<th style='width:3%;padding: 0px;' class='ClassbtnShiftAllocationEdit'></th>";
        str += "<th style='width:3%;padding: 0px;' class='ClassbtnShiftAllocationDelete'></th>";
        str += "<th  style='text-align:center;display:none'>ShiftAllocationId</th>";
        str += "<th  style='text-align:center;width:40%'>Shift Allocation</th>";
        str += "<th  style='text-align:center;width:20%'>Status</th></tr></thead><tbody>";

        $.ajax({
            url: '/ShiftAllocation/GetShiftAllocationData',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getdata = response;

                str += "<tr id='row_9999' style='display:none'><td  style='width:2%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                    str += "<td  style='text-align:center;display:none'></td>";
                    str += "<td  style='text-align:center;display:none'>0</td>";
                str += "<td  style='text-align:center;width:40%;display:none'></td>";
                str += "<td  style='text-align:center;width:20%;display:none'></td></tr>";
                if (getdata.length > 0) {
                    var ClientName = getdata[0].Name == null ? "" : getdata[0].Name;
                    $('#lblcompany').html("Company : " + ClientName);
                }
                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var ShiftAllocationId = getdata[i].ShiftAllocationId == null ? "" : getdata[i].ShiftAllocationId;
                        var ShiftAllocation = getdata[i].ShiftAllocation == null ? "" : getdata[i].ShiftAllocation;
                        var Status = getdata[i].Status == null ? "" : getdata[i].Status;

                        //str += "<tr id='row_9999' style='display:none'><td  style='width:2%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                        //str += "<td  style='text-align:center;display:none'></td>";
                        //str += "<td  style='text-align:center;display:none'>0</td>";
                        //str += "<td  style='text-align:center;width:60%;;display:none'></td></tr>";
                        str += "<tr><td style='width:3%;' class='ClassbtnShiftAllocationEdit'><a id='rowpencil' class='expand fa fa-pencil'></a></td>";
                        str += "<td style='width:3%;' class='ClassbtnShiftAllocationDelete'><a id='rowdelete' class='fa fa-trash'></a></td>";
                        str += "<td  style='text-align:center;display:none'>" + ShiftAllocationId + "</td>";
                        str += "<td  style='text-align:center;width:40%'>" + ShiftAllocation + "</td>";
                        str += "<td  style='text-align:center;width:20%'>" + Status + "</td></tr>";
                    }

                }
                str += "</tbody></table>";
                $("#loaddata").html(str);

                $("#LoadingPanel1").css("display", "none");

                $(".fa-trash").click(function () {
                    var ShiftAllocationId = $(this).parent().parent().children()[2].innerText;
                    $("#hdnShiftAllocationId").val(ShiftAllocationId);
                    $("#Deletemodal").css("display", "block");
                });

                $(".fa-pencil").click(function () {
                    var visible = $(this).parent().parent().hasClass("Edit");
                    var tr = $(this).closest('tr');
                    var row = table.row(tr);
                    if (visible == true) {
                        $(this).parent().parent().next('tr').remove();
                        $(this).parent().parent().removeClass('Edit');
                    }
                    else {
                        row.child(Editing(row.data())).show();
                        $('#ddlStatus').val(txtStatus);
                        row.child.show();
                        tr.addClass('Edit');
                    }
                });

                var table = $('#gridShiftAllocation').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: false,
                    info: false,
                    "pageLength": 50,
                    autoWidth: true,
                    scrollX: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    fixedHeader: true,
                    fixedColumns: {
                        leftColumns: 11,
                    },

                    dom: 'lBfrtip',
                    buttons: [
                        {
                            extend: 'csvHtml5',
                            title: 'Shift Allocation',
                            exportOptions: {
                                columns: [3,4]
                            }
                        }
                    ],


                    initComplete: function () {
                        $("#gridShiftAllocation_length").children().html('<button id="btnaddShiftAllocation"  type="button" class="w3-btn w3-teal fa fa-plus" style="margin-bottom:-44px;">&nbsp;Add New Shift Allocation</button><button id="btnExport" type="button" class="w3-btn w3-teal Export" style="margin-left:200px;height:26px;padding-top:3px;"><i class="fa fa-file-excel-o"></i>&nbsp;Export to CSV</button>');

                        $("#btnaddShiftAllocation").click(function () {

                            var trow1 = $(this).parent().parent().siblings();

                            var trow = $(this).parent().parent().siblings()[1].childNodes[0];
                            var row = table.row(trow);
                            var c = 0;

                            var te = Editing(c);
                            row.child(Editing(c)).show();
                        });

                        $(".Export").click(function () {
                            $('.dt-button.buttons-csv.buttons-html5').trigger('click');
                        });
                    },

                    "columnDefs": [
                        { "width": "100px", "targets": 'fullsize' }
                    ],

                    "drawCallback": function () {

                        $('.fa-angle-right').click(function (eve) {
                            eve.stopImmediatePropagation();
                            var tr = $(this).closest('tr');
                            var row = table.row(tr);
                            var visible = $(this).parent().parent().hasClass("shown");
                            var anglechange = $(this).hasClass("fa-angle-right");
                            if (anglechange == true) {
                                var x = tr.children()[0];
                                $(this).removeClass("fa-angle-right");
                                $(this).addClass("fa-angle-down");
                            }
                            else {
                                $(this).addClass("fa-angle-right");
                                $(this).removeClass("fa-angle-down");
                            }
                            if (visible == true) {
                                // This row is already open - close it
                                $(this).parent().parent().next('tr').remove();
                                $(this).parent().parent().removeClass('shown');
                            }
                            else {
                                // Open this row
                                row.child(format(row.data())).show();
                                row.child.show();
                                tr.addClass('shown');
                            }
                        });
                        GridButtonHideShow(table, "gridShiftAllocation");
                    }

                });

                // scrolling Top when Click On Next Button

                table.on('page.dt', function () {
                    $('.dataTables_scrollBody').animate({
                        scrollTop: 0
                    }, 300);
                });

                // Hide Show For DataTable Column And Buttons Start Here

                GridButtonHideShow(table, "gridShiftAllocation");

                // Hide Show For DataTable Column And Buttons End Here
            }
        });
    }

    function Editing(d) {

        var id = getParameterByName('id');
        $.ajax({

            success: function (response) {

            },
            complete: function () {
                $(".CancelChangeClass").click(function () {
                    $(this).parent().parent().parent().parent().prev('tr').removeClass('Edit');
                    $(this).parent().parent().parent().parent().remove();
                });

                $("#btnsavechange").click(function (eve) {
                    eve.stopImmediatePropagation();
                    var ShiftAllocationId = $(this).parent().parent().parent().parent().prev('tr').children()[2].innerText;
                    var firstrow = $(this).parent().parent().prev('div').children().find('input[type=text]');
                    var sropdownval = $(this).parent().parent().prev('div').children().find('select');


                    var ShiftAllocation = firstrow[0].value;
                    var Status = sropdownval[0].value;
                    var UID = getParameterByName('UID');
                    var id = getParameterByName('id');
                    if (ShiftAllocation != "") {
                        $("#LoadingPanel1").css("display", "block");

                        $.ajax({
                            type: "POST",
                            url: "/ShiftAllocation/SaveShiftAllocation",
                            data: JSON.stringify({ "ShiftAllocationId": ShiftAllocationId, "ShiftAllocation": ShiftAllocation, "id": id, "UID": UID, "Status": Status }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (response) {
                                var result = response;
                                if (result.Result == 'Success') {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                    var id = getParameterByName('id');
                                    GetShiftAllocation(id);
                                }
                                else {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                }
                            }
                        })
                    } else {
                        $("#LoadingPanel1").css("display", "none");
                        $('#txtShiftAllocation').css('border-color', 'red');
                    }
                });
            }
        });
        if (d == 0) {

            return '<div class="row">'
                + '<div class="col-lg-6">'
                + 'Shift Allocation <a style="color:red">*</a><input id="txtShiftAllocation" type="text" class="form-control" style="width:100%" required>'
                + '</div><div class="col-lg-6">'
                + 'Status<select id="ddlStatus" style="width:100%" class="form-control" required><option value="Active">Active</option><option value="InActive">InActive</option></select>'
                + '</div></div>'
                + '<div class="col-lg-12">'
                + '<div class="col-lg-5">'
                + '<input type="button" id="btnsavechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                + '</div><div class="col-lg-5">'
                + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                + '</div><div class="col-lg-2">'
                + '</div></div>'


        }
        else {
            txtStatus = d[4];
            return '<div class="row">'
                + '<div class="col-lg-12">'
                + 'Shift Allocation <a style="color:red">*</a><input id="txtShiftAllocation" type="text" class="form-control" value="' + d[3] + '" style="width:100%" required>'
                + '</div><div class="col-lg-12">'
                + 'Status<select id="ddlStatus" style="width:100%" class="form-control" required><option value="Active">Active</option><option value="InActive">InActive</option></select>'
                + '</div></div>'
                + '<div class="col-lg-12">'
                + '<div class="col-lg-5">'
                + '<input type="button" id="btnsavechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                + '</div><div class="col-lg-5">'
                + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                + '</div><div class="col-lg-2">'
                + '</div></div>'
        }
    }


    function btnyes_Click() {

        var ShiftAllocationId = $('#hdnShiftAllocationId').val();
        var id = getParameterByName('id');
        $.ajax({
            url: '/ShiftAllocation/DeleteShiftAllocation',
            type: 'post',
            data: { ShiftAllocationId: ShiftAllocationId, id: id },
            async: false,
            success: function (response) {
                $("#Deletemodal").css("display", "none");
                if (response.Result == 'Success') {
                    CustomAlert(response);
                    var id = getParameterByName('id');
                    GetShiftAllocation(id);
                } else {
                    CustomAlert(response);
                }
            }
        });
    }

    function btnbacktoJob_Click() {
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var id = getParameterByName('id');
        var RID = getParameterByName('RID');
        window.location.href = '/Register/Register?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&RID=' + RID;
    }

</script>


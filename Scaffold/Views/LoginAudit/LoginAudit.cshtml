
@{
    ViewBag.Title = "LoginAudit";
}


<style>
    .dt-button.buttons-csv.buttons-html5 {
        display: none;
    }
    #txtToDate, #txtFromDate {
    color:black;
    }
    .clslbl {
    color: black !important;
    }

    .clsCompanyNameWidth, .clsUserNameWidth, .clsCountryWidth, .clsIPAddressWidth,.clscityWidth {
        min-width: 70px !important;
    }
    .clslogouttime {
        min-width: 80px !important;
    }

    .clsUTCLoginWidth, .clsGeographicWidth,.clstotalsession {
        min-width: 130px !important;
    }
    .clsValidUserWidth, .clsLoginAttemptWidth, .clsPerthTimeWidth {
        min-width: 60px !important;
    }
    .clsSessionIdWidth {
    min-width:120px!important;
    }
    .clsLoginFailureWidth,.clsregionNameWidth {
    min-width: 200px !important;
    }
</style>

<script>
    $(function () {

        var date = new Date();
        var newdate = new Date(date);
        newdate.setDate(newdate.getDate() - 2);

        $("#txtFromDate").datepicker({
            dateFormat: 'dd-M-yy',
            closeText: 'Close',
        }).datepicker("setDate", newdate);

        $("#txtToDate").datepicker({
            dateFormat: 'dd-M-yy',
            closeText: 'Close',
        }).datepicker("setDate", new Date());
        $('#hdnTimeOffSet').val(new Date().getTimezoneOffset());
        GetLoginAuditData();
    });

    function GetLoginAuditData()
    {
        $("#LoadingPanel1").css("display", "block");
        var fromDate = $('#txtFromDate').val();
        var toDate = $('#txtToDate').val();
        var hdnTimeOffSet = $('#hdnTimeOffSet').val();
        $.ajax({
            type: 'POST',
            url: '/LoginAudit/GetLoginAuditData',
            data: JSON.stringify({ fromDate: fromDate, toDate: toDate,hdnTimeOffSet:hdnTimeOffSet }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                var data = response;
                var str = '';
                $('#tblLoginAudit').DataTable().clear();
                $('#tblLoginAudit').DataTable().destroy();
                if (data.length != 0) {
                  
                    $.each(data, function (index, obj) {

                        var CompanyName = obj.Name == null ? "" : obj.Name;
                        var ValidUser = obj.ValidUser == null ? "" : obj.ValidUser;
                        var Username = obj.Username == null ? "" : obj.Username;
                        var LoginAttemptSuccess = obj.LoginAttemptSuccess == null ? "" : obj.LoginAttemptSuccess;
                        var Country = obj.Country == null ? "" : obj.Country;
                        var IPAddress = obj.IPAddress == null ? "" : obj.IPAddress;
                        var UTCLoginTime = obj.UTCLoginTime == null ? "" : obj.UTCLoginTime;
                        var GeographicLoginTime = obj.GeographicLoginTime == null ? "" : obj.GeographicLoginTime;
                        var PerthTime = obj.PerthTime == null ? "" : obj.PerthTime;
                        var SessionId = obj.SessionId == null ? "" : obj.SessionId;
                        var LoginFailureReason = obj.LoginFailureReason == null ? "" : obj.LoginFailureReason;
                        var regionName = obj.regionName == null ? "" : obj.regionName;
                        var city = obj.city == null ? "" : obj.city;
                        var zip = obj.zip == null ? "" : obj.zip;
                        var latitute = obj.latitute == null ? "" : obj.latitute;
                        var longitude = obj.longitude == null ? "" : obj.longitude;
                        var timezone = obj.timezone == null ? "" : obj.timezone;
                        var PerthLogoutTime = obj.PerthLogoutTime == null ? "" : obj.PerthLogoutTime;
                        var PerthTotalSessionTime = obj.PerthTotalSessionTime == null ? "" : obj.PerthTotalSessionTime;
                        

                        str += "<tr>";
                        str += "<td class='clsCompanyNameWidth' style='display:none'></td>";
                        str += "<td class='clsCompanyNameWidth'>" + CompanyName + "</td>";
                        str += "<td class='clsValidUserWidth'>" + ValidUser + "</td>";
                        str += "<td class='clsUserNameWidth'>" + Username + "</td>";
                        str += "<td class='clsLoginAttemptWidth'>" + LoginAttemptSuccess + "</td>";
                        str += "<td class='clsCountryWidth'>" + Country + "</td>";
                        str += "<td class='clsIPAddressWidth'>" + IPAddress + "</td>";
                        str += "<td class='clsUTCLoginWidth'>" + DateTimeFormat(UTCLoginTime) + "</td>";
                        str += "<td class='clsGeographicWidth'>" + DateTimeFormat(GeographicLoginTime) + "</td>";
                        str += "<td class='clsPerthTimeWidth'>" + ReturnTime(PerthTime) + "</td>";
                        str += "<td class='clslogouttime'>" + ReturnTime(PerthLogoutTime) + "</td>";
                        str += "<td class='clstotalsession'>" + PerthTotalSessionTime + "</td>";
                        str += "<td class='clsSessionIdWidth'>" + SessionId + "</td>";
                        str += "<td class='clsLoginFailureWidth'>" + LoginFailureReason + "</td>";
                        str += "<td class='clscityWidth'>" + city + "</td>";
                        str += "<td class='clsregionNameWidth'>" + regionName + "</td>";
                        str += "</tr>";
                    });
                  
                }
                $("#LoadingPanel1").css("display", "none");
                $('#tbodyTblLoginAudit').html(str);
                var table = $('#tblLoginAudit').dataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    "bLengthChange": false,
                    "bInfo": false,
                    autoWidth: false,
                    scrollX: true,
                    scrollCollapse: true,
                    scrollY: "60vh",

                    dom: 'Bfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Login Audit',
                            exportOptions: {
                                columns: ':visible'
                            }
                        }
                    ],
                });
            }
        });
    }

    function btnRefresh_Click() {
        GetLoginAuditData();
    }

    function btnExportToCSV()
    {
        $('.dt-button.buttons-csv.buttons-html5').trigger('click');
    }



    // Get DateTime Format for Json Datetime
    function ReturnTime(date) {
        if (date != null && date != undefined && date != "") {
            date = date.toString();
            var newDate = new Date(parseInt(date.substr(6)));

            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

            var DateTo2 = tConvert(("0" + newDate.getHours()).slice(-2) + ':' + ("0" + newDate.getMinutes()).slice(-2));

            return DateTo2.toString();
            //return DateTo.toString();
        }
        else {
            return "";
        }
    }

    function tConvert(time) {
        // Check correct time format and split into components
        time = time.toString().match(/^([01]\d|2[0-3])(:)([0-5]\d)(:[0-5]\d)?$/) || [time];

        if (time.length > 1) { // If time format correct
            time = time.slice(1); // Remove full string match value
            time[5] = +time[0] < 12 ? ' AM' : ' PM'; // Set AM/PM
            time[0] = +time[0] % 12 || 12; // Adjust hours
        }
        return time.join(''); // return adjusted time or original string
    }

    function ReturnTime1(date) {
        if (date != null && date != undefined && date != "") {
            date = date.toString();
            var newDate = new Date(parseInt(date.substr(6)));

            const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

            var DateTo2 = ("0" + newDate.getHours()).slice(-2) + ':' + ("0" + newDate.getMinutes()).slice(-2);

            return DateTo2.toString();
            //return DateTo.toString();
        }
        else {
            return "";
        }
    }



</script>


    <script>
        //Line Add on 7 Aug 2019 For Rotate Image Start
        function ImageRotate(angle) {
            if (angle == 90 || angle == -90 || angle == 270 || angle == -270) {
                $('#imga').addClass("rotatedimg");
            }
            var isFirefox = navigator.userAgent.toLowerCase().indexOf('firefox') > -1;
            if (isFirefox == true) {
                $(".changeimg").css('image-orientation', +angle + 'deg');
            } else {
                $(".changeimg").css({ 'transform': 'rotate(' + angle + 'deg)' });
            }
        }

        function newclickforward() {
            var isFirefox = navigator.userAgent.toLowerCase().indexOf('firefox') > -1;
            var imgsrc = $('#imga').attr('src');

            var angle = 90;
            var newangle = $("#imgangle").val();

            if (newangle == 0) {
                newangle = 90;
            } else {
                newangle = parseInt(newangle) + angle;
            }
            if (newangle == 90 || newangle == -90 || newangle == 270 || newangle == -270) {
                $('#imga').addClass("rotatedimg");
            } else {
                $('#imga').removeClass("rotatedimg");
            }

            if (isFirefox == true) {
                $(".changeimg").css('image-orientation', +newangle + 'deg');
            } else {
                $(".changeimg").css({ 'transform': 'rotate(' + newangle + 'deg)' });
            }

            if (newangle > -360 && newangle < 360) {
                $("#imgangle").val(newangle);
            } else {
                newangle = 0;
                $("#imgangle").val(newangle);
            }
        }
        function newclickbackward() {
            var isFirefox = navigator.userAgent.toLowerCase().indexOf('firefox') > -1;
            var angle = -90;
            var newangle = $("#imgangle").val();

            if (newangle == 0) {
                newangle = -90;
            } else {
                newangle = parseInt(newangle) + angle;
            }

            if (newangle == 90 || newangle == -90 || newangle == 270 || newangle == -270) {
                //alert("hello");
                // $(".rotatedimgdiv").css("margin", "50px 0 0 0");
                //$(".rotatedimg").css("margin", "0 0 0 25px").css("max-width", "260px").css("width", "100%");
                $('#imga').addClass("rotatedimg");
                // $("#removemargin").css("margin-top", "0");
            } else {
                // $(".rotatedimgdiv").css("margin", "0 0 0 0");
                $('#imga').removeClass("rotatedimg");
                //$(".rotatedimg").css("margin", "0 0 0 0").css("max-width", "auto").css("width", "100%");
                // $("#removemargin").css("margin-top", "-32px");
            }

            if (isFirefox == true) {
                $(".changeimg").css('image-orientation', +newangle + 'deg');
            } else {
                $(".changeimg").css({ 'transform': 'rotate(' + newangle + 'deg)' });
            }

            if (newangle > -360 && newangle < 360) {
                $("#imgangle").val(newangle);
            } else {
                newangle = 0;
                $("#imgangle").val(newangle);

            }
        }


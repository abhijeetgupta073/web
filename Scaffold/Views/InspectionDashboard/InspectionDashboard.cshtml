                        row += "<tr class='forRemoveData1'><td style='text-align: center;'>" + obj.TotalCompliance + "</td><td style='text-align: center;'>" + obj.TotaNonCompliance + "</td><td style='text-align: center;'>" + obj.InspectDashTotal + "</td></tr>";
                    });
                    $("#tblDetails tbody").append(row);
                },
                error: function (response) {
                    alert(response);
                }
            });
        }

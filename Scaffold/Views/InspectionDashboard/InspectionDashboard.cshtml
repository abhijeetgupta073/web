        function Changesite() {
            var ClientID = $("#hdnClientID").val();
            var Siteid = $("#ddlsite").val();
            InspectionStatus(ClientID, Siteid, "All");
            LocationBySite(ClientID, Siteid, "All")
            ddlJobbind(ClientID, Siteid);
            SiteInspectionCount(ClientID, Siteid);
            LocationInspectionCount(ClientID, Siteid, "All");
        }

        function selectarea() {
            var ClientID = $("#hdnClientID").val();
            var ddlselectarea = $("#ddlarea").val();
            var Siteid = $("#ddlsite").val();
            InspectionStatus(ClientID, Siteid, ddlselectarea);
            LocationBySite(ClientID, Siteid, ddlselectarea)
            LocationInspectionCount(ClientID, Siteid, ddlselectarea);
        }
        function SiteDropDownBind(id) {
            var UID = getParameterByName('UID');
            $.ajax({
                type: "POST",
                async: false,
                url: "/InspectionDashboard/SiteDropDownBind",
                data: JSON.stringify({ id: id, UID: UID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var getData = response;
                    var SiteLocId = "";//Added on 02-September -2021
                    $("#ddlsite").html("");
                    ////$("#ddlsite").append('<option value="All">All</option>');
                    //for (var i = 0; i < getData.length; i++) {
                    //    //SiteLocId = getData[0].SiteLocID;
                    //    SiteLocId = getData[i].SiteLocID;
                    //    if (SiteLocId == 0) {
                    //        SiteLocId = "All";
                    //    }//Added on 02-September-2021
                    //    //$("#ddlsite").append('<option value="' + getData[i].SiteLocID + '">' + getData[i].SiteLocation + '</option>');
                    //    $("#ddlsite").append('<option value="' + SiteLocId + '">' + getData[i].SiteLocation + '</option>');

                    //}
                    $("#ddlsite").html("");

                    if (getData.length === 1) {
                        SiteLocId = getData[0].SiteLocID;
                        $("#ddlsite").append('<option value="' + SiteLocId + '">' + getData[0].SiteLocation + '</option>');
                    //    Changesite();
                    } else {
                        for (var i = 0; i < getData.length; i++) {
                            SiteLocId = getData[i].SiteLocID;
                            if (SiteLocId == 0) {
                                SiteLocId = "All";
                            }
                            $("#ddlsite").append('<option value="' + SiteLocId + '">' + getData[i].SiteLocation + '</option>');

                        }
                    }

                }
            });
        }
        function ddlJobbind(id, SiteId) {
            var UID = getParameterByName('UID');

            $.ajax({
                type: "POST",
                //  url: "../WebApi/Dashboard.asmx/ddlJobDashboard",
                url: "/InspectionDashboard/ddlJobDashboard",
                data: JSON.stringify({ id: id, SiteId: SiteId, UID: UID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // var ddlJobdropdownbind = response.d;
                    var ddlJobdropdownbind = response;
                    //alert(ddllocationSitedropdownbind.length);

                    //$("#ddlarea").html("");
                    //$("#ddlarea").append('<option value="All">All</option>');
                    //for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                    //    siteLocid = ddlJobdropdownbind[0].areaid;
                    //    $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].areaid + '">' + ddlJobdropdownbind[i].area + '</option>');

                    //}

                    $("#ddlarea").html("");

                    if (ddlJobdropdownbind.length === 1) {
                        var singleArea = ddlJobdropdownbind[0];
                        $("#ddlarea").append('<option value="' + singleArea.areaid + '" selected>' + singleArea.area + '</option>');
                        selectarea();
                    } else {
                        $("#ddlarea").append('<option value="All">All</option>');
                        for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                            $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].areaid + '">' + ddlJobdropdownbind[i].area + '</option>');
                        }
                    }
                }
            });
        }

        function SiteInspectionCount(ClientID, Siteid) {
            //  $('.forRemoveDataAction').remove();
            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/InspectionGetBySiteTotal",
                url: "/InspectionDashboard/InspectionGetBySiteTotal",
                data: JSON.stringify({ ClientID: ClientID, siteid: Siteid }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    //var SiteData = response.d;
                    var SiteData = response.SiteTotal;
                    $('#txtSiteValues').val(SiteData);

                }
            });

        }
        function LocationInspectionCount(ClientID, Siteid, locationID) {
            //  $('.forRemoveDataAction').remove();
            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/InspectionGetByLocationTotal",
                url: "/InspectionDashboard/InspectionGetByLocationTotal",
                data: JSON.stringify({ ClientID: ClientID, siteid: Siteid, locationID: locationID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                   // var LocationData = response.d;
                    var LocationData = response.LocationTotal;
                    $('#txtLocationValues').val(LocationData);
                }
            });

        }

        function ByCategory(Status, ClientID, Siteid, locationID) {
            var inspectionStatus = Status;
            $('#hdnInspectionStatus').val(inspectionStatus);
            $('.forRemoveDataAction').remove();
            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/InspectionGetBystatus",
                url: "/InspectionDashboard/InspectionGetBystatus",
                data: JSON.stringify({ Status: Status, ClientID: ClientID, siteid: Siteid, locationID: locationID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    // var Status = response.d;
                    var Status = response;
                    var CycloneData = [];
                    if (Status.length > 0) {
                        for (var i = 0; i < Status.length; i++) {
                            var TobePush = true;
                            if (TobePush) {

                                CycloneData.push({ name: Status[i].ScaffRefAction, y: Status[i].DescriptionAction, z: Status[i].Location, s: Status[i].BuildingNo, r: Status[i].assetId, x: Status[i].FloorLevel, a: Status[i].DesignType, b: Status[i].MaterialType, c: Status[i].PreparationHrs, d: Status[i].RiskRating, sliced: true });

                            }
                        }
                    }
                    $('#btnOpenModelAllDetails').click();

                    if (inspectionStatus == "Green") {
                        $("#labelScaffoldInspectionstatus").css('display', 'none');
                        $('#ScaffoldInspectionstatus').css('display', 'block');
                        $('#ScaffoldInspectionstatus').attr('src', '/images/green.jpg');
                    } else if (inspectionStatus == "Red") {
                        $("#labelScaffoldInspectionstatus").css('display', 'none');
                        $('#ScaffoldInspectionstatus').css('display', 'block');
                        $('#ScaffoldInspectionstatus').attr('src', '/images/Red.jpg');
                    } else if (inspectionStatus == "Yellow") {
                        $("#labelScaffoldInspectionstatus").css('display', 'none');
                        $('#ScaffoldInspectionstatus').css('display', 'block');
                        $('#ScaffoldInspectionstatus').attr('src', '/images/yellow.jpg');
                    } else {
                        $('#ScaffoldInspectionstatus').css('display', 'none');
                        $("#labelScaffoldInspectionstatus").css('display', 'block');
                        $("#labelScaffoldInspectionstatus").text(inspectionStatus);
                    }


                    var row1 = '';


                   // $.each(response.d, function (index, obj) {
                    $.each(response, function (index, obj) {
                        var DateTagged = '';                                                  //Date Tagged
                        if (obj.DateTagged != "" && obj.DateTagged != null && obj.DateTagged != '1900-01-01')
                        {
                            var date1 = new Date(obj.DateTagged);
                            var erect = "" + date1 + "";
                            var date1dd = erect.substring(8, 11);
                            var date1mm = erect.substring(4, 7);
                            var date1yyyy = erect.substring(11, 16);
                            DateTagged = date1dd + '-' + date1mm + '-' + date1yyyy
                        }
                        // commented on  04-04-2025   no need to date formate 
                        //var RecentInspDate = '';                                                  //Recent Insp Date
                        //if (obj.RecentInspDate != "" && obj.RecentInspDate != null && obj.RecentInspDate != '1900-01-01')
                        //{
                        //    var daterecent = new Date(obj.RecentInspDate);
                        //    var recentDate = "" + daterecent + "";
                        //    var recentdatedd = recentDate.substring(8, 11);
                        //    var recentdatemm = recentDate.substring(4, 7);
                        //    var recentdateyyyy = recentDate.substring(11, 16);
                        //    RecentInspDate = recentdatedd + '-' + recentdatemm + '-' + recentdateyyyy
                        //}

                        row1 += "<tr class='forRemoveDataAction'><td style='text-align: center;font-size: 12px;'>" + obj.ScaffRefAction + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DescriptionAction + "</td><td style='text-align: center;font-size: 12px;'>" + obj.SiteLocation + "</td><td style='text-align: center;font-size: 12px;'>" + obj.Location + "</td><td style='text-align: center;font-size: 12px;'>" + obj.BuildingNo + "</td><td style='text-align: center;font-size: 12px;'>" + obj.assetId + "</td><td style='text-align: center;font-size: 12px;'>" + obj.FloorLevel + "</td><td style='text-align: center;font-size: 12px;'>" + obj.WONumber + "</td><td style='text-align: center;font-size: 12px;'>" + obj.ClientScaffref + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DesignType + "</td><td style='text-align: center;font-size: 12px;'>" + obj.MaterialType + "</td><td style='text-align: center;font-size: 12px;'>" + DateTagged + "</td><td style='text-align: center;font-size: 12px;'>" + obj.RecentInspDate + "</td><td style='text-align: center;font-size: 12px;'>" + obj.DaysSinceLastInsp + "</td><td style='text-align: center;font-size: 12px;'>" + obj.HireDaysToDate + "</td></tr>";

                    });

                    $("#tbDetails tbody").append(row1);
                }
            });

        }


        function InspectionStatus(ClientID, Siteid, locationID) {

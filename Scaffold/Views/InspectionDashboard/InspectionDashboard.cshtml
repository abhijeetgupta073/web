                    if (Cyclone.length > 0) {
                        for (var i = 0; i < Cyclone.length; i++) {
                            var TobePush = true;
                            if (TobePush) {

                                CycloneData.push({ name: Cyclone[i].CycloneAction, y: Cyclone[i].TotalCounts, sliced: true });
                                Cton.push(Cyclone[i].CycloneAction);

                            }


                        }


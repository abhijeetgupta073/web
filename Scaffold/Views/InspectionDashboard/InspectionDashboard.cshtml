                        navigation: {
                            buttonOptions: {
                                verticalAlign: 'top',
                                y: -12,
                            }
                        },
                        exporting: {
                            buttons: {

                                contextButton: {
                                    enabled: true,
                                    x: 9,
                                },

                                exportButton: {
                                    onclick: function () {
                                        $('#btnOpenModel1').click();
                                    },
                                    text: 'Show All'
                                }
                            }


                        },
                        credits: {
                            enabled: false
                        },
                        series: [{
                            showInLegend: false,
                            colorByPoint: true,
                            data: CycloneData
                        }]
                    });
                    function redrawchart1() {
                        var chart = $('#container').highcharts();

                        var w = $('#container').closest(".wrapper").width()
                        chart.setSize(
                            w, w * (2.2 / 4), false
                        );
                    }
                    $('#menu_toggle').on('click', function () {
                        $(window).resize(redrawchart1);
                        redrawchart1();
                    });
                    $(window).resize(redrawchart1);
                    redrawchart1();
                    var row = '';
                    // $.each(response.d, function (index, obj) {
                    $.each(response, function (index, obj) {
                        var num;
                        num = (obj.PctAllSite1 * 100);
                        row += "<tr class='forRemoveData'><td style='text-align: center;'>" + obj.Status + "</td><td style='text-align: center;'>" + obj.TotalCounts + "</td></tr>";
                    });
                    $("#tbDetails1 tbody").append(row);

                }
            });
        }



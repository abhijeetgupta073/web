                        colors: ['#4c9640', '#f9cb13', '#fc2828', '#FFFFFF', '#0000FF']
                    });//Change line By 19 Nov 2018
                    Highcharts.chart('container', {
                        chart: {
                            type: 'bar',
                            backgroundColor: '#f2f2f2'
                            //plotBackgroundImage: '~/images/green.jpg'
                        },
                        title: {
                            align: 'left',
                           // text: 'Inspection Status',  // Line Comment On 26 Nov 2019
                            text: 'Inspection Status (No. of Jobs)',
                            style: {
                                fontSize: '16px',
                            }
                        },
                        subtitle: {
                            text: ''
                        },
                        xAxis: {
                            categories: ['Green', 'Yellow', "Red", 'Out of Service', 'Restricted Access'],//Change line By 19 Nov 2018
                            title: {
                                text: null
                            }
                        },
                        yAxis: {
                            min: 0,
                            title: {
                                text: '',
                                align: 'high'
                            },
                            labels: {
                                overflow: 'justify'
                            }
                        },
                        tooltip: {
                            formatter: function () {
                                return this.x + ', ' + this.y + ' Qty';

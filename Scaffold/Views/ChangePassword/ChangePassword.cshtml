    <script>

        function getParameterByName(name, url) {
            if (!url) url = window.location.href;
            name = name.replace(/[\[\]]/g, "\\$&");
            var regex = new RegExp("[?&]" + name + "(=([^&#]*)|&|#|$)"),
                results = regex.exec(url);
            if (!results) return null;
            if (!results[2]) return '';
            return decodeURIComponent(results[2].replace(/\+/g, " "));
        }

        $(document).ready(function () {
            $('#lblYear').html(new Date().getFullYear());
            $('#txtUserName').val('@ViewBag.txtUserName');

        });

        //var password = document.getElementById("password");
        //var confirm_password = document.getElementById("confirm_password");

        //function validatePassword() {
        //    if (password.value != confirm_password.value) {
        //        confirm_password.setCustomValidity("Passwords Don't Match");
        //    } else {
        //        confirm_password.setCustomValidity('');
        //    }
        //}

        //password.onchange = validatePassword;
        //confirm_password.onkeyup = validatePassword;

        function btnLogin_Click() {

          
           var txtnewpassword = $('#txtnewpassword').val();
           var txtconfirmpassword = $('#txtconfirmpassword').val();
           if (txtnewpassword != "" || txtconfirmpassword!="") {

               var password = document.getElementById("txtnewpassword");
               var confirm_password = document.getElementById("txtconfirmpassword");

               if (password.value != confirm_password.value) {
                  // confirm_password.setCustomValidity("Passwords Don't Match");
                   $('#art1').removeClass('alert w3-green w3-card-4').addClass('alert w3-red w3-card-4');
                   $('#art1').css("display", "block");
                   $('#alertlabel').html('<strong>Alert ! </strong>Passwords Dont Match .');
               } else {
                 //  confirm_password.setCustomValidity('');

                   var ID = getParameterByName('ID');
                   $.ajax({
                       type: "POST",
                       url: "/ChangePassword/btnLogin_Click",
                       data: JSON.stringify({ txtnewpassword: txtnewpassword, ID: ID }),
                       contentType: "application/json; charset=utf-8",
                       dataType: "json",
                       async: false,
                       success: function (response) {
                           var GetData = response;
                           if (response.Result =="Success") {
                               $('#modalAgency').css('display', 'block');
                             } else {
                              $('#passwordMsg').css('display', 'block');
                           }

                       }
                   });
               }
           } else {
               $('#art1').removeClass('alert w3-green w3-card-4').addClass('alert w3-red w3-card-4');
               $('#art1').css("display", "block");
               $('#alertlabel').html('<strong>Alert ! </strong>Please enter password and Confirm passwod .');
           }
        }
        
        function btncancel_Click()
        {
            window.location.href = '/Login/Login';
          // Response.Redirect("~/Login.aspx");
        }

        function btnok_Click()
        {
            window.location.href = '/Login/Login';
       // ScriptManager.RegisterStartupScript(this, this.GetType(), "Open", "document.getElementById('modalAgency').style.display='none';", true);
       //   Response.Redirect("~/Login.aspx");
        }

        function passwordok_Click()
        {
            var ID = getParameterByName('ID');
            window.location.href = '/ChangePassword/ChangePassword?ID=' + ID;
           // Response.Redirect("~/ChangePassword.aspx?ID="+Request.QueryString["ID"]);
        }
    </script>

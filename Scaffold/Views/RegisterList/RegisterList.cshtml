<script>
       function SetDefaultValues() {
           $('#hdnLoginUserID').val('@ViewBag.UserId');
           $('#hdnOfflineEnabled').val('@ViewBag.OfflineEnabled');
           if ($('#hdnOfflineEnabled').val() == 'True') {
               $('#divOffline').css('display', 'block');
               //$('#divOfflineInspection').css('display', 'block');//Commented on on 23-July-2021
               $('#divOfflineUploadData').css('display', 'block');
               //divOffline.Visible = false;
               //divOfflineInspection.Visible = false;
               //divOfflineUploadData.Visible = false;
           }
           //Added on on 23-July-2021
           $('#hdnOfflineInspEnable').val('@ViewBag.OfflineInspEnable');
           if ($('#hdnOfflineInspEnable').val() == 'True') {
               $('#divOfflineInspection').css('display', 'block');
               $('#divOfflineUploadData').css('display', 'block');
           }
           var EnUserRole = getParameterByName('UserRole');
           var DecriptValues = Decrypt([EnUserRole]);
           var UserRole = DecriptValues[0];//Added on 16-May-2022
           if (UserRole == 75) {
               $('#divOffline').css('display', 'none');
               $('#divOfflineUploadData').css('display', 'none');
               $('#divOfflineInspection').css('display', 'none');
           }


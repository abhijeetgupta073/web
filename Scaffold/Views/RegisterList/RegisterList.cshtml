<div id="divCopyHistPopup" class="w3-modal" style="display: none">
    <input type="hidden" id="hiddenRegid" />
    <input type="hidden" id="hiddenOldRegid" />
    <input type="hidden" id="hiddenOldLocId" />
    <input type="hidden" id="hiddenOldSiteId" />
    <input type="hidden" id="hiddenOldFloorid" />
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 300px; width: 75%; margin-top: 86px;">
        <header class="w3-container w3-dark-grey">
            <h4 class="w3-text-white" id="h10" runat="server"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp;Alert</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">
                <label id="lblMessagecopyhist"> </label>
            </p>
        </div>
        <div class="row">
            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4">
                <div class="col-xs-6 col-lg-9 col-md-6 col-sm-6">
                    <label style="margin-right:20px ;font-size:large"> As a Live Job ?</label>
                </div>
                <div class="col-xs-3 col-lg-3 col-md-3 col-sm-3">
                    <input type="radio" name="SelectJobType" value="0" style="vertical-align: -webkit-baseline-middle" />
                </div>
            </div>

            <div class="col-xs-4 col-lg-3 col-md-4 col-sm-4">
                <div class="col-xs-6 col-lg-8 col-md-6 col-sm-6">
                    <label style="font-size:large"> With Inventory ?</label>

                </div>
                <div class="col-xs-1 col-lg-1 col-md-1 col-sm-1">

                    <input type="checkbox" id="WithInventoryForLiveJob" value="1" style="vertical-align: -webkit-baseline-middle" />
                </div>

            </div>
            <div class="col-xs-4 col-lg-5 col-md-4 col-sm-4">
                <div class="col-xs-6 col-lg-5 col-md-6 col-sm-6">
                    <label style="font-size:large">Built Date </label>

                </div>
                <div class="col-xs-6 col-lg-7 col-md-6 col-sm-6">
                    <div class="input-container">
                        <input type="text" id="BuildDate" class="form-control" readonly />
                        <span class="calendar-icon ClassA">
                            <i class="fa fa-calendar" aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>


        </div>

        <div class="row">

            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4">
                <div class="col-xs-6 col-lg-9 col-md-6 col-sm-6">
                    <label style="margin-right:20px;font-size:large;"> As a Pipeline Job ?</label>

                </div>
                <div class="col-xs-3 col-lg-3 col-md-3 col-sm-3">
                    <input type="radio" name="SelectJobType" value="1" style="vertical-align: -webkit-baseline-middle" />

                </div>

            </div>
            <div class="col-xs-4 col-lg-3 col-md-4 col-sm-4">
                <div class="col-xs-6 col-lg-8 col-md-6 col-sm-6">
                    <label style="font-size:large"> With Inventory ?</label>

                </div>
                <div class="col-xs-1 col-lg-1 col-md-1 col-sm-1">

                    <input type="checkbox" id="WithInventoryForPipelineJob" value="1" style="vertical-align: -webkit-baseline-middle" />
                </div>

            </div>
            <div class="col-xs-4 col-lg-5 col-md-4 col-sm-4">
                <div class="col-xs-6 col-lg-5 col-md-6 col-sm-6">
                    <label style="font-size:large">Pipeline Start Date </label>

                </div>
                <div class="col-xs-6 col-lg-7 col-md-6 col-sm-6">
                    <div class="input-container">
                        <input type="text" id="PipelineStartDate" class="form-control" readonly />
                        <span class="calendar-icon ClassB ">
                            <i class="fa fa-calendar" aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
            </div>

        </div>
        <hr />
        <div>
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12" style="text-align:center">
                <h4 style="margin-top:auto">Complete Job Copy ??</h4>
            </div>

        </div>

        <div class="row" style="padding-bottom: 20px">
            <div class="col-xs-4 col-lg-5 col-md-4 col-sm-4">

            </div>
            <div class="col-xs-2 col-lg-1 col-md-2 col-sm-2">
                <button Class="w3-btn w3-green w3-hover-dark-grey" id="btnFloorMarkYes" OnClick="btncopyhistYesClick()"><i class="glyphicon glyphicon-ok-circle"></i> Yes</button>
            </div>
            <div class="col-xs-2 col-lg-1 col-md-2 col-sm-2">
                <button Class="w3-btn nln-bg w3-hover-dark-grey" id="btnFloorMarkNo" onclick="btncopyhistNoClick();return false;"><i class="glyphicon glyphicon-remove-circle"></i> No</button>
            </div>
            <div class="col-xs-4 col-lg-5 col-md-4 col-sm-4"></div>

        </div>

    </div>
</div>

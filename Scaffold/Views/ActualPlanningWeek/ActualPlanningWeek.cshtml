            position: relative;
            display: block;
        }

        .input-container input {
            width: 100%;
            padding-right: 30px;
            box-sizing: border-box;
        }

    @@media (min-width: 768px) {
        .export-btn {
            width: auto;
        }

        #btnGenerate, #btnDeleteAll {
            width: auto;
        }

        .date-range {

    @@media (max-width: 768px) {
        .responsive-container {
            padding: 8px;
        }
    }

    @@media (max-width: 576px) {
        .responsive-container {
            padding: 5px;
        }
    }

    .dflex {
        display: flex;
        align-items: center;
    }

    .wfitContent {
        min-width: fit-content;

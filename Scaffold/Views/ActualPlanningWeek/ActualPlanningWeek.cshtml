            <b>
                <i class="fa fa-clock"></i>&nbsp;Actual Planning Week
            </b>
        </h4>
    </div>
</div>

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 date-range" style=" margin-left: 3px;">
    <div class="col-lg-3 col-md-2 col-sm-12 col-xs-12 dflex">
        <label style=" margin-left:0px; font-weight: bold;" class="wfitContent">Week Start Day:</label>
        <select id="ddlweekstartday" Class="form-control" style="width: 100%; margin-left: 5px;" disabled>
            <option value="2">Monday</option>
            <option value="3">Tuesday</option>
            <option value="4">Wednesday</option>
            <option value="5">Thursday</option>
            <option value="6">Friday</option>
            <option value="7">Saturday</option>
            <option value="1">Sunday</option>
        </select>
    </div>

    <div class="col-lg-3 col-md-2 col-sm-12 col-xs-12 dflex">
        <label for="txtFromDate" class="wfitContent">
            From Date:
        </label>
        <div style="position: relative; width: 93%; margin-left: 6px;">
            <input type="text"
                   id="txtFromDate"
                   placeholder="Select From Date"
                   style="width: 100%; padding: 4px 30px 4px 10px; border: 1px solid #ccc; border-radius: 4px;" readonly />
            <span class="calendar-icon" style="position: absolute; top: 50%; right: 10px; transform: translateY(-50%); cursor: pointer;">
                <i class="fa fa-calendar" aria-hidden="true"></i>
            </span>
        </div>
    </div>


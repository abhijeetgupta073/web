<script>

    $(function () {

        $("#txtFromDate").datepicker({
            dateFormat: "dd-M-yy",
            changeMonth: true,
            changeYear: true,
            maxDate: new Date(),
            onSelect: function (dateText, inst) {
                $(this).val(dateText);
            }
        });

        GetWeekStartDay();

        GetActualPlanningWeekData();


        $("#btnGenerate").on("click", function () {
            var Fromdate = $("#txtFromDate").val();
            //var ToDate = $("#txtToDate").val();
            if (Fromdate === "" || Fromdate == null) {
                var Response = { Result: "Failed", Message: "Please select From Date." };
                CustomAlert(Response);
                return;
            }
            //else if (ToDate === "") {
            //    var Response = { Result: "Failed", Message: "Please select To Date." };
            //    CustomAlert(Response);
            //    return;
            //}
            var fromDateObj = $("#txtFromDate").datepicker('getDate');
            //var toDateObj = $("#txtToDate").datepicker('getDate');
            //if (fromDateObj !== null && toDateObj !== null && fromDateObj > toDateObj) {
            //    var Response = { Result: "Failed", Message: "From Date must not be greater than To Date." };
            //    CustomAlert(Response);
            //    $("#txtFromDate").val("");
            //    $("#txtToDate").val("");
            //    return;
            //}
            //var today = new Date();
            //if (fromDateObj > today) {
            //    var Response = { Result: "Failed", Message: "From Date should not be greater than Today's Date." };
            //    CustomAlert(Response);
            //    return;
            // }

            // Calculate the date 10 weeks before today
            var today = new Date();
            var tenWeeksAgo = new Date();
            tenWeeksAgo.setDate(today.getDate() - (10 * 7)); // 10 weeks = 10 * 7 days

            if (fromDateObj > tenWeeksAgo) {
                var Response = { Result: "Failed", Message: "From Date must be earlier than 10 weeks before the current date." };
                CustomAlert(Response);
                $("#txtFromDate").val();
                return;
            }

            var fromDateDay = fromDateObj.getDay();
            fromDateDay = (fromDateDay === 0) ? 7 : fromDateDay; // Convert Sunday (0) to 7
            fromDateDay = fromDateDay % 7 + 1; // Shift Sunday to 1 and other days accordingly

            if (fromDateDay != getWeekStartDay) {
                var Response = { Result: "Failed", Message: "The selected From Date does not match the Week Start Day. Please select Date which matches the Week Start Day. " };
                CustomAlert(Response);
                $("#txtFromDate").val();
                return;
            }
            
            GenerateActualWeek(Fromdate);
        });


        $('#btnDeleteAll').on('click', function () {
            $("#confmodal").css("display", "block");
        });

    });


    function GetWeekStartDay() {
        $("#LoadingPanel1").css("display", "block");
        var id = getParameterByName('id');
        $.ajax({
            url: '/ActualPlanningWeek/BindWeekStartDayDropdown',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getData = response;
                getWeekStartDay = getData[getData.length - 1].WeekStartDay;
                $("#ddlweekstartday").val(getWeekStartDay);

                $("#LoadingPanel1").css("display", "none");
            }
        });

    }

    function GetActualPlanningWeekData() {
        $("#LoadingPanel1").css("display", "block");
        var id = getParameterByName('id');
        $.ajax({
            url: '/ActualPlanningWeek/ActualPlanningWeekData',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getdata = response;

                $('#gridActualPlanningWeekReport').DataTable().clear();
                $('#gridActualPlanningWeekReport').DataTable().destroy();

                var str = "";

                str += '<table id="gridActualPlanningWeekReport" class="table table-striped display">';
                str += "<thead><tr>";
                str += "<th style='text-align:center;width:8%;color:black;font-weight:bold;'>Week No.</th>";
                str += "<th style='text-align:center;width:8%;color:black;font-weight:bold;'>Week Start Date</th>";
                str += "<th style='text-align:center;width:8%;color:black;font-weight:bold;'>Week End Date</th>";
                str += "<th style='text-align:center;width:10%;color:black;font-weight:bold;'>Generated By</th>";
                str += "</tr></thead><tbody>";

                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var WeekNo = getdata[i].WeekNo == null ? "" : getdata[i].WeekNo;
                        var WeekStartDate = getdata[i].WeekStartDate == null ? "" : getdata[i].WeekStartDate;
                        var WeekEndDate = getdata[i].WeekEndDate == null ? "" : getdata[i].WeekEndDate;
                        var GeneratedBy = getdata[i].CreatedBy == null ? "" : getdata[i].CreatedBy;


                        str += "<tr>";
                        str += "<td style='text-align:center;width:8%;'>" + WeekNo + "</td>";
                        str += "<td style='text-align:center;width:8%'>" + DateFormat(WeekStartDate) + "</td>";
                        str += "<td style='text-align:center;width:8%'>" + DateFormat(WeekEndDate) + "</td>";
                        str += "<td style='text-align:center;width:10%'>" + GeneratedBy + "</td>";
                        str += "</tr>";
                    }
                    $("#btnGenerate").prop("disabled", true);
                    $("#btnDeleteAll").prop("disabled", false);
                } else {

                    $("#LoadingPanel1").css("display", "none");
                    $("#btnGenerate").prop("disabled", false);
                    $("#btnDeleteAll").prop("disabled", true);
                }

                str += "</tbody></table>";
                $("#loaddata").html(str);

                $('#gridActualPlanningWeekReport').dataTable({
                    "bSort": false,
                    "processing": true,
                    scrollY: '62vh',
                    searching: true,
                    paging: true,
                    "pageLength": 20,
                    info: false,
                    autoWidth: false,

                    dom: 'Bfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Actual Planning Week Report',
                            exportOptions: {
                                columns: ':visible'
                            }
                        }
                    ],
                });

                $("#LoadingPanel1").css("display", "none");
            },
            error: function (xhr, textStatus, errorThrown) {
                $("#LoadingPanel1").css("display", "none");
                var Response = { Result: "Failed", Message: errorThrown };
                CustomAlert(Response);
            }
        });
    }

    function GenerateActualWeek(Fromdate) {
        $("#LoadingPanel1").css("display", "block");
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        Fromdate = Fromdate;
        $.ajax({
            url: '/ActualPlanningWeek/GenerateActualPlanningWeek',
            type: 'POST',
            data: JSON.stringify({ Fromdate: Fromdate, id: id, UID: UID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $('#txtFromDate').val();
                var GetData = response;
                CustomAlert(response);
                GetActualPlanningWeekData();
            },
            error: function (xhr, textStatus, errorThrown) {
                var Response = { Result: "Failed", Message: errorThrown };
                CustomAlert(Response); 
            }
        });
    }

    function DeleteActualWeek() {
        var id = getParameterByName('id');
        $.ajax({
            url: '/ActualPlanningWeek/DeleteActualPlanningWeek',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $('#txtFromDate').val('');
                var GetData = response;
                CustomAlert(response);
                GetActualPlanningWeekData();
            }
        });
    }

    function btnyes_Click() {
        DeleteActualWeek();
        $("#confmodal").css("display", "none");
    }

    function btnno_Click() {
        $("#confmodal").css("display", "none");
    }

</script>

<div style="display:none;top: 0px;" id="CustomAlert">
    <span onclick="this.parentElement.style.display='none'" class="w3-closebtn">×</span>
    <span ID="alertMsg"></span>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12">

            <label for="txtToDate" class="wfitContent">
                To Date:
            </label>
            <div style="position: relative; width: 93%; margin-left: 6px;">
                <input type="text"
                       id="txtToDate"
                       placeholder="Select To Date"
                       style="width: 100%; padding: 4px 30px 4px 10px; border: 1px solid #ccc; border-radius: 4px;" readonly />
                <span class="calendar-icon" style="position: absolute; top: 50%; right: 10px; transform: translateY(-50%); cursor: pointer;">
                    <i class="fa fa-calendar" aria-hidden="true"></i>
                </span>
            </div>
        </div>*@

    <div class="col-lg-3 col-md-2 col-sm-12 col-xs-12">
        <button id="btnGenerate">Generate</button>
        <button id="btnDeleteAll">Delete All</button>
    </div>
</div>


{
    $('#txtTotalDeBoardEdit').val('');
    $('#txtTotalReInstateEdit').val('');
    $('#txtDeBoardItemEdit').val('');
    $('#txtreInstateEdit').val('');
    $('#divConfirmation').css('display','none');
// txtTotalDeBoardEdit.Text = "";
//txtTotalReInstateEdit.Text = "";
//txtDeBoardItemEdit.Text = "";
//txtreInstateEdit.Text = "";
//divConfirmation.Style.Add("display", "none");
}

function btnConfirNo_Click()
{
    //chkuseentervalue.Checked = true;
    $('#chkuseentervalue').prop('checked',true)
       // divConfirmation.Style.Add("display", "none");
    $('#divConfirmation').css('display', 'none');
}
</script>



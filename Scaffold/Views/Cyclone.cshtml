<script>
$(document).ready(function () {
    $('#liCyclone').removeClass('active').addClass('active');
    ShowJobInfoDetails();
    $('#maindivCyclone').css('display', 'block');
});

function btnsave_Click() {
    //public ActionResult btnsave_Click(string RID,string txtTotalDeBoardEdit,string chkuseentervalue,string ddlCycloneAction,string ddlPriorityRiskRating,string txtTotalReInstateEdit,string txtreInstateEdit,string txtDeBoardItemEdit,string txtcomments)
    var RID=getParameterByName('RID');
    var txtTotalDeBoardEdit=$('#txtTotalDeBoardEdit').val();
    var chkuseentervalue = $('#chkuseentervalue').prop('checked');
    var ddlCycloneAction=$('#ddlCycloneAction').val();
    var ddlPriorityRiskRating=$('#ddlPriorityRiskRating').val();
    var txtTotalReInstateEdit=$('#txtTotalReInstateEdit').val();
    var txtreInstateEdit = $('#txtreInstateEdit').val();
    var txtDeBoardItemEdit = $('#txtDeBoardItemEdit').val();
    var txtcomments = $('#txtcomments').val();
    var ddlRangeOfOutBoard = $('#ddlRangeOfOutBoard').val();
    $.ajax({
        type: "POST",
        url: "/Cyclone/btnsave_Click",
        data: JSON.stringify({ RID: RID, txtTotalDeBoardEdit: txtTotalDeBoardEdit, chkuseentervalue: chkuseentervalue, ddlCycloneAction: ddlCycloneAction, ddlPriorityRiskRating: ddlPriorityRiskRating, txtTotalReInstateEdit: txtTotalReInstateEdit, txtreInstateEdit: txtreInstateEdit, txtDeBoardItemEdit: txtDeBoardItemEdit, txtcomments: txtcomments, ddlRangeOfOutBoard: ddlRangeOfOutBoard }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            var GetData = response;
            if (response.Result == "Success") {
                CustomAlert(response);
                 $("#LoadingPanel1").css("display", "none");
                 ShowJobInfoDetails();
            } else {
                CustomAlert(response);
                $("#LoadingPanel1").css("display", "none");
            }
        }
    });
}


function chkuseentervalue_CheckedChanged() {
    $('#LoadingPanel1').show();
    if ($('#chkuseentervalue').prop('checked') == false) {
        $('#divConfirmation').css('display','block');
    }
    //if (chkuseentervalue.Checked == false) {
    //    divConfirmation.Style.Add("display", "block");
    //}
    $('#LoadingPanel1').hide();
}

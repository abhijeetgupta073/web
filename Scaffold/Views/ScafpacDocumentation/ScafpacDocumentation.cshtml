                dataType: "json",
                async: true,
                success: function (response) {
                    CustomAlert(response);
                    $('#modaltextbox').hide();
                    $('#ddldoctype').empty();
                    $('#txtdoctype').val('');
                    ddlDocumentType();
                }
            });
        }
    }


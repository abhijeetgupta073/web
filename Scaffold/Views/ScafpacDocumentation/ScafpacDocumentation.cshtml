    function ddlDocumentType() {
        //var ClientID = getParameterByName('id');
        var ClientID = 1;

        $.ajax({
            url: '/ScafpacDocumentation/ddlDocumentType',
            type: 'POST',
            data: JSON.stringify({ ClientID: ClientID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,

            success: function (response) {
                data = response;
                var optionAppend = "<option value=''>Select---</option>";
                $.each(data, function (index, obj) {
                    optionAppend += "<option value=" + obj.DocumentTypeId + ">" + obj.documentType + "</option>";
                });
                $('#ddldoctype').empty().append(optionAppend);

            }

        });
    }

    chckflag = false;
    function SaveDocument() {

        var files;
        var ddldoctype = $('#ddldoctype option:selected').text();
        var browerFile = $('#fileuplod').val();
        if (ddldoctype != 'Select---' && ddldoctype != '' && browerFile != null && browerFile != '') {

            $('#LoadingPanel1').css('display', 'block');
            // Checking whether FormData is available in browser
            if (window.FormData !== undefined) {
                if (files == null || files == "") {
                    var fileUpload = $('#fileuplod').get(0);
                    files = fileUpload.files;
                }
                var fileUpload = $('#fileuplod').get(0);
                // Create FormData object
                var fileData = new FormData();
                if (files.length != 0) {

                    var FileName = files[0].name;
                    var FileSize = files[0].size;
                    var Extension = FileName.substring(FileName.lastIndexOf('.') + 1).toLowerCase();
                    $('#hdnOriginalfileName').val(files[0].name);

                    if (Extension.toLowerCase() == "gif".toLowerCase() || Extension.toLowerCase() == "png" || Extension.toLowerCase() == "jpg".toLowerCase() || Extension.toLowerCase() == "jpeg".toLowerCase() || Extension.toLowerCase() == "pdf".toLowerCase() || Extension.toLowerCase() == "docx".toLowerCase() || Extension.toLowerCase() == "xlsx".toLowerCase() || Extension.toLowerCase() == "m4a".toLowerCase() || Extension.toLowerCase() == "Wav".toLowerCase() || Extension.toLowerCase() == "xls".toLowerCase() || Extension.toLowerCase() == "doc".toLowerCase() || Extension.toLowerCase() == "tif".toLowerCase() || Extension.toLowerCase() == "tiff".toLowerCase()) {

                        fileData.append(files[0].name, files[0]);
                        chckflag = true;
                    }
                    else {
                        var response = { Result: "Failed", Message: "<strong>Failed to upload Document ! </strong>Valid File Extensions Are jpg, jpeg, png, gif, pdf, docx, doc, xlsx, xls,tif,tiff" };
                        CustomAlert(response)
                        chckflag = false;
                    }
                }



                if (chckflag == true) {
                    var txtdesc = $('#txtdesc').val();
                    var OriginalDocumentName = $('#hdnOriginalfileName').val();

                    var UID = getParameterByName('UID');
                    var ClientID = getParameterByName('id');
                    var SiteID = $('#ddlSite').val();

                    fileData.append('ClientID', ClientID);
                    fileData.append('UID', UID);
                    fileData.append('SiteID', SiteID);
                    fileData.append('ddldoctype', ddldoctype);
                    fileData.append('txtdesc', txtdesc);
                    fileData.append('browerFile', browerFile);
                    fileData.append('OriginalDocumentName', OriginalDocumentName);
                    //Commented On 04-07-2023 We currently dont need this check on scafold/inpex. Thus it is copied from Waco but not deployed on Scafold/inpex
                    /*if (ddldoctype.toUpperCase() == Extension.toUpperCase()) {*/
                    $.ajax({
                        url: '/ScafpacDocumentation/btnsave_Click',
                        type: "POST",
                        contentType: false, // Not to set any content header
                        processData: false, // Not to process data
                        data: fileData,

                        success: function (response) {
                            CustomAlert(response);
                            $('#Adddocs').css('display', 'none');
                            $('#txtdesc').val('');
                            $('#fileuplod').val('');
                            $('#ddldoctype').val('');
                            $('#spnShowFileName').text('');
                            $('#hdnOriginalfileName').val('');
                            $('#LoadingPanel1').css('display', 'none');
                            GetDocumentTypeData();
                        }
                    });
                    //Commented On 04-07-2023 We currently dont need this check on scafold. Thus it is copied from Waco but not deployed on Scafold
                    //} else {
                    //    var Response = { Result: "Failed", Message: "Document Type And File Extension Should Be Same. Change Document Type And Click On Save. " };
                    //    CustomAlert(Response);
                    //}
                }
            }
        } else {
            var Response = { Result: "Failed", Message: "Select any file and document type" };
            CustomAlert(Response);
        }
        $('#LoadingPanel1').css('display', 'none');
    }

    function GetDocumentTypeData() {
        var ClientID = getParameterByName('id');
        var SiteID = $('#ddlSite').val();
        var CategoryID = $('#ddlCategory').val();
        if (SiteID == "") {
            var SiteID = "All";
        }
        $.ajax({
            url: '/ScafpacDocumentation/GetDocumentTypeData',
            type: 'POST',
            data: JSON.stringify({ ClientID: ClientID, SiteID: SiteID, CategoryID: CategoryID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,

            success: function (response) {
                var data = response;

                $('#tblDocument').DataTable().clear();
                $('#tblDocument').DataTable().destroy();

                if (data.length != 0) {
                    var str = '';
                    $.each(data, function (index, obj) {

                        var DocumentId = obj.DocumentId == null ? "" : obj.DocumentId;
                        var DocumentName = obj.DocumentName == null ? "" : obj.DocumentName;
                        var documentType = obj.documentType == null ? "" : obj.documentType;
                        var Description = obj.Description == null ? "" : obj.Description;
                        var DateOfUpload = obj.DateOfUpload == null ? "" : obj.DateOfUpload;
                        var DocumentPDFURL = obj.DocumentURL == null ? "" : obj.DocumentURL;
                        var OriginalDocumentName = obj.OriginalDocumentName == null ? "" : obj.OriginalDocumentName;


                        str += "<tr>";
                        str += "<td style='display:none'></td>";
                        /* str += "<td id=" + DocumentId + " title='Click here for Edit' style='cursor:pointer;' DDescription='" + Description + "'><i class='fa fa-pencil' onclick=OpeEditPopup('" + DocumentId + "','" + DocumentName + "')></i></td>";*/
                        str += "<td id=" + DocumentId + " title='Click here for Edit' style='cursor:pointer;' DDescription='" + Description + "'><i class='fa fa-pencil' onclick=OpeEditPopup('" + DocumentId + "')></i></td>";
                        str += "<td id='DeleveryDocIDDelete_" + index + "' title='Delete' style='cursor:pointer;'><i class='fa fa-trash' onclick=ShowDeletePopup('" + DocumentId + "')></i></td>";

                        str += "<td>" + OriginalDocumentName + "</td>";
                        str += "<td>" + documentType + "</td>";
                        str += "<td>" + Description + "</td>";
                        str += "<td>" + DateFormat(DateOfUpload) + "</td>";
                        str += "<td id='DeleveryDocID_" + index + "' title='View Record' style='cursor:pointer;'><button type='button' id='tbnView' Class='w3-btn w3-teal ViewRecord' documentURL='" + DocumentPDFURL + "' ><i class='fa fa-search'></i>&nbsp;View</button></td>";
                        str += "</tr>";
                    });
                    $('#tbodyTblDocument').html(str);

                }
                var table = $('#tblDocument').DataTable({
                    "bSort": false,
                    "processing": true,
                    scrollY: '62vh',
                    searching: true,
                    paging: false,
                    info: false,
                    autoWidth: false,

                });

                $('#tbodyTblDocument').on('click', '.ViewRecord', function (event) {
                    event.stopImmediatePropagation();
                    var DocumentURL = $(this).attr('documentURL');
                    if (DocumentURL != '') {
                        window.open(DocumentURL);
                    }
                });
                GridButtonHideShow(table, "tblDocument");
            }
        });
    }

    function ShowDeletePopup(DocumentId) {
        $('#hdnDocumentId').val(DocumentId);
        $("#Deletemodal").css("display", "block");
    }

    function OpeEditPopup(DocumentId) {
        $('#EditPopup').css("display", "block");

        var Description = $('#' + DocumentId).attr("DDescription");

        $('#hdnDocumentId').val(DocumentId);
        $('#txtdescription').val(Description);
       /* $('#hdnDocumentName').val(DocumentName);*/
    }

    function btnCancel() {
        $('#EditPopup').css("display", "none");
    }

    function btnyes_Click() {

        var DocumentId = $('#hdnDocumentId').val();

        $.ajax({
            url: '/ScafpacDocumentation/DeleteDocument',
            type: 'post',
            data: { DocumentId: DocumentId },
            async: false,
            success: function (response) {
                $("#Deletemodal").css("display", "none");
                if (response == 'Success') {
                    var Response = { Result: "Success", Message: "Record Delete Successfully." };
                    CustomAlert(Response);
                    GetDocumentTypeData();
                }
            }
        });
    }

    function btneditSave() {

        $('#LoadingPanel1').css('display', 'block');
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var hdnDocumentID = $('#hdnDocumentId').val();
        var txtdescription = $('#txtdescription').val();
        var hdnDocumentName = $('#hdnDocumentName').val();

        $.ajax({
            url: '/ScafpacDocumentation/btnEditSave',
            type: 'POST',
            data: JSON.stringify({ id: id, UID: UID, hdnDocumentID: hdnDocumentID, txtdescription: txtdescription, hdnDocumentName: hdnDocumentName }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,

            success: function (response) {
                var gat = response;
                if (response == "Success") {

                    $('#EditPopup').css("display", "none");

                    var Response = { Result: "Success", Message: "Record Saved Successfully." };
                    CustomAlert(Response);
                    GetDocumentTypeData();
                    $('#LoadingPanel1').css('display', 'none');
                }
            }
        });
        $('#LoadingPanel1').css('display', 'none');
    }

</script>



        } else {
            var response = { Result: 'Failed', Message: 'Select Report name from the list..' };
            CustomAlert(response);
        }
    }

    function submitDays() {
        var ddlScaffoldOwnerValue = $('#ddlScaffoldOwner option:selected').text();
        var siteLocationId = $('#ddlsiteloctnid').val();
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var listboxAvailableReports = $('#listboxAvailableReports option:selected').text();
        var Days = $('#daysDropdown option:selected').val();
        var clientID = $('#ddlClient').val();
        var siteLocId = $('#ddlsiteloctnid').val();
        var encryData = Encrypt([siteLocationId, listboxAvailableReports, ddlScaffoldOwnerValue]);
        siteLocationId = encryData[0];
        listboxAvailableReports = encryData[1];
        ddlScaffoldOwnerValue = encryData[2];
        if (buttontype == 1) {
            window.open('/NdaysStandingReport/NdaysStandingReport?UID=' + UID + '&id=' + id + '&site=' + siteLocationId + '&Owner=' + ddlScaffoldOwnerValue + '&availablereportname=' + listboxAvailableReports + '&btn=' + 'prv' + '&ClientID=' + clientID + '&SiteLocId=' + siteLocId + '&Days=' + Days);
        } else {
            window.open('/MultipleReport/ExportToCsvnStandingReportsDays_Click?UID=' + UID + '&id=' + id + '&site=' + siteLocationId + '&Owner=' + ddlScaffoldOwnerValue + '&availablereportname=' + listboxAvailableReports + '&btn=prv&ClientID=' + clientID + '&SiteLocId=' + siteLocId + '&Days=' + Days);
        }
    }

    function closePopup() {
        var modal = document.getElementById('activityReportPopup');
        modal.style.display = "none";
    }
</script>

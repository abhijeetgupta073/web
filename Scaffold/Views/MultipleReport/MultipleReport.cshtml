    function GetDescriptionValue() {
        var listboxAvailableReports = $('#listboxAvailableReports option:selected').text();
        //$("#listdescription").val('');
        $.ajax({
            url: '/MultipleReport/GetDescriptionValueData',
            type: 'post',
            async: false,
            data: { listboxAvailableReports: listboxAvailableReports },
            success: function (response) {

                if (response != null) {
                    $('#listdescription').text(response);
                }
            }
        });
    }

    function SaveDescriptionValue() {
        var listboxAvailableReports = $('#listboxAvailableReports option:selected').text();
        var listdescription = $('#listdescription').val();
        $.ajax({
            url: '/MultipleReport/listdescription_TextChanged',
            type: 'POST',
            async: false,
            data: { listboxAvailableReports: listboxAvailableReports, listdescription: listdescription },
            success: function (response) {
                if (response.Result == 'Success') {
                    CustomAlert(response);
                    GetDescriptionValue();
                } else {
                    CustomAlert(response);
                }
            }
        });
    }


        function BoxAvailableReportBind() {
            var id = getParameterByName('id');
            var UID = getParameterByName('UID');
            var UserRole = getParameterByName('UserRole');
            $.ajax({
                url: '/MultipleReport/ListBoxAvailableReportBind',
                type: 'get',
                contentType: "application/json; charset=utf-8",
                async: false,
                data: {
                    UID: UID, id: id, UserRole: UserRole
                },
                success: function (response) {
                    if (response != null) {
                        var optionAppend = "";
                        $.each(response, function (index, obj) {
                            optionAppend += "<option value=" + obj.ReportID + ">" + obj.ReportName + "</option>";
                        });
                        $('#listboxAvailableReports').empty().append(optionAppend);
                    }
                }
            });
        }





    function ddlsiteloction() {
        var id = getParameterByName('id');
        var UserRole = getParameterByName('UserRole');
        var UID = getParameterByName('UID');
        $.ajax({
            url: '/MultipleReport/ddlSiteLocation',
            type: 'post',
            async: false,
            data: { id: id, UserRole: UserRole, UID: UID },
            success: function (response) {

                if (response != null) {
                    var optionAppend = "<option value=''></option>";
                    $.each(response, function (index, obj) {
                        optionAppend += "<option value=" + obj.SiteLocID + ">" + obj.SiteLocation + "</option>";
                    });
                    $('#ddlsiteloctnid').empty().append(optionAppend);
                }
            }
        });
    }

    function ddlOwnerName() {
        var id = getParameterByName('id');
        $.ajax({
            url: '/MultipleReport/ddlownername',
            type: 'post',
            async: false,
            data: { id: id },
            success: function (response) {

                if (response != null) {
                    var optionAppend = "";
                   // $('#ddlScaffoldOwner').empty(); ///Add 07-Sep-2021
                    var optionAppend = "<option value=''>All</option>";   // Add 07-Sep-2021
                        $.each(response, function (index, obj) {
                        optionAppend += "<option value=" + obj.ScaffoldOwner + ">" + obj.ScaffoldOwner + "</option>";
                    });
                    $('#ddlScaffoldOwner').empty().append(optionAppend);
                }
            }
        });
    }


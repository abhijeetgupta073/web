        //$("#ContentPlaceHolder1_getCamera").on("click", function () {
        $("#getCamera").on("click", function () {
            $("#cancelsnap").on("click", function () {
                $("#btnOpenModel4").css("display", "none");
                cameraStream.stop();

            });
            $("#btnOpenModel4").css("display", "block");


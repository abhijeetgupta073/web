        $('#divCreatePop').css('display', 'none');
        $("#Photoblock").css('display', 'none');
        $('#txtdesc').val('');
        $('#TextBox1').val('');
    }


    function GetDrawingData() {
        var ClientID = getParameterByName('id');
        var RID = getParameterByName('RID');
        $.ajax({
            url: '/Drawings/GetDrawingData',
            type: 'POST',
            data: JSON.stringify({ RID: RID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,

            success: function (response) {
                var data = response;

                $('#tblDrowing').DataTable().clear();
                $('#tblDrowing').DataTable().destroy();

                if (data.length != 0) {
                    var str = '';
                    $.each(data, function (index, obj) {
                        var ID = obj.ID == null ? "" : obj.ID;
                        var DocumentName = obj.DocumentName == null ? "" : obj.DocumentName;
                        var OriginalDocumentName = obj.OriginalDocumentName == null ? "" : obj.OriginalDocumentName;
                        var RegisterID = obj.RegisterID == null ? "" : obj.RegisterID;
                        var Description = obj.Description == null ? "" : obj.Description;
                        var DocumentPdfPath = obj.DocumentURL == null ? "" : obj.DocumentURL;
                        var CreatedOn = obj.CreatedOn == null ? "" : obj.CreatedOn;

                        str += "<tr>";
                        str += "<td style='display:none;'></td>";
                        str += "<td id='DrawingIDDelete_" + index + "' title='Delete' style='cursor:pointer;'><i class='fa fa-trash' onclick=ShowDeletePopup('" + ID + "')></i></td>";
                        if (OriginalDocumentName == null || OriginalDocumentName == "") {
                            str += "<td>" + DocumentName + "</td>";
                        } else {
                            str += "<td>" + OriginalDocumentName + "</td>";
                        }
                        str += "<td>" + Description + "</td>";
                        str += "<td>" + DateFormat(CreatedOn) + "</td>";
                        str += "<td id='DrawingID_" + index + "' title='View Record' style='cursor:pointer;'><button type='button' id='tbnView' Class='w3-btn w3-teal ViewRecord' documentURL='" + DocumentPdfPath + "' ><i class='fa fa-search'></i>&nbsp;View</button></td>";
                        str += "</tr>";
                    });
                    $('#tbodyTblDrowing').html(str);

                }
                table = $('#tblDrowing').dataTable({
                    "bSort": false,
                    "processing": true,
                    scrollY: '22vh',
                    searching: true,
                    paging: false,
                    info: false,
                    autoWidth: false,

                });

                $('#tbodyTblDrowing').on('click', '.ViewRecord', function (event) {
                    event.stopImmediatePropagation();
                    var DocumentURL = $(this).attr('documentURL');
                    if (DocumentURL != '') {
                        window.open(DocumentURL);
                    }
                });
            }

        });
    }

    function ShowDeletePopup(DocumentId) {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        $('#hdnDocumentId').val(DocumentId);
        $("#Deletemodal").css("display", "block");
    }

    function btnyes_Click() {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        var DocumentId = $('#hdnDocumentId').val();
        var RID = getParameterByName('RID');
        $.ajax({
            url: '/Drawings/DeleteDrawing',
            type: 'post',
            data: { DocumentId: DocumentId, RID },
            async: false,
            success: function (response) {
                $("#Deletemodal").css("display", "none");
                if (response == 'Success') {
                    var Response = { Result: "Success", Message: "Record Delete Successfully." };
                    CustomAlert(Response);
                    GetDrawingData();
                    showtImage();
                }
            }
        });
    }

</script>

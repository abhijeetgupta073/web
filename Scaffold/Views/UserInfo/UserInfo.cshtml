    function btnSave_Click() {

        savepassword();
        var fileData = new FormData();
        var files;

        // Checking whether FormData is available in browser
        if (window.FormData !== undefined) {
            if (files == null || files == "") {
                var fileUpload = $('#radUpdogImg').get(0);
                files = fileUpload.files;
            }
            var fileUpload = $('#radUpdogImg').get(0);
            if (files.length != 0) {
                var FileName = files[0].name;
                var FileSize = files[0].size;
                var extension = FileName.substring(FileName.lastIndexOf('.') + 1).toLowerCase();
                fileData.append(files[0].name, files[0]);
            }
        }

        var UserID = getParameterByName('UserID');
        var decryptData = Decrypt([UserID]);
        UserID = decryptData[0];
        UserID = UserID == '' ? 0 : UserID;

        var UID = getParameterByName('UID');
        var id = getParameterByName('id');

        let firstName = $('#txtFirstname').val();
        let lastName = $('#txtLastname').val();
        let userRole = $('#ddluserrole option:selected').text();
        let status = $('#ddlstatus').val();
        let mobileNo = $('#txtContact').val();
        let emailAddress = $('#txtEmail').val();
        let chkInspector = $('#chkInspector').is(':checked');
        let licenceNo = $('#txtlicenceNo').val();
        let birthDate = $('#Birthdate').val();
        let category = $('#ddlCategory').val();
        let password = $('#txtPassworduser').val();
        let address = $('#txtAddress').val();
        let city = $('#txtcity').val();
        let state = $('#ddlstate option:selected').text();
        let ddlCountry = $('#ddlCountry option:selected').text();
        let postCode = $('#txtpostcodeuk').val();
        if (postCode == "") {
            postCode = $('#txtZip').val();
        }
        let ownerName = $('#ddlOwnerName option:selected').text();
        let subOwner = $('#ddlSubOwner option:selected').text();


        let Site, Location;
        if (userRole === "Client View Single Site Single Location") {
            Site = $('#ddlSite option:selected').val();
            if (Site === 'undefined' || Site == null) Site = '';

            Location = $('#ddlLocation option:selected').val();
            if (Location === 'undefined' || Location == null) Location = '';
        } else {
            Site = "";
            Location = "";
        }

        let notes = $('#txtnotes').val();
        let txtUK = $('#txtUK').val();
        let image = $('#tempimg').val();
        let imgangle = $('#imgangle').val();
        let radUpdogImg = $('#radUpdogImg').val();
        let hdnpassword = $('#hdnpassword').val();
        var txtIPAddress = $('#txtIPAddress').val();
        var ChkIpAddress = $('#ChkIpAddress').is(':checked');
        var ChkEmailAuthantication = $('#ChkEmailAuthantication').is(':checked');

        // Append all fields to FormData
        fileData.append('UserID', UserID);
        fileData.append('UID', UID);
        fileData.append('id', id);
        fileData.append('firstName', firstName);
        fileData.append('lastName', lastName);
        fileData.append('userRole', userRole);

        $("#getCamera").on("click", function () {
            // alert();

            $("#cancelsnap").on("click", function () {
                $("#btnOpenModel").css("display", "none");
                cameraStream.stop();
            });
            $("#btnOpenModel").css("display", "block");
            $(".hdnCamerabefore").css("display", "none");

            var canvas = document.getElementById('canvas');
            var context = canvas.getContext('2d');
            var video = document.querySelector('video#video');
            var cameraStream = null;
            var mediaConfig = { video: true };
            var errBack = function (e) {
                console.log('An error has occurred!', e)
            };
            // Put video listeners into place
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia(mediaConfig).then(function (stream) {
                    video.srcObject = stream;
                    video.play();
                    cameraStream = stream.getTracks()[0];
                });
            }
            /* Legacy code below! */
            else if (navigator.getUserMedia) { // Standard
                navigator.getUserMedia(mediaConfig, function (stream) {
                    video.src = stream;
                    video.play();
                    cameraStream = stream.getTracks()[0];
                }, errBack);
            }
            else if (navigator.mozGetUserMedia) {// Mozilla-prefixed
                navigator.mozGetUserMedia(mediaConfig, function (stream) {
                    video.src = window.URL.createObjectURL(stream);
                    video.play();
                    cameraStream = stream.getTracks()[0];
                }, errBack);
            }
            // Trigger photo take
            document.getElementById('snap').addEventListener('click', function () {
                $("#btnOpenModel").css("display", "none");
                $(".hdnCamerabefore").css("display", "block");
                $("#imga").css("display", "none");
                context.drawImage(video, 0, 0, 640, 480);
                var image = document.getElementById("canvas").toDataURL("image/png");
                $("#tempimg").val(image);
                $('#canvas').css('display', 'block');
                $('#radUpdogImg').css('display', 'none');
                $('#getCamera').css('display', 'none');
                $('#divdeleteimag').css('display', 'block');
                $('#btnchngeimg').css('display', 'none');
                $('#btnchngg').css('display', 'none');
                cameraStream.stop();
            });

        });
    });


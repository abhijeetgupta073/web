        fileData.append('ChkEmailAuthantication', ChkEmailAuthantication);

        function chkInspectorCheck() {
            var flag = false;
            if (chkInspector == true && licenceNo == "") {
                flag = true;
            }
            return flag;
        }

        if (CheckRequiredfields() == false) {
            if (validateEmail(emailAddress) == true) {
                $("#txtEmail").css("border-color", "");

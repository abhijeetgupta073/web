                    if ((ChkIpAddress == true && txtIPAddress != "") || ChkIpAddress == false) {
                        var ChekcIpAddress = CheckIPAddress(txtIPAddress);
                        if (ChekcIpAddress == true) {
                            $.ajax({
                                url: '/UserInfo/btnSave_Click',

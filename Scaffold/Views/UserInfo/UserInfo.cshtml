                    // $("#ddluserrole option:contains(" + response.Role + ")").attr('selected', 'selected');
                    if (response.Role != "") {
                        $('[id=ddluserrole] option').filter(function () {
                            return ($(this).text() == response.Role);
                        }).prop('selected', true);
                    }
                    $('#ddlstatus').val(response.Status);
                    $('#txtContact').val(response.CellPhone);
                    $('#txtUK').val(response.CellPhone);
                    $('#txtEmail').val(response.EmailID);
                    $('#txtlicenceNo').val(response.LicenceNo);
                    var IsInspector = response.IsInspector;
                    if (IsInspector == true) {
                        $('#chkInspector').prop('checked', true);
                    } else {
                        $('#chkInspector').prop('checked', false);
                    }
                    $('#Birthdate').val(DateFormat(response.BirthDate));
                    // $("#ddlCategory").val(response.Category);
                    $("#ddlCategory option:contains(" + response.Category + ")").attr('selected', 'selected');
                    $("#ddlCountry option:contains(" + response.Country + ")").attr('selected', 'selected');
                    $('#txtPassworduser').val(response.Password);
                    $('#txtAddress').val(response.Address);
                    $('#txtcity').val(response.City);
                    //$('#ddlstate').val(response.State);
                    if (response.Role == 'Inspection Audit View' || response.Role == 'Client View Single Site') {
                        $('#ddlOwnerName').prop("disabled", false);
                        $('#ddlSubOwner').prop("disabled", false);
                    } else {
                        $('#ddlOwnerName').prop("disabled", true);
                        $('#ddlSubOwner').prop("disabled", true);
                    }
                    const Site = document.getElementById("ddlSite")
                    const Location = document.getElementById("ddlLocation")
                    if (response.Role == 'Client View Single Site Single Location') {
                        $('#divSelectSiteAndLocation').css("display", "block");
                        ddlSite();
                        Site.setAttribute('required', 'required')
                        Location.setAttribute('required', 'required')


                    } else {
                        $('#divSelectSiteAndLocation').css("display", "none");
                        Site.removeAttribute('required', 'required')
                        Location.removeAttribute('required', 'required')
                    }

                    $("#ddlstate option:contains(" + response.State + ")").attr('selected', 'selected');
                    $('#txtpostcodeuk').val(response.Zip);
                    $('#txtZip').val(response.Zip);
                    //$('#ddlSubOwner').val(response.SiteOwnerName);

                    var SiteOwnerName = response.ScaffoldOwner;
                    if (SiteOwnerName != "") {
                        // $('#ddlSubOwner option:selected').text(SiteOwnerName);
                        $("#ddlSubOwner option:contains(" + response.ScaffoldOwner + ")").attr('selected', 'selected');

                    }
                    var ddlOwnerName = response.SiteOwnerName;
                    if (ddlOwnerName != "") {
                        $("#ddlOwnerName option:contains(" + response.SiteOwnerName + ")").attr('selected', 'selected');
                    }

                    let SiteData = response.Site;
                    if (SiteData) {
                        $("#ddlSite").val(SiteData)
                    }
                    let LocationData = response.Location;
                    if (LocationData) {
                        ddlLocation();

                        $("#ddlLocation").val(LocationData)

                    }
                    var IPAddress = response.IPAddress == null ? "" : response.IPAddress;
                    var IPAuthentication = response.IPAuthentication;
                    if (IPAuthentication == true) {
                        $('#ChkIpAddress').prop('checked', true);
                    } else {
                        $('#ChkIpAddress').prop('checked', false);
                    }
                    $('#txtIPAddress').val(IPAddress);
                    var EmailAuthentication = response.EmailAuthentication;
                    if (EmailAuthentication == true) {
                        $('#ChkEmailAuthantication').prop('checked', true);
                    } else {
                        $('#ChkEmailAuthantication').prop('checked', false);
                    }

                    $('#txtnotes').val(response.notes);
                    if (response.LicencePicUpload != null && response.LicencePicUpload != '') {
                        $('#imga').attr('src', '/Images/UserLicencePic/' + response.LicencePicUpload);
                        $('#divdeleteimag').css('display', 'block');
                        $('#deleteimageupload').val(response.LicencePicUpload);
                    } else {
                        $("#imga").attr("src", "/images/noimg.jpg");
                        $('#divdeleteimag').css('display', 'none');
                    }
                }
                $('#userDetailsMainDiv').css('display', 'block');
            }
        });
    }



    function btnAddUser_Click() {
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var Clientid = getParameterByName('id');
        var UserID = '0';
        var encryData = Encrypt([UserID]);
        UserID = encryData[0];
        window.location.href = '/UserInfo/UserInfo?UID=' + UID + '&UserRole=' + UserRole + '&id=' + Clientid + '&UserID=' + UserID;
    }

    function btndeleteyes_Click() {
        var UserID = getParameterByName('UserID');
        var deleteimageupload = $('#deleteimageupload').val();
        $.ajax({
            url: '/UserInfo/btndeleteyes_Click',
            type: 'post',
            async: false,
            data: { UserID: UserID, deleteimageupload: deleteimageupload },
            success: function (response) {
                if (response.Result == 'Success') {
                    CustomAlert(response);
                    $('#divdelete').css('display', 'none');
                    ShowClientDetails();
                } else {
                    CustomAlert(response);
                }
            }
        });
    }

    function btnbackRegister_Click() {
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var RID = getParameterByName('RID');
        window.location.href = '/Register/Register?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&RID=' + RID;
        // Response.Redirect("Register.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&RID=" + Request.QueryString["RID"], false);
    }

    function btnbackInspection_Click() {
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var RID = getParameterByName('RID');

        window.location.href = '/InspectionList/InspectionList?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&RID=' + RID + '&from=' + "Job";
        //  Response.Redirect("InspectionList.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&RID=" + Request.QueryString["RID"], false);
    }


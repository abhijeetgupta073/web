                $("#txtEmail").css("border-color", "red");
            }
        } else {
            Res = { Result: 'Failed', Message: 'Please fill out mandatory fields' };
            CustomAlert(Res);
        }
    }


    function CheckRequiredfields() {
        var requiredInput = false;
        $('#ModalUserInfo').find('input, select').each(function () {
            if ($(this).prop('required') == true && ($(this).val() == "" || $(this).val() == null)) {
                if (requiredInput == false) {
                    requiredInput = true;
                }
                $(this).addClass('requiredColumn');
            } else {
                $(this).removeClass('requiredColumn');
            }
        });
        return requiredInput;
    }

    function validateEmail(email) {
        const re = /^(([^<>()\[\]\\.,;:\s@@"]+(\.[^<>()\[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        //return re.test(String(email).toLowerCase());
        if (re.test(String(email).toLowerCase())) {
            return true;
        } else {
            return false;
        }
    }


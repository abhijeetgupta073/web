        var hdnDDDocumentID = $('#hdnDocumentId').val();
        var txtdescription = $('#txtdescription').val();
        var hdnDocumentName = $('#hdnDocumentName').val();
        
            $.ajax({
                url: '/Document/btnEditSave',

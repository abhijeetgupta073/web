    function ddlDocumentType() {
        var ClientID = getParameterByName('id');
        $.ajax({
            url: '/Document/ddlDocumentType',
            type: 'POST',
            data: JSON.stringify({ ClientID: ClientID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,

            success: function (response) {
                data = response;
                var optionAppend = "<option value=''>Select---</option>";
                $.each(data, function (index, obj) {
                    optionAppend += "<option value=" + obj.DocumentTypeId + ">" + obj.documentType + "</option>";
                });
                $('#ddldoctype').empty().append(optionAppend);

            }

        });
    }

    function txtdoctype_TextChanged() {
        SaveDocumentTypeValue();
    }

    function SaveDocumentTypeValue() {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        var txtDoctype = $('#txtdoctype').val();
        var ClientID = getParameterByName('id');
        var UID = getParameterByName('UID');
        //var alphanumericRegex = /^[a-zA-Z0-9]+$/;
        var alphanumericRegex = /^[a-zA-Z0-9\s]+$/;
        if (!alphanumericRegex.test(txtDoctype)) {
            //alert("Please enter only alphanumeric characters.");
            var Response = { Result: "Failed", Message: "Please Enter Only Numbers And Alphabet" };
            CustomAlert(Response);
            document.getElementById("txtdoctype").value = "";
        } else {
            $.ajax({
                url: '/Document/txtdoctype_TextChanged',
                type: 'POST',
                data: JSON.stringify({ txtDoctype: txtDoctype, ClientID: ClientID, UID: UID }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                    CustomAlert(response);
                    $('#modaltextbox').hide();
                    $('#ddldoctype').empty();
                    $('#txtdoctype').val('');
                    ddlDocumentType();

                }
            });
        }
    }

    function GetDocumentTypeData() {
        var ClientID = getParameterByName('id');
        var RID = getParameterByName('RID');
        $.ajax({
            url: '/Document/GetDocumentTypeData',
            type: 'POST',
            data: JSON.stringify({ ClientID: ClientID, RID: RID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,

            success: function (response) {
                var data = response;

                $('#tblDocument').DataTable().clear();
                $('#tblDocument').DataTable().destroy();

                if (data.length != 0) {
                    var str = '';
                    $.each(data, function (index, obj) {

                        var DocumentId = obj.DocumentId == null ? "" : obj.DocumentId;
                        var DocumentName = obj.DocumentName == null ? "" : obj.DocumentName;
                        var documentType = obj.documentType == null ? "" : obj.documentType;
                        var Description = obj.Description == null ? "" : obj.Description;
                        var DateOfUpload = obj.DateOfUpload == null ? "" : obj.DateOfUpload;
                        var DocumentPDFURL = obj.DocumentURL == null ? "" : obj.DocumentURL;
                        var OriginalDocumentName = obj.OriginalDocumentName == null ? "" : obj.OriginalDocumentName;

                        str += "<tr>";
                        str += "<td style='display:none'></td>";
                       /* str += "<td id=" + DocumentId + " title='Click here for Edit' style='cursor:pointer;' DDescription='" + Description + "'><i class='fa fa-pencil' onclick=OpeEditPopup('" + DocumentId + "','" + DocumentName + "')></i></td>";*/
                        str += "<td id=" + DocumentId + " title='Click here for Edit' style='cursor:pointer;' DDescription='" + Description + "'><i class='fa fa-pencil' onclick=OpeEditPopup('" + DocumentId + "')></i></td>";
                        str += "<td id='DeleveryDocIDDelete_" + index + "' title='Delete' style='cursor:pointer;'><i class='fa fa-trash' onclick=ShowDeletePopup('" + DocumentId + "')></i></td>";

                        str += "<td>" + OriginalDocumentName + "</td>";
                        str += "<td>" + documentType + "</td>";
                        str += "<td>" + Description + "</td>";
                        str += "<td>" + DateFormat(DateOfUpload) + "</td>";
                        str += "<td id='DeleveryDocID_" + index + "' title='View Record' style='cursor:pointer;'><button type='button' id='tbnView' Class='w3-btn w3-teal ViewRecord' documentURL='"+ DocumentPDFURL +"' ><i class='fa fa-search'></i>&nbsp;View</button></td>";
                        str += "</tr>";
                    });
                    $('#tbodyTblDocument').html(str);
                  
                }
               var table = $('#tblDocument').DataTable({
                    "bSort": false,
                    "processing": true,
                    scrollY: '62vh',
                    searching: true,
                    paging: false,
                    info: false,
                    autoWidth: false,

                });

                $('#tbodyTblDocument').on('click', '.ViewRecord', function (event) {
                        event.stopImmediatePropagation();
                        var DocumentURL = $(this).attr('documentURL');
                        if (DocumentURL != '') {
                            window.open(DocumentURL);
                        }
                });

                // Hide Show For DataTable Column And Buttons Start Here

                GridButtonHideShow(table, "tblDocument");

                // Hide Show For DataTable Column And Buttons End Here
            }

        });
    }

 

    function ShowDeletePopup(DocumentId) {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        $('#hdnDocumentId').val(DocumentId);
        $("#Deletemodal").css("display", "block");
    }

    function btnyes_Click() {

        var DocumentId = $('#hdnDocumentId').val();

        $.ajax({
            url: '/Document/DeleteDocument',
            type: 'post',
            data: { DocumentId: DocumentId },
            async: false,
            success: function (response) {
                 $("#Deletemodal").css("display", "none");
                if (response == 'Success') {
                    var Response = { Result: "Success", Message: "Record Delete Successfully." };
                    CustomAlert(Response);
                    GetDocumentTypeData();
                }
            }
        });
    }

    function OpeEditPopup(DocumentId) {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        $('#EditPopup').css("display", "block");

        var Description = $('#' + DocumentId).attr("DDescription");

        $('#hdnDocumentId').val(DocumentId);
        $('#txtdescription').val(Description);
       /* $('#hdnDocumentName').val(DocumentName);*/
    }


    function btneditSave() {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });

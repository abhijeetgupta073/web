    chckflag = false;
    function SaveDocument() {
        if (IsSiteStatus == "InActive") {
            CustomAlert({
                Result: "Failed", Message: "This site is InActive. This Action is not allowed."
            });
            return false;
        }
        var files;
        var ddldoctype = $('#ddldoctype option:selected').text();
        var browerFile = $('#fileuplod').val();
        if (ddldoctype != 'Select---' && ddldoctype != '' && browerFile != null && browerFile != '') {

            $('#LoadingPanel1').css('display', 'block');
            // Checking whether FormData is available in browser
            if (window.FormData !== undefined) {
                if (files == null || files == "") {
                    var fileUpload = $('#fileuplod').get(0);
                    files = fileUpload.files;
                }
                var fileUpload = $('#fileuplod').get(0);
                // Create FormData object
                var fileData = new FormData();
                if (files.length != 0) {

                    var FileName = files[0].name;
                    var FileSize = files[0].size;
                    var Extension = FileName.substring(FileName.lastIndexOf('.') + 1).toLowerCase();
                    $('#hdnOriginalfileName').val(files[0].name);

                    if (Extension.toLowerCase() == "gif".toLowerCase() || Extension.toLowerCase() == "png" || Extension.toLowerCase() == "jpg".toLowerCase() || Extension.toLowerCase() == "jpeg".toLowerCase() || Extension.toLowerCase() == "pdf".toLowerCase() || Extension.toLowerCase() == "docx".toLowerCase() || Extension.toLowerCase() == "xlsx".toLowerCase() || Extension.toLowerCase() == "m4a".toLowerCase() || Extension.toLowerCase() == "Wav".toLowerCase() || Extension.toLowerCase() == "xls".toLowerCase() || Extension.toLowerCase() == "doc".toLowerCase() || Extension.toLowerCase() == "tif".toLowerCase() || Extension.toLowerCase() == "tiff".toLowerCase()) {

                        fileData.append(files[0].name, files[0]);
                        chckflag = true;
                    }
                    else {
                        var response = { Result: "Failed", Message: "<strong>Failed to upload Document ! </strong>Valid File Extensions Are jpg, jpeg, png, gif, pdf, docx, doc, xlsx, xls, tif, tiff" };
                        CustomAlert(response)
                        chckflag = false;
                    }
                }

                if (chckflag == true) {
                    var txtdesc = $('#txtdesc').val();
                    var OriginalDocumentName = $('#hdnOriginalfileName').val();

                    var UID = getParameterByName('UID');
                    var ClientID = getParameterByName('id');
                    var RID = getParameterByName('RID');

                    fileData.append('ClientID', ClientID);
                    fileData.append('UID', UID);
                    fileData.append('RID', RID);
                    fileData.append('ddldoctype', ddldoctype);
                    fileData.append('txtdesc', txtdesc);
                    fileData.append('browerFile', browerFile);
                    fileData.append('OriginalDocumentName', OriginalDocumentName);
                    //Commented On 04-07-2023 We currently dont need this check on scafold/inpex. Thus it is copied from Waco but not deployed on Scafold/inpex 
                    /*if (ddldoctype.toUpperCase() == Extension.toUpperCase()) {*/
                        $.ajax({
                            url: '/Document/btnsave_Click',
                            type: "POST",
                            contentType: false, // Not to set any content header
                            processData: false, // Not to process data
                            data: fileData,

                            success: function (response) {
                                CustomAlert(response);
                                $('#Adddocs').css('display', 'none');
                                $('#txtdesc').val('');
                                $('#fileuplod').val('');
                                $('#ddldoctype').val('');
                                $('#spnShowFileName').text('');
                                $('#hdnOriginalfileName').val('');
                                $('#LoadingPanel1').css('display', 'none');
                                GetDocumentTypeData();
                            }
                        });

                     //Commented On 04-07-2023 We currently dont need this check on scafold. Thus it is copied from Waco but not deployed on Scafold 
                    /*}*/
                    //Commented On 04-07-2023 We currently dont need this check on scafold. Thus it is copied from Waco but not deployed on Scafold 
                    //else {
                    //    var Response = { Result: "Failed", Message: "Document Type And File Extension Should Be Same. Change Document Type And Click On Save. " };
                    //    CustomAlert(Response);
                    //}
                }
            }

        }
        else {
            var Response = { Result: "Failed", Message: "Select any file and document type" };
                        CustomAlert(Response);
        }
        $('#LoadingPanel1').css('display', 'none');
    }


    $('#btnprint').css('display', 'block');
    $("#divbuttonsave").css("display", "none");
    GetSiteManHrsData();
  
    }
   function txtDate_SelectedDateChanged(){
    var SiteID = $('#ddlSite').val();
    if (SiteID != ""){
    GetSiteManHrsData();
      }
   } 

    var table = "";
    var SiteManHrsArr = [];
    function GetSiteManHrsData() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSite').val();
       
        var siteName = $('#ddlSite option:selected').text();
        var EntryDate = $('#txtDate').val();
        if ('@ViewBag.ExportToCSV' != "") {
            var chckExportToCsv = '@ViewBag.ExportToCSV' ;
          }

        $('#LoadingPanel1').show();
        
     if (SiteID != "") {
        $.ajax({
            type: "POST",
            url: "/SiteManHrs/GetSiteManHrsData",
            data: JSON.stringify({ id: id,SiteID:SiteID,siteName:siteName,EntryDate:EntryDate, chckExportToCsv:chckExportToCsv }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                
                var GetData = response;
                $('#tblSiteManHrsList').DataTable().clear();
                $('#tblSiteManHrsList').DataTable().destroy();
              //  $('#mainDivDataTable').css('display','block');
                if (GetData.length > 0) {
                    $("#divbuttonsave").css("display", "block");
                    var str = "";
                    for (var i = 0; i < GetData.length; i++) {
                        var SiteManHrsId = GetData[i].SiteManHrsId == null ? "" : GetData[i].SiteManHrsId;
                        var SiteLocId = GetData[i].SiteLocId == null ? "" : GetData[i].SiteLocId;
                        var SiteLocation = GetData[i].SiteLocation == null ? "" : GetData[i].SiteLocation;

                        var UserId = GetData[i].UserId == null ? "" : GetData[i].UserId;
                        var Resource = GetData[i].name == null ? "" : GetData[i].name;
                        var NoOfWorkedHrs = GetData[i].NoOfWorkedHrs == null ? "" : GetData[i].NoOfWorkedHrs.toFixed(2);
                        var IsPresent = GetData[i].IsPresent == null ? "" : GetData[i].IsPresent;
                        var AllocatedHrs = GetData[i].AllocatedHrs == null ? "" : GetData[i].AllocatedHrs.toFixed(2);
                        var Category = GetData[i].Category == null ? "" : GetData[i].Category;
                        var EntryDate = GetData[i].EntryDate == null ? "" : GetData[i].EntryDate;

                        str += "<tr>"
                        str += "<td class='setWidth0' id='SiteManHrsId_" + i + "' style='display:none'>" + SiteManHrsId + "</td>"
                        if(IsPresent == "Yes"){
                        str += "<td class='setWidth0'><input type='checkbox' class='Chkselected' id='CheckBoxIndex_" + i + "' checked /></td>"
                        } else{
                        str += "<td class='setWidth0'><input type='checkbox' class='Chkselected' id='CheckBoxIndex_" + i + "' /></td>"
                        } 
                        str += "<td class='setWidth1' id='SiteLocation_" + i + "'>" + SiteLocation + "</td>"
                        str += "<td class='setWidth2' id='Resource_" + i + "'>" + Resource + "</td>"
                        str += "<td class='setWidth3' id='Category_" + i + "'>" + Category + "</td>"
                        str += "<td class='setWidth4' id='AllocatedHrs_" + i + "'>" + AllocatedHrs + "</td>"
                        
                        str += "<td class='setWidth5' style='background-color: LightCyan;'><input id='NoOfWorkedHrs_" + i + "' min='0' type='number' class='Noofworks EnterQuantity form-control' value= '"+NoOfWorkedHrs+ "' /></td>"
                      
                      
                        str += "<td class='setWidth6' id='EntryDate_" + i + "'>" + EntryDate+ "</td>"  
                        str += "<td class='setWidth7' id='UserId_" + i + "' style='display:none'>" + UserId + "</td>"                  

                    }

                    $('#tbodySiteManHrsList').append(str);

                    $('.Chkselected').click(function () {
                        event.stopImmediatePropagation();
                         var CheckBoxAll = $(this).prop('checked');
                         var indexNumber = this.id.split('_')[1];
                        
                        if (CheckBoxAll == true) {
                          $("#NoOfWorkedHrs_" + indexNumber).val($('#txtstandardworkinghour').val());
                          $("#NoOfWorkedHrs_" + indexNumber).css('border','1px solid Red');
                            
                        } else {
                           $("#NoOfWorkedHrs_" + indexNumber).val("0.00");
                           $("#NoOfWorkedHrs_" + indexNumber).css('border','1px solid #9e9898');
                        }

                    });


                    $('#LoadingPanel1').hide();
                }
                $('#LoadingPanel1').hide();
                table = $('#tblSiteManHrsList').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    "bLengthChange": true,
                    "bInfo": false,
                    autoWidth: true,
                    scrollX: true,
                    scrollY: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    "lengthMenu": [10, 25, 50, 100, 200],
                    "pageLength": 50,

                    dom: 'Bfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Daily Site Hours Input List',
                            exportOptions: {
                                columns: [2,3, 4, 5, 6, 7]
                            },
                        }
                    ],

                });

            }
        })

      }
      else {
       $("#LoadingPanel1").css("display", "none");
      // $('#mainDivDataTable').css('display','none');

        }
    }

    function ExportToCsvButton_Click() {
    //@ViewBag.ExportToCSV="true";
    $('.dt-button.buttons-csv.buttons-html5').trigger('click');
    }

   function btnprint_Click(){
      $('#LoadingPanel1').show();
      if ($('#ddlSite').val() != "") {

                var ClientID = getParameterByName('id');
                var UID = getParameterByName('UID');
                var UserRole = getParameterByName('UserRole');  
                var SiteID = $('#ddlSite').val(); 
                var EntryDate = $('#txtDate').val(); 
                window.open('/SiteManHrsReport/showreport?UID=' + UID + '&UserRole=' + UserRole + '&id=' + ClientID + '&SiteId=' + SiteID + '&EntryDate=' + EntryDate );
                $("#LoadingPanel1").hide();
                } else {
                    var response = { Result: "Failed", Message: "Please Select Site ." }
                    CustomAlert(response);
                    $('#LoadingPanel1').hide();
                }
   }


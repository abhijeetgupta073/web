   function dropdownSiteLocation() {
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    //$('#LoadingPanel1').css('display', 'block');
    $.ajax({
        type: "POST",
        url: "/SiteManHrs/dropdownSiteLocation",

        data: JSON.stringify({ id: id, UID: UID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {

            var SiteData = response;
            if (SiteData.length > 0) {
                $("#ddlSite").append('<option value=""></option>');
                for (var i = 0; i < SiteData.length; i++) {
                    $("#ddlSite").append("<option value='" + SiteData[i].SiteLocID + "'>" + SiteData[i].SiteLocation + "</option>");
                }
            }
           
        }

    })
  }

  function btnSaveSiteManHrs_Click(){
       $('#LoadingPanel1').show();

        SiteManHrsDataArr = [];
        var ChkUpdateAllflag = false;
        if ($('#ddlSite').val() != "") {
         table.$('.Chkselected').each(function () {
                        if (this.checked) {
                            ChkUpdateAllflag = true;

                             var indexNumber = this.id.split('_')[1];
                             var SiteManHrsId = $("#SiteManHrsId_" + indexNumber).text();
                             var UserId = $("#UserId_" + indexNumber).text();
                             var Resource = $("#Resource_" + indexNumber).text();
                             var Category = $("#Category_" + indexNumber).text();
                             var AllocatedHrs = $("#AllocatedHrs_" + indexNumber).text();
                             var NoOfWorkedHrs = $("#NoOfWorkedHrs_" + indexNumber).val();
                             var EntryDate = $("#EntryDate_" + indexNumber).text();
                             var SiteLocation = $("#SiteLocation_" + indexNumber).text();                             
                             var ClientID = getParameterByName('id');
                             var UID = getParameterByName('UID');
                             var SiteID = $('#ddlSite').val();                     
                                                  
                            var ArryVal = { ClientID: ClientID, SiteLocId: SiteID, SiteManHrsId: SiteManHrsId, NoOfWorkedHrs: NoOfWorkedHrs, UserId:UserId, EntryDate:EntryDate ,UID:UID};
                            SiteManHrsDataArr.push(ArryVal);
                        }
                    });
                    if (ChkUpdateAllflag == true) {
                        $.ajax({
                            type: 'post',
                            url: '/SiteManHrs/btnSaveSiteManHrs_Click',
                            data: JSON.stringify({ model: SiteManHrsDataArr }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            async: false,
                            success: function (response) {
                                var GetData = response;
                                CustomAlert(response);
                                
                                GetSiteManHrsData();
                               
                            }
                        });
                    }
                    else {
                        var response = { Result: "Failed", Message: "Please select check box then click on Save Button." }
                        CustomAlert(response);
                        $('#LoadingPanel1').hide();
                    }
                  } else {
                    var response = { Result: "Failed", Message: "Please Select Site." }
                    CustomAlert(response);
                    $('#LoadingPanel1').hide();
                }

  }


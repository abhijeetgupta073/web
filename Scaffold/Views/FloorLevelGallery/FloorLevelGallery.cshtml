            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getData = response;
                $("#ddlFloorLabel").html("");
                // $("#ddlFloorLabel").append('<option value="All">All</option>');
                for (var i = 0; i < getData.length; i++) {

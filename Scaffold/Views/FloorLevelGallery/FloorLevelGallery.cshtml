    function DropdownFloorLevelBind() {
        var id = getParameterByName('id');
        var ddlSites = $("#ddlSites").val();
        var ddlLocaSite = $('#ddlLocaSite').val();
        var ddlBuilding = $('#ddlBuilding').val();
        var siteName = $("#ddlSites option:selected").text();
        $.ajax({
            type: "POST",
            url: "/FloorLevelGallery/DropdownFloorLevelBind",
            data: JSON.stringify({ id: id, ddlSites: ddlSites, ddlLocaSite: ddlLocaSite, ddlBuilding: ddlBuilding, siteName: siteName }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getData = response;
                $("#ddlFloorLabel").html("");
                 for (var i = 0; i < getData.length; i++) {
                    $("#ddlFloorLabel").append('<option value="' + getData[i].FloorLevelId + '">' + getData[i].FloorLevel + '</option>');
                }
            }
        });

        showthumnail();
    }
    function showthumnail() {

        var id = getParameterByName('id');
        var ddlSites = $("#ddlSites").val();
        ddlSites = ddlSites == null ? 0 : ddlSites;
        var ddlLocaSite = $('#ddlLocaSite').val();
        ddlLocaSite = ddlLocaSite == null ? "" : ddlLocaSite;
        var ddlBuilding = $('#ddlBuilding').val();
        ddlBuilding = ddlBuilding == null ? "" : ddlBuilding;
        $.ajax({
            url: '/FloorLevelGallery/showthumnail',
            type: 'POST',
            data: JSON.stringify({ id: id, ddlSites: ddlSites, ddlLocaSite: ddlLocaSite, ddlBuilding: ddlBuilding}),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                $('#placeholderforimage').empty().append(response);
              
                $('img').on('click', function () {
                    var imageid = this.id;
                    var SiteImageID = imageid.split('ppdl')[1];
                    if (imageid != 'ppdl') {
                        $('#ppdl').attr("src", this.src);
                        $('#popups').css('display', 'block');
                        $('#hdnImageId').val(SiteImageID);
                    }

                    else {

                    }
                });

                $('.close').on('click', function () {
                    $('#popups').css('display', 'none');
                });

            }

        });

    }


    function btndeletedyes_Click() {
        var id = getParameterByName('id');
        var ddlSites = $("#ddlSites").val();
        var hdnimgnames = $("#hdnimgnames").val();
        var hdnImageId = $('#hdnImageId').val();
        var ddlLocaSite = $('#ddlLocaSite').val();
        ddlLocaSite = ddlLocaSite == null ? "" : ddlLocaSite;
        var ddlBuilding = $('#ddlBuilding').val();
        ddlBuilding = ddlBuilding == null ? "" : ddlBuilding;

        $.ajax({
            url: '/FloorLevelGallery/btndeletedyes_Click',
            type: 'POST',
            data: JSON.stringify({ id: id, ddlSites: ddlSites, hdnimgnames: hdnimgnames, ddlLocaSite: ddlLocaSite, ddlBuilding: ddlBuilding, hdnImageId: hdnImageId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                $('#divdeleted').css("display", "none");
                if (response.Result != "") {
                    CustomAlert(response);
                    showthumnail();
                }
            }

        });
    }

    function addnewimages() {
        $('#FileUploads').val('');
        $('#txtdrawing').val('');
        $('#btnchoose').prop('checked', true);
        DropdownFloorLevelBind();
        HideChoose();
        HideSelect();
       
        //dropdownDrawing();
        //ShowDrawingImage();
        $("#ddlFloorLabel option").prop("selected", false);
        $("#txtdescs").val(' ');
        var siteID = $('#ddlSites').val(); 
        let buildingId = $('#ddlBuilding').val();
        let ddlLocaSite = $('#ddlLocaSite').val();
        if (siteID != "") {
            $("#divChooseSelectFile").css("display", "none");
            $("#divCreatePops").css("display", "block");
            $("#divdrawing").css("display", "none");
            $('#divddlFileSelect').css('display', 'none');
        } else {
            //$('#ContentPlaceHolder1_art1').removeClass('w3-section w3-card-12 j-alertBox-Success').addClass('w3-section fadeOut w3-card-12 j-alertBox-Failed');
            //$('#ContentPlaceHolder1_art1').css("display", "block");
            //$('#ContentPlaceHolder1_alertlabel').html('<strong>Alert ! </strong>Please Select Site And Then Add Floor Level Image .');
            //hideAlert();
            var Response = { Result: "Failed", Message: "Please Select Site And Then Add Floor Level Image ." };
            CustomAlert(Response);
        }
        if (buildingId != "") {
            DropdownFloorLevelBind();
        } else {
            if (siteID != "" && ddlLocaSite != "") {
                $("#divCreatePops").css("display", "none");
                var Response = { Result: "Failed", Message: "Please Select Building also And Then Add Floor Level Image." };
                CustomAlert(Response);
            }
        }

        if (siteID != "" && ddlLocaSite != "" && buildingId != "") {
            $("#divChooseSelectFile").css("display", "block");
            $("#divCreatePops").css("display", "block");
            $("#divdrawing").css("display", "block");
            // $('#divddlFileSelect').css('display', 'block');
          
        }

    }



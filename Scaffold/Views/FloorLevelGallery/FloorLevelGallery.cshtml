            data: JSON.stringify({ id: id, ddlLocaSite: ddlLocaSite }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getData = response;
                $("#ddlBuilding").html("");
                $("#ddlBuilding").append('<option value="">Select Building</option>');
                for (var i = 0; i < getData.length; i++) {
                    $("#ddlBuilding").append('<option value="' + getData[i].buildingid + '">' + getData[i].buildingno + '</option>');

                worksheet: name || '',
                table: toExcel
            };
            var link = document.createElement("a");
            link.download = "Locked In Scaffolds for " + $("#lblLockedSite").text() + ".xls";
            link.href = uri + base64(format(template, ctx))
            link.click();
        });

    });


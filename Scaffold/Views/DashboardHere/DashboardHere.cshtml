    function ddlSitebind(id, ClientID) {
        var UID = getParameterByName('UID');
        $.ajax({
            type: "POST",
            // url: "../WebApi/Dashboard.asmx/ddlsitedropdownbindquery",
            url: "/DashboardHere/ddlsitedropdownbindquery",
            data: JSON.stringify({ id: id, ClientID: ClientID, UID: UID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                //  var ddlSitedropdownbind = response.d;
                var ddlSitedropdownbind = response;
                //alert(ddllocationSitedropdownbind.length);
                var Siteid = "";
                var SiteLocatext = "";
                $("#ddlSite").html("");
                //$("#ddlSite").append('<option value="All">All</option>');

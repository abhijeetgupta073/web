    <script type="text/javascript">

        $(document).ready(function () {
            document.getElementById("LoginLogo").src += "?v=" + new Date().getTime();
            var Result = '@ViewBag.Result';
            var Message = '@ViewBag.Message';
            var EmailClientMsg = '@ViewBag.EmailClientMsg';
            if (EmailClientMsg != "") {
                $('#art1').removeClass('alert w3-green w3-card-4').addClass('alert w3-red w3-card-4');
                $('#art1').css("display", "block");
                $('#alertlabel1').html('<strong>Alert ! </strong>' + EmailClientMsg);
            }
            if (Result != "") {
                if (Result == "Success") {
                    $('#art1').removeClass('alert w3-red w3-card-4').addClass('alert w3-green w3-card-4');
                    $('#art1').css("display", "block");
                    $('#alertlabel').html('<strong>Success ! </strong>' + Message);
                } else {
                    $('#art1').removeClass('alert w3-green w3-card-4').addClass('alert w3-red w3-card-4');
                    $('#art1').css("display", "block");
                    $('#alertlabel').html('<strong>Alert ! </strong>' + Message);
                }
            }
            $('#hdnTimeOffSet').val(new Date().getTimezoneOffset());
        });
        function checkvalue(txt) {
            if (txt.value != "") {
                $('#' + txt.id).removeClass('w3-border w3-pale-red w3-border-red').addClass('w3-pale-green ');
            }
            else {
                $('#' + txt.id).addClass('w3-border w3-pale-red w3-border-red').removeClass('w3-pale-green');
                $('#rdf' + txt.id).addClass('rdf-text');
            }
        }
        //function close_window() {
        //    if (confirm("Close Window?")) {
        //        window.close();
        //    }
        //}
        function ShowHidePassword(ID) {
            if (document.getElementById($("#" + ID).prev().attr('id')).type == "password") {
                $("#" + ID).attr("data-hint", "Hide");
                $("#" + ID).find("i").removeClass("icon-eye").addClass("icon-eye-slash");
                document.getElementById($("#" + ID).prev().attr('id')).type = "text";
            }

            else {
                $("#" + ID).attr("data-hint", "Show");
                $("#" + ID).find("i").removeClass("icon-eye-slash").addClass("icon-eye");
                document.getElementById($("#" + ID).prev().attr('id')).type = "password";
            }
        }
        $(function () {

            var win1920 = function () {
                var wisize = $(window).width();
                if (wisize >= "1920") {
                    $('.form-control').removeClass('input-sm').addClass('input-lg');
                    $('.input-group-addon').removeClass('input-sm').addClass('input-lg');
                    $('.continue').css('font-size', '13px');

                }
                else {
                    $('.form-control').removeClass('input-lg').addClass('input-sm');
                    $('.input-group-addon').removeClass('input-lg').addClass('input-sm');
                    $('.continue').removeAttr('style');

                }
            }
            $(window).resize(win1920);
            win1920();
            $eyes = $('.eyes');
            $sign_up = $('.sign-up')
            $forgetPassword = $('.forget-password');
            //$txtpass = $('#<%=txtPassword.ClientID%>');
            //$btnLogin = $('#<%=btnLogin.ClientID%>');
            //$txtUserName = $('#<%=txtUserName.ClientID%>');
            //$textforgetEmail = $('#<%=textforgetEmail.ClientID%>');

            $txtpass = $('#txtPassword');
            $btnLogin = $('#btnLogin');
            $txtUserName = $('#txtUserName');
            $textforgetEmail = $('#textforgetEmail');
            $txtpass.keypress(function (e) {
                var key = e.which;
                if (key == 13) {
                    $btnLogin.trigger('click');
                    //return true;
                }
            });
            $eyes.unbind('click').bind('click', function () {
                if ($txtpass.hasClass('r-pass')) {
                    $txtpass.removeClass('r-pass').removeProp('type').prop('type', 'text');
                    $eyes.addClass('nln-bg').addClass('w3-text-white');
                }
                else {
                    $txtpass.addClass('r-pass').removeProp('type').prop('type', 'password');
                    $eyes.removeClass('nln-bg').removeClass('w3-text-white');
                }
            });
            //$txtpass.unbind('focus').bind('focus', function () {
            //    $(this).addClass('r-pass').removeProp('type').prop('type', 'password');
            //});
            $forgetPassword.unbind('click').bind('click', function () {
                // $(this).attr('data-toggle', 'modal').attr('data-target', '#forgetPasswordModal');

                if ($("#loginForm").hasClass('r-show')) {
                    $("#loginForm").removeClass('r-show').addClass('r-hide').fadeOut();
                    $('#forgetPasswordForm').removeClass('r-hide').addClass('r-show').fadeIn();
                    $('.center-block').animate({
                        left: '0px',
                        opacity: '1',
                        height: '190px',
                    });
                    $textforgetEmail.val($txtUserName.val());
                }
            });
        })
        function goBack() {
            location.reload();
        }

        function btnSubmit_Click() {
            var textforgetEmail = $('#textforgetEmail').val();
            $.ajax({
                type: "POST",
                url: "/Login/btnSubmit_Click",
                data: JSON.stringify({ textforgetEmail: textforgetEmail }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    var GetData = response;
                    if (response.Result == "Success") {
                        $('#art1').removeClass('alert w3-red w3-card-4').addClass('alert w3-green w3-card-4');
                        $('#art1').css("display", "block");
                        $('#alertlabel').html('<strong>Success ! </strong>' + response.Message);
                    } else {
                        $('#art1').removeClass('alert w3-green w3-card-4').addClass('alert w3-red w3-card-4');
                        $('#art1').css("display", "block");
                        $('#alertlabel').html('<strong>Warning ! </strong>' + response.Message);
                    }
                }

            });
        }
    </script>



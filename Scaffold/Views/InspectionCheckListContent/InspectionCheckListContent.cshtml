<script>
        $(document).ready(function () {
            $('.double-scroll').doubleScroll();

            if ('@ViewBag.InspectionCheckListColor' == 'True') {
                $('#RadioBtnColorBlack').prop('checked', true);
                $('#RadioBtnColorGreenRed').prop('checked', false);
                //RadioBtnColorGreenRed.Checked = false;
            } else {
                $('#RadioBtnColorBlack').prop('checked', false);
                $('#RadioBtnColorGreenRed').prop('checked', true);
            }
            DropdownBind();
            //RadioButtonBind();

            if (getParameterByName('RID') == null) {
                $('#btnCAncel').css('display', 'none');
                $('#btnsetasdefaultjob').css('display', 'none');
            } else {
               $('#btnsetdefault').css('display', 'none');
            }

            if('@ViewBag.ddlCheckListSelectedValues'!="" && '@ViewBag.ddlCheckListSelectedValues'!="0")
            {
                $('#ddlCheckList').val('@ViewBag.ddlCheckListSelectedValues');
            }
            RadioButtonBind();
             setTimeout(function () {
                GetInspectionCheckListData();

            }, 500);
        });



        $(document).ready(function () {
            //    $("#ulalwaysactive").css("display", "none");
            var screensize = $(window).width();
            if (screensize < 1150 && screensize > 650) {
                ($BODY.hasClass('nav-md'))
                $('#CreateNewDropDown').css("margin-top", "2px");
                $BODY.removeClass('nav-md').addClass('nav-sm');
                $LEFT_COL.removeClass('scroll-view');
                //$('#BlackSection').css('display', 'block');
                $('#imgLogo').parent().css('display', 'none');
                $('#imgLogo1').css('display', 'block').css("height", "38px");
                $('#leftbarsection').css('margin-top', '0px');


            }


            else {
                if (screensize < (650)) {
                    $BODY.removeClass('nav-sm')
                    $('#imgLogo').parent().css('display', 'none');
                    $('#imgLogo1').css('display', 'block').css("height", "52px");
                }
                else {
                    $('#CreateNewDropDown').css("margin-top", "6px");
                    $BODY.removeClass('nav-sm').addClass('nav-md');
                    //$('#BlackSection').css('display', 'none');
                    $('#imgLogo').parent().css('display', 'block');
                    $('#imgLogo1').css('display', 'none');
                    $('#leftbarsection').css('margin-top', '40px');
                }

            }
        });

        function ButtonClient() {
            $('#LoadingPanel1').css('display', 'block');
        }
</script>

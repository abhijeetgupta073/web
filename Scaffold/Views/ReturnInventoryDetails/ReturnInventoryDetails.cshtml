<script>
    $(document).ready(function () {

        $('#txtdesc').val('@ViewBag.ReturnDescription'.replace('&#39;', "'"));
        $('txtreturndate').val('@ViewBag.ReturnDate');
        $('#txtto').val('@ViewBag.To');
        $('#txtfrom').val('@ViewBag.From');
        $('#hdnOptimizeStatus').val('@ViewBag.OptimizeStatus');

        var ReturnStatus = ('@ViewBag.ReturnStatus');
        if (ReturnStatus != "" && ReturnStatus != null) {
            $('#lockimage').css('display', 'block');
            $('#btnrefresh').css("display", "none");
            $('#hdntextdisable').val(true);
            $('#btnconfrminvtry').css('display', 'none');
            $('#ckbox').attr('disabled', 'disabled');
            $('#txtdesc').attr('disabled', 'disabled');
        }


    });
</script>

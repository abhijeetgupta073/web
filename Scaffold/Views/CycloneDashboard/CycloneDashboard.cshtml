    function Manandprephr(id, SiteId, ddlRiskRating) {
            //var ddlsite = ("#ddlSite").val();

            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/ManandPrepHrs",
                url: "/CycloneDashboard/ManandPrepHrs",
                data: JSON.stringify({ id: id, SiteId: SiteId, ddlRiskRating: ddlRiskRating }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    //var ddlhrs = response.d;
                    var ddlhrs = response;
                    $('#txtavailhrs').text(ddlhrs[0].Mahhrsavail);
                    $('#txtprephrs').text(ddlhrs[0].totalprephrs);
                    var color = ddlhrs[0].ColorStatus;
                    $('#imgstatus').attr('src', '/images/' + color + '.jpg');
                }
            });

        }

        function ddlJobbind(id, SiteId) {

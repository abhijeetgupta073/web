    function ExportAllCategories() {
        var id = getParameterByName('id');
        var siteID = $('#ddlsite').val();
        var ddlarea = $('#ddlarea').val();
        var ddlRiskRating = $("#ddlRiskRating").val();
        //var SubOwner = $('#ddldiscipline').val();
        var SummDetail = "D";
        var CycAction = 'All';

        //window.location.href = '/CycloneDashboard/ExportAllCategories?id=' + id + '&siteID=' + siteID + '&ddlarea=' + ddlarea + '&SubOwner=' + SubOwner + '&SummDetail=' + SummDetail + '&CycAction=' + CycAction;
        window.location.href = '/CycloneDashboard/ExportAllCategories?id=' + id + '&siteID=' + siteID + '&ddlarea=' + ddlarea + '&SummDetail=' + SummDetail + '&CycAction=' + CycAction + '&ddlRiskRating=' + ddlRiskRating;
    }

    function openpopup() {
        if (ValidateInactiveSite()) return false;
        // Reset previous selections
        $('#ManHoursAvailable')
            .val('')
            .prop('disabled', true);

        $('#ddlpopsitedropdown').val('All');  // if you have a dropdown for site selection

        // Now show popup
        $("#popupModal").show();
    }

    function closepopup() {
        $("#popupModal").hide();
    }

    function SaveManHoursData() {
        var id = getParameterByName('id');
        var UID = getParameterByName('UID');
        var Site = $("#ddlpopsitedropdown").val();
        var ManHoursAvailable = $("#ManHoursAvailable").val();
        
        if (parseFloat(ManHoursAvailable) < 0) {
            var response = { Result: "Failed", Message: "Negative values are not allowed." }
            CustomAlert(response);
            return;
        }
        if (Site && Site !== "All") {
            $.ajax({
                url: '/CycloneDashboard/SaveManHoursData',
                async: false,
                data: { ClientId: id, UserId: UID, SiteId: Site, ManHoursAvailable: ManHoursAvailable },
                success: function (response) {
                    if (response.Success === "1") {
                        var response = { Result: "Success", Message: "Data saved successfully." }
                        CustomAlert(response);
                        $('#popupModal').hide();
                        $('#popupModal').find('input[type="text"], input[type="number"], input[type="email"], input[type="date"], textarea').val('');
                        $('#popupModal').find('select').prop('selectedIndex', 0);
                        location.reload();
                    } else {
                        var response = { Result: "Failed", Message: "Something went wrong. Please try again." }
                        CustomAlert(response);
                        return;
                    }
                },
                error: function (xhr, status, error) {
                    $('#msgBox').text("An error occurred while saving.");
                    console.error(error);
                }
            });
        }
        else {
            var response = { Result: "Failed", Message: "Please select a Site before proceeding." }
            CustomAlert(response);
        }
    }

    function SiteDropdown() {
        var id = getParameterByName('id');
        $.ajax({
            url: '/CycloneDashboard/BindallDropdown',
            async: false,
            data: { id: id },
            success: function (response) {

                data = response;

                var ddSite = "<option value='All'>All</option>";
                $.each(response.ddlsites, function (idx, obj) {
                    if (obj != null) {
                        ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                    }
                });
                $('#ddlpopsitedropdown').empty().append(ddSite);
            }
        });
    }

    function loadManHourData(siteId) {
        var id = getParameterByName('id');
        $.ajax({
            url: '/CycloneDashboard/GetManHourData',
            type: 'GET',
            data: { siteId: siteId, ClientId: id },
            success: function (response) {
                if (response && response.success) {
                    $('#ManHoursAvailable').val(response.data.ManHoursAvailable);
                } else {
                    $('#ManHoursAvailable').val('');
                }
            },
            error: function () {
                alert('Failed to load data. Please try again.');
            }
        });
    }

    function checkForNegativeValues() {
        var manHours = parseFloat($("#ManHoursAvailable").val()) || 0;
        

        if (manHours < 0 ) {
            $("#negativeValueMsg").show();
        } else {
            $("#negativeValueMsg").hide();
        }
    }

    function IsSiteInactive() {
        var SiteId = $('#ddlsite').val();
        if (SiteId == "" || SiteId == null) {
            return false;
        }
        var IsInactive = false;
        $.ajax({
            type: "POST",
            url: "/Layout/CheckSiteActiveStatusSiteId",
            data: JSON.stringify({ SiteId: SiteId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                IsInactive = response.IsInactive;
            }
        });
        return IsInactive;
    }

    function ValidateInactiveSite() {
        if (IsSiteInactive() == true) {
            CustomAlert({
                Result: "Failed",
                Message: "This site is InActive. You cannot make any changes."
            });
            return true;
        }
        return false;
    }
</script>

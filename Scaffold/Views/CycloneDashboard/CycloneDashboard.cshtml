        function BindallDropdown() {
            var id = getParameterByName('id');
            $.ajax({
                url: '/CycloneDashboard/BindallDropdown',
                async: false,
                data: { id: id },
                success: function (response) {

                    data = response;

                    var ddSite = "<option value='All'>All</option>";
                    $.each(response.ddlsites, function (idx, obj) {
                        if (obj != null) {
                            ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                        }
                    });

                    var ddlscaffref = "<option value='All'>All</option>";
                    $.each(response.ddlScaffReff, function (idx, obj) {
                        if (obj != null) {
                            ddlscaffref += '<option value="' + obj.RegisterId + '">' + obj.ScaffRef + '</option>';
                        }
                    });

                    $('#ddlsite').empty().append(ddSite);
                    $('#ddlscaffref').empty().append(ddlscaffref);

                }
            });
        }


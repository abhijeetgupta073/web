<div id="FormSection" class="row">
    <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12 xsformsection" style="padding-left: 1px;">
        <ul id="UlNavTabSeciton" class="nav nav-tabs" style="margin-bottom: 0px;">
            <li id="liThirdParty" runat="server" style="width: 191px">
                <a id="AnchorYardInventory" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;Third Party Inventory</span>
                </a>
            </li>
            <li class="active">
                <a id="AnchorDepotInventory" style="cursor: pointer;" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;Main Depot Inventory</span>
                </a>
            </li>
            <li id="liSiteInventory" style="width: 161px">
                <a id="AnchorSiteInventory" style="cursor: pointer;" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;Site Inventory</span>
                </a>
            </li>

            <li id="liJob">
                <a id="AnchorJobInventory" style="cursor: pointer;" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;Request Inventory / Deliveries</span>
                </a>
            </li>
            <li id="LiSacafpac" runat="server">
                <a id="AnchorReturnInventory" style="cursor: pointer;" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;Return Inventory</span>
                </a>
            </li>
            <li id="LiDamaged" runat="server">
                <a id="AnchorDamagedInventory" style="cursor: pointer;" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;Damaged Inventory</span>
                </a>
            </li>
            <li id="PipeLineInventory">
                <a id="AnchorPipeLineInventory" style="cursor: pointer;" data-toggle="tab">
                    <span class="spancolorandsize"><i class="fa fa-tag"></i>&nbsp;PipeLine Inventory</span>
                </a>
            </li>
        </ul>
    </div>
</div>


<div class="tab-content">
    <div id="custDetails" class="tab-pane fade in active table-bordered w3-padding w3-white" style="border-top: initial; height: auto !important">

        <div class="row">
            @*<div class="col-lg-2 col-md-2 col-sm-5  col-xs-7">
                    <label id="lblmaterial">Site:</label>
                    <select id="ddlSite" class="form-control" Style="height: 26px !important; padding-top: 4px !important; width: 100% !important" onchange="GetSiteInventoryData()"></select>
                </div>*@
            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-6">
                <label id="lblmaterial">Filter By Material Type  </label>
                <select id="ddlMaterialType" class="form-control" ; onchange="ddlMaterialType_SelectedIndexChanged()">
                </select>
            </div>
            <div class="col-lg-1 col-md-2 col-sm-3 col-xs-5">
                <label># of Items</label>
                <input type="text" id="txtitems" class="form-control" disabled="disabled" />
            </div>
            <div class="col-lg-2 col-md-2 col-sm-4 col-xs-4">
                <label>Total Tonnage</label>
                <input type="text" id="txttotaltonnage" class="form-control" disabled="disabled" />

            </div>
            <div class="col-md-2 col-sm-2 col-lg-2 col-xs-2">

                <button type="button" Class="btn w3-btn w3-teal" id="ExportToCsvButton" Style="margin-top: 15px; color:white;    width: 100%;" onclick="ExportToCsvButton_Click()"><i class="fa fa-file-excel-o"></i> Export To CSV</button>
            </div>
            <div class="col-md-2 col-sm-2 col-lg-2 col-xs-2">

                <button type="button" Class="w3-btn w3-blue" id="btnprint" Style="margin-top: 15px; color:white; width:100%;" onclick="btnprint_Click()"><i class="fa fa-print"></i>&nbsp;Print</button>
            </div>

        </div>

        <div class="row"></div>
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divSiteInventory">
                <div id="SiteInventoryGrid" style="color: black;">
                    <table id="tblSiteInventory" class="table;" style="width:100% !important;display:none">
                        <thead style="background-color: #efefef; color: #716262;">
                            <tr>
                                @*<td style="display:none">Site Id</td>*@
                                <th style="display:none" class="setWidth0"></th>
                                <th class="setWidth1">Material Type</th>
                                <th class="setWidth2">Item Code</th>
                                <th class="setWidth3">Item Description</th>
                                <th class="setWidth4">Delivered To Depot</th>
                                <th class="setWidth5">Delivered To Site</th>
                                <th class="setWidth6">Returned From Site</th>
                                <th class="setWidth7">Available Quantity</th>
                                <th class="setWidth8">Total Damaged Quantity</th>
                                <th class="setWidth9">Item Weight (kg)</th>
                                <th class="setWidth10">Total Weight (kg)</th>

                            </tr>
                        </thead>
                        <tbody id="tbodyTblSiteInventory"></tbody>
                    </table>

                </div>
            </div>
        </div>

    </div>
</div>


    <script>

        // For Right Click Disable All Projects Because View Pagesourc code not Allow To Show Any One.

        $(document).ready(function () {
            $("body").on("contextmenu", function (e) {
                return false;
            });
            ////Code For Ctrl+U And Ctrl+Shift+I Stop Disable All Projects Because View Pagesourc code not Allow To Show Any One.
            document.onkeydown = function (e) {
                if (event.keyCode == 123) { return false; }
                //    //  else if (e.ctrlKey && (e.keyCode === 67 || e.keyCode === 16 || e.keyCode === 73 || e.keyCode === 86 || e.keyCode === 85 || e.keyCode === 117)) { return false; }
                else if (e.ctrlKey && (e.keyCode === 16 || e.keyCode === 73 || e.keyCode === 85 || e.keyCode === 117)) { return false; }

            };
        });

        $(document).ready(function () {

            //$("select.chosen-select").select2();
            $('#hdnTimeOffSetForAllPage').val(new Date().getTimezoneOffset());
            var list = $('#lstSearch');
            list.val('dfg');
            var href = location.href.split('?');
            var href2 = href[0].split('/');
            if (href2[href2.length - 1] == "Default") {
                $('.side-menu li').removeClass('hideLeftBarLi');
                $('#LiMenuitem').addClass('hideLeftBarLi');
                $('#spnConfigleftBar').html('Configuration');
                $('#LiManage').addClass("hideLeftBarLi");
                $('#LiOprationalSetup').addClass("hideLeftBarLi");
            };

        });
        //function redirectToDash() {
        //    window.location.href = '/Default.aspx';
        //};

        function setinterval(Userid) {
            // alert(sessionid);
            setTimeout(function () {
                setinterval(Userid);
            }, 20000);
            var hdnoffset = $('#hdnTimeOffSetForAllPage').val();
            $.ajax({
                type: 'POST',
                //data: JSON.stringify({ id: Userid, session: sessionid }),
                data: JSON.stringify({ id: Userid, hdnoffset: hdnoffset }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                global: false,
                // url: '../WebApi/Dashboard.asmx/ForceLogOut',
                url: '/Layout/ForceLogOut',
                success: function (response) {
                    console.log(JSON.stringify(response));
                    if (response == "InActive") {
                        bootbox.alert({
                            message: "This Log-in is currently being used. Only one log in per user",
                            callback: function () {
                                window.location.href = '/Login/Login';
                            }
                        })
                    }
                }
            });
        }

        $(document).ready(function () {
            //  var Userid = $("#hdnUserId").val();
            //  var sessionid = $("#hdnsessionid").val();

            DropdownBindClient();

            var Userid = getParameterByName('UID');
            setinterval(Userid);



            var screensize = $(window).width();
            if (screensize < 1150 && screensize > 650) {
                ($BODY.hasClass('nav-md'))
                $('#CreateNewDropDown').css("margin-top", "2px");
                $BODY.removeClass('nav-md').addClass('nav-sm');
                $LEFT_COL.removeClass('scroll-view');
                //$('#BlackSection').css('display', 'block');
                $('#imgLogo').parent().css('display', 'none');
                $('#imgLogo1').css('display', 'block').css("height", "32px");
                $('#leftbarsection').css('margin-top', '0px');
                //$('.dropdown-menu').css('margin-left', '-96px');
                $('.imgdisplay').css('display', 'none');
                $('#ulalwaysdashboardactive').css('display', 'none');
                $('#ulalwaysactive').css('display', 'none');
            }
            else {
                if (screensize < (650)) {
                    $BODY.removeClass('nav-sm')
                    // $('#imgLogo').parent().css('display', 'none');
                    //$('#imgLogo1').css('display', 'block').css("height", "52px");
                    $('#lblSelectedCLient').css("font-size", "12px");
                    $('.dropdown user').css('margin-top', '3px');
                    //$('#lblSelectedCLient').css("font-size", "14px");
                    $('.dropdown-menu').css('margin-left', '-121px');
                    $('#lblUserName').css("font-size", "10px");
                    $('#DdlClient').css("width", "116px !important");
                    $('.imgdisplay').css('display', 'none');
                    $('.xsleft').css('margin-left', '-12px').css('float', 'left').css('text-allign', 'left');
                }
                else {
                    $('#CreateNewDropDown').css("margin-top", "6px");
                    $BODY.removeClass('nav-sm').addClass('nav-md');
                    //$('#BlackSection').css('display', 'none');
                    $('#imgLogo').parent().css('display', 'block');
                    $('#imgLogo1').css('display', 'none');
                    $('#leftbarsection').css('margin-top', '40px');
                    $('.xsleft').css('margin-top', '14px');
                }
            }
        });
    </script>


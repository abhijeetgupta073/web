        //}
        var InventoryID = $('#ddlitemcode').val();
        $.ajax({
            type: "POST",
            url: '/ItemUtilizeDashboard/ddlitemdesc_SelectedIndexChanged',
            async: false,
            data: JSON.stringify({ ddlMattype: ddlMattype, InventoryID: InventoryID, ddlSite: ddlSite }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {

                var GetData = response;

                $('#txtqtyonsite').val(numberWithCommas(response.txtqtyonsite));
                $('#txtqtystanding').val(numberWithCommas(response.txtqtystanding));
                $('#txtNotstarted').val(numberWithCommas(response.txtNotstarted));
                $('#txtqtyAvaliable').val(numberWithCommas(response.txtqtyAvaliable));
                $('#txtqtyDamaged').val(numberWithCommas(response.txtqtyDamaged));

            }
        });

        GetJobListData();
    }


    function GetJobListData() {
        $('#LoadingPanel1').show();
        var ddlSite = $('#ddlSite').val();
        var ddlMattype = $('#ddlMattype').val();
        // var ddlitemdesc = $('#ddlitemdesc').val();
        //var ddlitemdesc = $('#ddlitemdesc option:selected').text();
        //if (ddlitemdesc == "All") {
        //    ddlitemdesc = "";
        //}
        var InventoryID = $('#ddlitemcode').val();
        var id = getParameterByName('id');
        var InventoryID = $('#ddlitemcode').val();
        var EncryptData = [ddlSite, ddlMattype, InventoryID];
        var encryData = Encrypt(EncryptData);
        ddlSite = encryData[0];
        ddlMattype = encryData[1];
        InventoryID = encryData[2];
        $.ajax({
            type: "POST",
            url: "/ItemUtilizeDashboard/GetJobListData",
            data: JSON.stringify({ ddlSite: ddlSite, ddlMattype: ddlMattype, InventoryID: InventoryID, id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {
                var str = "";
                var GetData = response;
                $('#tblJobList').DataTable().clear();
                $('#tblJobList').DataTable().destroy();
                // $('#JobList').css('display', 'block');
                $('#divTotalAvailableQuantity').css('display', 'none');
                var TotalAvailableQuantity = 0;
                if (GetData.length > 0) {
                    $('#divTotalAvailableQuantity').css('display', 'block');
                    for (var i = 0; i < GetData.length; i++) {

                        var FromId = GetData[i].FromId == null ? "" : GetData[i].FromId;
                        var ToId = GetData[i].ToId == null ? "" : GetData[i].ToId;
                        var TotalWeight = GetData[i].TotalWeight == null ? "" : GetData[i].TotalWeight;
                        var ScaffRef = GetData[i].ScaffRef == null ? "" : GetData[i].ScaffRef;
                        var Location = GetData[i].Location == null ? "" : GetData[i].Location;
                        var BuildingNo = GetData[i].BuildingNo == null ? "" : GetData[i].BuildingNo;
                        var AssetNo = GetData[i].AssetNo == null ? "" : GetData[i].AssetNo;
                        var AvailableQuantity = GetData[i].AvailableQuantity == null ? "" : GetData[i].AvailableQuantity;

                        TotalAvailableQuantity += parseInt(AvailableQuantity);


                        str += "<tr>"
                        str += "<td class='setWidth0' style='display:none'></td>"
                        str += "<td class='setWidth1'>" + ScaffRef + "</td>"
                        str += "<td class='setWidth2'>" + Location + "</td>"
                        str += "<td class='setWidth3'>" + BuildingNo + "</td>"
                        str += "<td class='setWidth4'>" + AssetNo + "</td>"
                        str += "<td class='setWidth5'>" + numberWithCommas(AvailableQuantity) + "</td>"

                        str += "</tr>";


                    }
                    $('#tbodyJobList').append(str);
                    $('#LoadingPanel1').hide();
                }

                if (TotalAvailableQuantity != 0 || TotalAvailableQuantity != '') {
                    $('#txtTotalQuantity').val(numberWithCommas(TotalAvailableQuantity));
                }
                else {
                    $('#txtTotalQuantity').val('');
                }

                $('<caption/>').html('This Material is on these Jobs:').appendTo('#tblJobList');
                var table = $('#tblJobList').DataTable({
                    searching: false,
                    "bLengthChange": false,
                    "bInfo": false,
                    scrollY: true,
                    scrollCollapse: true,
                    scrollY: "30vh",
                    paging: false,
                    "bSort": false,

                    dom: 'Bfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Material List On Job',
                        }
                    ],

                });

                var tableLenght = $('#tblJobList tbody tr').length;
                if (tableLenght >= 8) {
                    $('.setWidth5').addClass('setWidththWithScroll');
                    $('.setWidth5').removeClass('setWidththWithoutScroll');

                } else {

                    $('.setWidth5').addClass('setWidththWithoutScroll');
                    $('.setWidth5').removeClass('setWidththWithScroll');
                }

            }
        })
    }


    function SiteDropdownBind() {
        var id = getParameterByName('id');
        $.ajax({
            type: "POST",
            url: '/ItemUtilizeDashboard/SiteDropdownBind',
            async: false,
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // var ddSite = "<option value='All'>All</option>";
                var ddSite = "";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                    }
                });

                $('#ddlSite').empty().append(ddSite);
                // ddlSite_SelectedIndexChanged();
            }
        });


    }

    function MaterialTypeDropdownBind() {
        ajaxload();
        var SiteID = $('#ddlSite').val();
        $.ajax({
            type: "POST",
            url: '/ItemUtilizeDashboard/ddlSite_SelectedIndexChanged',
            async: false,
            data: JSON.stringify({ SiteID: SiteID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {

                data = response;

                var ddlMattype = "<option value=''>All</option>";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddlMattype += '<option value="' + obj.MaterialType + '">' + obj.MaterialType + '</option>';
                    }
                });

                $('#ddlMattype').empty().append(ddlMattype);

                // ddlMattype_SelectedIndexChanged();

                var ddlmatval = $('#ddlSite').val();
                Chart1(ddlmatval);
                Chart2(ddlmatval);
            }

        });

    $(document).ready(function () {
        $("[id$=myButtonControlID]").click(function (e) {

            var uri = 'data:application/vnd.ms-excel;base64,';

            var template =
                '<html xmlns:o="urn:schemas-microsoft-com:office:office" ' +
                'xmlns:x="urn:schemas-microsoft-com:office:excel" ' +
                'xmlns="http://www.w3.org/TR/REC-html40">' +
                '<head>' +
                '<!--[if gte mso 9]><xml>' +
                '<x:ExcelWorkbook>' +
                '<x:ExcelWorksheets>' +
                '<x:ExcelWorksheet>' +
                '<x:Name>{worksheet}</x:Name>' +
                '<x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>' +
                '</x:ExcelWorksheet>' +
                '</x:ExcelWorksheets>' +
                '</x:ExcelWorkbook>' +
                '</xml><![endif]-->' +

                '<style>' +
                'table{border-collapse:collapse;font-size:11px;}' +
                'th,td{' +
                'font-size:11px;' +
                'padding:4px;' +
                'white-space:normal;' +
                'word-wrap:break-word;' +
                'vertical-align:top;' +
                '}' +
                'th{font-weight:bold;}' +

                'td:nth-child(3),th:nth-child(3){min-width:300px;}' +

                'td:nth-child(4),td:nth-child(5),td:nth-child(6){text-align:right;}' +
                '</style>' +

                '</head>' +
                '<body><table>{table}</table></body>' +
                '</html>';

            var base64 = function (s) {
                return window.btoa(unescape(encodeURIComponent(s)));
            };

            var format = function (s, c) {
                return s.replace(/{(\w+)}/g, function (m, p) {
                    return c[p];
                });
            };

            var toExcel = "Scaffolds Material " + $("#lblAction").text();
            toExcel += document.getElementById("tblScaffoldDetails").innerHTML;

            var ctx = {
                worksheet: 'Scaffolds',
                table: toExcel
            };

            var link = document.createElement("a");
            link.download = "Scaffolds_Material_" + $("#lblAction").text() + ".xls";
            link.href = uri + base64(format(template, ctx));
            link.click();
        });
    });

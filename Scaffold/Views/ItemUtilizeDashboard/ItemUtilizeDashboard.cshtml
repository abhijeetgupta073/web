    /// Chart 1 On Site Material Break-Down (Tonnes)
    function Chart1(ddlmatval) {
        $('.forRemoveData1').remove();
        $.ajax({
            type: "POST",
            // url: "../WebApi/Dashboard.asmx/ItemUtilizeFirst",
            url: "/ItemUtilizeDashboard/ItemUtilizeFirst",
            data: JSON.stringify({ Siteid: ddlmatval }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // ItemDetail = response.d;
                ItemDetail = response;
                var Item = [];
                var ItemData = [];
                var itemton = [];
                var percentage = [];
                for (var i = 0; i < ItemDetail.length; i++) {
                    var TobePush = true;
                    if (TobePush) {
                        ItemData.push({ name: ItemDetail[i].Material, y: ItemDetail[i].TotalTonnes, z: ((ItemDetail[i].PctTonnage) * 100).toFixed(2), sliced: true });
                        Item.push(ItemDetail[i].Material);
                        itemton.push(ItemDetail[i].TotalTonnes);
                        percentage.push((ItemDetail[i].PctTonnage) * 100);
                    }

                }
                var theExportOptions = Highcharts.getOptions().exporting.buttons.contextButton.menuItems;
                theExportOptions.splice(0, 1);
                //theExportOptions.splice(1, 5);

                //var pieColors = (function () {
                //    var colors = [],
                //        base = Highcharts.getOptions().colors[0],
                //        i;

                //    for (i = 0; i < 10; i += 1) {
                //        colors.push(Highcharts.Color(base).brighten((i - 2) / 12).get());
                //    }
                //    return colors;
                //}());

                Highcharts.chart('container1', {
                    chart: {
                        type: 'pie',
                        backgroundColor: '#f2f2f2',
                        options3d: {
                            enabled: true,
                            alpha: 45,
                            beta: 0
                        }
                    },
                    title: {
                        align: 'left',
                        text: 'On Site-Material Break-Down (Tonnes)'
                    },
                    tooltip: {
                        pointFormat: '{series.name}: {point.y}'

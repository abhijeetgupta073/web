    function LoadItemBreakdown(type, siteId, ClientId) {

        $('#lblAction').text(type);
        $('#labelaction').val(type);
        $('#QuantityModal1').show();

        if (type === "Available") {
            $('#thQuantity').text('Available Quantity');
        }
        else if (type === "Standing") {
            $('#thQuantity').text('Quantity with Job');
        }
        else if (type === "On Site") {
            $('#thQuantity').text('On Site');
        }
        else {
            $('#thQuantity').text('Quantity');
        }

        $('#LoadingPanel1').show();

        $.ajax({
            type: "POST",
            url: "/ItemUtilizeDashboard/GetScaffoldItemBreakdown",
            data: JSON.stringify({
                SiteId: siteId,
                Type: type,
                ClientId: ClientId
            }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",

            success: function (data) {

                if ($.fn.DataTable.isDataTable('#tblScaffoldDetails')) {
                    $('#tblScaffoldDetails').DataTable().destroy();
                }

                $('#tbodyScaffoldDetails').empty();

                var rows = '';
                var totalWeight = 0;

                $.each(data, function (i, obj) {

                    totalWeight += obj.TotalWeight;

                    var rowTonnage = (obj.TotalWeight / 1000).toFixed(2);
                    rows += `
                <tr>
                    <td style="text-align:center">${obj.MaterialType}</td>
                    <td style="text-align:center">${obj.ItemCode}</td>
                    <td style="text-align:center">${obj.ItemDesc}</td>
                    <td style="text-align:center">${obj.Quantity}</td>
                    <td style="text-align:center">${obj.ItemWeight}</td>
                    <td style="text-align:center">${obj.TotalWeight.toFixed(2)}</td>
                    <td style="text-align:center">${rowTonnage}</td>
                </tr>`;
                });

                $('#tbodyScaffoldDetails').append(rows);

                /*$('#txtTotalQuantity').val(totalWeight.toFixed(2));*/
                //$('#txtTotalTonnage').val((totalWeightTonnage / 1000).toFixed(4)); // ← optional summary field
                $('#ScaffoldDetailModal').modal('show');
                $('#LoadingPanel1').hide();
            },

            error: function () {
                $('#LoadingPanel1').hide();
                alert('Error loading scaffold data');
            }
        });
    }



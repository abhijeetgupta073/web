
@{
    ViewBag.Title = "ScaffoldMaterialListPhase2";
}

@*<link href="Assets/css/select2.min.css" rel="stylesheet" />
    <script src="Assets/js/select2.min.js"></script>*@
<script src="~/Content/js/JobInfo.js?v1=8.2"></script>
<script src="~/Content/js/ScaffoldMaterialListPhase2.js?V1=6"></script>

<script>
    $(function () {
        var id = '@ViewBag.HireInventory';
        $('#hdnHireInventory').val('@ViewBag.HireInventory');
        if ($('#hdnHireInventory').val() == "True") {
            $('#btnHireReport').css('display', 'Block');
        }
    });
</script>

<style>
    /*Window Size 67 %*/
    @@media (min-width: 1900px) and (max-width: 2050px) {
        #freeze {
            width: 100% !important;
        }

        #ExportTo {
            width: 100% !important;
        }

        #btnrequest {
            width: 100% !important;
        }

        #btnReturn {
            width: 100% !important;
        }

        #btnDamage {
            width: 100% !important;
        }
    }

    @@media only screen and (max-width: 600px) {

        #btnReturn {
            width: 107% !important;
        }

        #btnDamage {
            width: 107% !important;
        }
    }

    @@media (min-width: 768px) and (max-width: 1024px) {

        #btnReturn {
            width: 107% !important;
        }

        #btnDamage {
            width: 107% !important;
        }
    }

    label {
        font-size: 12px;
    }


    .setWidth1, .setWidth2, .setWidth4, .setWidth5, .setWidth6, .setWidth7 {
        min-width: 90px !important;
    }

    .setWidth8, .setWidth9 {
        min-width: 80px !important;
    }

    .setWidth10, .setWidth11, .setWidth12 {
        min-width: 80px !important;
    }

    .setWidth3 {
        min-width: 180px !important;
    }
</style>
<div class="row">
    <div class="title_left col-lg-5 col-md-5 col-sm-5">
        <h4 class="heading" style="color: #0070ba"><b><i class="fa fa-tasks"></i>&nbsp;<span id="lblclient" Font-Size="16px" Font-Bold="true">Job Inventory List</span></b></h4>
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2">
    </div>
    @*<asp:HiddenField ID="OptStatusHidden" runat="server" />
        <asp:HiddenField ID="rowcount" runat="server" />*@
    <input type="hidden" id="OptStatusHidden" />
    <input type="hidden" id="rowcount" />
    <input type="hidden" id="hdnSiteLocID" value="@ViewBag.SiteID" />
    <input type="hidden" id="hdnHireInventory" />
</div>

@Html.Partial("_RegisterPartiaView")

<div class="row">
    <div class="col-lg-12"></div>
</div>

<div class="row"></div>
<div class="row" style="width:98%;display:none;" id="divTotalDailyHireCost">
    <div class="col-lg-9 col-md-12 col-sm-12 col-xs-12"></div>
    <div class="col-lg-2 col-md-3 col-sm-4 col-xs-7">
        <label><b>Total Daily Job Hire Cost:</b></label>
    </div>
    <div class="col-lg-1 col-md-2 col-sm-2 col-xs-2" style="float:left;margin-left:-20px;width: 110px;">
        @*<asp:TextBox ID="txtTotalDailyHireCost" runat="server" CssClass="form-control" Enabled="false"></asp:TextBox>*@
        <input type="text" id="txtTotalDailyHireCost" value="@ViewBag.TotalDailyHireCost" Class="form-control" disabled />
    </div>
</div>
@*<%--
    <div class="row">
    </div>--%>*@
<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
        <div id="RegisterInventoryList" style="color: black; width: 100%;margin-top:5px;">
            <table id="tblRegisterInventoryList" class="table table-striped " style="width: 100%">
                <thead style="background-color: #efefef; color: #716262;">
                    <tr>
                        <th class="setWidth0" style="display:none;"></th>
                        <th class="setWidth1">Material Type</th>
                        <th class="setWidth2">Item Code</th>
                        <th class="setWidth3">Item Desc</th>
                        <th class="setWidth4">Delivered Qty</th>
                        <th class="setWidth5">Return Qty</th>
                        <th class="setWidth6">Damage Qty</th>
                        <th class="setWidth7">On Job</th>
                        <th class="setWidth8">Item Weight (kg)</th>
                        <th class="setWidth9">Total Weight (kg)</th>
                        <th class="setWidth10">UOM</th>
                        <th class="setWidth11">Daily Hire Rate</th>
                        <th class="setWidth12">Total Daily Hire Cost</th>

                    </tr>
                </thead>
                <tbody id="tbodyRegisterInventoryList" style="width:100%"></tbody>
            </table>

        </div>
    </div>
</div>

<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="width: 98%">
    <div class="clearfix"></div>

    <div class="double-scroll">
    </div>

</div>

<script>
    $(document).ready(function () {
        SiteDropDownBind();


        var CurrentDate = new Date();
        var rdpReportStartDate = new Date(CurrentDate.getFullYear(), CurrentDate.getMonth() - 1, 1);
        var rdpReportEndDate = new Date(CurrentDate.getFullYear(), CurrentDate.getMonth(), 0);

        $('#rdpReportStartDate').val(rdpReportStartDate.DateMonthFormat());
        $('#rdpReportEndDate').val(rdpReportEndDate.DateMonthFormat());
        $('#rdpReportStartDate1').val(rdpReportStartDate.DateMonthFormat());
        $('#rdpReportEndDate1').val(rdpReportEndDate.DateMonthFormat());
        $('#rdpSurgeReportStartDate').val(rdpReportStartDate.DateMonthFormat());
        $('#rdpSurgeReportEndDate').val(rdpReportEndDate.DateMonthFormat());
       // rdpReportStartDate1.SelectedDate = ReportStartDate;// add code on 30/Apr/2020
       // rdpReportEndDate1.SelectedDate = databaseCon.ToTimeZoneTime(DateTime.Now);// add code on 30/Apr/2020

    $("#rdpReportStartDate").datepicker({
            dateFormat: 'dd-M-yy',
            // maxDate: 0,
            closeText: 'Close',

    });
    $("#rdpReportEndDate").datepicker({
        dateFormat: 'dd-M-yy',
      //  maxDate: 0,
        closeText: 'Close',

    });
    $("#rdpReportStartDate1").datepicker({
        dateFormat: 'dd-M-yy',
        // maxDate: 0,
        closeText: 'Close',

    });
    $("#rdpReportEndDate1").datepicker({
        dateFormat: 'dd-M-yy',
        //  maxDate: 0,
        closeText: 'Close',

    });
        $("#rdpSurgeReportStartDate").datepicker({
            dateFormat: 'dd-M-yy',
            // maxDate: 0,
            closeText: 'Close',

        });
        $("#rdpSurgeReportEndDate").datepicker({
            dateFormat: 'dd-M-yy',
            //  maxDate: 0,
            closeText: 'Close',

        });

    var HireInventory = '@ViewBag.HireInventory';
        $('#hdnHireInventory').val(HireInventory);
        if (HireInventory == "False") {
            $('#divWeeklyReport').css('display', 'none');
            $('#divInvoiceCost').css('display', 'none');
            $('#divSAP').css('display', 'none');
          /*  $('#divInvoiceSurgeCost').css('display', 'none');*/
        }
    });
</script>


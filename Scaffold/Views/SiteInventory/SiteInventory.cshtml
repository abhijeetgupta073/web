                    <table id="tblSiteInventory" class="table;" style="width:100% !important;display:none">
                        <thead style="background-color: #efefef; color: #716262;">
                            <tr>
                                @*<td style="display:none">Site Id</td>*@
                                <th style="display:none" class="setWidth0"></th>
                                <th class="setWidth1">Material Type</th>
                                <th class="setWidth2">Item Code</th>

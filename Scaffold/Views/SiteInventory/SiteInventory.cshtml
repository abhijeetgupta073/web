                                <th class="setWidth4">Delivered To Site</th>
                                <th class="setWidth5">Quantity With Job</th>
                                <th class="setWidth6">Return Quantity To Depot</th>
                                <th class="setWidth7">Damaged Quantity From Job</th>
                                <th class="setWidth8">Damaged Quantity To Depot</th>

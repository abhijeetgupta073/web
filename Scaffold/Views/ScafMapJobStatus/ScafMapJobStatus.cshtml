
@{
    ViewBag.Title = "ScafMapJobStatus";
}

<script src="https://maps.googleapis.com/maps/api/js?key=@(Session["googlemapapi"])&libraries=places" type="text/javascript"></script>
<script>

    $(document).ready(function () {
        var id = getParameterByName('id');
        var DecriptData = Decrypt([id]);
        $("#ClientId").val(DecriptData[0]);

        var Clientid = $('#ClientId').val();
        SiteDropdownBind(Clientid);

        var ddlsite = $('#ddlsite').val();
        var Location = $("#ddllocation").val();

        ddllocationbind(Clientid, ddlsite); //add code on 30-May-2020.
        ddlbuildingbind(Clientid, ddlsite, "All"); // Add on 11-June-2020
        var ddlBuilding = $('#ddlbuilding').val(); //Added on 30-May-2022
        ddlFloorbind(Clientid, ddlsite, "All", "All");//Added on 30-May-2022
        var FloorLevelID = $('#ddlFloorLevel').val();
        GoogleMap(Clientid, ddlsite, "All", "All", "All");

    });

    function ddlchange() {
        var ddlsite = $('#ddlsite').val();
        var ClientID = $('#ClientId').val();
        ddllocationbind(ClientID, ddlsite); //add code on 30-May-2020.
        ddlbuildingbind(ClientID, ddlsite, "All");// Add on 11-June-2020
        var LocationId = $("#ddllocation").val();//Added on 30-May-2022
        var ddlBuilding = $('#ddlbuilding').val();//Added on 30-May-2022
        ddlFloorbind(ClientID, ddlsite, LocationId, ddlBuilding);//Added on 30-May-2022
        var FloorLevelID = $('#ddlFloorLevel').val();
        GoogleMap(ClientID, ddlsite, "All", "All", "All");

    }

    //add code on 26-Apr-2023.
    function Changelocation() {
        var ddlsite = $('#ddlsite').val();
        var ClientID = $('#ClientId').val();
        var Location = $("#ddllocation").val();
        ddlbuildingbind(ClientID, ddlsite, Location);
        var ddlBuilding = $('#ddlbuilding').val();//Added on 30-May-2022
        ddlFloorbind(ClientID, ddlsite, Location, ddlBuilding);//Added on 30-May-2022
        var FloorLevelID = $('#ddlFloorLevel').val();
        GoogleMap(ClientID, ddlsite, Location, "All", "All");
    }

    // Add on 11-June-2020
    function Changebuilding() {
        var ddlsite = $('#ddlsite').val();
        var ClientID = $('#ClientId').val();
        var Location = $("#ddllocation").val();
        var Building = $("#ddlbuilding").val();
        ddlFloorbind(ClientID, ddlsite, Location, Building);//Added on 30-May-2022
        var FloorLevelID = $('#ddlFloorLevel').val();
        GoogleMap(ClientID, ddlsite, Location, Building, "All");
    }

    function ChangeFloorLevel() {
        var ddlsite = $('#ddlsite').val();
        var ClientID = $('#ClientId').val();
        var Location = $("#ddllocation").val();
        var Building = $("#ddlbuilding").val();
        var FloorLevelID = $('#ddlFloorLevel').val();
        GoogleMap(ClientID, ddlsite, Location, Building, FloorLevelID);
    }


    function redirection_Click() {
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var id = getParameterByName('id');

        var RID = $('#hdnrid').val();
        var EncryptData = Encrypt([RID]);
        RID = EncryptData[0];
        window.location.href = '/Register/Register?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&RID=' + RID;

        // Response.Redirect("Register.aspx?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&RID=" + databaseCon.Encrypt(hdnrid.Value));

    }

    function SiteDropdownBind(Clientid) {
        var UID = getParameterByName('UID');
        $.ajax({
            type: "POST",
            url: '/ScafMapJobStatus/SiteDropdownBind',
            async: false,
            data: JSON.stringify({ id: Clientid, UID: UID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // var ddSite = "<option value='All'>All</option>";
                var ddSite = "";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                    }
                });
                if (ddSite != "") {
                    $('#ddlsite').empty().append(ddSite);
                }

            }
        });


    }
    //add code on 26-Apr-2023.
    function ddllocationbind(ClientID, ddlsite) {
        $.ajax({
            type: "POST",
            // url: '../WebApi/Dashboard.asmx/ddlLocationScafMap',
            url: '/ScafMapJobStatus/ddlLocationScafMap',
            data: JSON.stringify({ ClientID: ClientID, SiteId: ddlsite }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var ddllocationdropdownbind = response;
                $("#ddllocation").html("");
                $("#ddllocation").append('<option value="All">All</option>');
                for (var i = 0; i < ddllocationdropdownbind.length; i++) {
                    // Location = ddllocationdropdownbind[0].Location;
                    $("#ddllocation").append('<option value="' + ddllocationdropdownbind[i].areaid + '">' + ddllocationdropdownbind[i].area + '</option>');

                }
            }
        });
    }

    // Add on 11-June-2020
    function ddlbuildingbind(ClientID, SiteId, LocationId) {
        $.ajax({
            type: "POST",
            //url: "../WebApi/Dashboard.asmx/ddlbuildingScafMap",
            url: '/ScafMapJobStatus/ddlbuildingScafMap',
            data: JSON.stringify({ ClientID: ClientID, SiteId: SiteId, LocationId: LocationId }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var ddlbuildingdropdownbind = response;
                $("#ddlbuilding").html("");
                $("#ddlbuilding").append('<option value="All">All</option>');
                for (var i = 0; i < ddlbuildingdropdownbind.length; i++) {
                    $("#ddlbuilding").append('<option value="' + ddlbuildingdropdownbind[i].buildingid + '">' + ddlbuildingdropdownbind[i].buildingno + '</option>');
                }
            }
        });

    }

    //Added on 26-Apr-2023 Start here
    function ddlFloorbind(ClientID, SiteId, LocationId, ddlBuilding) {
        $.ajax({
            type: "POST",
            //url: "../WebApi/Dashboard.asmx/ddlbuildingScafMap",
            url: '/ScafMapJobStatus/ddlFloorbind',
            async: false,
            data: JSON.stringify({ ClientID: ClientID, SiteId: SiteId, LocationId: LocationId, ddlBuilding: ddlBuilding }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var ddlFloordropdownbind = response;
                $("#ddlFloorLevel").html("");
                $("#ddlFloorLevel").append('<option value="All">All</option>');
                for (var i = 0; i < ddlFloordropdownbind.length; i++) {
                    $("#ddlFloorLevel").append('<option value="' + ddlFloordropdownbind[i].FloorLevelId + '">' + ddlFloordropdownbind[i].FloorLevel + '</option>');
                }
            }
        });

    }
    //Added on 26-Apr-2023 End here
    // function GoogleMap(ClientID, id, SubOwner) {
    function GoogleMap(ClientID, id, location, building, FloorLevelID) {
        var locations = [];
        $.ajax({
            type: "POST",
            // url: '../WebApi/Dashboard.asmx/GetMapLocation',
            url: '/ScafMapJobStatus/GetMapLocation',
            data: JSON.stringify({ ClientID: ClientID, id: id, location: location, building: building, FloorLevelID: FloorLevelID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                // var GoogleMap = response.d;
                if (response.length == '0') {
                    var response = { Result: "Failed", Message: "There is no register for the selected value." }
                    CustomAlert(response);
                }
                var GoogleMap = response;
                for (var i = 0; i < GoogleMap.length; i++) {
                    locations.push([GoogleMap[i].Lat, GoogleMap[i].Long, GoogleMap[i].ScaffRef, GoogleMap[i].RID, GoogleMap[i].Lattitude, GoogleMap[i].Longitude, GoogleMap[i].StartDate, GoogleMap[i].EndDate, GoogleMap[i].HireDaysToDate, GoogleMap[i].MaterialTypeMap, GoogleMap[i].DesignType, GoogleMap[i].ManHrsDismantle, GoogleMap[i].Tonnage, GoogleMap[i].BuildingMap, GoogleMap[i].FloorLevelMap, GoogleMap[i].Status, GoogleMap[i].DaysSinceLastInsp, GoogleMap[i].Image]);

                }
                //alert(locations);
                GetMap(locations);
            }
        });


    }


    function GetMap(markers) {
        var map;
        var global_markers = [];
        var infowindow = new google.maps.InfoWindow({});
        var blobBaseUrl = "/images/sites/";
        var showDetailsInPopup = false;
        var maxImgWidth = 300;
        if (!document.getElementById('gmIwStyle')) {
            var st = document.createElement('style');
            st.id = 'gmIwStyle';
            st.innerHTML =
                '.gm-style .gm-style-iw-c{padding:0 !important;}' +
                '.gm-style .gm-style-iw-d{overflow:hidden !important;max-height:none !important;}' +
                '.gm-style .gm-style-iw-chr{display:none !important;}' +
                '.gm-style .gm-ui-hover-effect{display:none !important;}';
            document.head.appendChild(st);
        }

        $(function () {
            geocoder = new google.maps.Geocoder();
            if (markers.length > 0) {
                var lat = markers[0][4];
                var long = markers[0][5];
            }
            else {
                var lat = "";
                var long = "";
            }
            // var lat = markers[0][4];
            // var long = markers[0][5];
            var latlng = new google.maps.LatLng(lat, long);
            var myOptions = {
                zoom: 19,
                tilt: 0,
                center: latlng,
                mapTypeId: google.maps.MapTypeId.HYBRID,
                mapTypeControl: false,
            }
            map = new google.maps.Map(document.getElementById("map_canvas"), myOptions);
            map.setOptions({ minZoom: 2 });
            var Clientid = getParameterByName('id');
            // var ddlsite = $('#ContentPlaceHolder1_ddlsite').val();
            var ddlsite = $('#ddlsite').val();
            //GoogleMap(Clientid, ddlsite);
            addMarker();
        })


        function addMarker() {
            for (var i = 0; i < markers.length; i++) {
                // obtain the attribues of each marker
                var lat = '';                                                        //Latitude
                var lng = '';                                                        //longitude
                if (markers[i][0] != '0' && markers[i][0] != '0') {
                    lat = parseFloat(markers[i][0]);
                    lng = parseFloat(markers[i][1]);
                }

                var Name = '';                                                      //Scaffref
                if (markers[i][2] != '' && markers[i][2] != null) {
                    Name = markers[i][2];
                }
                var url = markers[i][3];                                             //RegisterId
                var duration = '';
                if (markers[i][8] != '' && markers[i][8] != null) {
                    duration = markers[i][8];
                }

                var ErectDate = '';                                                  //Date Tagged
                if (markers[i][6] != null && markers[i][6] != '1900-01-01') {
                    var date1 = new Date(markers[i][6]);
                    var erect = "" + date1 + "";
                    var date1dd = erect.substring(8, 11);
                    var date1mm = erect.substring(4, 7);
                    var date1yyyy = erect.substring(11, 16);
                    ErectDate = date1dd + '-' + date1mm + '-' + date1yyyy
                }
                else {
                    var date1 = '';
                }

                if (markers[i][7] != null && markers[i][7] != '1900-01-01') {               // Date of Dismentle
                    var date2 = new Date(markers[i][7]);
                }
                else {
                    var date2 = new Date();
                }
                if (date1 != '') {                                                  // Diffrence between date tagged and date Dismentle
                    var timeDiff = Math.abs(date2.getTime() - date1.getTime());
                }

                //var Status = Math.ceil(timeDiff / (1000 * 3600 * 24));

                var DType = '';                                                 //Design type
                if (markers[i][10] != '' && markers[i][10] != null) {
                    DType = markers[i][10];
                }
                var MType = '';                                                 //Material type
                if (markers[i][9] != '' && markers[i][9] != null) {
                    MType = markers[i][9];
                }
                if (lat != '' && lng != '' && lat != '0' && lng != '0') {        //Pass lattitude and longitude to marker
                    var myLatlng = new google.maps.LatLng(lat, lng);
                }
                else {
                    var myLatlng = '';
                }
                var ManDismantle = '';
                if (markers[i][11] != '' && markers[i][11] != null) {
                    ManDismantle = markers[i][11];
                }
                var HireDaysToDate = '';
                if (markers[i][8] != '' && markers[i][8] != null) {
                    HireDaysToDate = markers[i][8];
                }

                var DaysSinceLastInsp = '';
                if (markers[i][16] != '' && markers[i][16] != null) {
                    DaysSinceLastInsp = markers[i][16];
                }

                // Changed on 03 June 2020
                var Tonnage = '';
                if (markers[i][12] != '' && markers[i][12] != null) {
                    Tonnage = markers[i][12];
                }

                var BuildingMap = '';
                if (markers[i][13] != '' && markers[i][13] != null) {
                    BuildingMap = markers[i][13];
                }

                var FloorLevel = '';
                if (markers[i][14] != '' && markers[i][14] != null) {
                    FloorLevel = markers[i][14];
                }
                var Status = markers[i][15]
                var markerCode;
                console.log(Status);
                var cleanStatus = (Status && typeof Status === "string") ? Status.trim().toLowerCase() : "";

                if (cleanStatus === "out of service") {
                    markerCode = "#ffffff";
                } else if (cleanStatus === "green" || cleanStatus === "yellow") {
                    markerCode = "#5FB43B";
                } else if (cleanStatus === "red") {
                    markerCode = "#ED0704";
                } else if (cleanStatus === "de-planked") {
                    markerCode = "#FFD700"; // Yellow
                } else if (cleanStatus === "tied-down") {
                    markerCode = "#FF1493";  // Purple
                }
                else if (cleanStatus === "restricted access") {
                    markerCode = "#0000FF"; // Blue
                }


                // End Changed on 03 June 2020
                var ImageName = '';
                if (markers[i][17] != '' && markers[i][17] != null) {
                    ImageName = ('' + markers[i][17]).trim();
                }
                var ImageUrl = '';
                if (ImageName != '') {
                    ImageUrl = (ImageName.indexOf('/') === 0 || ImageName.indexOf('http') === 0)
                        ? ImageName
                        : blobBaseUrl + ImageName;
                }

                var contentString = "<html><body><div><p><h2>" + Name + "</h2></p></div></body></html>";
                var infoContent =
                    '<div style="font-family:Arial, sans-serif; font-size:12px; line-height:18px;">' +
                    '<b>-~-~-~-~--~-~-~-~- DETAILS -~-~-~-~--~-~-~-~-</b><br/>' +
                    'Scaf Ref&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + Name + '<br/>' +
                    'Erection Date&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + ErectDate + '<br/>' +
                    'Standing Days to Date&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + HireDaysToDate + '<br/>' +
                    'Days Since Last Inspection : ' + DaysSinceLastInsp + '<br/>' +
                    'Man Hrs Dismantle&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + ManDismantle + '<br/>' +
                    'Material Type&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + MType + '<br/>' +
                    'Design Type&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + DType + '<br/>' +
                    'Tonnage&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + Tonnage + '<br/>' +
                    'Building&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + BuildingMap + '<br/>' +
                    'Floor Level&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;: ' + FloorLevel +
                    '</div>'; //Changed on 21-Sep-2026 - image yahan se hata di, ab infoWindow() me image preload hone ke baad add hoti hai

                if (lat != '' && lng != '' && lat != '0' && lng != '0') {        //Pass lattitude and longitude to marker
                    var myLatlng = new google.maps.LatLng(lat, lng);
                }
                else {
                    var myLatlng = '';
                }

                var marker = new google.maps.Marker({                                           //Create marker
                    //icon: mark,
                    icon: pinSymbol(markerCode),
                    position: myLatlng,
                    map: map,

                    //Changed on 03 June 2020
                    /*   title: '-~-~-~-~-DETAILS-~-~-~-~- \n Scaf Ref                              : ' + Name + '\n Erection Date                     : ' + ErectDate + '\n Standing Days to Date       : ' + HireDaysToDate + '\n Days Since Last Inspection : ' + DaysSinceLastInsp + '\n Man Hrs Dismantle            : ' + ManDismantle + '\n Material Type                     : ' + MType + '\n Design Type                       : ' + DType + '\n Tonnage                             : ' + Tonnage + '\n Building                             : ' + BuildingMap + '\n Floor Level                         : ' + FloorLevel*/

                    title: '-~-~-~-~--~-~-~-~- DETAILS -~-~-~-~--~-~-~-~-\n' +
                        'Scaf Ref                               : ' + Name + '\n' +
                        'Erection Date                      : ' + ErectDate + '\n' +
                        'Standing Days to Date        : ' + HireDaysToDate + '\n' +
                        'Days Since Last Inspection : ' + DaysSinceLastInsp + '\n' +
                        'Man Hrs Dismantle             : ' + ManDismantle + '\n' +
                        'Material Type                      : ' + MType + '\n' +
                        'Design Type                        : ' + DType + '\n' +
                        'Tonnage                              : ' + Tonnage + '\n' +
                        'Building                              : ' + BuildingMap + '\n' +
                        'Floor Level                          : ' + FloorLevel

                    // title: '-~-~-~-~-DETAILS-~-~-~-~-\n Scaf Ref                         : ' + Name + '\n Erection Date                : ' + ErectDate + '\n Actual Standing Days  : ' + Status + '\n Man Hrs Dismantle      : ' + ManDismantle + '\n Material Type                : ' + MType + '\n Design Type                  : ' + DType
                    //title: '-~-~-~-~-DETAILS-~-~-~-~-\n ScaffRef : ' + Name + '\n Erection Date : ' + ErectDate + '\n Days Standing : ' + duration + '\n Man Hrs Dismantle : ' + ManDismantle + '\n MaterialType : ' + MType + '\n Design Type : ' + DType
                });

                infoWindow(marker, url, infoContent, ImageUrl);
                marker['infowindow'] = contentString;

                global_markers[i] = marker;


            }
        }

        function pinSymbol(color) {
            return {
                path: 'M 0,0 C -2,-20 -10,-22 -10,-30 A 10,10 0 1,1 10,-30 C 10,-22 2,-20 0,0 z M -2,-30 a 2,2 0 1,1 4,0 2,2 0 1,1 -4,0',
                fillColor: color,
                fillOpacity: 1,
                strokeColor: '#000',
                strokeWeight: 2,
                scale: 1,
            };
        }

        function infoWindow(marker, url, infoContent, imageUrl) {
            google.maps.event.addListener(marker, 'click', function () {

                //$('#ContentPlaceHolder1_hdnrid').val(url);
                $('#hdnrid').val(url);
                redirection_Click();
            });

            var hoverToken = 0;
            google.maps.event.addListener(marker, 'mouseover', function () {
                var myToken = ++hoverToken;

                var showPopup = function (html) {
                    if (myToken !== hoverToken) { return; }
                    infowindow.setContent(html);
                    infowindow.open(map, marker);
                };

                if (imageUrl != '') {
                    var img = new Image();
                    img.onload = function () {
                        var w = Math.min(img.naturalWidth, maxImgWidth);
                        var html = '<div style="width:' + w + 'px;">' +
                            (showDetailsInPopup ? '<div style="padding:8px;">' + infoContent + '</div>' : '') +
                            '<img src="' + imageUrl + '" style="display:block;width:' + w + 'px;height:auto;border:6px solid #0096ff;box-sizing:border-box;" />' +
                            '</div>';
                        showPopup(html);
                    };
                    img.onerror = function () {
                        if (showDetailsInPopup) {
                            showPopup('<div style="padding:8px;">' + infoContent + '</div>');
                        }
                    };
                    img.src = imageUrl;
                }
                else if (showDetailsInPopup) {
                    showPopup('<div style="padding:8px;">' + infoContent + '</div>');
                }
            });
            google.maps.event.addListener(marker, 'mouseout', function () {
                hoverToken++;
                infowindow.close();
            });
        }

        //window.onload = initialize;
        //ddlchange = initialize;
    }



</script>




<script>

      function OnRadioClick(rb) {
            var grid = $find("<%=JobRadGrid.ClientID %>");
            var element = grid.get_element();
            var rbs = element.getElementsByTagName("input");
            for (var i = 0; i < rbs.length; i++) {
                if (rbs[i].type == "radio") {
                    if (rbs[i].checked && rbs[i] != rb) {
                        rbs[i].checked = false;
                        break;
                    }
                }
            }
        }
        var count = 0;
        var NumRows = 0;


        $(document).ready(function () {
            dropdownSiteLocation();
            dropdownResource();

            var today = new Date();

            $("#txtDate").val(today.DateMonthFormat());

            $("#txtDate").datepicker({
            dateFormat: 'dd-M-yy',
            maxDate: new Date(),
            closeText: 'Close',

            });

            $("#NewEntryDate").datepicker({
            dateFormat: 'dd-M-yy',
            maxDate: new Date(),
            closeText: 'Close',

            });

             
            var ResourceId = getParameterByName('ResourceId');
            var EntryDate = getParameterByName('EntryDate');
            if (ResourceId != "" && ResourceId != undefined && EntryDate != "" && EntryDate != undefined){
                $('#hdnResourceId').val(ResourceId);
                $('#hdnEntryDate').val(EntryDate);

                $('#resourceDropDown').val(ResourceId);
                $("#NewEntryDate").val(EntryDate);
                $("#LinkButton1").css("width", "30%");
                $("#divreconcile").css("display", "block");
                $("#divmanHrs").css("display", "none");
                BtnManHrs_ClickNew();
            }
            else{

                $("#divreconcile").css("display", "none");
                $("#divmanHrs").css("display", "block");
                $("#txtDate").val(today.DateMonthFormat());
            }

                          
        });

       

        $(document).ready(function () {
            //    $("#ulalwaysactive").css("display", "none");
            var screensize = $(window).width();
            if (screensize < 1150 && screensize > 650) {
                ($BODY.hasClass('nav-md'))
                $('#CreateNewDropDown').css("margin-top", "2px");
                $BODY.removeClass('nav-md').addClass('nav-sm');
                $LEFT_COL.removeClass('scroll-view');
                //$('#BlackSection').css('display', 'block');
                $('#imgLogo').parent().css('display', 'none');
                $('#imgLogo1').css('display', 'block').css("height", "38px");
                $('#leftbarsection').css('margin-top', '0px');


            }


            else {
                if (screensize < (650)) {
                    $BODY.removeClass('nav-sm')
                    $('#imgLogo').parent().css('display', 'none');
                    $('#imgLogo1').css('display', 'block').css("height", "52px");
                }
                else {
                    $('#CreateNewDropDown').css("margin-top", "6px");
                    $BODY.removeClass('nav-sm').addClass('nav-md');
                    //$('#BlackSection').css('display', 'none');
                    $('#imgLogo').parent().css('display', 'block');
                    $('#imgLogo1').css('display', 'none');
                    $('#leftbarsection').css('margin-top', '40px');
                }

            }
        });

        $(document).ready(function () {
            Hidealert();
        });

        function Hidealert() {
            setTimeout(function () {
                $(".fadeOut").fadeOut(2000);
            }, 2000);
        }

    $(document).on("keydown",".EnterQuantity",function(eve) { 
         //$('.EnterQuantity').keydown(function (eve) {
                            if (eve.keyCode != 8) {
                                var value = eve.key
                                var regex = /^[-_!':.,;"/|<>?+=@@#$%^&*({})a-zA-Z[]]+$/;
                                if (value.match(regex)) {
                                    eve.preventDefault();
                                }
                                if (eve.keyCode == 189) {
                                    eve.preventDefault();
                                }
                            }
          //  });

    });

    function dropdownSiteLocation() {
    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    //$('#LoadingPanel1').css('display', 'block');
    $.ajax({
        type: "POST",
        url: "/ManHrs/dropdownSiteLocation",

        data: JSON.stringify({ id: id, UID: UID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {

            var SiteData = response;
            if (SiteData.length > 0) {
                $("#ddlSite").append('<option value="">Select Site</option>');
                for (var i = 0; i < SiteData.length; i++) {
                    $("#ddlSite").append("<option value='" + SiteData[i].SiteLocID + "'>" + SiteData[i].SiteLocation + "</option>");
                }
            }

        }

    })
  }

 function dropdownResource(){
  var id = getParameterByName('id');

    $.ajax({
        type: "POST",
        url: "/ManHrs/dropdownResource",

        data: JSON.stringify({ id: id }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: false,
        success: function (response) {

            var GetData = response;

            if (GetData.length > 0) {
                $("#resourceDropDown").empty();
               // $("#resourceDropDown").append('<option value=""></option>');
                for (var i = 0; i < GetData.length; i++) {
                    $("#resourceDropDown").append("<option value='" + GetData[i].UserId + "'>" + GetData[i].resource + "</option>");
                }
            }
        }
     });

  }


 function ddlSite_SelectedIndexChanged(){
  var SiteID = $('#ddlSite').val();
  SiteJobDropdownBind();
  // if (SiteID == ""){
       $("#divbuttonsave").css("display", "none");
    // }
   $('#tblManHrsList').DataTable().clear();
   $('#tblManHrsList').DataTable().destroy();

 }

function resourceDropDown_Changed(){
   var ResourceId = $('#resourceDropDown').val();
   $('#hdnResourceId').val(ResourceId);
   $("#divbuttonsave").css("display", "none");

   $('#tblManHrsList').DataTable().clear();
   $('#tblManHrsList').DataTable().destroy();

 }

 function SiteJobDropdownBind(){
     var id = getParameterByName('id');
     var SiteID = $('#ddlSite').val();
     if (SiteID == ""){
      SiteID= "0";
      $("#ddlJob").empty();
     }
     else{
      $.ajax({
        type: "POST",
        url: "/ManHrs/SiteJobDropdownBind",

        data: JSON.stringify({ id: id, SiteID: SiteID }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {

            var GetData = response;

            if (GetData.length > 0) {
                $("#ddlJob").empty();
               // $("#ddlJob").append('<option value="">All</option>');
                for (var i = 0; i < GetData.length; i++) {
                    $("#ddlJob").append("<option value='" + GetData[i].RegisterId + "'>" + GetData[i].ScaffRef + "</option>");
                }
            }
        }
     });

    }

  }

function BtnManHrs_ClickNew(){
  BtnManHrs_Click();
}

 var table = "";
 function BtnManHrs_Click(){
    var SiteID = "";
    var RegisterId = "";
    var id = getParameterByName('id');
    var SiteID = $('#ddlSite').val();
    RegisterId = $('#ddlJob').val();
    if(RegisterId == null){
      RegisterId= "" ;
    }
    var EntryDate = $('#txtDate').val();
    var ResourceId="";   
    var hdnResourceID = $('#hdnResourceId').val();
    var nothdnResourceId = $('#resourceDropDown').val();

    if(hdnResourceID != ""){
      ResourceId= hdnResourceID ;
      SiteID= "0";
    } 
    else{
      ResourceId= nothdnResourceId ;
    }
    var NewEntryDate = $('#NewEntryDate').val();
    $('#LoadingPanel1').show();

   // if (hdnResourceID = ""){
 
     if (SiteID != "") {
        $.ajax({
            type: "POST",
            url: "/ManHrs/GetManHrsData",
            data: JSON.stringify({ id: id,SiteID:SiteID,RegisterId:RegisterId,EntryDate:EntryDate, ResourceId:ResourceId, NewEntryDate:NewEntryDate }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (response) {

                var GetData = response;
                $('#tblManHrsList').DataTable().clear();
                $('#tblManHrsList').DataTable().destroy();
             
                if (GetData.length > 0) {
                     $("#divbuttonsave").css("display", "block");

                    var str = "";
                    for (var i = 0; i < GetData.length; i++) {
                        str = "";
                        var ManHrsId = GetData[i].ManHrsId == null ? "" : GetData[i].ManHrsId;
                        var SiteLocId = GetData[i].SiteLocId == null ? "" : GetData[i].SiteLocId;
                        var SiteLocation = GetData[i].SiteLocation == null ? "" : GetData[i].SiteLocation;

                        var UserId = GetData[i].UserId == null ? "" : GetData[i].UserId;
                        var Resource = GetData[i].name == null ? "" : GetData[i].name;
                        var RegisterID = GetData[i].RegisterID == null ? "" : GetData[i].RegisterID;
                        var Description = GetData[i].Description == null ? "" : GetData[i].Description;
                        var EntryDate = GetData[i].EntryDate == null ? "" : DateFormat(GetData[i].EntryDate);
                        var AdditionalHrs = GetData[i].AdditionalHrs == null ? "" : GetData[i].AdditionalHrs.toFixed(2);
                        var TypeofVariation = GetData[i].TypeofVariation == null ? "" : GetData[i].TypeofVariation;
                        var VariationDesc = GetData[i].VariationDesc == null ? "" : GetData[i].VariationDesc;
                        var IncludedInDayDocket = GetData[i].IncludedInDayDocket == null ? "" : GetData[i].IncludedInDayDocket;
                        var VariationComments = GetData[i].VariationComments == null ? "" : GetData[i].VariationComments;
                        var ErectionHrs = GetData[i].ErectionHrs == null ? "" : GetData[i].ErectionHrs.toFixed(2);
                        var DismantleHrs = GetData[i].DismantleHrs == null ? "" : GetData[i].DismantleHrs.toFixed(2);
                        var ModificationHrs = GetData[i].ModificationHrs == null ? "" : GetData[i].ModificationHrs.toFixed(2);

                        var SiteHrs = GetData[i].NoOfHrs == null ? "" : GetData[i].NoOfHrs.toFixed(2);
                        var AllocatedHrs = GetData[i].AllocatedHrs == null ? "" : GetData[i].AllocatedHrs.toFixed(2);
                        var Category = GetData[i].Category == null ? "" : GetData[i].Category;


                        str += "<tr id='tblManHrsList_tr_"+i+"'>"
                        str += "<td class='setWidth0' id='ManHrsId_" + i + "' style='display:none'>" + ManHrsId + "</td>"
                        str += "<td class='setWidth0' title='Click here for Delete' style='cursor:pointer;'><i class='fa fa-trash setWidth0' onclick=ShowDeletePopup('" + ManHrsId + "')></i></td>";
                        str += "<td class='setWidth1' id='SiteLocation_" + i + "'>" + SiteLocation + "</td>"
                        str += "<td class='setWidth2' id='Description_" + i + "'>" + Description + "</td>"
                        str += "<td class='setWidth3' id='Resource_" + i + "'>" + Resource + "</td>"
                        str += "<td class='setWidth4' id='Category_" + i + "'>" + Category + "</td>"
                        str += "<td class='setWidth5' id='SiteHrs_" + i + "'>" + SiteHrs + "</td>"

                        str += "<td class='setWidth6' id='AllocatedHrs_" + i + "'>" +AllocatedHrs + "</td>"
                        str += "<td class='setWidth7' style='background-color: LightCyan;'><input id='ErectionHrs_" + i + "' min='0' type='number' class='changeborder EnterQuantity appendDigitDecimal form-control' value= '"+ErectionHrs+ "' /></td>"
                        str += "<td class='setWidth8' style='background-color: LightCyan;'><input id='DismantleHrs_" + i + "' min='0' type='number' class='changeborder EnterQuantity appendDigitDecimal form-control' value= '"+DismantleHrs+ "' /></td>"
                        str += "<td class='setWidth9' style='background-color: LightCyan;'><input id='ModificationHrs_" + i + "' min='0' type='number' class='changeborder EnterQuantity appendDigitDecimal form-control' value= '"+ModificationHrs+ "' /></td>"
                        str += "<td class='setWidth10' style='background-color: LightCyan;'><input id='AdditionalHrs_" + i + "' min='0' type='number' class='changeborder EnterQuantity appendDigitDecimal form-control' value= '"+AdditionalHrs+ "' /></td>"

                        str += "<td class='setWidth11' style='background-color: LightCyan;'><select id='TypeofVariation_" + i + "'class='changeborder form-control' > <option value='' ></option> <option value='Delay' >Delay</option> <option value='Inclem. Weather' >Inclem. Weather</option> <option value='Modification' >Modification</option> </select> </td>"
                        str += "<td class='setWidth12' style='background-color: LightCyan;'><input id='VariationDesc_" + i + "' type='text' class='changeborder form-control' value= '"+VariationDesc+ "' /></td>"
                        str += "<td class='setWidth13' style='background-color: LightCyan;'><select id='IncludedInDayDocket_" + i + "'class='changeborder form-control' > <option value='' ></option> <option value='No' >No</option><option value='Yes' >Yes</option> </select> </td>"
                        str += "<td class='setWidth14' style='background-color: LightCyan;'><input id='VariationComments_" + i + "' type='text' class='changeborder form-control' value= '"+VariationComments+ "' /></td>"


                        str += "<td class='setWidth15' id='EntryDate_" + i + "'>" + EntryDate+ "</td>"
                        str += "<td class='setWidth16' id='UserId_" + i + "' style='display:none'>" + UserId + "</td>"
                        str += "<td class='setWidth17' id='RegisterID_" + i + "' style='display:none'>" + RegisterID + "</td>"
                        str += "<td class='setWidth18' id='SiteLocId_" + i + "' style='display:none'>" + SiteLocId + "</td>"
                        str += "</tr>"
                          
                          $('#tbodyManHrsList').append(str);  // append done here for making select dropdowns values.
                          $('#TypeofVariation_'+ i ).val(TypeofVariation);
                          $('#IncludedInDayDocket_'+ i ).val(IncludedInDayDocket);

                   }
                    //$('#tbodyManHrsList').append(str);

                     $('.changeborder').change(function () {
                        event.stopImmediatePropagation();
                          $(this).css('border','1px solid Red');
                          $(this).addClass('colorBorderChange');

                    });

                     $('.appendDigitDecimal').change(function () {

                        $(this).val(parseInt(this.value).toFixed(2));

                    });

                    $('#LoadingPanel1').hide();
                }

                $('#LoadingPanel1').hide();

                table = $('#tblManHrsList').DataTable({
                    "bSort": false,
                    "processing": true,
                    "language": {
                       "emptyTable":  "Please go to Site Man Hours and Assign Resources for the Selected Date"
                     } ,
                    searching: true,
                    "bLengthChange": true,
                    "bInfo": false,
                    autoWidth: false,
                    scrollX: true,
                    scrollY: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    "lengthMenu": [10, 25, 50, 100, 200],
                    "pageLength": 50,

                    dom: 'Bfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Daily Job Hours Allocation List',
                            exportOptions: {
                              columns: [2,3, 4, 5, 6, 7]
                            },
                        }
                    ],
 

                });
              
                if (hdnResourceID != ""){
                   //table.column(6).visible(false);
                   table.column(7).visible(false);
                } 



            }
         })

        }
        else {
                var response = { Result: "Failed", Message: "Please Select Site ." }
                 CustomAlert(response);
                 $("#LoadingPanel1").css("display", "none");

         }
    }

 function btnSaveManHrs_Click(){
       $('#LoadingPanel1').show();

        ManHrsDataArr = [];
        //var tablemanhrs= $('#tblManHrsList').dataTable(); //Get the total rows
        //var TablLength= tablemanhrs.fnGetData().length;

       var SiteID = "";
       var txtDate = "";
       var TablLength=$('#tblManHrsList tbody tr').length;
       var ChkUpdateAllflag = false;
       var hdnResourceID = $('#hdnResourceId').val();
       SiteID = $('#ddlSite').val();
       txtDate=$('#txtDate').val();
       if(hdnResourceID != ""){
          SiteID= "0";
          txtDate= $('#NewEntryDate').val();
       } 

       if (SiteID != "") {
         for (var i = 0; i < TablLength; i++) {
         var flagrow=false;

         $('#tblManHrsList_tr_'+i+' input').each(function(){ 
                 //if($(this).hasClass('changeborder')){  
                  if($(this).hasClass('colorBorderChange')){  
                  flagrow=true;
                       
                        }
               })
               
           if(flagrow)
           {
                //ChkUpdateAllflag=true;
  
                             var indexNumber = i ;
                             var AdditionalHrs = $("#AdditionalHrs_" + indexNumber).val();
                             var TypeofVariation = $("#TypeofVariation_" + indexNumber).val();
                             if(AdditionalHrs != "" && TypeofVariation == "" || AdditionalHrs == "" && TypeofVariation != "") {
                                  var response = { Result: "Failed", Message: "'Additional Hours' must be filled with 'Type of variation' " }
                                  CustomAlert(response);
                                  $('#LoadingPanel1').hide();
                             }
                             else{
                             ChkUpdateAllflag=true;
                             var ManHrsId = $("#ManHrsId_" + indexNumber).text();
                             var UserId = $("#UserId_" + indexNumber).text();
                             var Resource = $("#Resource_" + indexNumber).text();
                             var Category = $("#Category_" + indexNumber).text();
                             var AllocatedHrs = $("#AllocatedHrs_" + indexNumber).text();
                             var SiteHrs = $("#SiteHrs_" + indexNumber).text();
                             var EntryDate = $("#EntryDate_" + indexNumber).text();
                             var SiteLocation = $("#SiteLocation_" + indexNumber).text();
                             var DismantleHrs = $("#DismantleHrs_" + indexNumber).val();
                             var ModificationHrs = $("#ModificationHrs_" + indexNumber).val();
                             var ErectionHrs = $("#ErectionHrs_" + indexNumber).val();
                             //var AdditionalHrs = $("#AdditionalHrs_" + indexNumber).val();
                             //var TypeofVariation = $("#TypeofVariation_" + indexNumber).val();
                             var VariationDesc = $("#VariationDesc_" + indexNumber).val();
                             var IncludedInDayDocket = $("#IncludedInDayDocket_" + indexNumber).val();
                             var VariationComments = $("#VariationComments_" + indexNumber).val();

                             var ClientID = getParameterByName('id');
                             var UID = getParameterByName('UID');
                             //var SiteID = $('#ddlSite').val();
                             //var RegisterID = $('#ddlJob').val();
                             var RegisterID = $("#RegisterID_" + indexNumber).text();
                             var SiteID = $("#SiteLocId_" + indexNumber).text();
                            // var txtDate=$('#txtDate').val();

                            var ArryVal = { SiteLocId: SiteID, RegisterID:RegisterID, ManHrsId:ManHrsId, AllocatedHrs:AllocatedHrs, NoOfHrs: SiteHrs, DismantleHrs:DismantleHrs, ModificationHrs:ModificationHrs,
                                           ErectionHrs:ErectionHrs, AdditionalHrs:AdditionalHrs, TypeofVariation:TypeofVariation, VariationDesc:VariationDesc, IncludedInDayDocket:IncludedInDayDocket,
                                            VariationComments:VariationComments, UserId:UserId, EntryDate:txtDate ,UID:UID };
                            ManHrsDataArr.push(ArryVal);
                           }
              }
         }

                if (ChkUpdateAllflag == true) {
                        $.ajax({
                            type: 'post',
                            url: '/ManHrs/btnSaveManHrs_Click',
                            data: JSON.stringify({ model: ManHrsDataArr }),
                              //data:{modal:ManHrsDataArr},
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            async: false,
                            success: function (response) {
                                var GetData = response;
                                CustomAlert(response);

                                BtnManHrs_Click();

                            }
                        });
                      }
                 else {
                    
                    $('#LoadingPanel1').show();
               }     

                } else {
                    var response = { Result: "Failed", Message: "Please Select Site." }
                    CustomAlert(response);
                    $('#LoadingPanel1').hide();
               }

    $('#LoadingPanel1').hide();
  }



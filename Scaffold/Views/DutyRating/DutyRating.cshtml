
@{
    ViewBag.Title = "DutyRating";
}

    <style>
        .dt-button.buttons-csv.buttons-html5 {
            display: none;
        }

        #gridDutyRating_length {
            margin-top: -16px;
        }
    </style>

<script>
    $(document).ready(function () {
        if (getParameterByName('RID') != null) {
            $('#btnCAncel').css('display', 'block');
        }
    });
    $(function () {
        GetDutyRating();
    });

    let Status = '';
    function GetDutyRating() {

        $("#LoadingPanel1").css("display", "block");

        var str = "";

        str += '<table id="gridDutyRating" class="table table-striped display" style="width:100%;table-layout:fixed;font-size:12px">';
        str += "<thead><tr>";
        str += "<th style='width:6%' class='ClassbtnDutyRatingEdit'>#</th>";
        str += "<th style='width:6%' class='ClassbtnDutyRatingDelete'>#</th>";
        str += "<th  style='text-align:center;display:none'>DutyRatingId</th>";
        str += "<th  style='text-align:left;width:30%'>Duty Rating</th>";
        str += "<th  style='text-align:center;width:20%'>Status</th></tr></thead><tbody>";

        var id = getParameterByName('id');
        $.ajax({
            url: '/DutyRating/GetDutyRatingData',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getdata = response;
               
                str += "<tr id='row_9999' style='display:none'><td  style='width:2%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                    str += "<td  style='text-align:center;display:none'></td>";
                    str += "<td  style='text-align:center;display:none'>0</td>";
                    str += "<td  style='text-align:left;width:10%'></td>";
                    str += "<td  style='text-align:center;width:10%'></td></tr>";
                

                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var DutyRatingId = getdata[i].DutyRatingId == null ? "" : getdata[i].DutyRatingId;
                        var DutyRating = getdata[i].DutyRating == null ? "" : getdata[i].DutyRating;
                        var DutyRatingStatus = getdata[i].DutyRatingStatus == null ? "" : getdata[i].DutyRatingStatus;

                       // str += "<td  style='width:2%;display:inline-flex;'><a id='rowpencil' class='expand fa fa-pencil'></a>&nbsp;&nbsp;<a id='rowdelete' class='fa fa-trash'></a></td>";
                        str += "<td style='width:3%;' class='ClassbtnDutyRatingEdit'><a id='rowpencil' class='expand fa fa-pencil'></a></td>";
                        str += "<td style='width:3%;' class='ClassbtnDutyRatingDelete'><a id='rowdelete' class='fa fa-trash'></a></td>";
                        str += "<td  style='text-align:center;display:none'>" + DutyRatingId + "</td>";
                        str += "<td  style='text-align:left;width:10%'>" + DutyRating + "</td>";
                       // str += "<td  style='text-align:center; width:10%'><button style='background-color: #45b6af;color:white;' class='form-control'  > " + DutyRatingStatus + "</button></td></tr>";
                        str += "<td  style='text-align:center; width:10%'>" + DutyRatingStatus + "</td></tr>";
                    }
                  
                }
                str += "</tbody></table>";
                $("#loaddata").html(str);

                $("#LoadingPanel1").css("display", "none");

                $(".fa-trash").click(function () {
                    //var designType = $(this).parent().parent().children()[1].innerText;
                    var dutyRating = $(this).parent().parent().children()[2].innerText;
                    $("#hdnDutyRatingId").val(dutyRating);
                    $("#Deletemodal").css("display", "block");
                });

                $(".fa-pencil").click(function () {
                    var visible = $(this).parent().parent().hasClass("Edit");
                    var tr = $(this).closest('tr');
                    var row = table.row(tr);
                    if (visible == true) {
                        $(this).parent().parent().next('tr').remove();
                        $(this).parent().parent().removeClass('Edit');
                    }
                    else {
                        row.child(Editing(row.data())).show();
                        $('#ddlStatus').val(Status);
                        row.child.show();
                        tr.addClass('Edit');
                    }

                });

                var table = $('#gridDutyRating').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    info: false,
                    "pageLength": 50,
                    autoWidth: true,
                    scrollX: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    fixedHeader: true,
                    fixedColumns: {
                        leftColumns: 11,
                    },
                    dom: 'lBfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Duty Rating',
                            exportOptions: {
                                columns: [3, 4]
                            }
                        }
                    ],

                    initComplete: function () {
                        $(this.api().table().container()).find('input').parent().wrap('<form>').parent().attr('autocomplete', 'off'); // Auto Fill In Text box when ID Or Password Save on Crome Browser
                        $("#gridDutyRating_length").children().html('<button id="btnaddDutyRating"  type="button" class="w3-btn w3-teal fa fa-plus" style="margin-bottom:-43px;">&nbsp;Add New Duty Rating</button><button id="btnExport" type="button" class="w3-btn w3-teal Export" style="margin-left:190px;height:27px;padding-top:3px;width:133px;"><i class="fa fa-file-excel-o"></i>&nbsp;Export to CSV</button>');
                        $("#btnaddDutyRating").click(function () {

                            var trow1 = $(this).parent().parent().siblings();
                            var trow = $(this).parent().parent().siblings()[2].childNodes[0];
                            // var trow = $(this).parent().parent().siblings()[2].children[1].children[0].children[1].childNodes[0];
                            var row = table.row(trow);
                            var c = 0;
                            row.child(Editing(c)).show();

                        });

                        $(".Export").click(function () {
                            $('.dt-button.buttons-csv.buttons-html5').trigger('click');
                        });
                    },
                    "columnDefs": [
                        { "width": "100px", "targets": 'fullsize' }
                    ],
                    "drawCallback": function () {

                        $('.fa-angle-right').click(function (eve) {
                            eve.stopImmediatePropagation();
                            var tr = $(this).closest('tr');
                            var row = table.row(tr);
                            var visible = $(this).parent().parent().hasClass("shown");
                            var anglechange = $(this).hasClass("fa-angle-right");
                            if (anglechange == true) {
                                var x = tr.children()[0];
                                $(this).removeClass("fa-angle-right");
                                $(this).addClass("fa-angle-down");
                            }
                            else {
                                $(this).addClass("fa-angle-right");
                                $(this).removeClass("fa-angle-down");
                            }
                            if (visible == true) {
                                // This row is already open - close it
                                $(this).parent().parent().next('tr').remove();
                                $(this).parent().parent().removeClass('shown');
                            }
                            else {
                                // Open this row
                                row.child(format(row.data())).show();
                                row.child.show();
                                tr.addClass('shown');
                            }
                        });
                        GridButtonHideShow(table, "gridDutyRating");
                    }

                });

                // scrolling Top when Click On Next Button

                table.on('page.dt', function () {
                    $('.dataTables_scrollBody').animate({
                        scrollTop: 0
                    }, 300);
                });

                // Hide Show For DataTable Column And Buttons Start Here

                GridButtonHideShow(table, "gridDutyRating");

                // Hide Show For DataTable Column And Buttons End Here
            }
        });
    }





    function Editing(d) {

        var id = getParameterByName('id');
        $.ajax({

            success: function (response) {

            },
            complete: function () {
                $(".CancelChangeClass").click(function () {
                    $(this).parent().parent().parent().parent().prev('tr').removeClass('Edit');
                    $(this).parent().parent().parent().parent().remove();
                });

                $("#savechange").click(function () {

                   // var dutyRatingId = $(this).parent().parent().parent().parent().prev('tr').children()[1].innerText;
                    var dutyRatingId = $(this).parent().parent().parent().parent().prev('tr').children()[2].innerText;
                    var firstrow = $(this).parent().parent().prev('div').children().find('input[type=text]');
                    var sropdownval = $(this).parent().parent().prev('div').children().find('select');

                    var DutyRating = firstrow[0].value;
                    var Status = sropdownval[0].value;

                    var id = getParameterByName('id');
                    var UID = getParameterByName('UID');

                    if (DutyRating != "") {
                        $("#LoadingPanel1").css("display", "block");

                        $.ajax({
                            type: "POST",
                            url: "/DutyRating/SaveDutyRatingData",
                            data: JSON.stringify({ "dutyRatingId": dutyRatingId, "DutyRating": DutyRating, "Status": Status, "id": id, "UID": UID }),
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                            success: function (response) {
                                var result = response;
                                if (result.Result == 'Success') {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                    GetDutyRating();
                                }
                                else {
                                    $("#LoadingPanel1").css("display", "none");
                                    CustomAlert(response);
                                }
                                // $('#hdnOldQty').val("");
                            }
                        })
                    } else {
                        $("#LoadingPanel1").css("display", "none");
                        $('#txtDutyRating').css('border-color', 'red');
                    }

                });
            }
        });
        if (d == 0) {
            return '<div class="col-lg-12">'
                + '<div class="col-lg-6">'
                + ' Duty Rating <a style="color:red">*</a><input id="txtDutyRating" type="text" class="form-control" style="width:100%" required>'
                + '</div><div class="col-lg-6">'
                + 'Status<select id="ddlStatus" style="width:100%" class="form-control" required><option value="Active">Active</option><option value="InActive">InActive</option></select>'
                + '</div></div>'
                + '<div class="col-lg-12">'
                + '<div class="col-lg-3">'
                + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                + '</div><div class="col-lg-3">'
                + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                + '</div><div class="col-lg-6"></div>'

        }
        else {
            Status = d[4];
            return '<div class="col-lg-12">'
                + '<div class="col-lg-6">'
                + 'Duty Rating <a style="color:red">*</a><input id="txtDutyRating" type="text" class="form-control" value="' + d[3] + '" style="width:100%" required>'
                + '</div><div class="col-lg-6">'
                + 'Status<select id="ddlStatus" style="width:100%" class="form-control" required><option value="Active">Active</option><option value="InActive">InActive</option></select>'
                + '</div></div>'
                + '<div class="col-lg-12">'
                + '<div class="col-lg-3">'
                + '<input type="button" id="savechange" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%"/>'
                + '<input type="submit" id="btnsubmit" class="btn btn-primary" value="Save" style="color:white;margin-top:6px;width:100%;display:none"/>'
                + '</div><div class="col-lg-3">'
                + '<input type="button" id="cancelchange" class="btn CancelChangeClass" value="Cancel" style="color:black;background: lightgrey;margin-top:6px;width:100%"/>'
                + '</div><div class="col-lg-6"></div></div>'
        }

    }




  

    function btnyes_Click() {

        var DutyRatingId = $('#hdnDutyRatingId').val();

        $.ajax({
            url: '/DutyRating/DeleteDocument',
            type: 'post',
            data: { DutyRatingId: DutyRatingId },
            async: false,
            success: function (response) {
                $("#Deletemodal").css("display", "none");
                if (response.Result == 'Success') {
                    CustomAlert(response);
                    GetDutyRating();
                } else {
                    CustomAlert(response);
                }
            }
        });
    }
    function btnCAncel_Click() {
        // Response.Redirect("Register.aspx?UID="+Request.QueryString["UID"]+"&UserRole="+Request.QueryString["UserRole"]+"&id="+Request.QueryString["id"]+"&RID="+Request.QueryString["RID"], false);
        var UID = getParameterByName('UID');
        var UserRole = getParameterByName('UserRole');
        var id = getParameterByName('id');
        var RID = getParameterByName('RID');

        window.location.href = '/Register/Register?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&RID=' + RID;
    }
</script>

<input type="hidden" id="hdnTableData" />
<input type="hidden" id="hdnDutyRatingId" />
<div class="row">
    <div class="col-lg-2 col-md-3 col-sm-4">
        <h4 class="heading" style="color: #0070ba;font-size:15px;"><b><i class="fa fa-line-chart"></i>&nbsp;Duty Rating List</b></h4>
    </div>
    <div class="col-lg-2 col-md-3 col-sm-4  ">
        @*<asp:LinkButton runat="server" ID="btnCAncel" Style="height: 24px; padding-top: 3px" CssClass="w3-btn w3-small  nln-bg w3-text-white" OnClick="btnCAncel_Click"> <i class="fa fa-backward"> </i>&nbsp;&nbsp;Back to Job</asp:LinkButton>*@
        <button id="btnCAncel" Style="height: 24px; padding-top: 3px;display:none" Class="w3-btn w3-small  nln-bg w3-text-white" OnClick="btnCAncel_Click()"> <i class="fa fa-backward"> </i>&nbsp;&nbsp;Back to Job</button>
    </div>
</div>

<div class="row">
    <div class="col-xs-12 col-lg-6 col-md-9 col-sm-12">
        <div id="loaddata" style="color: black; width: 100%"></div>
    </div>
</div>

<div id="Deletemodal" class="w3-modal" runat="server" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 128px; width: 365px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey">
            <span class="w3-closebtn"></span>
            <h4 class="w3-text-white"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp;Delete Record</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">
                <label>Are you sure you want to Delete the Record?</label>
            </p>
        </div>
        <div class="row" style="padding-bottom: 20px">

            <div class="col-lg-4 col-sm-4 col-md-4 col-xs-4"></div>
            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" style="margin-right: 21px">
                <button id="btnyes" Class="w3-btn w3-green w3-hover-dark-grey" OnClick="btnyes_Click()"> <i class="glyphicon glyphicon-ok-circle"></i> Yes</button>
            </div>
            <div class="col-xs-2 col-lg-4 col-md-2 col-sm-2">
                <button id="btnno" Class="w3-btn nln-bg w3-hover-border-dark-grey" OnClick="$('#Deletemodal').hide();"><i class="glyphicon glyphicon-remove-circle"></i> No</button>
            </div>
        </div>

    </div>
</div>


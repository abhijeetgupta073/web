<script>
    $(function () {
        GetSubCategories();


    });



    var Gobalcategory = "";
    var GobalhireMeasurement = "";
    function GetSubCategories() {

        var str = "";

        str += '<table id="dataforgrid" class="table table-striped display" style="width:100%;table-layout:fixed;font-size:12px">';
        str += "<thead><tr>";
        str += "<th style='width:2%'>#</th>";
        str += "<th  style='text-align:center;'>Tonnage Hire Rate in $</th>";
        str += "<th  style='text-align:center;'>Tonnage Surge Rate in $</th>";
        str += "<th  style='text-align:center;'>Surge Applied Tonnage</th></tr ></thead > <tbody>";

        var id = getParameterByName('id');

        $.ajax({
            url: '/InvoicedSurgeReport/GetSubCategoryData',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getdata = response.getData;
                var Clientdata = response.getData2;
                str += "<tr id='row_9999' style='display:none'><td  style='width:2%;'><a class='expand fa fa-angle-right' style='font-size:19px;'></a></td>";
                str += "<td  style='text-align:center;display:none'>0</td>";
                str += "<td  style='text-align:center;'></td>";
                str += "<td  style='text-align:center;'></td>";
                str += "<td  style='text-align:center;'></td>";
                str += "<td  style='text-align:center;'></td></tr>";


                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var SurgeRate_ID = getdata[i].SurgeRate_ID == null ? "" : getdata[i].SurgeRate_ID;
                        var TonnageHireRate = getdata[i].TonnageHireRate == null ? "" : getdata[i].TonnageHireRate;
                        var TonnageSurgeRate = getdata[i].TonnageSurgeRate == null ? "" : getdata[i].TonnageSurgeRate;
                        var SurgeAppliedTonnage = getdata[i].SurgeAppliedTonnage == null ? "" : getdata[i].SurgeAppliedTonnage;
                        //var AgreedHire = getdata[i].AgreedHire == null ? "" : getdata[i].AgreedHire;


                        if (TonnageHireRate) {

                            var AddDoller = "$";
                            var TonnageHireRate = AddDoller + TonnageHireRate;
                        }


                        if (TonnageSurgeRate) {

                            var AddDoller = "$";
                            var TonnageSurgeRate = AddDoller + TonnageSurgeRate;
                        }

                        str += "<td  style='width:2%;display: inline-flex;'><a id='rowpencil' onclick='EditeSurgeDetails()' class='expand fa fa-pencil'></td>";
                        str += "<td  style='text-align:center;display:none'>" + SurgeRate_ID + "</td>";
                        str += "<td  style='text-align:center;'>" + TonnageHireRate + "</td>";
                        str += "<td  style='text-align:center;'>" + TonnageSurgeRate + "</td>";
                        str += "<td  style='text-align:center;'>" + SurgeAppliedTonnage + "</td></tr>";
                        /*                        str += "<td  style='text-align:center;'>" + AgreedHire + "</td>*/

                    }

                }
                else {
                    $('#CustomAlert').removeClass('j-alertBox-Failed1');
                    $('#CustomAlert').addClass('j-alertBox-Failed2').css('display', 'block');
                    var Client = Clientdata[0].Name;
                    var Response = { Result: "Failed", Message: "No Surge Rate available for the client - " + Client };
                    CustomAlert(Response);
                }
                str += "</tbody></table>";
                $("#loaddata").html(str);

                $("#LoadingPanel1").css("display", "none");

                $(".fa-trash").click(function () {
                    var subCateId = $(this).parent().parent().children()[1].innerText;
                    $("#SurgeRate_ID").val(subCateId);
                    $("#Deletemodal").css("display", "block");
                });



                var table = $('#dataforgrid').DataTable({
                    "bSort": false,
                    "processing": true,
                    searching: true,
                    info: false,
                    "pageLength": 50,
                    autoWidth: true,
                    scrollX: true,
                    scrollCollapse: true,
                    scrollY: "60vh",
                    fixedHeader: true,
                    fixedColumns: {
                        leftColumns: 11,
                    },

                    dom: 'lBfrtip',
                    buttons: [

                        {
                            extend: 'csvHtml5',
                            title: 'Sub Category',
                            exportOptions: {
                                columns: [2, 3, 4, 5]
                            }
                        }
                    ],


                    initComplete: function () {
                        $(this.api().table().container()).find('input').parent().wrap('<form>').parent().attr('autocomplete', 'off'); // Auto Fill In Text box when ID Or Password Save on Crome Browser
                        $("#dataforgrid_length").children().html('<button id="btnaddSubCategory"  type="button" class="w3-btn w3-teal fa fa-plus" style="margin-bottom:-34px;">&nbsp;Add New Sub Category</button><button id="btnExport" type="button" class="w3-btn w3-teal Export" style="margin-left:185px;margin-top: -5px;;height:27px;padding-top:3px;"><i class="fa fa-file-excel-o"></i>&nbsp;Export to CSV</button>');

                        $("#btnaddSubCategory").click(function () {

                            var trow1 = $(this).parent().parent().siblings();
                            var trow = $(this).parent().parent().siblings()[2].childNodes[0];
                            // var trow = $(this).parent().parent().siblings()[2].children[1].children[0].children[1].childNodes[0];
                            var row = table.row(trow);
                            var c = 0;
                            row.child(Editing(c)).show();

                        });

                        $(".Export").click(function () {
                            $('.dt-button.buttons-csv.buttons-html5').trigger('click');
                        });
                    },

                    "columnDefs": [
                        { "width": "100px", "targets": 'fullsize' }
                    ],

                    "drawCallback": function () {

                        $('.fa-angle-right').click(function (eve) {
                            eve.stopImmediatePropagation();
                            var tr = $(this).closest('tr');
                            var row = table.row(tr);
                            var visible = $(this).parent().parent().hasClass("shown");
                            var anglechange = $(this).hasClass("fa-angle-right");
                            if (anglechange == true) {
                                var x = tr.children()[0];
                                $(this).removeClass("fa-angle-right");
                                $(this).addClass("fa-angle-down");
                            }
                            else {
                                $(this).addClass("fa-angle-right");
                                $(this).removeClass("fa-angle-down");
                            }
                            if (visible == true) {
                                // This row is already open - close it
                                $(this).parent().parent().next('tr').remove();
                                $(this).parent().parent().removeClass('shown');
                            }
                            else {
                                // Open this row
                                row.child(format(row.data())).show();
                                row.child.show();
                                tr.addClass('shown');
                            }
                        });
                    }

                });

                // scrolling Top when Click On Next Button

                table.on('page.dt', function () {
                    $('.dataTables_scrollBody').animate({
                        scrollTop: 0
                    }, 300);
                });
            }
        });
    }

    function EditeSurgeDetails() {
        $('#txtHideEditebtn').css("display", "block")
        $.ajax({
            url: '/InvoicedSurgeReport/GetSubCategoryData',
            type: 'post',
            data: {},
            async: false,
            success: function (response) {

                var getdata = response;


                if (getdata.length > 0) {
                    for (var i = 0; i < getdata.length; i++) {
                        var SurgeRate_ID = getdata[i].SurgeRate_ID == null ? "" : getdata[i].SurgeRate_ID;
                        var TonnageHireRate = getdata[i].TonnageHireRate == null ? "" : getdata[i].TonnageHireRate;
                        var TonnageSurgeRate = getdata[i].TonnageSurgeRate == null ? "" : getdata[i].TonnageSurgeRate;
                        var SurgeAppliedTonnage = getdata[i].SurgeAppliedTonnage == null ? "" : getdata[i].SurgeAppliedTonnage;
                        //var AgreedHire = getdata[i].AgreedHire == null ? "" : getdata[i].AgreedHire;

                        $('#txtHireRate').val(TonnageHireRate);
                        $('#txtSurgeRate').val(TonnageSurgeRate);
                        $('#txtSurgeAppliedTonnage').val(SurgeAppliedTonnage);
                        //    $('#txtAgreedHire').val(AgreedHire);
                    }

                }
            }
        });
    }

    function SaveSurgeData() {

        var hireRate = $('#txtHireRate').val();
        var SurgeRate = $('#txtSurgeRate').val();
        var SurgeAppliedTonnage = $('#txtSurgeAppliedTonnage').val();
        var Clientid = getParameterByName('id');
        // var AgreedHire = $('#txtAgreedHire').val();

        if ((hireRate == "") || (SurgeRate == "") || (SurgeAppliedTonnage == "")) {

            var Response = { Result: "Failed", Message: "Please Fill The Data." };
            CustomAlert(Response);
        }
        else {
            $.ajax({
                url: '/InvoicedSurgeReport/SaveSurgeData',
                type: 'post',
                data: { hireRate: hireRate, SurgeRate: SurgeRate, SurgeAppliedTonnage: SurgeAppliedTonnage, Clientid: Clientid },
                async: false,
                success: function (response) {
                    if (response.Result == 'Success') {
                        CustomAlert(response);
                        GetSubCategories();

                        $('#txtHireRate').val('');
                        $('#txtSurgeRate').val('');
                        $('#txtSurgeAppliedTonnage').val('');
                        /*  $('#txtAgreedHire').val('');*/

                        $('#txtHideEditebtn').css("display", "none")
                    } else {
                        CustomAlert(response);
                    }
                }
            });
        }
    }




</script>

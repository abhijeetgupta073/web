<style>
    .lblName {
        font-size: 11px;
    }

    .tdbtnExpend {
        background: #c9c9c9 none;
    }

    .paging_simple_numbers {
        display: none !important;
    }

    .setWidth0, .setWidth1, .setWidth2 {
        min-width: 17px;
    }

    .setWidth3, .setWidth4, .setWidth5, .setWidth6, .setWidth7, .setWidth8, .setWidth9 {
        min-width: 117px;
    }

    #txtzip_wrapper {
        /*width: 104px !important;*/
        height: 40px !important;
    }

    #txtzip {
        height: 25px;
        border: 1px solid;
    }

    #txtpostcodeuk {
        /*width:104px !important;*/
        height: 28px !important;
    }

    .form-control {
        height: 28px !important;
    }

    .input-group {
        margin-bottom: 0px;
    }

    #FormSection label {
        color: gray !important;
        font-size: 11px;
        font-weight: 500;
    }

    .nav-sm span.fa, .nav-sm .menu_section h3 {
        display: block !important;
    }

    .w3-card-4, .w3-hover-shadow:hover {
        box-shadow: 0 0px 0px 0 rgba(0,0,0,0.2),0 0px 0px 0 rgba(0,0,0,0.19) !important;
    }

    .rgCommandTable td:nth-child(1) {
        display: block !important;
    }

    @@media (min-width:768px) and (max-width:1500px) {
        .clientDefault {
            height: auto;
        }
    }

    @@media (min-width:350px) and (max-width:950px) {
        #btnCAncel {
            font-size: 10px !important;
            padding-left: 2px !important;
        }
    }

    @@media only screen and (max-width: 600px) and (min-width: 290px) {


        .clientDefault {
            height: auto;
        }
    }

    #txtContact, #txtzip,
    #txtStandardWorkingHrs, #txtplnstandDur, #txtUK, #txtManHrsRatio {
        border-color: #e5e5e5 !important;
        border-radius: 4px !important;
    }
</style>


<script>
        $(document).ready(function () {
            if (('@ViewBag.checkboxManHoursManagement') != "") {
                $('#checkboxManHoursManagement').prop('disabled',true);
            }
            if (('@ViewBag.btnFloorLevelImage') == "0") {
                $('#btnFloorLevelImage').css('display', 'none');
            }
            if (('@ViewBag.PlannedStandingDuration') == 'True') {
                $('#txtplnstandDur').prop('disabled',true);
            }
            $('#hdnManHoursManagementCheck').val('@ViewBag.ManHoursManagement');

            var InventoryChecked='@ViewBag.InventoryChecked';
            var HireInventory='@ViewBag.HireInventory';
            if (HireInventory == "True")
            {
                if (InventoryChecked != "0")
                {
                    $('#chkHireInventory').prop('disabled', true);
                    HireInventoryMessage();
                     @*chkHireInventory.Enabled = false;
                     ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "HireInventory", "<script>HireInventoryMessage();</script>", false);*@

                }
              }
                else
                {
                    if (InventoryChecked != "0")
                    {
                        $('#chkHireInventory').prop('disabled', true);
                        HireInventoryOldDataMessage();
                        @*chkHireInventory.Enabled = false;
                        ScriptManager.RegisterStartupScript(this.Page, this.GetType(), "HireInventory1", "
                         <script>HireInventoryOldDataMessage();</script>", false);*@
                    }
                }

                $("#radUpdogImg").change(function () {
                    var urlImage = readURL(this);
                    $('#hdnUploadImage').val(urlImage);
                });
            var UserRole = getParameterByName('UserRole');
            var DecryptUserRole = Decrypt([UserRole])
            if (DecryptUserRole == "10") {
                $("#BtnDeleteInactiveSite").show();
                $("#btnDeleteInactiveClient").show();
                $("#btnCheckMissingBlob").show();
            } else {
                $("#BtnDeleteInactiveSite").hide();
                $("#btnDeleteInactiveClient").hide();
                $("#btnCheckMissingBlob").hide();
            }

        });
        function HireInventoryOldDataMessage() {
            $('.HireInventoryMessage').hover(function () {
                //$('#ContentPlaceHolder1_art1').removeClass('w3-section w3-card-12 j-alertBox-Success').addClass('w3-section fadeOut w3-card-12 j-alertBox-Failed');
                //$('#ContentPlaceHolder1_art1').css("display", "block");
                //$('#ContentPlaceHolder1_alertlabel').html('<strong>Alert ! </strong>You must set up the ‘Sub Category’ Master before ‘Hire Inventory’ can be Enabled');
                //hideAlert();
                //var Response = { Result: "Failed", Message: "You must set up the ‘Sub Category’ Master before ‘Hire Inventory’ can be Enabled." };
                var Response = { Result: "Failed", Message: "You must set up the ‘Sub Category’ Master before ‘Hire: Standing (With Surge Rates)’ can be Enabled." };
                CustomAlert(Response);

            });
        }
        function HireInventoryMessage() {
            $('.HireInventoryMessage').hover(function () {
                //$('#ContentPlaceHolder1_art1').removeClass('w3-section w3-card-12 j-alertBox-Success').addClass('w3-section fadeOut w3-card-12 j-alertBox-Failed');
                //$('#ContentPlaceHolder1_art1').css("display", "block");
                //$('#ContentPlaceHolder1_alertlabel').html('<strong>Alert ! </strong>Inventory has been already loded  you cannot enabled it.');
                //hideAlert();
                var Response = { Result: "Failed", Message: "Inventory has been already loded  you cannot enabled it." };
                CustomAlert(Response);
            });
        }


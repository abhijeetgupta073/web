            function myfunction(key) {
                //getting key code of pressed key
                var keycode = (key.which) ? key.which : key.keyCode;
                var phn = $("#ContentPlaceHolder1_txtContact").val();

                //comparing pressed keycodes
                if ((keycode < 48 || keycode > 57)) {
                    return false;
                }
                else {
                    //    //Condition to check textbox contains ten numbers or not
                    if (phn.length < 10) {
                        return true;
                    }
                    else {
                        return false;
                    }
                }
            }

            $(function () {
                var Href = window.location.href.split('?');
                if (Href.length == 1) {
                    $('#UlNavTabSeciton li').css('display', 'none');
                    $('#liCompany').css('display', 'block');
                }
                $('#UlNavTabSeciton a').css('cursor', 'pointer');
                $('#UlNavTabSeciton a').click(function (e) {
                    $('#LoadingPanel1').css('display', 'block');
                    var ClickAcnhorID = e.currentTarget.id;
                    if (ClickAcnhorID == 'AnchorCompanyInfo') {
                        $('#LoadingPanel1').css('display', 'none');
                    }


                    if (ClickAcnhorID == 'AnchorAttachedFiles') {
                        window.location.href = '/Client_Documents.aspx?' + Href[1];
                    }

                });
            });

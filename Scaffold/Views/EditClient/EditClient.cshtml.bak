                                                        </EditFormSettings>
                                                        <DetailTables>
                                                            <Telerik:GridTableView Name="DetailTable" CommandItemSettings-ShowAddNewRecordButton="true" CommandItemSettings-AddNewRecordText=" Add New Location" CommandItemDisplay="Top" AutoGenerateColumns="false" HeaderStyle-Width="50px" DataKeyNames="ID" Width="100%">
                                                                <Columns>
                                                                    <%--Nested Button Section Start--%>
                                                                    <Telerik:GridTemplateColumn Exportable="false" UniqueName="btnedit" HeaderStyle-Width="4%" FilterControlWidth="5%" AllowFiltering="false">
                                                                        <ItemTemplate>
                                                                            <asp:LinkButton ID="btnedit" runat="server" ToolTip="edit" Text="edit" CommandName="Edit"><i class="glyphicon glyphicon-pencil"></i></asp:LinkButton>
                                                                        </ItemTemplate>
                                                                    </Telerik:GridTemplateColumn>
                                                                    <Telerik:GridTemplateColumn UniqueName="btndelete" Exportable="false" HeaderStyle-Width="4%" FilterControlWidth="5%" AllowFiltering="false">
                                                                        <ItemTemplate>
                                                                            <asp:LinkButton ID="btndelete" runat="server" ToolTip="delete" Text="delete" CommandName="Delete"><i class="fa fa-trash"></i></asp:LinkButton>
                                                                        </ItemTemplate>
                                                                    </Telerik:GridTemplateColumn>
                                                                    <Telerik:GridTemplateColumn HeaderText="Location" HeaderStyle-Width="30%" FilterControlWidth="100%" FilterDelay="1500" DataField="Area" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                        <ItemTemplate>
                                                                            <asp:Label ID="lblarea" runat="server" Text='<%#Eval("Area") %>'></asp:Label>

                                                                        </ItemTemplate>

                                                                    </Telerik:GridTemplateColumn>

                                                                    <Telerik:GridTemplateColumn UniqueName="AreaStatus" HeaderStyle-Width="50px" FilterControlWidth="100%" SortExpression="AreaStatus" HeaderText="Status" FilterDelay="1500" DataField="AreaStatus" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                        <ItemTemplate>
                                                                            <asp:Label ID="lblarestatus" runat="server" Width="30%" Text='<%#Eval("AreaStatus") %>'></asp:Label>
                                                                        </ItemTemplate>
                                                                        <FilterTemplate>
                                                                            <Telerik:RadComboBox Skin="Simple" RenderMode="Lightweight" ID="ddlStatus" runat="server" MarkFirstMatch="true" Width="50%" AppendDataBoundItems="true" SelectedValue='<%#((GridItem)Container).OwnerTableView.GetColumn("AreaStatus").CurrentFilterValue %>' OnClientSelectedIndexChanged="onchanged1">
                                                                                <Items>
                                                                                    <Telerik:RadComboBoxItem Text="All" />
                                                                                    <Telerik:RadComboBoxItem Text="Active" Value="Active" />
                                                                                    <Telerik:RadComboBoxItem Text="InActive" Value="InActive" />
                                                                                </Items>
                                                                            </Telerik:RadComboBox>
                                                                            <Telerik:RadScriptBlock ID="scipt" runat="server">
                                                                                <script type="text/javascript">
                                                                                    function onchanged1(sender, args) {
                                                                                        var status = $find("<%#((GridItem)Container).OwnerTableView.ClientID%>")
                                                                                        status.filter("AreaStatus", args.get_item().get_value(), "EqualTo");
                                                                                    }
                                                                                </script>
                                                                            </Telerik:RadScriptBlock>
                                                                        </FilterTemplate>
                                                                    </Telerik:GridTemplateColumn>
                                                                </Columns>

                                                                <EditFormSettings EditFormType="Template">
                                                                    <FormTemplate>
                                                                        <div class="row w3-padding-top">
                                                                            <div class="col-xs-4">
                                                                                <label>Location<span style="color: red">&nbsp*</span></label>
                                                                                <Telerik:RadTextBox ID="txtarea" runat="server" Width="100%" Text='<%#Eval("Area") %>'></Telerik:RadTextBox>
                                                                                <asp:RequiredFieldValidator CssClass="rdf-initial rdf-text" ID="rfvaildtxtarea" runat="server" ControlToValidate="txtarea" ValidationGroup="LocationSave" ErrorMessage="* Required"></asp:RequiredFieldValidator>
                                                                            </div>
                                                                            <div class="col-xs-4">
                                                                                <label>Status</label>
                                                                                <Telerik:RadComboBox Skin="Simple" RenderMode="Lightweight" ID="ddlStatuss" Width="90%" runat="server" MarkFirstMatch="true" SelectedValue='<%#Eval("AreaStatus") %>'>
                                                                                    <Items>
                                                                                        <%--<Telerik:RadComboBoxItem Text="All" />--%>
                                                                                        <Telerik:RadComboBoxItem Text="Active" Value="Active" />
                                                                                        <Telerik:RadComboBoxItem Text="InActive" Value="InActive" />
                                                                                    </Items>
                                                                                </Telerik:RadComboBox>

                                                                                <asp:RequiredFieldValidator ID="rfvaildstatuss" runat="server" ControlToValidate="ddlStatuss" ValidationGroup="LocationSave" CssClass="rfvstatus rdf-initial rdf-text" ErrorMessage="* Required"></asp:RequiredFieldValidator>

                                                                            </div>
                                                                        </div>
                                                                        <div class="row w3-padding-top">
                                                                            <div class="col-lg-3 col-md-3 col-sm-2">
                                                                                <asp:Button ValidationGroup="LocationSave" ID="btnsave" runat="server" Width="100%" CssClass="btn btn-primary" Text="Save" CommandName='<%#(Container is GridEditFormInsertItem)?"PerformInsert":"Update" %>' />
                                                                            </div>
                                                                            <div class="col-lg-3 col-md-3 col-sm-2">
                                                                                <asp:Button ID="btnCancel" runat="server" Width="100%" CssClass="btn btn-white" ForeColor="Black" Text="Cancel" CommandName="Cancel" />
                                                                            </div>
                                                                        </div>
                                                                    </FormTemplate>
                                                                </EditFormSettings>

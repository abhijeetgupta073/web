                                                <div class="col-xs-1 col-lg-1 col-md-1 col-sm-1" id="divdeleteimag" runat="server" style="display: none">
                                                    <a id="btndeleteImage" onclick="deletecheck();" class="glyphicon glyphicon-trash xyz"></a>
                                                    @*<%--<asp:LinkButton runat="server" ToolTip="Delete" ID="btndeleteImage" CommandName="Delete" OnClick="btndeleteImage_Click"><i class="glyphicon glyphicon-trash"></i></asp:LinkButton>--%>*@
                                                </div>
                                            </div>
                                            <div class="row">
                                                <fieldset class="imageframe" style="height: 158px; border:none; max-width: 235px;">
                                                    <legend>
                                                        @*<%-- <label><i class="fa fa-file-image-o "></i>&nbsp;Company Logo  </label>--%>
                                                            <%--  <label>Company Logo  </label>--%>*@
                                                    </legend>


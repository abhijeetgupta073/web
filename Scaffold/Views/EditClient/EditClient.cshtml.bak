            function deletecheck() {
                var green = $('.ruUploadSuccess').text();
                if (green == "") {
                    var Progress = $('.ruUploadProgress').text();
                    if (Progress != "") {
                        $('.ruCancel').click();
                        $('.ruButton').click();
                    }

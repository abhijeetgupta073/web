                                                                                <asp:RadioButton runat="server" Checked='<%#Eval("GPS").ToString()=="False" ?false:true %>' GroupName="GpsTracker" id="btngps" /><label id="lblgps" style="margin-right:30px!important; margin-left:5px!important">GPS</label>


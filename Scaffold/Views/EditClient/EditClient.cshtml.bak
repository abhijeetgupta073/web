                                                            <th class='setWidth4'>Site/Project Name</th>
                                                            <th class='setWidth5'>Address</th>
                                                            <th class='setWidth6'>City</th>
                                                            <th class='setWidth7'>State/County</th>
                                                            <th class='setWidth8'>Postcode</th>
                                                            <th class='setWidth9'>Status</th>

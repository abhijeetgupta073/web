    <div id="divdelete" class="w3-modal" style="display: none">
        <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 128px; width: 365px; margin-top: 86px;">
            <header class="w3-container w3-dark-grey">
                <h4 class="w3-text-white" id="h3"><i class="fa fa-exclamation-circle w3-text-yellow"></i>Delete Record</h4>
            </header>
            <div class="w3-container">
                <p class="w3-padding-top w3-text-grey">
                    <label id="c1">Are you sure you want to Delete the Record?</label>
                </p>
            </div>
            <div class="row" style="padding-bottom: 20px">
                <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4"></div>
                <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px;">
                    @*<asp:LinkButton CssClass="w3-btn w3-green w3-hover-dark-grey" OnClick="btndeleteyes_Click" ID="btndeleteyes" CausesValidation="false" runat="server"><i class="glyphicon glyphicon-ok-circle "></i> Yes</asp:LinkButton>*@
                    <button Class="w3-btn w3-green w3-hover-dark-grey" OnClick="btndeleteyes_Click()" id="btndeleteyes"><i class="glyphicon glyphicon-ok-circle "></i> Yes</button>
                </div>
                <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2">

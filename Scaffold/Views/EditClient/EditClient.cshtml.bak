@*Asset Save And Edit Popup Start*@

<div id="divAssetSavePopup" class="w3-modal" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 300px; width: 350px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey">
            <h4 class="w3-text-white" id="btnclose1"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp; Asset<a id="btnAssetclose" class="close" style="float: right; color: white" onclick="btnAssetclose(0);">X</a></h4>
            <h4 class="w3-text-white" id="btncloseandback" style="display:none;"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp; Asset<a id="btnAssetclose" class="close" style="float: right; color: white" onclick="btnAssetclose(1);">X</a></h4>
        </header>
        <div class="row">
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12">
                @*<label id="lbldescription" style="font-size: 15px"># Asset No<span style="color: red">&nbsp*</span></label>*@
                <label># Asset No<span style="color: red">&nbsp*</span></label>
                <input type="text" id="txtAssetNo" Class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12">
                <label>Asset Description</label>
                <input type="text" id="txtAssetDesc" Class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12">
                <label style="font-size: 15px">Status<span style="color: red">&nbsp*</span></label>
                <select id="ddlAssetStatus" class="form-control">
                    <option value="Active">Active</option>
                    <option value="InActive">InActive</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div id="divSaveAsset" class="col-xs-6 col-lg-6 col-md-6 col-sm-6">
                <button id="btnSaveAsset" style="width:100%;height:32px;" Class="w3-btn w3-small w3-green btnheight imagesize" OnClick="btnSaveAsset(0)"><i class="fa fa-save"> </i>&nbsp;Save</button>
            </div>
            <div id="divSaveandBackAsset" class="col-xs-6 col-lg-6 col-md-6 col-sm-6" style="display: none;">
                <button style="width:100%; height:32px;" Class="w3-btn w3-small w3-grey btnheight imagesize" OnClick="btnSaveAsset(1)"><i class="fa fa-save"></i>&nbsp;Save & Go Back</button>
            </div>
            <div id="divAssetClose" class="col-xs-6 col-lg-6 col-md-6 col-sm-6">
                <button id="btnAssetClose" onclick="btnAssetclose(0);" style="Width:100%" Class="w3-btn w3-small w3-red btnheight imagesize"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp; Cancel</button>
            </div>
            <div id='divAssetCloseandback' class="col-xs-6 col-lg-6 col-md-6 col-sm-6" style="display:none;">
                <button id="btnAssetCloseandback" onclick="btnAssetclose(1);" style="Width:100%" Class="w3-btn w3-small w3-red btnheight imagesize"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp; Cancel & Go Back</button>
            </div>
        </div>
    </div>
</div>

<div id="ChangeUserconfirm" class="w3-modal" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 168px; width: 400px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey">
            <h4 class="w3-text-white" id="h1" runat="server">Alert!</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">
                <label id="Label2"></label>
            </p>
        </div>
        <div class="row" style="padding-bottom: 20px">
            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4"></div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px">
                <button Class="w3-btn w3-green w3-hover-dark-grey" id="btnChangeUsernyes" OnClick="btnChangeUsernyes_Click()"><i class="glyphicon glyphicon-ok-circle"></i> Yes</button>
            </div>
            <div class="col-xs-2 col-lg-4 col-md-2 col-sm-2">
                <button Class="w3-btn nln-bg w3-hover-dark-grey" id="btnChangeUsernno" OnClick="btnChangeUsernno_Click()"><i class="glyphicon glyphicon-remove-circle"></i> No</button>
            </div>
        </div>
    </div>
</div>
@*Asset Save And Edit Popup End here*@

                                                                                <asp:RequiredFieldValidator ID="rdfLat" runat="server" CssClass="valid rdf-initial rdf-text" ControlToValidate="txtlat" ValidationGroup="EditSave" ErrorMessage="* Required"></asp:RequiredFieldValidator>

                                                                                <label>Address<span style="color: red">&nbsp*</span></label>
                                                                                <Telerik:RadTextBox ID="txtaddress" CssClass="Address" runat="server" Width="100%" Text='<%#Eval("Address") %>'></Telerik:RadTextBox>
                                                                                <asp:RequiredFieldValidator ID="rfvtxtaddress" runat="server" CssClass="rdf-initial rdf-text" ValidationGroup="EditSave" ControlToValidate="txtaddress" ErrorMessage="* Required"></asp:RequiredFieldValidator>

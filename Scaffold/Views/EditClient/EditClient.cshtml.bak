                    var hideen = $("#txtaddress").val() + ',' + $("#txtcity").val() + ',' + $("#ddlstates").val() + ',' + $('.PostCode').val();

                    var address = hideen;
                    geocoder.geocode({ 'address': address }, function (results, status) {

                        if (status == google.maps.GeocoderStatus.OK) {
                            var latitude = results[0].geometry.location.lat();
                            var longitude = results[0].geometry.location.lng();
                            // $(".rgEditForm").find(".Lattitude").val(latitude);
                            // $(".rgEditForm").find(".Longitude").val(longitude);
                            $("#txtlat").val(latitude);
                            $("#txtlong").val(longitude);
                        }
                    });
                }
                else {
                    $("#DivAlertBox").css("display", "block");
                }
                //var geocoder = new google.maps.Geocoder();
                //var hideen = $('.rgEditForm').find('.Address').val() + ',' + $('.rgEditForm').find('.City').val() + ',' + $('.rgEditForm').find('.State').val() + ',' + $('.rgEditForm').find('.PostCode').val();

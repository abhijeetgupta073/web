                                                </table>

                                            </div>

                                            @*<Telerik:RadGrid ID="gridsitelocation" OnItemCreated="gridsitelocation_ItemCreated" runat="server" AllowPaging="true" PageSize="12" Skin="Metro" OnNeedDataSource="gridsitelocation_NeedDataSource" OnItemCommand="gridsitelocation_ItemCommand" MasterTableView-CommandItemSettings-ShowAddNewRecordButton="true" MasterTableView-CommandItemSettings-AddNewRecordText=" Add New Sites" OnDetailTableDataBind="gridsitelocation_DetailTableDataBind" OnItemDataBound="gridsitelocation_ItemDataBound" GroupingSettings-CaseSensitive="false" AutoGenerateColumns="false" AllowFilteringByColumn="true" MasterTableView-AllowSorting="true" ClientSettings-EnableAlternatingItems="true">
                                                    <clientsettings scrolling-allowscroll="true" scrolling-scrollheight="500px" allowrowsdragdrop="true"></clientsettings>
                                                    <mastertableview name="SiteMaster" datakeynames="ID" commanditemdisplay="Top">
                                                        <CommandItemSettings ShowAddNewRecordButton="true" ExportToCsvText="Sitelocctionlist" ShowExportToCsvButton="false" />
                                                        <Columns>
                                                            <Telerik:GridTemplateColumn Exportable="false" HeaderStyle-Width="10px" AllowFiltering="false" UniqueName="UniqueEdit">
                                                                <ItemTemplate>
                                                                    <asp:LinkButton ID="btnedit" runat="server" ToolTip="edit" Text="edit" CommandName="Edit"><i class="glyphicon glyphicon-pencil"></i></asp:LinkButton>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn Exportable="false" HeaderStyle-Width="10px" AllowFiltering="false">
                                                                <ItemTemplate>
                                                                    <asp:LinkButton ID="btndelete" runat="server" ToolTip="delete" Text="delete" CommandName="Delete"><i class="fa fa-trash"></i></asp:LinkButton>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn HeaderText="Owner Name" HeaderStyle-Width="90px" FilterControlWidth="100px" FilterDelay="1500" DataField="OwnerName" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lblOwnerName" runat="server" Text='<%#Eval("OwnerName") %>'></asp:Label>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn HeaderText="Site/Project Name" HeaderStyle-Width="90px" FilterControlWidth="100px" FilterDelay="1500" DataField="SiteLocation" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lblsitelocation" runat="server" Text='<%#Eval("SiteLocation") %>'></asp:Label>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn HeaderText="Address" HeaderStyle-Width="90px" FilterControlWidth="100px" FilterDelay="1500" DataField="Address" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lbladdress" runat="server" Text='<%#Eval("Address") %>'></asp:Label>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn HeaderText="City" HeaderStyle-Width="90px" FilterControlWidth="100px" FilterDelay="1500" DataField="City" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lblcity" runat="server" Text='<%#Eval("City") %>'></asp:Label>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn UniqueName="State" SortExpression="State" HeaderStyle-Width="90px" FilterControlWidth="100px" HeaderText="State/County" FilterDelay="1500" DataField="State" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lblstate" runat="server" Text='<%#Eval("State") %>'></asp:Label>
                                                                </ItemTemplate>
                                                                <FilterTemplate>
                                                                    <Telerik:RadComboBox Skin="Simple" RenderMode="Lightweight" ID="ddlgridstate" Width="150px" Height="250px" runat="server" DataSourceID="dsddlState" DataTextField="State" DataValueField="State" MarkFirstMatch="true" AppendDataBoundItems="true" SelectedValue='<%#((GridItem)Container).OwnerTableView.GetColumn("State").CurrentFilterValue %>' OnClientSelectedIndexChanged="onchanged3">
                                                                        <Items>
                                                                            <Telerik:RadComboBoxItem Text="All" />
                                                                        </Items>
                                                                    </Telerik:RadComboBox>

                                                                    <Telerik:RadScriptBlock ID="scipt" runat="server">
                                                                        <script type="text/javascript">
                                                                            function onchanged3(sender, args) {
                                                                                var state = $find("<%# ((GridItem)Container).OwnerTableView.ClientID%>")
                                                                                state.filter("State", args.get_item().get_value(), "EqualTo");
                                                                            }
                                                                        </script>
                                                                    </Telerik:RadScriptBlock>
                                                                </FilterTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn HeaderStyle-Width="90px" FilterControlWidth="100px" HeaderText="Postcode" FilterDelay="1500" DataField="Zip" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lblzip" runat="server" Text='<%#Eval("Zip") %>'></asp:Label>
                                                                </ItemTemplate>
                                                            </Telerik:GridTemplateColumn>
                                                            <Telerik:GridTemplateColumn UniqueName="SiteLocationStatus" HeaderStyle-Width="90px" FilterControlWidth="100px" SortExpression="SiteLocationStatus" HeaderText="Status" FilterDelay="1500" DataField="SiteLocationStatus" DataType="System.String" AllowFiltering="true" AllowSorting="true" ShowFilterIcon="false">
                                                                <ItemTemplate>
                                                                    <asp:Label ID="lblsitelocstatus" runat="server" Width="58%" Text='<%#Eval("SiteLocationStatus") %>'></asp:Label>
                                                                </ItemTemplate>
                                                                <FilterTemplate>
                                                                    <Telerik:RadComboBox Skin="Simple" RenderMode="Lightweight" ID="ddlStatus" runat="server" Width="100px" MarkFirstMatch="true" AppendDataBoundItems="true" SelectedValue='<%#((GridItem)Container).OwnerTableView.GetColumn("SiteLocationStatus").CurrentFilterValue %>' OnClientSelectedIndexChanged="onchanged1">
                                                                        <Items>
                                                                            <Telerik:RadComboBoxItem Text="All" />
                                                                            <Telerik:RadComboBoxItem Text="Active" Value="Active" />
                                                                            <Telerik:RadComboBoxItem Text="InActive" Value="InActive" />
                                                                        </Items>
                                                                    </Telerik:RadComboBox>
                                                                    <Telerik:RadScriptBlock ID="script" runat="server">
                                                                        <script type="text/javascript">
                                                                            function onchanged1(sender, args) {
                                                                                var status = $find("<%#((GridItem)Container).OwnerTableView.ClientID%>")
                                                                                status.filter("SiteLocationStatus", args.get_item().get_value(), "EqualTo");
                                                                            }
                                                                        </script>
                                                                    </Telerik:RadScriptBlock>
                                                                </FilterTemplate>
                                                            </Telerik:GridTemplateColumn>

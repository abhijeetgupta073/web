<div class="modal fade" id="SitePopup" role="dialog" aria-hidden="true">
    @*<div class="modal-dialog clsSitePopupDialog"role="document">*@
    <!-- Modal content-->
    <div class="modal-content">
        <div class="modal-header">
            <button id="btnback" type="button" class="close" onclick="btnCancel(0)" data-dismiss="modal">&times;</button>
            <button id="btngoback" type="button" class="close" onclick="btnCancel(1)" data-dismiss="modal" style="display:none">&times;</button>
            <h4 class="modal-title" id="addTitle">Add Site</h4>
            @*<h4 class="modal-title" id="editTitle">Machine - <span id="SpnHdrTool"></span></h4>*@
        </div>
        <div class="modal-body" style="height:400px">
            <div class="col-xs-12  col-lg-12 col-md-12 col-sm-12">
                <div class="row ">
                    <div class="col-lg-3 col-md-3 col-xs-12 col-sm-4">
                        <label class="lblName">Owner Name</label>
                        @*<Telerik:RadTextBox ID="txtOwnerName" runat="server" Width="100%" Text='<%#Eval("OwnerName") %>'></Telerik:RadTextBox>*@
                        <input type="text" id="txtOwnerName" class="form-control" style="Width:100%" />
                    </div>
                    <div class="col-lg-3 col-md-3 col-xs-12 col-sm-4 ">
                        <label class="lblName">Status</label>
                        <select id="ddlStatuss" class="form-control">
                            <option value="Active">Active</option>
                            <option value="InActive">InActive</option>
                        </select>
                        @*<Telerik:RadComboBox Skin="Simple" RenderMode="Lightweight" ID="ddlStatuss" Width="100%" runat="server" MarkFirstMatch="true" SelectedValue='<%#Eval("SiteLocationStatus") %>'>
                                <Items>
                                    <%--<Telerik:RadComboBoxItem Text="All" />--%>
                                    <Telerik:RadComboBoxItem Text="Active" Value="Active" />
                                    <Telerik:RadComboBoxItem Text="InActive" Value="InActive" />
                                </Items>
                            </Telerik:RadComboBox>
                            <asp:RequiredFieldValidator ID="rfvddlStatuss" runat="server" CssClass="valid rdf-initial rdf-text" ControlToValidate="ddlStatuss" ValidationGroup="EditSave" ErrorMessage="* Required"></asp:RequiredFieldValidator>*@
                    </div>
                    <div class="col-lg-6 col-md-6 col-xs-12 col-sm-4">
                        <label class="lblName">Site/Project Name<span style="color: red">&nbsp*</span></label>
                        <input type="text" id="txtsitelocation" class="form-control" style="width:100%" required />
                        @*<Telerik:RadTextBox ID="txtsitelocation" runat="server" Width="100%" Text='<%#Eval("SiteLocation") %>'></Telerik:RadTextBox>
                                <asp:RequiredFieldValidator ID="rfvtxtsitelocation" runat="server" CssClass="rdf-initial rdf-text" ValidationGroup="EditSave" ControlToValidate="txtsitelocation" ErrorMessage="* Required"></asp:RequiredFieldValidator>
                            </div>*@

                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-xs-12 col-sm-12">
                            <label class="lblName">Address<span style="color: red">&nbsp*</span></label>
                            <input type="text" id="txtaddress" style="width:100%" class="form-control Address" required />
                            @*<Telerik:RadTextBox ID="txtaddress" CssClass="Address" runat="server" Width="100%" Text='<%#Eval("Address") %>'></Telerik:RadTextBox>
                                <asp:RequiredFieldValidator ID="rfvtxtaddress" runat="server" CssClass="rdf-initial rdf-text" ValidationGroup="EditSave" ControlToValidate="txtaddress" ErrorMessage="* Required"></asp:RequiredFieldValidator>*@
                        </div>
                        <div class="col-lg-2 col-md-2 col-xs-12 col-sm-4">
                            <label class="lblName">City<span style="color: red">&nbsp*</span></label>
                            <input type="text" id="txtSitecity" style="width:100%" class="form-control City" required />
                            @*<Telerik:RadTextBox ID="txtcity" runat="server" CssClass="City" Width="100%" Text='<%#Eval("City") %>'></Telerik:RadTextBox>
                                <asp:RequiredFieldValidator ID="rfvtxtcity" runat="server" CssClass="rdf-initial rdf-text" ValidationGroup="EditSave" ControlToValidate="txtcity" ErrorMessage="* Required"></asp:RequiredFieldValidator>*@
                        </div>
                        <div class="col-lg-2 col-md-3 col-xs-12 col-sm-4">
                            <label class="lblName" id="lblstate">State/County</label>
                            <select class="form-control" id="ddlstates"></select>
                            @*<Telerik:RadComboBox Skin="Simple" CssClass="State" RenderMode="Lightweight" ID="ddlstates" runat="server" Width="100%" DataSourceID="dsddlstate" DataTextField="state" DataValueField="State" MarkFirstMatch="true" AppendDataBoundItems="true" SelectedValue='<%#Eval("State")%>' EmptyMessage="All" Enabled="true" Height="250px">
                                    <Items>
                                  <Telerik:RadComboBoxItem Text="" />
                                 </Items>
                                </Telerik:RadComboBox>
                            *@

                        </div>
                        <div class="col-lg-2 col-md-1 col-xs-12 col-sm-4">
                            <label class="lblName">Postcode</label>
                            <input type="text" id="txtSitezip" Class="PostCode form-control" Mask="####" MaxLength="4" style="width:100%;display:none;" />
                            <input type="text" id="txtukSitepost" Class="PostCode form-control" style="width:100%;display:none;" />

                            @*<Telerik:RadMaskedTextBox ID="txtzip" CssClass="PostCode" runat="server" Mask="####" Visible="false" MaxLength="4" Width="100%" Text='<%#Eval("Zip") %>'></Telerik:RadMaskedTextBox>
                                <Telerik:RadTextBox ID="txtukpost" CssClass="PostCode" runat="server" Visible="false" Width="100%" Text='<%#Eval("Zip") %>'></Telerik:RadTextBox>*@
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-4 col-md-6 col-xs-12 col-sm-6">
                            <label class="lblName">Hand Over & Inspection Distribution List</label>
                            <input type="text" id="txtdistriList" class="form-control" style="Width:90%" />
                            @*<Telerik:RadTextBox ID="txtdistriList" runat="server" Width="100%" Text='<%#Eval("DistributionList") %>'></Telerik:RadTextBox>*@
                        </div>
                        <div class="col-lg-2 col-md-7 col-sm-4 col-xs-6" style="margin-top: 16px;">
                            <button type="button" id="gpssitebutton" onclick="GetlatlaongBysite();" style="margin-left: -11px;width: 110%;font-size: 13px;color:black">Set GPS by Address</button>
                        </div>
                        <div class="col-lg-2 col-md-2 col-xs-12 col-sm-3">
                            <label class="lblName">Latitude<span style="color: red">&nbsp*</span></label>
                            <input type="number" id="txtlat" class="form-control Lattitude" style="Width:100%" required />
                            @*<Telerik:RadNumericTextBox ID="txtlat" runat="server" Width="100%" Text='<%#Eval("SiteLat") %>' NumberFormat-DecimalDigits="11" CssClass="form-control Lattitude"></Telerik:RadNumericTextBox>
            <asp:RequiredFieldValidator ID="rdfLat" runat="server" CssClass="valid rdf-initial rdf-text" ControlToValidate="txtlat" ValidationGroup="EditSave" ErrorMessage="* Required"></asp:RequiredFieldValidator>*@
                        </div>
                        <div class="col-lg-2 col-md-2 col-xs-12 col-sm-3">
                            <label class="lblName">Longitude<span style="color: red">&nbsp*</span></label>
                            <input type="number" id="txtlong" class="form-control Longitude" style="Width:100%" required />
                            @*<%--<Telerik:RadTextBox ID="txtlong" runat="server" Width="100%" Text='<%#Eval("SiteLong") %>'></Telerik:RadTextBox>--%>
            <Telerik:RadNumericTextBox ID="txtlong" runat="server" Width="100%" Text='<%#Eval("SiteLong") %>' NumberFormat-DecimalDigits="11" CssClass="form-control Longitude">
            </Telerik:RadNumericTextBox>
            <asp:RequiredFieldValidator ID="rdfLong" runat="server" CssClass="valid rdf-initial rdf-text" ControlToValidate="txtlong" ValidationGroup="EditSave" ErrorMessage="* Required"></asp:RequiredFieldValidator>*@
                        </div>
                        <div class="col-lg-2 col-md-2 col-xs-6 col-sm-3">
                            <label class="lblName">Man Hours Available</label>
                            <input type="text" id="txtManHrsAvai" style="Width:100%" Class="form-control txtManHoursAvailable " />
                            @*<Telerik:RadNumericTextBox ID="txtManHrsAvai" runat="server" Enabled="false" Width="100%" Text='<%#Eval("ManHoursAvailable") %>' CssClass="form-control txtManHoursAvailable ">
            </Telerik:RadNumericTextBox>*@
                        </div>

                        @*<%-- Changes On 10 July 2019--%>*@
                        <div id="divMaintainInventory" class="col-lg-3 col-md-3 col-xs-12 col-sm-3 divMaintainInventory" style="margin-top: 8px; display: inline-flex;display:none !important; padding-left: 10px">
                            @*<asp:CheckBox runat="server" ID="checkboxMaintainInventory" Checked='<%#Eval("MaintainInventory").ToString()=="False" ?false:true %>' />*@
                            <input type="checkbox" id="checkboxMaintainInventory" />
                            <label class="lblName" style="margin-left: 10px;">Maintain Inventory At Site</label>
                        </div>
                        <div id="divMaintainInventoryAtJob" class="col-lg-3 col-md-3 col-xs-12 col-sm-3 divMaintainInventoryAtJob" style="margin-top: 8px; display: inline-flex; padding-left: 10px">

                            @*<%--  Changes on 12 Sep 2019  for Inpex Only--%>*@
                            @*<asp:CheckBox runat="server" ID="checkboxMaintainInventoryAtJob" Checked='<%#Eval("MaintainInventoryAtJob").ToString()=="False" ?false:true %>' />*@
                            <input type="checkbox" id="checkboxMaintainInventoryAtJob" />
                            <label class="lblName" style="margin-left: 10px;">Maintain Inventory At Job</label>
                        </div>
                        <div id="divCycloneManagement" class="col-lg-3 col-md-3 col-xs-12 col-sm-3 divCycloneManagement" style="margin-top: 8px; display: inline-flex; padding-left: 10px">

                            @*<%--  Changes on 12 Sep 2019  for Inpex Only--%>*@
                            @*<asp:CheckBox runat="server" ID="checkboxCycloneManagement" Checked='<%#Eval("CycloneManagement").ToString()=="False" ?false:true %>' />*@
                            <input type="checkbox" id="checkboxCycloneManagement" />
                            <label class="lblName" style="margin-left: 10px;">Cyclone Management</label>
                        </div>
                        <div id="divManHourMngAtSite" class="col-lg-3 col-md-3 col-xs-12 col-sm-3  divManHourMngAtSite" style="margin-top: 8px; display: inline-flex; padding-left: 10px">

                            @*<asp:CheckBox runat="server" ID="chkboxManHoursManagement" Checked='<%#Eval("ManHoursManagement").ToString()=="True" ?true:false %>' />*@
                            <input type="checkbox" id="chkboxManHoursManagement" />
                            <label class="lblName" style="margin-left: 10px;">Man Hours Management</label>
                        </div>
                        <div id="divGpsSitePin" class="col-lg-3 col-md-3 col-xs-12 col-sm-3  divGpsSitePin" style="margin-top:9px; display: inline-flex; padding-left: 10px">
                            @*<asp:CheckBox runat="server" ID="chkboxEnabledGPSSitePin" Checked='<%#Eval("EnabledGPSSitePin").ToString()=="True" ?true:false %>' />*@
                            <input type="checkbox" id="chkboxEnabledGPSSitePin" />
                            <label class="lblName" style="margin-left: 10px;">Enabled GPS Site Pin</label>
                        </div>


                        @*<%--Add Code on 30/march/2020--%>*@
                        <div id="divCaptureGps" class="col-lg-3 col-md-3 col-xs-12 col-sm-3  divCaptureGps" style="margin-top:9px; display: inline-flex; padding-left: 10px">
                            <input type="checkbox" id="chkboxEnabledCaptureGps" />

                            @*<asp:CheckBox runat="server" ID="chkboxEnabledCaptureGps" Checked='<%#Eval("EnabledCaptureGps").ToString()=="True" ?true:false %>' />*@
                            <label class="lblName" style="margin-left: 10px;">Enabled GPS Capture</label>
                        </div>
                        <div id="divOffSystemInspection" class="col-lg-3 col-md-3 col-xs-12 col-sm-3  divOffSystemInspection" style="margin-top:9px; display: inline-flex; padding-left: 10px">
                            @*<asp:CheckBox runat="server" ID="chkOffSystemInspection" Checked='<%#Eval("OffSystemInspection").ToString()=="True" ?true:false %>' />*@
                            <input type="checkbox" id="chkOffSystemInspection" />
                            <label style="margin-left: 10px;">Off System Inspection</label>
                        </div>
                        @*<%--    //24-Oct-2019--start--%>*@
                        @*<div class="row w3-padding-top">*@
                        <div id="divgpsandfloorlevel" class="col-lg-3 col-md-3 col-xs-12 col-sm-3 " style="margin-top: 10px; display: inline-flex;display:block; padding-left: 10px; border: 1px solid #009688;">
                            @*<asp:RadioButton runat="server" Checked='<%#Eval("GPS").ToString()=="False" ?false:true %>' GroupName="GpsTracker" id="btngps" />*@
                            <input type="radio" name="GpsTracker" id="btngps" />
                            <label class="lblName" id="lblgps" style="margin-right:30px!important; margin-left:5px!important">GPS</label>

                            @*<asp:RadioButton runat="server" Checked='<%#Eval("FloorLevel").ToString()=="True" ?true:false %>' GroupName="GpsTracker" id="btnfloorlevel" />*@
                            <input type="radio" name="GpsTracker" id="btnfloorlevel" />
                            <label class="lblName" id="lblfloorlvl" style="margin-left:5px!important;">Floor Level</label>

                        </div>
                        @*</div>*@


                        <div class="col-lg-3 col-md-3 col-xs-12 col-sm-3">
                            <label class="lblName">Inventory Mailing List</label>
                            <input type="text" id="txtMailingList" class="form-control" style="Width:100%" />

                        </div>

                        <div id="divSkipMat" class="col-lg-3 col-md-3 col-xs-12 col-sm-3  clsSkipMat" style="margin-top:9px; display: inline-flex; padding-left: 10px">
                            <input type="checkbox" id="chkboxSkipMaterial" />

                            @*<asp:CheckBox runat="server" ID="chkboxEnabledCaptureGps" Checked='<%#Eval("EnabledCaptureGps").ToString()=="True" ?true:false %>' />*@
                            <label class="lblName" style="margin-left: 10px;">Skip Material List For Selected Job</label>
                        </div>
                        <div id="divPipelineInv" class="col-lg-3 col-md-3 col-xs-12 col-sm-3  divPipelineInv" style="margin-top:9px; display: inline-flex; padding-left: 10px">
                            <input type="checkbox" id="chkPipelineInv" />
                            <label class="lblName" style="margin-left: 10px;">Enable Pipeline Inventory</label>
                        </div>

                        <div id="BtnDeleteInactiveSite" style="display:none;">
                            <button type="button" id="btnCheckMissingBlob" class="btn btn-success" style="margin:2px" onclick="CheckMissingBlobFiles();"><i class="fa fa-search"></i> Check Missing Blob</button>
                            <button class="btn btn-danger"
                                    onclick="DeleteInactiveSiteDocuments();"
                                    title="Deletes Register Documents and Inspection Documents.">
                                <i class="fa fa-trash"></i>
                                Delete Documents
                            </button>

                            <button type="button"
                                    class="btn btn-danger"
                                    onclick="DeleteSiteImages();"
                                    title="Deletes Site Images, Gallery Images, Inspection Images, Signatures, Delivery Images & Documents.">
                                <i class="fa fa-trash"></i> Delete Site Images
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div id="divsavesite" class="col-lg-2 col-md-2 col-sm-3 col-xs-4 ">
                @*<asp:Button ID="btnsave" runat="server" Width="100%" style="margin-left: -4px;" CssClass="btn btn-primary" ValidationGroup="EditSave" Text="Save" CommandName='<%#(Container is GridEditFormInsertItem)?"PerformInsert":"Update" %>' />*@
                <button id="btnsave" style="Width:100%" Class="btn btn-primary" onclick="btnCheckChangeUser()"><i class="fa fa-save"> </i>&nbsp;Save</button>
            </div>
            <div id="divsaveandbacksite" class="col-lg-2 col-md-2 col-sm-3 col-xs-4" style="display: none;">
                <button id="btnsaveandbacksite" style="Width:100%;" Class="btn btn-primary " onclick="btnCheckChangeUser(1)"><i class="fa fa-save"> </i>&nbsp;Save & Go Back</button>
            </div>
            <div id="divCancel" class="col-lg-2 col-md-2 col-sm-3 col-xs-4">
                @*<asp:Button ID="btnCancel" runat="server" Width="100%" CssClass="btn btn-white" Text="Cancel" CommandName="Cancel" />*@
                <button id="btnCancel" style="Width:100%" data-dismiss="modal" class="btn btn-white" onclick="btnCancel(0)"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp; Cancel</button>
            </div>
            <div id="divCancelandgoback" class="col-lg-2 col-md-2 col-sm-3 col-xs-4" style="display:none;">
                <button id="btnCancelandgoback" style="Width:100%" data-dismiss="modal" class="btn btn-white" onclick="btnCancel(1)"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp; Cancel & Go Back</button>
            </div>
        </div>
    </div>
    @*</div>*@
</div>

@*Site Save and Edit Popup End*@

@*Location Save And Edit Popup Start*@

<div id="divLocationSavePopup" class="w3-modal" style="display: none">
    <div class="w3-modal-content w3-animate-zoom w3-card-8" style="height: 200px; width: 350px; margin-top: 86px;">
        <header class="w3-container w3-dark-grey">
            <h4 class="w3-text-white" id="h8"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp; Location<a id="close" class="close" style="float: right; color: white" onclick="btnLocationclose(0);">X</a></h4>
            <h4 class="w3-text-white" id="h8andgoback" style="display:none;"><i class="fa fa-exclamation-circle w3-text-yellow"></i>&nbsp; Location<a id="close" class="close" style="float: right; color: white" onclick="btnLocationclose(1);">X</a></h4>
        </header>
        <div class="row">
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12">
                @*<label id="lblLocation" style="font-size: 15px">Location<span style="color: red">&nbsp*</span></label>*@
                <label>Location<span style="color: red">&nbsp*</span></label>
                <input type="text" id="txtarea" Class="form-control" required />
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 col-lg-12 col-md-12 col-sm-12">
                <label id="lblSratus" style="font-size: 15px">Status<span style="color: red">&nbsp*</span></label>
                <select id="ddlAreaStatus" class="form-control">
                    <option value="Active">Active</option>
                    <option value="InActive">InActive</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div id="divSaveLocation" class="col-xs-6 col-lg-6 col-md-6 col-sm-6">
                <button id="btnSaveLocation" style="width:100%; height:32px;" Class="w3-btn w3-small w3-green btnheight imagesize" OnClick="btnSaveLocation(0)"><i class="fa fa-save"> </i>&nbsp;Save</button>
            </div>
            <div id="divSaveandBackLocation" class="col-xs-6 col-lg-6 col-md-6 col-sm-6" style="display:none;">
                <button style="width:100%; height:32px;" Class="w3-btn w3-small w3-grey btnheight imagesize" OnClick="btnSaveLocation(1)"><i class="fa fa-save"></i>&nbsp;Save & Go Back</button>
            </div>
            <div id="divClose" class="col-xs-6 col-lg-6 col-md-6 col-sm-6">
                <button id="btnClose" onclick="btnLocationclose(0);" style="Width:100%" Class="w3-btn w3-small w3-red btnheight imagesize"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp; Cancel</button>
            </div>
            <div id="divCloseandgoback" class="col-xs-6 col-lg-6 col-md-6 col-sm-6" style="display:none;">
                <button id="btnCloseandgoback" onclick="btnLocationclose(1);" style="Width:100%" Class="w3-btn w3-small w3-red btnheight imagesize"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp; Cancel & Go Back</button>
            </div>
        </div>
    </div>
</div>

@*Location Save And Edit Popup End here*@



@{
    ViewBag.Title = "EditClient";
}

<script src="https://maps.googleapis.com/maps/api/js?key=@(Session["googlemapapi"])&libraries=places" type="text/javascript"></script>
<script src="~/Content/js/EditClient.js?V1=29"></script>

<style>
    .requiredColumn {
        border-color: red;
    }
    /*#SitePopup{
     z-index: 3 !important;
    }*/
    #DivAlertBox {
        z-index: 4 !important;
    }

    @@media only screen and (min-width: 900px) and (max-width: 1605px) {
        .clsSitePopupDialog {
            width: 950px;
        }
    }

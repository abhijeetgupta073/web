            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4"></div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px">

                @*<asp:LinkButton CssClass="w3-btn w3-green w3-hover-dark-grey" ID="btnconfirmyes" runat="server" OnClick="btnconfirmyes_Click" CausesValidation="false"><i class="glyphicon glyphicon-ok-circle"></i> Yes</asp:LinkButton>*@
                <button Class="w3-btn w3-green w3-hover-dark-grey" id="btnconfirmyes"  OnClick="btnconfirmyes_Click()" CausesValidation="false"><i class="glyphicon glyphicon-ok-circle"></i> Yes</button>

            </div>
            <div class="col-xs-2 col-lg-4 col-md-2 col-sm-2">
                @*<asp:LinkButton CssClass="w3-btn nln-bg w3-hover-dark-grey" ID="btnconfirmno" runat="server" OnClick="btnconfirmno_Click"><i class="glyphicon glyphicon-remove-circle"></i> No</asp:LinkButton>*@
                <button Class="w3-btn nln-bg w3-hover-dark-grey" id="btnconfirmno"  OnClick="btnconfirmno_Click()"><i class="glyphicon glyphicon-remove-circle"></i> No</button>
            </div>
        </div>
    </div>
</div>
        <header class="w3-container w3-dark-grey">
            <h4 class="w3-text-white" id="h7" runat="server">Alert!</h4>
        </header>
        <div class="w3-container">
            <p class="w3-padding-top w3-text-grey">


                <label runat="server" id="Label1">Are you sure you want to Deliver all items?</label>
            </p>
        </div>
        <div class="row" style="padding-bottom: 20px">
            <div class="col-xs-4 col-lg-4 col-md-4 col-sm-4"></div>
            <div class="col-xs-2 col-lg-2 col-md-2 col-sm-2" style="margin-right: 21px">
                @*<asp:LinkButton CssClass="w3-btn w3-green w3-hover-dark-grey" ID="chkpopupyes" runat="server" OnClick="chkpopupyes_Click"><i class="glyphicon glyphicon-ok-circle"></i> Yes</asp:LinkButton>*@
                <button Class="w3-btn w3-green w3-hover-dark-grey" id="chkpopupyes" runat="server" OnClick="chkpopupyes_Click()"><i class="glyphicon glyphicon-ok-circle"></i>&nbsp;Yes</button>
            </div>
            <div class="col-xs-2 col-lg-4 col-md-2 col-sm-2">
                @*<asp:LinkButton CssClass="w3-btn nln-bg w3-hover-dark-grey" ID="chkpopupno" runat="server" OnClick="chkpopupno_Click"><i class="glyphicon glyphicon-remove-circle"></i> No</asp:LinkButton>*@
                <button Class="w3-btn nln-bg w3-hover-dark-grey" id="chkpopupno" OnClick="chkpopupno_Click()"><i class="glyphicon glyphicon-remove-circle"></i>&nbsp;No</button>
            </div>
        </div>
    </div>
</div>

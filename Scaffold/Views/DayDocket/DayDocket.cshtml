
@{
    ViewBag.Title = "DayDocket";
}

<script>
 $(document).ready(function () {

  GetDayDocketData();

  });

 function GetDayDocketData() {
    $('#LoadingPanel1').show();
    var id = getParameterByName('id');   

  $.ajax({
        type: "POST",
        url: "/DayDocket/ShowDayDocketData",
        data: JSON.stringify({ id: id }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            var str = "";
            var GetData = response;
            $('#tblDayDocket').DataTable().clear();
            $('#tblDayDocket').DataTable().destroy();

            if (GetData.length > 0) {

                for (var i = 0; i < GetData.length; i++) {

                    var DayDocketID = GetData[i].DayDocketID == null ? "" : GetData[i].DayDocketID;
                    var comments1 = GetData[i].comments == null ? "" : GetData[i].comments;
                    var comments = (comments1.length > 70) ? comments1.substring(0, 70) + '.....' : comments1;

                    var SiteRef = GetData[i].SiteRef == null ? "" : GetData[i].SiteRef;
                    var ClientSign = GetData[i].ClientSign == null ? "" : GetData[i].ClientSign;
                    var EntryDate = GetData[i].EntryDate == null ? "" : DateFormat(GetData[i].EntryDate);
                    var SiteLocID = GetData[i].SiteLocID == null ? "" : GetData[i].SiteLocID;
                    var sitelocation = GetData[i].sitelocation == null ? "" : GetData[i].sitelocation;
                    var NoOfHrs = GetData[i].NoOfHrs == null ? "" : GetData[i].NoOfHrs.toFixed(2);


                    str += "<tr>"
                    str += "<td class='setWidth0' style='display:none'></td>"
                    
                    str += "<td class='setWidth1'>" + EntryDate + "</td>"
                    str += "<td class='setWidth2'>" + sitelocation + "</td>"
                    str += "<td class='setWidth3'>" + NoOfHrs + "</td>"
                    str += "<td class='setWidth4'>" + SiteRef + "</td>"
                    str += "<td class='setWidth5'>" + comments + "</td>"

                    if(ClientSign==""){
                    str += "<td title='click here to open Day Docket Form.' style='cursor:pointer;'><a type='button' id='tbnOpen' class='btnOpen' ChkDayDocketID_='" + DayDocketID + "' onclick=OpenDayDocketForm('" + DayDocketID +"','" + SiteLocID +"','" + NoOfHrs +"','" + EntryDate + "') ><i class='fa fa-link'></i>&nbsp;Open</a></td>";
                      }else{
                       str += "<td title='click here to view Pdf Report.' style='cursor:pointer;'><button type='button' Class='w3-btn w3-teal' onclick=ViewPdfDocument('" + DayDocketID +"','" + SiteLocID +"','" + EntryDate + "') ><i class='fa fa-search'></i>&nbsp;View</button></td>"
                       }
                         if(SiteRef != ""){
                            str += "<td title='click here to email Day Docket.' style='cursor:pointer;'><button type='button' Class='btn btn-danger' onclick=btnEmailClick('" + DayDocketID +"','" + SiteLocID +"','" + EntryDate + "','" + ClientSign + "') ><i class='fa fa-envelope'></i>&nbsp;Email</button></td>"
                         }else{
                          // str += "<td title='click here to email Day Docket.' style='cursor:pointer;display:none'><button type='button' Class='btn btn-success' onclick=btnEmailClick('" + DayDocketID +"','" + SiteLocID +"','" + EntryDate + "','" + ClientSign + "')><i class='fa fa-envelope'></i>&nbsp;Email</button></td>"
                            str += "<td></td>"
                         }

                    //str += "<td class='setWidth10'>" + DateFormat(LastEmailSentOn) + "</td>";

                }

                $('#tbodyDayDocket').append(str);
                
            }

            var table = $('#tblDayDocket').DataTable({
                "bSort": false,
                "processing": true,
                searching: true,
                "bLengthChange": true,
                "bInfo": false,
                autoWidth: false,
                scrollX: true,
                scrollY: true,
                scrollCollapse: true,
                scrollY: "60vh",
                "lengthMenu": [10, 25, 50],
                "pageLength": 50,

            });
            //var UserRole = getParameterByName("UserRole");
            //var DecriptValues = Decrypt([UserRole]);
            //UserRole = DecriptValues[0];
            //if (UserRole != 10) {
            //    table.column(1).visible(false);
               
            //}
        }
    })
    $('#LoadingPanel1').hide();
}  

function OpenDayDocketForm(DayDocketID,SiteLocID,NoOfHrs,EntryDate){

    $.ajax({
        type: "POST",
        url: "/DayDocket/DayDocketEntryRedirect",
        data: JSON.stringify({ DayDocketID:DayDocketID, SiteLocID:SiteLocID, NoOfHrs:NoOfHrs, EntryDate:EntryDate}),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {

                var DayDocketInst= response.DayDocketInst;
                var id = getParameterByName('id');
                var UID = getParameterByName('UID');
                var UserRole = getParameterByName('UserRole');

                if (DayDocketInst != "0") {
                    //Response.Redirect("DayDocketForm?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&DayDock=" + databaseCon.Encrypt(DayDocketInst.ToString()) + "&SiteID=" + databaseCon.Encrypt(SiteLocID) + "&EntryDate=" + databaseCon.Encrypt(Convert.ToDateTime(EntryDate).ToString()));
                    window.location.href = '/DayDocketForm/DayDocketForm?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&DayDock=' + DayDocketInst + '&SiteID=' + SiteLocID + '&EntryDate=' + EntryDate;
                }
                else {
              //Response.Redirect("DayDocketForm?UID=" + Request.QueryString["UID"] + "&UserRole=" + Request.QueryString["UserRole"] + "&id=" + Request.QueryString["id"] + "&DayDock=" + databaseCon.Encrypt(DayDocketID) + "&SiteID=" + databaseCon.Encrypt(SiteLocID) + "&EntryDate=" + databaseCon.Encrypt(Convert.ToDateTime(EntryDate).ToString()));
              window.location.href = '/DayDocketForm/DayDocketForm?UID=' + UID + '&UserRole=' + UserRole + '&id=' + id + '&DayDock=' + DayDocketID + '&SiteID=' + SiteLocID + '&EntryDate= '+ EntryDate;

            }
        }
    })
}   

function ViewPdfDocument(DayDocketID,SiteLocID,EntryDate) {

$('#LoadingPanel1').show();
var id=getParameterByName('id');

$.ajax({
    type: "POST",
    url: "/DayDocket/ViewPdfDocument",
    data: JSON.stringify({ id:id, DayDocketID:DayDocketID, SiteLocID:SiteLocID, EntryDate:EntryDate}),
    contentType: "application/json; charset=utf-8",
    dataType: "json",
    async: true,
    success: function (response) {
        if (response.Result == "Success") {
                var PdfPath = response.Message;
                if (PdfPath != "") {
                    window.open(PdfPath);
                    $('#LoadingPanel1').hide();
                } else {
                    var Response = { Result: "Failed", Message: "Pdf document not found." }
                    CustomAlert(Response);
                }
            }
        }
    });

}


function btnEmailClick(DayDocketID,SiteLocID,EntryDate,ClientSign) {

    $('#LoadingPanel1').show();

    var id = getParameterByName('id');
    var UID = getParameterByName('UID');
    var UserRole = getParameterByName('UserRole');
    var DomainName = window.location.origin;
    if(ClientSign!="")
    {
    $.ajax({
        type: "POST",
        url: "/DayDocket/btnEmailClick",
        data: JSON.stringify({ id: id, UID: UID, UserRole: UserRole, DayDocketID: DayDocketID, SiteLocID:SiteLocID, EntryDate:EntryDate,  DomainName:DomainName, ClientSign:ClientSign }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            if (response.Result == "Success") {
                var txtFile = response.txtFile;
                var txttempfile = response.txttempfile;
                var txtcc = response.txtcc;
                var txtClientEmail = response.txtClientEmail;
                var txtsubject = response.txtsubject;
                var txtEmailMSg = response.txtEmailMSg;
                $('#txtFile').val(txtFile);
                $('#txttempfile').val(txttempfile);
                $('#txtcc').val(txtcc);
                $('#txtClientEmail').val(txtClientEmail);
                $('#txtsubject').val(txtsubject);
                $('#txtEmailMSg').text(txtEmailMSg);
                $('#hdnDayDocketID').val(DayDocketID);
                $('#emailConfirm').css('display', 'block');

                $('#LoadingPanel1').hide();

            } else {
                var Response = { Result: "Failed", Message: "Please Sand Email again. " };
                CustomAlert(Response);
                $('#LoadingPanel1').hide();
            }
        }
    });

    }else {
                var Response = { Result: "Failed", Message: "DayDocket not yet signed by Client." };
                CustomAlert(Response);
                $('#LoadingPanel1').hide();
            }
}

function btnSend_Click() {
    $('#LoadingPanel1').show();

    var txtClientEmail = $('#txtClientEmail').val();
    var txtcc = $('#txtcc').val();
    var txtsubject = $('#txtsubject').val();
    var txtEmailMSg = $('#txtEmailMSg').text();
    var txtFile = $('#txtFile').val();
    var hdnDayDocketID = $('#hdnDayDocketID').val();
    var txttempfile= $('#txttempfile').val();
    $.ajax({
        type: "POST",
        url: "/DayDocket/btnSend_Click",
        data: JSON.stringify({ txtClientEmail: txtClientEmail, txtcc: txtcc, txtsubject: txtsubject, txtEmailMSg: txtEmailMSg, txtFile: txtFile, DayDocketID: hdnDayDocketID, txttempfile: txttempfile }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {
            if (response.Result == "Success") {
                CustomAlert(response);
                $('#LoadingPanel1').hide();
                $('#emailConfirm').css('display', 'none');

            } else {
                CustomAlert(response);
                $('#LoadingPanel1').hide();
                $('#emailConfirm').css('display', 'none');
            }
        }
    });
}

function btnCancel_Click() {
    var txttempfile = $('#txttempfile').val();
    var txtFile = $('#txtFile').val();
    $.ajax({
        type: "POST",
        url: "/DayDocket/btnCancel_Click",
        data: JSON.stringify({ txttempfile: txttempfile,txtFile:txtFile }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        async: true,
        success: function (response) {

        }
    });
   
    $('#emailConfirm').css('display', 'none');
}


                    //  mtrltnng = response.d;
                    mtrltnng = response;
                    var Week = [];
                    var Matrltnng1 = [];
                    var Matrltnng2 = [];
                    var week1tonnage = 0;
                    var weeks = [];
                    var week10tonnage = 0;
                    var start = "";
                    var end = "";
                    if (mtrltnng.length > 0) {
                        for (var i = 0; i < mtrltnng.length; i++) {
                            var TobePush = true;
                            if (TobePush) {

                                Matrltnng1.push({ name: mtrltnng[i].WeekNo, y: mtrltnng[i].MaterialType1Tonnage, sliced: true });
                                Matrltnng2.push({ name: mtrltnng[i].WeekNo, y: mtrltnng[i].MaterialType2Tonnage, sliced: true });
                                //week1tonnage = WTonnage[0].TotErectedTonnage;
                                //week10tonnage = WTonnage[9].TotErectedTonnage;
                                Week.push(mtrltnng[i].WeekEndDate);
                                weeks.push([mtrltnng[i].WeekEndDate - 1, mtrltnng[i].MaterialType1Tonnage]);
                                // weeks.push([mtrltnng[i].WeekEndDate - 1, mtrltnng[i].MaterialType2Tonnage]);
                                if (mtrltnng[i].WeekNo == '10') {
                                    start = mtrltnng[i].WeekStartDate;
                                    end = mtrltnng[i].WeekEndDate;
                                }
                            }
                        }
                        var MaterialType1 = $("#ddlmaterial1").val() == null ? "" : $("#ddlmaterial1").val();
                        var MaterialType2 = $("#ddlmaterial2").val() == null ? "" : $("#ddlmaterial2").val();

                        //var todate = $("#ctl00_ContentPlaceHolder1_Picdatetodt_dateInput").val();
                        //var fromdate = $('#ctl00_ContentPlaceHolder1_Picdatefrmdt_dateInput').val();
                        var todate = $("#Picdatetodt").val();
                        var fromdate = $('#Picdatefrmdt').val();

                    }
                    Highcharts.chart('Chart1container', {
                        title: {
                            //align: 'left',
                            //var vk = $("#ContentPlaceHolder1_ddlsite").val();
                            //text: '(Week 10 => ' + ddlsite + ' to ' + ddlmaterial2 + ')',
                            text: '( ' + MaterialType1 + ' Vs ' + MaterialType2 + ' Builds - By Tonnage)',
                            x: -40,
                        },
                        subtitle: {
                            // align: 'left',
                            text: '(' + fromdate + ' to ' + todate + ')',
                            x: -40,
                        },
                        yAxis: {
                            allowDecimals: true,
                            title: {
                                text: ''
                            }
                        },

                        xAxis: {
                            categories: Week
                        },
                        tooltip: { pointFormat: '{series.name} :<b>{point.y:,.2f}</b>' },
                        labels: {
                            items: [{
                                html: '',
                                style: {
                                    left: '50px',
                                    top: '18px',
                                    color: (Highcharts.theme && Highcharts.theme.textColor) || 'black'
                                }
                            }]
                        },
                        navigation: {
                            buttonOptions: {
                                verticalAlign: 'top',
                                y: -12,
                            }
                        },
                        exporting: {
                            buttons: {
                                contextButton: {
                                    enabled: true,
                                    x: 9,
                                },
                                exportButton: {
                                    //x: -28,
                                    onclick: function () {
                                        $('#btnOpenModel1').click();
                                    },
                                    //symbol: 'circle'
                                    text: 'Show All'
                                }
                            }


                        },
                        series: [{
                            type: 'column',
                            regression: false,
                            regressionSettings: {
                                name: 'Linear (MaterialTypeTonnage)',
                                dashStyle: 'ShortDot',
                                color: '#76C3FD'
                            },
                            name: '( ' + MaterialType1 + ')',
                            data: Matrltnng1
                        }, {
                            type: 'column',
                            name: '( ' + MaterialType2 + ')',
                            color: '#D5333E',
                            data: Matrltnng2

                        }]
                    });

                    Highcharts.setOptions({
                        lang: {
                            thousandsSep: ','
                        }
                    });

                    function redrawchart() {
                        var chart = $('#Chart1container').highcharts();

                        var w = $('#Chart1container').closest(".wrapper").width()
                        var size = $(window).width();
                        if (size < 1150 && size > 650) {
                            chart.setSize(
                           w, w * (1.0 / 4), false
                        );
                        } else {
                            if (size < (650)) {
                                chart.setSize(
                                 w, w * (3.0 / 4), false
                              );
                            } else {
                                chart.setSize(
                         w, w * (1.0 / 4), false
                         );
                            }
                        }
                    }

                    $(window).resize(redrawchart);
                    redrawchart();
                    var row = '';
                    //$.each(response.d, function (index, obj) {
                    $.each(response, function (index, obj) {
                        var num;
                        row += "<tr class='forRemoveData'><td style='text-align: center;'>" + obj.WeekNo + "</td><td style='text-align: center;'>" + obj.WeekStartDate + "</td><td style='text-align: center;'>" + obj.WeekEndDate + "</td><td style='text-align: center;'>" + obj.MaterialType1Tonnage + "</td><td style='text-align: center;'>" + obj.MaterialType2Tonnage + "</td></tr>";
                    });
                    $("#tbDetails1 tbody").append(row);

                }

            });

        }


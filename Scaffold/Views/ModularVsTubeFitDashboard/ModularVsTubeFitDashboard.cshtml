                    for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                        siteLocid = ddlJobdropdownbind[0].areaid;
                        $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].areaid + '">' + ddlJobdropdownbind[i].area + '</option>');

                    }
                }
            });
        }

        function chart1(ClientID, Siteid, Location, MaterialType1, MaterialType2, fromdate, todate) {
            $('.forRemoveData').remove();
            $.ajax({
                type: "POST",
                //url: "../WebApi/Dashboard.asmx/MaterialProgress",
                url: "/ModularVsTubeFitDashboard/MaterialProgress",
                data: JSON.stringify({ id: ClientID, site: Siteid, jobid: Location, MaterialType1: MaterialType1, MaterialType2: MaterialType2, fromdate: fromdate, todat: todate }),

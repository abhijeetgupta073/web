        function ChangeReportdate(sender, e) {
            var ClientID = $("#hdnClientID").val();
            var MaterialType1 = $('#ddlmaterial1').val();
            var MaterialType2 = $('#ddlmaterial2').val();
            //var fromdate = $('#ctl00_ContentPlaceHolder1_Picdatefrmdt_dateInput').val();
            //var todate = $('#ctl00_ContentPlaceHolder1_Picdatetodt_dateInput').val();
            var fromdate = $('#Picdatefrmdt').val();
            var todate = $('#Picdatetodt').val();
            var Location = $("#ddlarea").val();
            var Siteid = $("#ddlsite").val();


            var dResultFromdate = new Date(fromdate);
            var dResultTodate = new Date(todate);

            if (dResultTodate < dResultFromdate) {
                alert('To Date should be greater than From Date');
            }
            var days = 70;

            var dFromPlus10week = new Date(fromdate);
            dFromPlus10week.setDate(dFromPlus10week.getDate() + days);
            var dToDate = new Date(todate);
            dToDate.setDate(dToDate.getDate());
            //fromdate.setMonth(fromdate.getMonth() + dif);
            if (dFromPlus10week < dToDate) {
                alert('Date Range should be within 10 weeks');

            }

        }

        function ChangeReporFromdate(sender, e) {
            var ClientID = $("#hdnClientID").val();
            var MaterialType1 = $('#ddlmaterial1').val();
            var MaterialType2 = $('#ddlmaterial2').val();
            //var fromdate = $('#ctl00_ContentPlaceHolder1_Picdatefrmdt_dateInput').val();
            //var todate = $('#ctl00_ContentPlaceHolder1_Picdatetodt_dateInput').val();
            var fromdate = $('#Picdatefrmdt').val();
            var todate = $('#Picdatetodt').val();
            var Location = $("#ddlarea").val();
            var Siteid = $("#ddlsite").val();

            var dFromPlus10weeks = new Date(fromdate);
            var dToDates = new Date(todate);

            if (dFromPlus10weeks > dToDates) {
                alert('From Date should be less than To Date');
            }

            var days = 70;
            var dFromPlus10week = new Date(todate);
            dFromPlus10week.setDate(dFromPlus10week.getDate() - days);
            var dToDate = new Date(fromdate);
            dToDate.setDate(dToDate.getDate());
            if (dToDate < dFromPlus10week) {
                alert('Date Range should be within 10 weeks');

            }

        }


        function BindallDropdown() {
            var id = $("#hdnClientID").val();
            $.ajax({
                url: '/ModularVsTubeFitDashboard/BindallDropdown',
                async: false,
                data: { id: id },
                success: function (response) {

                    data = response;

                    var ddSite = "<option value='All'>All</option>";
                    $.each(response.ddlsites, function (idx, obj) {
                        if (obj != null) {
                            ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                        }
                    });

                    // var ddlMaterialType = "<option value='All'>All</option>";
                    var ddlMaterialType = "";
                    $.each(response.ddlMaterialType, function (idx, obj) {
                        if (obj != null) {
                            ddlMaterialType += '<option value="' + obj.MaterialType + '">' + obj.MaterialType + '</option>';
                        }
                    });

                    $('#ddlsite').empty().append(ddSite);
                    $('#ddlmaterial1').empty().append(ddlMaterialType);
                    $('#ddlmaterial2').empty().append(ddlMaterialType);
                }
            });
        }


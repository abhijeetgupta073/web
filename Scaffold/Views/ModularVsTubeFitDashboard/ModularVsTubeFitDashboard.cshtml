                            }
                        },
                        exporting: {
                            buttons: {
                                contextButton: {
                                    enabled: true,
                                    x: 9,
                                },
                                exportButton: {
                                    //x: -28,
                                    onclick: function () {
                                        $('#btnOpenModel3').click();
                                    },
                                    //symbol: 'circle'
                                    text: 'Show All'
                                }
                            }


                        },
                        series: [{
                            type: 'column',

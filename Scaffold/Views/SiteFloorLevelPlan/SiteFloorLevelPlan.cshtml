        function btnredirecttoJob_Click(RID) {
            var UID = getParameterByName('UID');
            var UserRole = getParameterByName('UserRole');
            var Clientid = getParameterByName('id');
            var RegisterId = $("#hdnRegisterID").val();
            if (RegisterId == '' || RegisterId == null)
            {
                RegisterId = RID;
            }
            var CallFrom = 'FloorMap';

            var EncryptData = Encrypt([RegisterId, CallFrom]);
            RegisterId = EncryptData[0];
            CallFrom = EncryptData[1];
            var hdnTimeOffSet = $('#hdnTimeOffSetForAllPage').val();

            window.location.href = '/Register/Register?UID=' + UID + '&UserRole=' + UserRole + '&id=' + Clientid + '&RID=' + RegisterId + '&hdnTimeOffSet=' + hdnTimeOffSet + '&CallFrom=' + CallFrom;

        }

        function Changesite() {
            //added to display the loading panel at the time of Site change.(09-02-2023)
            $('#LoadingPanel1').css('display', 'block');
            var ClientID = $("#hdnClientID").val();
            var Siteid = $("#ddlsite").val();
            defaultlandingImage(ClientID, Siteid); // Add on 24-June-2020
            ddllocationDropdownbind(ClientID, Siteid);  // Add on 28-May-2020
            ddlbuildingDropdownbind(ClientID, Siteid, ''); // Add on 9-June-2020
            //ddlFloorLevelDropdownbind(ClientID, Siteid);
            ddlFloorLevelDropdownbind(ClientID, Siteid, '', '');
            var Drawing = $('#chkboxDrawing').is(':checked');
            GetSiteFloorLevelPlanData(ClientID, Siteid, '', '', '', Drawing);
        }

        // Add on 28-May-2020
        function Changelocation() {
            var ClientID = $("#hdnClientID").val();
            var Siteid = $("#ddlsite").val();
            var locationid = $("#ddllocation").val();
            ddlbuildingDropdownbind(ClientID, Siteid, locationid);
            ddlFloorLevelDropdownbind(ClientID, Siteid, locationid, '');
            var Drawing = $('#chkboxDrawing').is(':checked');
            GetSiteFloorLevelPlanData(ClientID, Siteid, '', locationid, '', Drawing);
        }
        // Add on 9-June-2020
        function Changebuilding() {
            var ClientID = $("#hdnClientID").val();
            var Siteid = $("#ddlsite").val();
            var locationid = $("#ddllocation").val();
            var buildingid = $("#ddlbuilding").val();
            ddlFloorLevelDropdownbind(ClientID, Siteid, locationid, buildingid);
            var Drawing = $('#chkboxDrawing').is(':checked');
            GetSiteFloorLevelPlanData(ClientID, Siteid, '', locationid, buildingid, Drawing);
        }

        function selectFloorLevel() {
            $('#LoadingPanel1').css('display', 'block');
            var ClientID = $("#hdnClientID").val();
            var Siteid = $("#ddlsite").val();
            var ddlselectFloorLevel = $("#ddlFloorLevel").val();
            $("#hdnFloorLevelId").val(ddlselectFloorLevel); // Add on 22-June-2020
            var locationid = $("#ddllocation").val();
            var buildingid = $("#ddlbuilding").val();
            //GetSiteFloorLevelPlanData(ClientID, Siteid, ddlselectFloorLevel);
            var Drawing = $('#chkboxDrawing').is(':checked');
            GetSiteFloorLevelPlanData(ClientID, Siteid, ddlselectFloorLevel, locationid, buildingid, Drawing);
            $('#LoadingPanel1').css('display', 'block');
        }

        function showdrawing() {
            var ClientID = $("#hdnClientID").val();
            var Siteid = $("#ddlsite").val();
            var ddlselectFloorLevel = $("#ddlFloorLevel").val();
            $("#hdnFloorLevelId").val(ddlselectFloorLevel); // Add on 22-June-2020
            var locationid = $("#ddllocation").val();
            var buildingid = $("#ddlbuilding").val();
            var Drawing = $('#chkboxDrawing').is(':checked');

            if ((Siteid != "" && Siteid != null) && (ddlselectFloorLevel != "" && ddlselectFloorLevel != null) && (locationid != "" && locationid != null) && (buildingid != "" && buildingid != null)) {

                GetSiteFloorLevelPlanData(ClientID, Siteid, ddlselectFloorLevel, locationid, buildingid, Drawing);
                $('#LoadingPanel1').css('display', 'block');

            } else {

            }

        }

        function SiteDropDownBind() {
            var id = $("#hdnClientID").val();
            $.ajax({
                type: "POST",
                url: "/SiteFloorLevelPlan/SiteDropDownBind",
                data: JSON.stringify({ id: id }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    var getData = response;
                    var Siteid = "";
                    $("#ddlsite").html("");
                   // $("#ddlsite").append('<option value=""></option>');
                    for (var i = 0; i < getData.length; i++) {
                        Siteid = getData[0].SiteLocID;
                        $("#ddlsite").append('<option value="' + getData[i].SiteLocID + '">' + getData[i].SiteLocation + '</option>');

                    }
                    //Added the if condition to prevent GetSiteFloorLevelPlanData multiple times comming back from register (06-02-2023)
                    var CallFrom = getParameterByName('FromReg');
                    var decryCallFrom = Decrypt(CallFrom);

                    if (decryCallFrom != 'FromReg') {
                        Changesite();
                    }
                }
            });

        }

        // Add on 28-May-2020
        function ddllocationDropdownbind(id, SiteId) {

            $.ajax({
                type: "POST",
                //url: "../WebApi/Dashboard.asmx/ddllocationDropdown",
                url: "/SiteFloorLevelPlan/ddllocationDropdown",
                data: JSON.stringify({ id: id, SiteId: SiteId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    var ddllocationbind = response;

                    $("#ddllocation").html("");
                    //$("#ContentPlaceHolder1_ddllocation").append('<option value="">All</option>');
                    $("#ddllocation").append('<option value="">Select Location</option>');
                    for (var i = 0; i < ddllocationbind.length; i++) {
                        // $("#ddllocation").append('<option value="' + ddllocationbind[i].LocationId + '">' + ddllocationbind[i].Location + '</option>');
                        $("#ddllocation").append('<option value="' + ddllocationbind[i].areaid + '">' + ddllocationbind[i].area + '</option>');
                    }
                }
            });

        }

        // Add on 9-June-2020
        function ddlbuildingDropdownbind(id, SiteId, LocationId) {

            $.ajax({
                type: "POST",
               // url: "../WebApi/Dashboard.asmx/ddlbuildingDropdown",
                url: "/SiteFloorLevelPlan/ddlbuildingDropdown",
                data: JSON.stringify({ id: id, SiteId: SiteId, LocationId: LocationId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    var ddlbuildingbind = response;
                    $("#ddlbuilding").html("");
                    //$("#ddlbuilding").append('<option value="">All</option>');
                    $("#ddlbuilding").append('<option value="">Select Building</option>');
                    for (var i = 0; i < ddlbuildingbind.length; i++) {
                        $("#ddlbuilding").append('<option value="' + ddlbuildingbind[i].buildingid + '">' + ddlbuildingbind[i].buildingno + '</option>');
                    }
                }
            });

        }

        //function ddlFloorLevelDropdownbind(id, SiteId) {
        function ddlFloorLevelDropdownbind(id, SiteId, LocationId, BuildingId) {

            $.ajax({
                type: "POST",
               // url: "../WebApi/Dashboard.asmx/ddlFloorLevelDropdown",
                url: "/SiteFloorLevelPlan/ddlFloorLevelDropdown",
               data: JSON.stringify({ id: id, SiteId: SiteId, LocationId: LocationId, BuildingId: BuildingId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    var ddlddlFloorLevelbind = response;

                    $("#ddlFloorLevel").html("");
                    $("#ddlFloorLevel").append('<option value=""></option>');
                    for (var i = 0; i < ddlddlFloorLevelbind.length; i++) {
                        //$("#ContentPlaceHolder1_ddlFloorLevel").append('<option value="' + ddlddlFloorLevelbind[i].FloorLevel + '">' + ddlddlFloorLevelbind[i].FloorLevel + '</option>');
                        $("#ddlFloorLevel").append('<option value="' + ddlddlFloorLevelbind[i].FloorLevelId + '">' + ddlddlFloorLevelbind[i].FloorLevel + '</option>');
                    }
                }
            });

        }


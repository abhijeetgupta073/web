                    <canvas id="canvas" width="640" height="480" style="width: 316px; height: 180px; margin-left: 14px; margin-top: 10px;"></canvas>
                </div>
            </div>
            <div class="row w3-padding-top">
                <div class="col-lg-6 col-sm-6 col-md-6">
                </div>
                <div class="col-lg-6 col-sm-6 col-md-6" style="display: none">
                    <label id="lblfilename"></label>

                </div>
            </div>
            <br />
        </div>

    </div>
</div>


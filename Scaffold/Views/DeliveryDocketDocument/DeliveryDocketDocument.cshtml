    function deliveryDocketDoc() {
        $('#LoadingPanel1').show();
        var id = getParameterByName('id');
        var transId = getParameterByName('TranId');
        var RInvId = getParameterByName('RInvId');

        $.ajax({
            url: '/DeliveryDocketDocument/GetdeliveryDocketDoc',
            type: 'get',
            data: { id: id, transId: transId, RInvId: RInvId },
            async: false,
            success: function (response) {
                var str = "";
                var GetData = response;
                $('#tblDeliveryDocketDocument').DataTable().clear();
                $('#tblDeliveryDocketDocument').DataTable().destroy();

                if (GetData.length > 0) {

                    for (var i = 0; i < GetData.length; i++) {
                        var DDocumentId = GetData[i].DDDocumentId == null ? "" : GetData[i].DDDocumentId;
                        var DocumentName = GetData[i].DocumentName == null ? "" : GetData[i].DocumentName;
                        var Description = GetData[i].Description == null ? "" : GetData[i].Description;
                        var DateOfUpload = GetData[i].DateOfUpload == null ? "" : GetData[i].DateOfUpload;
                        var TransID = GetData[i].TransID == null ? "" : GetData[i].TransID;

                        str += "<tr>"
                        str += "<td style='display:none;'>" + + "</td>";
                        // str += "<td id='DeleveryDocIDEdit_" + i + "' title='Edit Record' style='cursor:pointer;' class='expand fa fa-pencil'><i class='fa fa-pencil' onclick=ShowEditPopup('" + DDocumentId + "')></i></td>";
                        //str += "<td id='DeleveryDocIDEdit_" + i + "' title='Edit Record' style='cursor:pointer;' class='expand fa fa-pencil' rowNumberId='" + DDocumentId + "' onclick=OpeEditPopup('" + DDDocumentID + "','" + DocumentName + "')></td>";
                        str += "<td id=" + DDocumentId + " title='Click here for Edit' style='cursor:pointer;' DDescription='" + Description + "'><i class='fa fa-pencil' onclick=OpeEditPopup('" + DDocumentId + "','" + DocumentName + "')></i></td>";
                        str += "<td id='DeleveryDocIDDelete_" + i + "' title='Delete' style='cursor:pointer;'><i class='fa fa-trash' onclick=ShowDeletePopup('" + DDocumentId + "')></i></td>";

                        //str += "<td id='JobId_" + i + "' style='text-align:center;'><input type='Radio' name='JonSelected' class='ChkJobIdID' JobId_='" + JobId + "'/></td>"

                        str += "<td>" + Description + "</td>"
                        str += "<td>" + DateFormat(DateOfUpload) + "</td>"
                        //str += "<td id='DeleveryDocID_" + i + "' title='View Record Record' style='cursor:pointer;'><input type="button" id="tbnView" onclick=ViewRecord('" + DDocumentId + "')/><i class='fa fa-pencil' onclick=ViewRecord('" + DDocumentId + "')></i></td>";
                        str += "<td id='DeleveryDocID_" + i + "' title='View Record Record' style='cursor:pointer;'><button type='button' id='tbnView' Class='w3-btn w3-teal' onclick=ViewRecord('" + DDocumentId + "') ><i class='fa fa-search'></i>&nbsp;View</button></td>";
                        str += "</tr>"
                    }

                    $('#tbodyTblDeliveryDocketDoc').append(str);
                }
                    $('#LoadingPanel1').hide();
                    table = $('#tblDeliveryDocketDocument').DataTable({
                        "bSort": false,
                        "processing": true,
                        searching: true,
                        "bLengthChange": false,
                        "bInfo": false,
                        autoWidth: false,
                        scrollX: true,
                        scrollCollapse: true,
                        scrollY: "60vh",
                        "paging": false,
                        "ordering": false,
                        "info": false
                    });

            }
        });
    }


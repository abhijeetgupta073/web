                var Result = response;
                if (Result > 0) {
                    var Response = { Result: "Success", Message: "Record Delete Successfully." };
                     CustomAlert(Response);
                    deliveryDocketDoc();
                } else {
                    var Response = { Result: "Failed", Message: "Record Not Delete." };
                    CustomAlert(Response);
                }
            }
        });
    }

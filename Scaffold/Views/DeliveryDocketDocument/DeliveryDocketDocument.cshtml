    function filepath() {
        $('#LoadingPanel1').show();
        var files;
        // Checking whether FormData is available in browser
        if (window.FormData !== undefined) {
            if (files == null || files == "") {
                var fileUpload = $('#fileuplod').get(0);
                files = fileUpload.files;
            }
            var fileUpload = $('#fileuplod').get(0);
            // Create FormData object
            var fileData = new FormData();
            if (files.length != 0) {

                var FileName = files[0].name;
                var FileSize = files[0].size;
                var Extension = FileName.substring(FileName.lastIndexOf('.') + 1).toLowerCase();

                if (Extension.toLowerCase() == "gif".toLowerCase() || Extension.toLowerCase() == "png" || Extension.toLowerCase() == "jpg".toLowerCase() || Extension.toLowerCase() == "jpeg".toLowerCase() || Extension.toLowerCase() == "pdf".toLowerCase() || Extension.toLowerCase() == "docx".toLowerCase() || Extension.toLowerCase() == "xlsx".toLowerCase() || Extension.toLowerCase() == "m4a".toLowerCase() || Extension.toLowerCase() == "Wav".toLowerCase() || Extension.toLowerCase() == "xls".toLowerCase() || Extension.toLowerCase() == "doc".toLowerCase()) {

                    fileData.append(files[0].name, files[0]);

                }
            }

            var UID = getParameterByName('UID');
            var UserRole = getParameterByName('UserRole');
            var id = getParameterByName('id');
            var transId = getParameterByName('TranId');
            var RInvId = getParameterByName('RInvId');
            var Site = getParameterByName('Site');
            var Job = getParameterByName('Job');

            var txtdesc = $('#txtdesc').val();
            var temimg = $('#tempimg').val();
            var fileuplod = $('#fileuplod').val();

            fileData.append('UID', UID);
            fileData.append('ClientID', id);
            fileData.append('TransId', transId);
            fileData.append('txtdesc', txtdesc);
            fileData.append('RInvId', RInvId);
            fileData.append('UserRole', UserRole);
            fileData.append('image', temimg);
            fileData.append('fileUpload', fileuplod);
            fileData.append('Site', Site);
            fileData.append('Job', Job);
            if (txtdesc != null && txtdesc != '') {
                $.ajax({
                    url: '/DeliveryDocketDocument/btnsave_Click',
                    type: "POST",
                    contentType: false, // Not to set any content header
                    processData: false, // Not to process data
                    data: fileData,
                    success: function (response) {
                        var res = response;
                        //$('#art1').addClass("w3-section w3-card-12  j-close j-alertBox-Success").css('display', 'block');
                        //$('#alertlabel1').text("Success ! Data Saved Successfully.");
                        //var Response = { Result: "Success", Message: "Data Saved Successfully." };
                        CustomAlert(response);
                        $('#Adddocs').hide();
                        location.reload();
                       // deliveryDocketDoc();
                    }
                });
            } else {
                //$('#art1').addClass("w3-section w3-card-12 j-alertBox-Failed").css('display', 'block');
                //$('#alertlabel').text("Alert ! Fill Description.");
                var Response = { Result: "Failed", Message: "Please Fill Description." };
                CustomAlert(Response);
                $('#LoadingPanel1').hide();
            }
        }
    }



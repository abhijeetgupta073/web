    function btnPrintImage_Click() {
        var container = document.getElementById("containerwithgraph");
        html2canvas(container, { allowTaint: false, backgroundColor: '#ffffcc', removeContainer: true /*width:useWidth,height:useHeight*/ }).then(function (canvas) {

            var link = document.createElement("a");
            document.body.appendChild(link);
            link.href = canvas.toDataURL();
            link.download = "Inventory_Site_History_Report.png";
            link.target = '_blank';
            link.click();
        });
    }


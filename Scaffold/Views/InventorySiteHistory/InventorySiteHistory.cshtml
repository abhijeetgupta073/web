    function formatDated(dateString) {
        if (!dateString) return '';
        let date = new Date(dateString);
        let months = [
            'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
            'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
        ];
        let day = String(date.getDate()).padStart(2, '0');
        let month = months[date.getMonth()];
        let year = date.getFullYear();
        return `${day}-${month}-${year}`;
    }
    function ShowAllTable(Code) {
        $('#LoadingPanel1').css('display', 'block');
        $('.forRemoveData').remove();
        var ClientID = getParameterByName('id');
        var SiteID = $('#ddlSite').val();
        var ddlMattype = $('#ddlMattype').val();
        var FromDate = formatDated($('#WeekStart').val());
        var EndDate = formatDated($('#WeekEnding').val());
        var ddlitemcode = $('#ddlitemcode').val();
        var ddlitemdesc = $('#ddlitemdesc').text();
        var ddlSubCategory = $('#ddlSubCategory').val();
        var ItemCode = "";
        if (Code == "" || Code == null || Code == undefined) {
            ItemCode = ddlitemcode;
        }
        else {
            ItemCode = Code;
        }
        if (ddlitemcode == "All") {
            ddlitemcode == 0;
        }

        $.ajax({
            type: "POST",
            url: "/InventorySiteHistory/GetSweatReportData",
            data: JSON.stringify({ ClientID: ClientID, SiteID: SiteID, ddlMattype: ddlMattype, FromDate: FromDate, EndDate: EndDate, ddlitemcode: ItemCode, ddlitemdesc: ddlitemdesc, ReportType: "D", ddlSubCategory: ddlSubCategory }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var getData = response;
                $('#tblSweatReportimg').DataTable().clear();
                $('#tblSweatReportimg').DataTable().destroy();

                if (getData.length != 0) {
                    var str = '';
                    $('#LoadingPanel1').css('display', 'none');
                    $.each(getData, function (index, obj) {
                        var ItemCode = obj.ItemCode == null ? "" : obj.ItemCode;
                        var ItemDesc = obj.ItemDesc == null ? "" : obj.ItemDesc;
                        var OnSiteQuantity = obj.OnSiteQuantity == null ? "" : obj.OnSiteQuantity;
                        var QuantityWithJob = obj.QuantityWithJob == null ? "" : obj.QuantityWithJob;
                        var Available = obj.Available == null ? "" : obj.Available;
                        var Utilation = obj.Utilation == null ? "" : obj.Utilation;
                        var subcategory = obj.subcategory == null ? "" : obj.subcategory;

                        str += "<tr>";
                        str += "<td id='ItemCode_" + index + "' class='setWidth14'>" + ItemCode + "</td>";
                        str += "<td id='ItemDesc_" + index + "' class='setWidth15'>" + ItemDesc + "</td>";
                        str += "<td id='OnSiteQuantity_" + index + "' class='setWidth13' >" + OnSiteQuantity + "</td>";
                        str += "<td id='QuantityWithJob_" + index + "' class='setWidth11'>" + QuantityWithJob + "</td>";
                        str += "<td id='Utilation_" + index + "' class='setWidth11'>" + Utilation + "%" + "</td>";
                        str += "<td id='Available_" + index + "' class='setWidth14'>" + Available + "</td>";
                        str += "<td id='subcategory_" + index + "' class='setWidth5'>" + subcategory + "</td>";
                        str += "</tr>";
                    });

                    $('#tblbodySweatReportm').html(str);

                    //added 18-08-2023 For excle
                    $('#hdnTableData1').html(str);
                    table = $('#tblSweatReportm').dataTable({
                        "bSort": true,
                        "processing": true,
                        scrollY: '62vh',
                        searching: true,
                        paging: true,
                        info: false
                    });
                }
                else {
                    var getData = response;
                    $('#tblSweatReportm').DataTable().clear();
                    $('#tblSweatReportm').DataTable().destroy();

                    if (getData.length != 0) {
                        var str = '';
                        $('#LoadingPanel1').css('display', 'none');
                        $.each(getData, function (index, obj) {
                            var weekdays = obj.weekdays == null ? "" : getFormattedDate(obj.weekdays);
                            var inventoryid = obj.inventoryid == null ? "" : obj.inventoryid;
                            var OnSiteQuantity = obj.OnSiteQuantity == null ? "" : obj.OnSiteQuantity;
                            var ItemCode = obj.ItemCode == null ? "" : obj.ItemCode;
                            var ItemDesc = obj.ItemDesc == null ? "" : obj.ItemDesc;
                            var UsedQty = obj.UsedQty == null ? "" : obj.UsedQty;
                            var Utilation = obj.Utilation == null ? "" : obj.Utilation;

                            str += "<tr>";
                            str += "<td id='weekdays_" + index + "' class='setWidth11'>" + weekdays + "</td>";
                            str += "<td id='inventoryid_" + index + "' style='display:none' class='setWidth12'>" + inventoryid + "</td>";
                            str += "<td id='ItemDesc_" + index + "' class='setWidth15'>" + ItemDesc + "</td>";
                            str += "<td id='OnSiteQuantity_" + index + "' class='setWidth13' >" + OnSiteQuantity + "</td>";
                            str += "<td id='ItemCode_" + index + "' class='setWidth14'>" + ItemCode + "</td>";
                            str += "<td id='UsedQty_" + index + "' class='setWidth11'>" + UsedQty + "</td>";
                            str += "<td id='Utilation_" + index + "' class='setWidth11'>" + Utilation + "%" + "</td>";
                            str += "</tr>";
                        });

                        $('#tblbodySweatReportm').html(str);
                        table = $('#tblSweatReportm').dataTable({
                            "bSort": true,
                            "processing": true,
                            scrollY: '62vh',
                            searching: true,
                            paging: true,
                            info: false
                        });
                    }
                }
            }
        });
    }

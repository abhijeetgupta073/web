    function getLastFriday() {
        var today = new Date();
        var day = today.getDay(); // Get the current day (0 = Sunday, 1 = Monday, ...)

        // Calculate the number of days to subtract to reach the last Friday
        var daysToSubtract = (day + 2) % 7;

        // Subtract the calculated number of days from the current date
        var lastFriday = new Date(today.getFullYear(), today.getMonth(), today.getDate() - daysToSubtract);

        // Return the formatted last Friday date
        var dateObj = new Date(lastFriday);
        var day = dateObj.getDate();
        var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var month = monthNames[dateObj.getMonth() + 1]; // Adding 1 since month is zero-indexed
        var month = monthNames[dateObj.getMonth()]; // now we match indes from array
        var year = dateObj.getFullYear();
        //var formattedDate = (month < 10 ? '0' + month : month) + '/' + day + '/' + year;
        var formattedDate = day + '-' + month + '-' + year;

        $("#WeekEnding").val(formattedDate);
    }

    function GetThreeMonthsOldLastFriday() {
        var today = new Date();
        //var today = new Date("2023-07-21");
        // Calculate the month and year of 3 months ago
        //var month = today.getUTCMonth() - 12;
        var month = today.getUTCMonth();
        var year = today.getUTCFullYear() - 1;

        // Adjust the year if necessary
        if (month < 0) {
            month += 12;
            year--;
        }

        // Set the date to the last day of the calculated month
        //var lastDayOfMonth = new Date(Date.UTC(year, month + 1,today.getDate()));
        //var lastDayOfMonth = new Date(Date.UTC(year, month,0));
        var lastDayOfMonth = new Date(Date.UTC(year, month, today.getDate()));

        // Calculate the day of the last Friday
        //var lastFriday = lastDayOfMonth.getUTCDate() - ((lastDayOfMonth.getUTCDay() + 1) % 7);
        var lastFriday = lastDayOfMonth.getUTCDate() - ((lastDayOfMonth.getUTCDay()) % 7);

        // Create the date object for the last Friday of 3 months ago
        var lastFridayDate = new Date(Date.UTC(year, month, lastFriday));
        // Loop until the date falls on a Friday
        while (lastFridayDate.getDay() !== 5) {
            lastFridayDate.setDate(lastFridayDate.getDate() - 1);
        }
        var day = lastFridayDate.getUTCDate();
        var monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var month = monthNames[lastFridayDate.getUTCMonth() + 1]; // Adding 1 since month is zero-indexed
        var month = monthNames[lastFridayDate.getUTCMonth()]; // now we match indes from array
        var year = lastFridayDate.getUTCFullYear();
        //var formattedDate = (month < 10 ? '0' + month : month) + '/' + day + '/' + year;
        var formattedDate = day + '-' + month + '-' + year;
        ;
        $("#WeekStart").val(formattedDate);
    }

    function SiteDropdown() {
        var ClientID = getParameterByName('id');
        var UID = getParameterByName('UID');
        $.ajax({
            type: "POST",
            url: "/InventorySiteHistory/SiteDropdown",
            data: JSON.stringify({ ClientID: ClientID, UID: UID }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
                var SiteData = response;
                var SiteLocId = "";
                $("#ddlSite").html("");
                for (var i = 0; i < SiteData.length; i++) {
                    SiteLocId = SiteData[i].SiteLocID;
                    if (SiteLocId == 0) {
                        SiteLocId = "All";
                    }
                    $("#ddlSite").append("<option value='" + SiteLocId + "'>" + SiteData[i].SiteLocation + "</option>");
                }
            }
        });
    }

    function MaterialTypeDropdownBind() {

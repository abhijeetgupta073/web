                    let str = `
    <tr style="background-color: yellow;">
            <td class="text-center" style="color: red; font-size: 20px;" colspan="14">${response.Message}</td> <!-- Adjusted colspan to match the table structure -->
    </tr>
`;

                    // Append the message row to the tbody
                    $('#tbodyOffSystemInspectionListMessage').append(str);

                    // Reinitialize the DataTable to handle this new message
                    $.ajax({
                        type: "POST",
                        url: "/OffSystemInspection/GetOffSystemInspectionData",
                        data: JSON.stringify({ id: id, SiteID: SiteID, LocationID: LocationID, ddlSubOwner: ddlSubOwner, hdnTimeOffSet: hdnTimeOffSet, ddlBuilding: ddlBuilding, FloorLevel: FloorLevel, WorkGroup: WorkGroup, Bearing: Bearing }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        maxJsonLength: 50000000,
                        async: false,
                        success: function (response) {
                            $('#ChkAllInspections').hide();
                            $('#btnSaveInspect').prop('disabled', true);
                            $('#DivtblOffSystemInspectionListMessage').show(); // Hide message div after displaying the message
                            $('#OffSystemInspectionList').show(); // Show the DataTable list

                            // Clear and destroy existing DataTable
                            $('#tblOffSystemInspectionList').DataTable().clear().destroy();

                            var str = "";
                            var GetData = response;

                            if (GetData.length > 0) {
                                for (var i = 0; i < GetData.length; i++) {
                                    var Status = GetData[i].Status || "";
                                    if (Status !== 'NotStarted' && Status !== 'Pipeline') {
                                        var RegisterId = GetData[i].REGISTERId || "";
                                        var ScaffRef = GetData[i].ShowRegisterID || "";
                                        var ClientScaffref = GetData[i].ClientScaffref || "";
                                        var Location = GetData[i].Location || "";
                                        var BuildingNo = GetData[i].BuildingNo || "";
                                        var FloorLevel = GetData[i].FloorLevel || "";
                                        var Bearing = GetData[i].Bearing || "";
                                        var Description1 = GetData[i].Description || "";
                                        var AssetNo = GetData[i].AssetNo || "";
                                        var InspectedBy = GetData[i].InspectedBy || "";
                                        var SiteLocation = GetData[i].SiteLocation || "";
                                        var RecentInspDate = GetData[i].RecentInspDate || "";

                                        str += "<tr>"
                                        str += "<td class='setWidth0' style='display:none'></td>"
                                        if (Status.toUpperCase() === "RED" || Status.toUpperCase() === "GREEN" || Status.toUpperCase() === "YELLOW") {
                                            str += "<td class='setWidth1'><img src='/images/" + Status + ".jpg' class='img-responsive' style='height: 22px;width: 22px;float: left;'/></td>";
                                        } else {
                                            str += "<td class='setWidth1'>" + Status + "</td>"
                                        }
                                        str += "<td class='setWidth1' style='display:none;'>" + Status + "</td>"
                                        str += "<td class='setWidth1'>" + ScaffRef + "</td>"
                                        str += "<td class='setWidth2'>" + SiteLocation + "</td>"
                                        str += "<td class='setWidth3'>" + Location + "</td>"
                                        str += "<td class='setWidth4'>" + BuildingNo + "</td>"
                                        str += "<td class='setWidth5'>" + AssetNo + "</td>"
                                        str += "<td class='setWidth6'>" + FloorLevel + "</td>"
                                        str += "<td class='setWidth8'>" + Bearing + "</td>"
                                        str += "<td class='setWidth10' style='cursor:pointer;'><input type='checkbox' id='ChkTransID_" + RegisterId + "' class='ChkTransID setWidth10' value=" + RegisterId + " ChkRegisterId_='" + RegisterId + "' /></td>"
                                        str += "<td class='setWidth9' style='cursor:pointer;'><input type='checkbox' class='ChkTransIDOutOffServ setWidth9' id='OutOffServiceRegisterId_" + RegisterId + "'/></td>"
                                        str += "<td class='setWidth0' style='cursor:pointer;'><input type='checkbox' class='ChkTransIDDePlank setWidth9' id='DePlankRegisterId_" + RegisterId + "'/></td>"
                                        str += "<td class='setWidth13' style='cursor:pointer;'><input type='checkbox' class='ChkTransIDTieDown setWidth9' id='TieDownRegisterId_" + RegisterId + "'/></td>"
                                        str += "<td class='setWidth11'><input id='txtcomment_" + RegisterId + "' type='text' class='setWidth11' /></td>"
                                        str += "<td class='setWidth7'>" + RecentInspDate + "</td>"
                                        str += "<td class='setWidth8'>" + InspectedBy + "</td>"
                                        str += "<td class='setWidth8'>" + ClientScaffref + "</td></tr>"
                                    }
                                }

                                $('#tbodyOffSystemInspectionList').append(str);

                                // Handling checkbox interactions
                                $('.ChkAllID').click(function () {
                                    var CheckBoxAll = $(this).prop('checked');
                                    $('.ChkTransID').prop('checked', CheckBoxAll);
                                });

                                $('.ChkTransIDDePlank').click(function () {
                                    var CheckBoxAll = $(this).prop('checked');
                                    var id = this.id.split('_')[1];
                                    $('#ChkTransID_' + id).prop('checked', CheckBoxAll);
                                    if (CheckBoxAll) {
                                        $('#OutOffServiceRegisterId_' + id).prop('checked', false);
                                        $('#TieDownRegisterId_' + id).prop('checked', false);
                                    }
                                });

                                $('.ChkTransIDTieDown').click(function () {
                                    var CheckBoxAll = $(this).prop('checked');
                                    var id = this.id.split('_')[1];
                                    $('#ChkTransID_' + id).prop('checked', CheckBoxAll);
                                    if (CheckBoxAll) {
                                        $('#DePlankRegisterId_' + id).prop('checked', false);
                                        $('#OutOffServiceRegisterId_' + id).prop('checked', false);
                                    }
                                });

                                $('.ChkTransIDOutOffServ').click(function () {
                                    var CheckBoxAll = $(this).prop('checked');
                                    var id = this.id.split('_')[1];
                                    $('#ChkTransID_' + id).prop('checked', CheckBoxAll);
                                });

                                $('#LoadingPanel1').hide();
                            }

                            // Initialize DataTable after populating data
                            $('#tblOffSystemInspectionList').DataTable({
                                "bSort": false,
                                "processing": true,
                                "bLengthChange": true,
                                autoWidth: true,
                                scrollX: true,
                                scrollY: true,
                                scrollCollapse: true,
                                scrollY: "60vh",
                                "paging": false,
                                dom: 'Bfrtip',
                                buttons: [
                                    {
                                        extend: 'csvHtml5',
                                        title: 'Off System Inspection List',
                                        exportOptions: {
                                            columns: [2, 3, 4, 5, 6, 7, 8, 9, 12, 14]
                                        },
                                    }
                                ],
                            });

                            // Disable all inputs in the DataTable (checkboxes, text fields, etc.)
                            $('#tblOffSystemInspectionList input, #tblOffSystemInspectionList select').prop('disabled', true);

                            // Hide the loading panel if it's visible
                    $('#LoadingPanel1').hide();

                            // Optionally, show the modal if required
                    //$('#GetOfflineLinkModalForInspection').show();
                            $('#OffSystemInspectionList').show();
                        }
                    });
                }



            }
        });




    }

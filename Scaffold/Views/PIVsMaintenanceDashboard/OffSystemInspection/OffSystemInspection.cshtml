<script>

    function BindallDropdown() {
        var id = getParameterByName('id');
        $.ajax({
            url: '/OffSystemInspection/BindallDropdown',
            async: false,
            data: { id: id },
            success: function (response) {

                data = response;

                var ddSite = "<option value='-1'>Select Site</option>";
                $.each(response.ddlsites, function (idx, obj) {
                    if (obj != null) {
                        // ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                        if (response.ddlsites.length === 1) {
                            // If there is only one site, set ddSite to that site and break the loop
                            ddSite = '<option value="' + obj.SiteLocID + '" selected>' + obj.SiteLocation + '</option>';
                        } else {
                            // If there are multiple sites, append the options normally
                            ddSite += '<option value="' + obj.SiteLocID + '">' + obj.SiteLocation + '</option>';
                        }
                    }
                });

                var ddlInspectedBy = "<option value=''  disabled selected='selected'>Select--</option>";

                $.each(response.ddlInspectedBy, function (idx, obj) {
                    if (obj != null) {
                        ddlInspectedBy += '<option value="' + obj.UserId + '">' + obj.name + '</option>';
                    }
                });



                $('#ddlSitesLoc').empty().append(ddSite);
                $('#ddlddlInspectedByadd').empty().append(ddlInspectedBy);

            }
        });
    }
    function dropdownlocation() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSitesLoc').val();
        $.ajax({
            url: '/OffSystemInspection/dropdownlocation',
            async: false,
            data: { id: id, SiteID: SiteID },
            success: function (response) {

                var ddlLocation = "<option value=''>All</option>";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddlLocation += '<option value="' + obj.areaid + '">' + obj.area + '</option>';
                    }
                });

                $('#ddlLocaSite').empty().append(ddlLocation);

            }
        });
    }

    function dropdownBuilding() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSitesLoc').val();
        var LocationID = $('#ddlLocaSite').val();
        $.ajax({
            url: '/OffSystemInspection/dropdownBuilding',
            async: false,
            data: { id: id, SiteID: SiteID, LocationID: LocationID },
            success: function (response) {

                var ddlBuilding = "<option value=''>All</option>";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddlBuilding += '<option value="' + obj.buildingid + '">' + obj.buildingno + '</option>';
                    }
                });

                $('#ddlBuilding').empty().append(ddlBuilding);
                $('#ddlBuilding').select2({
                    placeholder: '  Select buildings',
                    allowClear: true
                });
            }
        });
    }


    function dropdownSubOwner() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSitesLoc').val();
        var LocationID = $('#ddlLocaSite').val();
        var BuildingId = $('#ddlBuilding').val();
        var FloorLevelId = $('#ddlFloorLevel').val();
        $.ajax({
            url: '/OffSystemInspection/dropdownSubOwner',
            async: false,
            data: { id: id, SiteID: SiteID, LocationID: LocationID, BuildingId: BuildingId, FloorLevelId: FloorLevelId },
            success: function (response) {

                var ddlSubOwner = "<option value=''>All</option>";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddlSubOwner += '<option value="' + obj.ScaffoldOwner + '">' + obj.ScaffoldOwner + '</option>';
                    }
                });

                $('#ddlSubOwner').empty().append(ddlSubOwner);

                if (response.length === 0) {

                    $('#ddlSubOwner').prop('disabled', true);


                } else {


                    $('#ddlSubOwner').prop('disabled', false);


                }

            }
        });
    }
    //Added on 02-August-2022 end here

    function dropdownFloorLevel() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSitesLoc').val();
        var LocationID = $('#ddlLocaSite').val();
        var BuildingId = $('#ddlBuilding').val();

        if (BuildingId == 'All' || BuildingId == "" || BuildingId == null || BuildingId == undefined) {
            var ddlFloorLevel = "<option value=''>All</option>";
            $('#ddlFloorLevel').empty().append(ddlFloorLevel);
        }
        else {
            $.ajax({
                url: '/OffSystemInspection/dropdownFloorLevel',
                type: 'POST',
                data: { id: id, SiteID: SiteID, LocationID: LocationID, BuildingId: BuildingId },
                success: function (response) {

                    var ddlFloorLevel = "<option value=''>All</option>";
                    $.each(response, function (idx, obj) {
                        if (obj != null) {
                            ddlFloorLevel += '<option value="' + obj.FloorLevelId + '">' + obj.FloorLevel + '</option>';
                        }
                    });
                    $('#ddlFloorLevel').empty().append(ddlFloorLevel);
                }
            });
        }
    }

    function dropdownWorkgroup() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSitesLoc').val();
        var LocationID = $('#ddlLocaSite').val();
        var BuildingId = $('#ddlBuilding').val();
        var FloorLevelId = $('#ddlFloorLevel').val();
        $.ajax({
            url: '/OffSystemInspection/dropdownWorkGroup',
            async: false,
            data: { id: id, SiteID: SiteID, LocationID: LocationID, BuildingId: BuildingId, FloorLevelId: FloorLevelId },
            success: function (response) {

                var ddlWorkgroup = "<option value=''>All</option>";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddlWorkgroup += '<option value="' + obj.WorkGroup + '">' + obj.WorkGroup + '</option>';
                    }
                });

                $('#ddlWorkgroup').empty().append(ddlWorkgroup);

            }
        });
    }
    function dropdownBearing() {
        var id = getParameterByName('id');
        var SiteID = $('#ddlSitesLoc').val();
        var LocationID = $('#ddlLocaSite').val();
        var BuildingId = $('#ddlBuilding').val();
        var FloorLevelId = $('#ddlFloorLevel').val();
        var Workgroup = $('#ddlWorkgroup').val();
        $.ajax({
            url: '/OffSystemInspection/dropdownBearing',
            type: 'POST',
            data: { id: id, SiteID: SiteID, LocationID: LocationID, BuildingId: BuildingId, FloorLevelId: FloorLevelId, Workgroup: Workgroup },
            success: function (response) {

                var ddlBearing = "<option value=''>All</option>";
                $.each(response, function (idx, obj) {
                    if (obj != null) {
                        ddlBearing += '<option value="' + obj.Bearing + '">' + obj.Bearing + '</option>';
                    }
                });

                $('#ddlBearing').empty().append(ddlBearing);

            }
        });
    }

    function msgbuilding() {
        var LocationID = $('#ddlLocaSite').val();
        if (LocationID == 'All' || LocationID == "" || LocationID == null || LocationID == undefined) {
            var response = { Result: "Failed", Message: "Please Select Location Before Selecting Building." }
            CustomAlert(response);
        }
    }

    function msgfloorlevel() {
        var BuildingId = $('#ddlBuilding').val();
        if (BuildingId == 'All' || BuildingId == "" || BuildingId == null || BuildingId == undefined) {
            var response = { Result: "Failed", Message: "Please Select Building Before Selecting FloorLevel." }
            CustomAlert(response);
        }
    }

    function msglocation() {
        var SiteID = $('#ddlSitesLoc').val();
        if (SiteID == '-1' || SiteID == "" || SiteID == null || SiteID == undefined) {
            var response = { Result: "Failed", Message: "Please Select Site Before Selecting Location." }
            CustomAlert(response);
        }
    }

    function ddlSites_SelectedIndexChanged() {
        dropdownlocation();
        dropdownSubOwner();
        dropdownBuilding();
        dropdownFloorLevel(); //Added On 09-July-2022
        dropdownWorkgroup();
        dropdownBearing();
        GetOffSystemInspectionData();

                        //data: JSON.stringify({ id: id, SiteID: SiteID, LocationID: LocationID, ddlSubOwner: ddlSubOwner, hdnTimeOffSet: hdnTimeOffSet, ddlBuilding: ddlBuilding, FloorLevel: FloorLevel }),

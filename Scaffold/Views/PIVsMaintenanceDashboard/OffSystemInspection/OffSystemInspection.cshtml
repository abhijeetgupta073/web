    }
    function ddlBuilding_SelectedIndexChanged() {
        dropdownSubOwner();
        dropdownFloorLevel(); //Added On 09-July-2022
        dropdownWorkgroup();
        dropdownBearing();
        GetOffSystemInspectionData();
    }
    function ddlSubOwner_SelectedIndexChanged() {
        dropdownBearing();
        GetOffSystemInspectionData();

    }
    function ddlFloorLevel_SelectedIndexChanged() {
        /*dropdownSubOwner();*/
        dropdownBearing();
        dropdownWorkgroup();//Added on 02-August-2022
        GetOffSystemInspectionData();

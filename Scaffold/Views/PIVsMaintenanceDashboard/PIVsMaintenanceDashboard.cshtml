        function ddlsitedropdownbindquery(ClientID) {
            //var ddlsite = ("#ddlSite").val();

            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/ddlJobDashboard",
                url: "/PIVsMaintenanceDashboard/ddlsitedropdownbindquery",
                data: JSON.stringify({ id: ClientID}),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var GetData = response;
                    $("#ddlsite").html("");
                    $("#ddlsite").append('<option value="All">All</option>');
                    for (var i = 0; i < GetData.length; i++) {
                        $("#ddlsite").append('<option value="' + GetData[i].SiteLocID + '">' + GetData[i].SiteLocation + '</option>');
                    }
                }
            });

        }

        function ddlJobbind(id, SiteId) {
            //var ddlsite = ("#ddlSite").val();

            $.ajax({
                type: "POST",
                // url: "../WebApi/Dashboard.asmx/ddlJobDashboard",
                url: "/PIVsMaintenanceDashboard/ddlJobDashboard",
                data: JSON.stringify({ id: id, SiteId: SiteId }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var ddlJobdropdownbind = response;
                    $("#ddlarea").html("");
                    $("#ddlarea").append('<option value="All">All</option>');
                    for (var i = 0; i < ddlJobdropdownbind.length; i++) {
                        siteLocid = ddlJobdropdownbind[0].areaid;
                       // $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].SiteLocID + '">' + ddlJobdropdownbind[i].SiteLoca + '</option>');
                        $("#ddlarea").append('<option value="' + ddlJobdropdownbind[i].areaid + '">' + ddlJobdropdownbind[i].area + '</option>');
                    }
                }
            });

        }


        /// ChartDashboard 2 For (Upper Grid data).
        function BuildsOnSiteTons(ClientID, SiteLocId, LocationId, GraphData) {
            //$('.forRemoveData1').remove();
            $.ajax({
                type: "POST",
                //url: "../WebApi/Dashboard.asmx/PIMaintenaceDashboardData1",
                url: "/PIVsMaintenanceDashboard/PIMaintenaceDashboardData1",
                data: JSON.stringify({ ClientID: ClientID, SiteLocId: SiteLocId, LocationId: LocationId, GraphData: GraphData }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    ItemDetail = response;

                    for (var i = 0; i < ItemDetail.length; i++) {
                        var ConditionText = ItemDetail[i].ConditionText;

                        if (ConditionText == "Number OF Scaffolds Built To Date")
                        {
                            $("#txtScaffoldbuiltTotal").val(ItemDetail[i].AllValue);
                            $("#txtScaffoldbuiltPI").val(ItemDetail[i].PIValue);
                            $("#txtScaffoldbuiltMaintain").val(ItemDetail[i].MaintenanceValue);
                            //$("#ContentPlaceHolder1_txtScaffoldbuiltTotal").val(ItemDetail[i].AllValue);
                            //$("#ContentPlaceHolder1_txtScaffoldbuiltPI").val(ItemDetail[i].PIValue);
                            //$("#ContentPlaceHolder1_txtScaffoldbuiltMaintain").val(ItemDetail[i].MaintenanceValue);
                        }

                        if (ConditionText == "Total Number OF Scaffolds Standing")
                        {
                            $("#txtScaffoldStandingTotal").val(ItemDetail[i].AllValue);
                            $("#txtScaffoldStandingPI").val(ItemDetail[i].PIValue);
                            $("#txtScaffoldStandingMaintain").val(ItemDetail[i].MaintenanceValue);
                            //$("#ContentPlaceHolder1_txtScaffoldStandingTotal").val(ItemDetail[i].AllValue);
                            //$("#ContentPlaceHolder1_txtScaffoldStandingPI").val(ItemDetail[i].PIValue);
                            //$("#ContentPlaceHolder1_txtScaffoldStandingMaintain").val(ItemDetail[i].MaintenanceValue);
                        }

                        if (ConditionText == "Av Weight OF Standing Scaffold")
                        {
                            $("#txtAvgWeightTotal").val(ItemDetail[i].AllValue);
                            $("#txtAvgWeightPI").val(ItemDetail[i].PIValue);
                            $("#txtAvgWeightMaintain").val(ItemDetail[i].MaintenanceValue);
                            //$("#ContentPlaceHolder1_txtAvgWeightTotal").val(ItemDetail[i].AllValue);
                            //$("#ContentPlaceHolder1_txtAvgWeightPI").val(ItemDetail[i].PIValue);
                            //$("#ContentPlaceHolder1_txtAvgWeightMaintain").val(ItemDetail[i].MaintenanceValue);
                        }

                        if (ConditionText == "Av Number OF days Standing(To Date)")
                        {
                            $("#txtAvgNumDaysTotal").val(ItemDetail[i].AllValue);
                            $("#txtAvgNumDaysPI").val(ItemDetail[i].PIValue);
                            $("#txtAvgNumDaysMaintain").val(ItemDetail[i].MaintenanceValue);
                            //$("#ContentPlaceHolder1_txtAvgNumDaysTotal").val(ItemDetail[i].AllValue);
                            //$("#ContentPlaceHolder1_txtAvgNumDaysPI").val(ItemDetail[i].PIValue);
                            //$("#ContentPlaceHolder1_txtAvgNumDaysMaintain").val(ItemDetail[i].MaintenanceValue);
                        }

                        if (ConditionText == "AT-PAC Tonnage")
                        {
                            $("#txtATPACTonnageTotal").val(ItemDetail[i].AllValue);
                            $("#txtATPACTonnagePI").val(ItemDetail[i].PIValue);
                            $("#txtATPACTonnageMaintain").val(ItemDetail[i].MaintenanceValue);
                            //$("#ContentPlaceHolder1_txtATPACTonnageTotal").val(ItemDetail[i].AllValue);
                            //$("#ContentPlaceHolder1_txtATPACTonnagePI").val(ItemDetail[i].PIValue);
                            //$("#ContentPlaceHolder1_txtATPACTonnageMaintain").val(ItemDetail[i].MaintenanceValue);
                        }

                        if (ConditionText == "Tube & Fit Tonnage")
                        {
                            $("#txtTubeFitTonnageTotal").val(ItemDetail[i].AllValue);
                            $("#txtTubeFitTonnagePI").val(ItemDetail[i].PIValue);
                            $("#txtTubeFitTonnageMaintain").val(ItemDetail[i].MaintenanceValue);
                            //$("#ContentPlaceHolder1_txtTubeFitTonnageTotal").val(ItemDetail[i].AllValue);
                            //$("#ContentPlaceHolder1_txtTubeFitTonnagePI").val(ItemDetail[i].PIValue);
                            //$("#ContentPlaceHolder1_txtTubeFitTonnageMaintain").val(ItemDetail[i].MaintenanceValue);
                        }

                        if (ConditionText == "AT-PAC Ratio")
                        {
                            $("#txtATPACRatioTotal").val((ItemDetail[i].AllValue * 100).toFixed(2) + "%");
                            $("#txtATPACRatioPI").val((ItemDetail[i].PIValue * 100).toFixed(2) + "%");
                            $("#txtATPACRatioMaintain").val((ItemDetail[i].MaintenanceValue * 100).toFixed(2) + "%");
                            //$("#ContentPlaceHolder1_txtATPACRatioTotal").val((ItemDetail[i].AllValue*100) + "%");
                            //$("#ContentPlaceHolder1_txtATPACRatioPI").val((ItemDetail[i].PIValue*100)+ "%");
                            //$("#ContentPlaceHolder1_txtATPACRatioMaintain").val((ItemDetail[i].MaintenanceValue*100) + "%");
                        }

                        if (ConditionText == "Tube & Fit Ratio")
                        {
                            $("#txtTubeFitRatioTotal").val((ItemDetail[i].AllValue * 100).toFixed(2) + "%");
                            $("#txtTubeFitRatioPI").val((ItemDetail[i].PIValue * 100).toFixed(2) + "%");
                            $("#txtTubeFitRatioMaintain").val((ItemDetail[i].MaintenanceValue * 100).toFixed(2) + "%");
                            //$("#ContentPlaceHolder1_txtTubeFitRatioTotal").val((ItemDetail[i].AllValue*100) + "%");
                            //$("#ContentPlaceHolder1_txtTubeFitRatioPI").val((ItemDetail[i].PIValue*100) + "%");
                            //$("#ContentPlaceHolder1_txtTubeFitRatioMaintain").val((ItemDetail[i].MaintenanceValue*100) + "%");
                        }

                    }
                }
            })
        }


        $(document).ready(function () {
            $("#PIVVsMantanceDashBoardimgLogo").attr('src', '@ViewBag.ClientImage');

            var id = getParameterByName('id');
            var DecriptData = Decrypt([id]);
            $("#hdnClientID").val(DecriptData[0]);

            var ClientID = $('#hdnClientID').val();
            ddlsitedropdownbindquery(ClientID);
